;!function(){try { var e="undefined"!=typeof globalThis?globalThis:"undefined"!=typeof global?global:"undefined"!=typeof window?window:"undefined"!=typeof self?self:{},n=(new e.Error).stack;n&&((e._debugIds|| (e._debugIds={}))[n]="091f394c-0967-d1cc-8ab8-d5754416b014")}catch(e){}}();
(globalThis.TURBOPACK||(globalThis.TURBOPACK=[])).push(["object"==typeof document?document.currentScript:void 0,111265,e=>{"use strict";var a=e.i(420459);e.s(["careersPage_benefit1_description",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Meaningful equity so every team member has skin in the game.":"pt-BR"===i?"Participação acionária relevante para que cada membro da equipe tenha interesse direto no sucesso.":"de"===i?"Echte Beteiligung, damit jedes Teammitglied am Erfolg teilhat.":"fr"===i?"Une participation significative au capital pour que chaque membre de l'équipe soit pleinement impliqué dans la réussite de l'entreprise.":"es"===i?"Participación accionaria significativa para que cada miembro del equipo tenga algo en juego.":"it"===i?"Una partecipazione azionaria significativa, così ogni membro del team è coinvolto in prima persona.":"hi"===i?"सार्थक इक्विटी, ताकि टीम के हर सदस्य की इसमें हिस्सेदारी हो।":"id"===i?"Ekuitas yang berarti agar setiap anggota tim memiliki kepentingan langsung dalam keberhasilan.":"th"===i?"สิทธิ์ในหุ้นที่มีคุณค่า เพื่อให้สมาชิกทุกคนในทีมมีส่วนได้ส่วนเสียร่วมกัน":"ko"===i?"모든 팀원이 함께 성과를 나눌 수 있는 의미 있는 지분을 제공해요.":"全チームメンバーが当事者意識を持てる、意義あるエクイティ。"}])},49891,e=>{"use strict";var a=e.i(420459);e.s(["careersPage_benefit1_title",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Equity upside":"pt-BR"===i?"Ganhos com participação acionária":"de"===i?"Beteiligung am Erfolg":"fr"===i?"Participation au capital":"es"===i?"Potencial de participación accionaria":"it"===i?"Vantaggi azionari":"hi"===i?"इक्विटी का लाभ":"id"===i?"Keuntungan ekuitas":"th"===i?"ผลตอบแทนจากหุ้น":"ko"===i?"지분 혜택":"エクイティによる成長機会"}])},69245,e=>{"use strict";var a=e.i(420459);e.s(["careersPage_benefit2_description",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Comprehensive health coverage plus wellness budget for gym, sports clubs, and more.":"pt-BR"===i?"Cobertura de saúde completa, além de uma verba de bem-estar para academia, clubes esportivos e muito mais.":"de"===i?"Umfassende Krankenversicherung plus Wellness-Budget für Fitnessstudio, Sportvereine und mehr.":"fr"===i?"Une couverture santé complète ainsi qu'un budget bien-être pour la salle de sport, les clubs sportifs, et plus encore.":"es"===i?"Cobertura médica integral más un presupuesto de bienestar para gimnasio, clubes deportivos y mucho más.":"it"===i?"Copertura sanitaria completa e un budget benessere per palestra, club sportivi e molto altro.":"hi"===i?"व्यापक स्वास्थ्य सुरक्षा, साथ ही जिम, खेल क्लबों और अन्य गतिविधियों के लिए तंदुरुस्ती बजट।":"id"===i?"Jaminan kesehatan menyeluruh ditambah anggaran kebugaran untuk pusat kebugaran, klub olahraga, dan lainnya.":"th"===i?"ประกันสุขภาพครบครัน พร้อมงบสุขภาวะสำหรับฟิตเนส ชมรมกีฬา และอื่นๆ อีกมากมาย":"ko"===i?"종합 건강 보험과 함께 헬스장, 스포츠 클럽 등에 쓸 수 있는 웰니스 예산을 지원해요.":"充実した健康保険に加え、ジムやスポーツクラブなどに使えるウェルネス予算。"}])},783800,e=>{"use strict";var a=e.i(420459);e.s(["careersPage_benefit2_title",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Wellness & health":"pt-BR"===i?"Bem-estar e saúde":"de"===i?"Wellness & Gesundheit":"fr"===i?"Bien-être et santé":"es"===i?"Bienestar y salud":"it"===i?"Benessere e salute":"hi"===i?"स्वास्थ्य और तंदुरुस्ती":"id"===i?"Kebugaran & kesehatan":"th"===i?"สุขภาวะและสุขภาพ":"ko"===i?"웰니스 & 건강":"ウェルネスと健康"}])},490912,e=>{"use strict";var a=e.i(420459);e.s(["careersPage_benefit3_description",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Generous parental leave topped up globally, no matter where you are.":"pt-BR"===i?"Licença parental generosa, com benefício complementar em qualquer lugar do mundo, não importa onde você esteja.":"de"===i?"Großzügige Elternzeit, weltweit aufgestockt – egal, wo du bist.":"fr"===i?"Un congé parental généreux, complété partout dans le monde, où que vous soyez.":"es"===i?"Permiso parental generoso y remunerado en todo el mundo, estés donde estés.":"it"===i?"Congedo parentale generoso con integrazione retributiva globale, ovunque tu sia.":"hi"===i?"उदार अभिभावकीय अवकाश, जिसमें दुनिया भर में अतिरिक्त वेतन सहायता मिलती है, चाहे आप कहीं भी हों।":"id"===i?"Cuti orang tua berbayar yang besar dengan manfaat tambahan secara global, di mana pun Anda berada.":"th"===i?"วันลาเพื่อเลี้ยงดูบุตรอย่างเต็มที่ พร้อมเงินชดเชยเพิ่มเติมตามมาตรฐานทั่วโลก ไม่ว่าคุณจะอยู่ที่ไหน":"ko"===i?"어디에 있든 넉넉한 유급 육아휴직을 지원해요.":"世界中どこにいても、充実した育児休暇を追加でサポートします。"}])},295077,e=>{"use strict";var a=e.i(420459);e.s(["careersPage_benefit3_title",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Paid parental leave":"pt-BR"===i?"Licença parental remunerada":"de"===i?"Bezahlte Elternzeit":"fr"===i?"Congé parental rémunéré":"es"===i?"Permiso parental remunerado":"it"===i?"Congedo parentale retribuito":"hi"===i?"सवेतन अभिभावकीय अवकाश":"id"===i?"Cuti orang tua berbayar":"th"===i?"วันลาเลี้ยงดูบุตรแบบได้รับค่าจ้าง":"ko"===i?"유급 육아 휴직":"有給育児休暇"}])},652472,e=>{"use strict";var a=e.i(420459);e.s(["careersPage_benefit4_description",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"All the AI tools you need, fully covered. No limits, no approvals, just build.":"pt-BR"===i?"Todas as ferramentas de AI de que você precisa, totalmente cobertas. Sem limites, sem aprovações, é só construir.":"de"===i?"Alle KI-Tools, die du brauchst, voll abgedeckt. Keine Limits, keine Freigaben – einfach loslegen.":"fr"===i?"Tous les outils d'IA dont vous avez besoin, entièrement pris en charge. Aucune limite, aucune approbation, créez tout simplement.":"es"===i?"Todas las herramientas de IA que necesitas, totalmente cubiertas. Sin límites, sin aprobaciones, solo crea.":"it"===i?"Tutti gli strumenti AI di cui hai bisogno, completamente coperti. Nessun limite, nessuna approvazione: pensa solo a creare.":"hi"===i?"आपके लिए ज़रूरी सभी AI साधन, पूरी तरह कंपनी के खर्च पर। कोई सीमा नहीं, कोई मंज़ूरी नहीं, बस बनाइए।":"id"===i?"Semua alat AI yang Anda butuhkan, sepenuhnya ditanggung. Tanpa batas, tanpa persetujuan, langsung berkarya.":"th"===i?"เครื่องมือ AI ทุกอย่างที่คุณต้องการ ครอบคลุมเต็มที่ ไม่มีขีดจำกัด ไม่ต้องขออนุมัติ แค่ลงมือสร้าง":"ko"===i?"필요한 모든 AI 도구를 전액 지원해요. 제한도, 승인도 없이 그저 만들기만 하면 돼요.":"必要なAIツールはすべて完全にカバー。制限も承認も不要、ただ作ることに集中できます。"}])},390267,e=>{"use strict";var a=e.i(420459);e.s(["careersPage_benefit4_title",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Unlimited AI access":"pt-BR"===i?"Acesso ilimitado à AI":"de"===i?"Unbegrenzter KI-Zugang":"fr"===i?"Accès illimité à l'IA":"es"===i?"Acceso ilimitado a IA":"it"===i?"Accesso illimitato all'AI":"hi"===i?"AI तक असीमित पहुंच":"id"===i?"Akses AI tanpa batas":"th"===i?"เข้าถึง AI ได้ไม่จำกัด":"ko"===i?"무제한 AI 이용":"AIへの無制限アクセス"}])},240596,e=>{"use strict";var a=e.i(420459);e.s(["careersPage_benefit5_description",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Moving countries is a big deal. We help make it a little less so.":"pt-BR"===i?"Mudar de país é uma grande decisão. Nós ajudamos a tornar isso um pouco mais fácil.":"de"===i?"Ein Umzug ins Ausland ist eine große Sache. Wir machen sie ein bisschen leichter.":"fr"===i?"Changer de pays, ce n'est pas rien. Nous vous aidons à rendre cela un peu plus simple.":"es"===i?"Mudarse de país es algo importante. Te ayudamos a que lo sea un poco menos.":"it"===i?"Trasferirsi in un altro paese è un grande passo. Noi ti aiutiamo a renderlo un po' più semplice.":"hi"===i?"दूसरे देश में बसना बड़ी बात है। हम इसे थोड़ा आसान बनाने में मदद करते हैं।":"id"===i?"Pindah negara itu hal besar. Kami membantu membuatnya sedikit lebih ringan.":"th"===i?"การย้ายประเทศเป็นเรื่องใหญ่ เราช่วยให้มันง่ายขึ้นอีกนิด":"ko"===i?"다른 나라로 이주하는 건 큰일이죠. 저희가 조금 더 수월하게 도와드려요.":"海外への引っ越しは大変なこと。私たちはその負担を少しでも軽くするお手伝いをします。"}])},444363,e=>{"use strict";var a=e.i(420459);e.s(["careersPage_benefit5_title",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Relocation support":"pt-BR"===i?"Apoio à realocação":"de"===i?"Umzugsunterstützung":"fr"===i?"Aide à l’installation":"es"===i?"Apoyo para la reubicación":"it"===i?"Supporto al trasferimento":"hi"===i?"स्थानांतरण सहायता":"id"===i?"Dukungan relokasi":"th"===i?"การสนับสนุนการย้ายถิ่นฐาน":"ko"===i?"이주 지원":"移住サポート"}])},355812,e=>{"use strict";var a=e.i(420459);e.s(["careersPage_benefits_label",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Global benefits":"pt-BR"===i?"Benefícios globais":"de"===i?"Globale Benefits":"fr"===i?"Avantages mondiaux":"es"===i?"Beneficios globales":"it"===i?"Vantaggi globali":"hi"===i?"वैश्विक लाभ":"id"===i?"Manfaat global":"th"===i?"สวัสดิการทั่วโลก":"ko"===i?"글로벌 복지":"グローバル福利厚生"}])},799244,821671,857903,581775,213717,e=>{"use strict";var a=e.i(420459);e.s(["careersPage_cultureFit_item2_body",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Move fast, ship often. Results over talk. When things get messy, lean in. That's where the opportunity is.":"pt-BR"===i?"Aja rápido, lance com frequência. Resultados valem mais que discurso. Quando as coisas ficarem difíceis, encare de frente. É aí que está a oportunidade.":"de"===i?"Schnell handeln, oft ausliefern. Ergebnisse statt Reden. Wenn es kompliziert wird, packen wir an. Genau da liegt die Chance.":"fr"===i?"Avancez vite, livrez souvent. Les résultats avant les discours. Quand les choses se compliquent, foncez. C'est là que se trouve l'opportunité.":"es"===i?"Avanza rápido, lanza con frecuencia. Resultados antes que palabras. Cuando las cosas se complican, involúcrate. Ahí está la oportunidad.":"it"===i?"Muoviti in fretta, rilascia spesso. Risultati più che parole. Quando le cose si complicano, rimboccati le maniche. È lì che si nascondono le opportunità.":"hi"===i?"तेज़ी से आगे बढ़ें, अक्सर रिलीज़ करें। बातों से ज़्यादा नतीजे मायने रखते हैं। जब चीज़ें उलझ जाएँ, तो डटकर सामना करें। मौका वहीं छिपा होता है।":"id"===i?"Bergerak cepat, sering merilis. Hasil lebih penting daripada bicara. Saat keadaan jadi rumit, hadapi langsung. Di situlah peluangnya.":"th"===i?"เดินหน้าเร็ว ปล่อยผลงานบ่อย เน้นผลลัพธ์มากกว่าคำพูด เมื่อสถานการณ์ยุ่งยาก ให้เข้าไปลุย เพราะนั่นคือจุดที่มีโอกาส":"ko"===i?"빠르게 움직이고 자주 출시해요. 말보다 결과가 중요하죠. 상황이 복잡해질 때 오히려 적극적으로 뛰어드세요. 바로 거기에 기회가 있으니까요.":"スピーディーに動き、頻繁にリリースする。発言よりも成果を重視する。状況が混沌としてきたら、むしろ踏み込む。そこにこそチャンスがあります。"}],799244),e.s(["careersPage_cultureFit_item2_chip1",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Ship":"pt-BR"===i?"Entregar":"de"===i?"Ausliefern":"fr"===i?"Livrer":"es"===i?"Lanzar":"it"===i?"Rilascia":"hi"===i?"रिलीज़":"id"===i?"Rilis":"th"===i?"ปล่อยผลงาน":"ko"===i?"출시":"リリース"}],821671),e.s(["careersPage_cultureFit_item2_chip2",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Results over talk":"pt-BR"===i?"Resultados acima do discurso":"de"===i?"Ergebnisse statt Gerede":"fr"===i?"Des résultats plutôt que des paroles":"es"===i?"Resultados antes que palabras":"it"===i?"Risultati, non chiacchiere":"hi"===i?"बातों से ज़्यादा नतीजे":"id"===i?"Hasil di atas omongan":"th"===i?"เน้นผลลัพธ์มากกว่าคำพูด":"ko"===i?"말보다 결과":"発言より結果"}],857903),e.s(["careersPage_cultureFit_item2_chip3",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Focused urgency":"pt-BR"===i?"Urgência com foco":"de"===i?"Fokus und Tempo":"fr"===i?"Agir vite, avec discernement":"es"===i?"Urgencia con enfoque":"it"===i?"Urgenza mirata":"hi"===i?"केंद्रित तत्परता":"id"===i?"Fokus dan gesit":"th"===i?"ลงมืออย่างเร่งด่วนและมีเป้าหมาย":"ko"===i?"집중력 있는 속도감":"集中力とスピード感"}],581775),e.s(["careersPage_cultureFit_item2_chip4",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Thrive in chaos":"pt-BR"===i?"Prosperar no caos":"de"===i?"Im Chaos aufblühen":"fr"===i?"S'épanouir dans le chaos":"es"===i?"Prosperar en el caos":"it"===i?"A proprio agio nel caos":"hi"===i?"अव्यवस्था में आगे बढ़ें":"id"===i?"Berkembang dalam kekacauan":"th"===i?"รับมือความวุ่นวายได้ดี":"ko"===i?"혼돈 속에서도 성장하기":"混沌のなかで力を発揮"}],213717)},382831,719636,e=>{"use strict";var a=e.i(420459);e.s(["careersPage_cultureFit_item2_headlineA",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"You are a driver.":"pt-BR"===i?"Você está no comando.":"de"===i?"Du bist die treibende Kraft.":"fr"===i?"Vous êtes aux commandes.":"es"===i?"Eres quien conduce.":"it"===i?"Sei un protagonista.":"hi"===i?"आप दिशा देने वाले हैं।":"id"===i?"Kamu memegang kendali.":"th"===i?"คุณคือผู้ขับเคลื่อน":"ko"===i?"스스로 이끄는 사람이에요.":"自ら前に進める人です。"}],382831),e.s(["careersPage_cultureFit_item2_headlineB",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Not a passenger.":"pt-BR"===i?"Não é passageiro.":"de"===i?"Kein Beifahrer.":"fr"===i?"Pas un simple passager.":"es"===i?"No quien va de pasajero.":"it"===i?"Non uno spettatore.":"hi"===i?"यात्री नहीं।":"id"===i?"Bukan penumpang.":"th"===i?"ไม่ใช่แค่ผู้โดยสาร":"ko"===i?"따라가기만 하는 사람이 아니에요.":"乗客ではありません。"}],719636)},33943,526696,64894,951909,e=>{"use strict";var a=e.i(420459);e.s(["careersPage_cultureFit_item3_body",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Put customers first. Obsess over the craft. Have the courage to do things differently — even when the easier path is right there.":"pt-BR"===i?"Coloque os clientes em primeiro lugar. Seja obcecado pela qualidade. Tenha a coragem de fazer as coisas de um jeito diferente — mesmo quando o caminho mais fácil está bem ali.":"de"===i?"Stelle Kunden an erste Stelle. Lebe für das Handwerk. Hab den Mut, Dinge anders zu machen – selbst wenn der einfachere Weg direkt vor dir liegt.":"fr"===i?"Placez les clients au premier plan. Ayez l'obsession du travail bien fait. Ayez le courage de faire les choses différemment, même quand la voie la plus facile est toute trouvée.":"es"===i?"Pon a los clientes primero. Obsesiónate con el oficio. Ten el valor de hacer las cosas de otra forma, incluso cuando el camino fácil está justo ahí.":"it"===i?"Metti i clienti al primo posto. Coltiva l'ossessione per la qualità. Abbi il coraggio di fare le cose in modo diverso, anche quando la strada più facile è proprio lì davanti.":"hi"===i?"ग्राहकों को सबसे पहले रखें। काम की बारीकी के प्रति जुनूनी रहें। चीज़ों को अलग तरीके से करने का साहस रखें — भले ही आसान रास्ता ठीक सामने हो।":"id"===i?"Utamakan pelanggan. Tekun menyempurnakan karya. Beranilah melakukan hal secara berbeda — bahkan saat jalan yang lebih mudah ada di depan mata.":"th"===i?"ให้ความสำคัญกับลูกค้าเป็นอันดับแรก หมกมุ่นกับคุณภาพของงาน และกล้าที่จะทำสิ่งต่าง ๆ ในแบบที่แตกต่าง แม้ว่าเส้นทางที่ง่ายกว่าจะอยู่ตรงหน้าก็ตาม":"ko"===i?"고객을 최우선으로 생각하세요. 완성도에 몰두하세요. 더 쉬운 길이 바로 눈앞에 있더라도, 남들과 다르게 할 용기를 가지세요.":"お客様を第一に考える。ものづくりにとことんこだわる。たとえ簡単な道がすぐそこにあっても、あえて違うやり方を選ぶ勇気を持つ。"}],33943),e.s(["careersPage_cultureFit_item3_chip1",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Customers first":"pt-BR"===i?"Clientes em primeiro lugar":"de"===i?"Kunden zuerst":"fr"===i?"Les clients d'abord":"es"===i?"Los clientes primero":"it"===i?"I clienti prima di tutto":"hi"===i?"ग्राहक सबसे पहले":"id"===i?"Pelanggan yang utama":"th"===i?"ลูกค้ามาก่อน":"ko"===i?"고객 최우선":"お客様第一"}],526696),e.s(["careersPage_cultureFit_item3_chip2",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Exceptional craft":"pt-BR"===i?"Qualidade excepcional":"de"===i?"Herausragendes Handwerk":"fr"===i?"Un savoir-faire exceptionnel":"es"===i?"Excelencia en el oficio":"it"===i?"Qualità eccezionale":"hi"===i?"काम में उत्कृष्टता":"id"===i?"Karya yang luar biasa":"th"===i?"ฝีมือที่ยอดเยี่ยม":"ko"===i?"뛰어난 완성도":"卓越したものづくり"}],64894),e.s(["careersPage_cultureFit_item3_chip3",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Dare to be different":"pt-BR"===i?"Ouse ser diferente":"de"===i?"Trau dich, anders zu sein":"fr"===i?"Oser être différent":"es"===i?"Atrévete a ser diferente":"it"===i?"Osa essere diverso":"hi"===i?"अलग होने का साहस":"id"===i?"Berani tampil beda":"th"===i?"กล้าที่จะแตกต่าง":"ko"===i?"다르게 할 용기":"違いを恐れない"}],951909)},190784,e=>{"use strict";var a=e.i(420459);e.s(["careersPage_cultureFit_item3_headlineA",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"You care deeply.":"pt-BR"===i?"Você se importa de verdade.":"de"===i?"Du gehst mit echter Leidenschaft an die Sache.":"fr"===i?"Vous vous impliquez profondément.":"es"===i?"Te importa de verdad.":"it"===i?"Ci tieni davvero.":"hi"===i?"आप सचमुच परवाह करते हैं।":"id"===i?"Kamu sangat peduli.":"th"===i?"คุณใส่ใจอย่างลึกซึ้ง":"ko"===i?"진심을 다하는 사람이에요.":"本気で向き合う人です。"}])},212400,526711,186318,52741,e=>{"use strict";var a=e.i(420459);e.s(["careersPage_cultureFit_item4_body",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Hold a high bar. Choose candor over comfort. Lift the people around you — and leave your ego at the door.":"pt-BR"===i?"Mantenha um padrão elevado. Escolha a franqueza em vez do conforto. Eleve as pessoas ao seu redor — e deixe o ego do lado de fora.":"de"===i?"Setze die Messlatte hoch. Wähle Offenheit statt Bequemlichkeit. Bring die Menschen um dich herum nach vorn – und lass dein Ego vor der Tür.":"fr"===i?"Maintenez un niveau d'exigence élevé. Préférez la franchise au confort. Faites grandir les personnes qui vous entourent — et laissez votre ego à la porte.":"es"===i?"Mantén un alto nivel de exigencia. Elige la franqueza antes que la comodidad. Impulsa a quienes te rodean y deja tu ego en la puerta.":"it"===i?"Mantieni standard elevati. Scegli la franchezza al posto della comodità. Fai crescere le persone attorno a te e lascia l'ego fuori dalla porta.":"hi"===i?"ऊँचा स्तर बनाए रखें। सुविधा से ज़्यादा ईमानदार स्पष्टता चुनें। अपने आसपास के लोगों को आगे बढ़ाएँ — और अपना अहंकार दरवाज़े पर ही छोड़ दें।":"id"===i?"Pertahankan standar tinggi. Pilih kejujuran daripada kenyamanan. Dukung orang-orang di sekitarmu — dan kesampingkan egomu.":"th"===i?"ตั้งมาตรฐานไว้สูง เลือกความตรงไปตรงมามากกว่าความสบายใจ ยกระดับคนรอบข้าง และทิ้งอีโก้ไว้หน้าประตู":"ko"===i?"높은 기준을 유지하세요. 편안함보다 솔직함을 택하세요. 주변 사람들을 끌어올리고, ego는 잠시 내려놓으세요.":"高い基準を保つ。心地よさよりも率直さを選ぶ。まわりの人を引き上げる。そして、エゴは入り口に置いてくる。"}],212400),e.s(["careersPage_cultureFit_item4_chip1",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Obsess over talent":"pt-BR"===i?"Valorize talentos obsessivamente":"de"===i?"Talent im Fokus":"fr"===i?"L'obsession du talent":"es"===i?"Obsesiónate con el talento":"it"===i?"Ossessione per il talento":"hi"===i?"प्रतिभा के प्रति जुनून":"id"===i?"Terobsesi pada bakat":"th"===i?"ให้ความสำคัญกับคนเก่งอย่างจริงจัง":"ko"===i?"인재에 진심":"才能にとことんこだわる"}],526711),e.s(["careersPage_cultureFit_item4_chip2",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Candor over comfort":"pt-BR"===i?"Franqueza acima do conforto":"de"===i?"Offenheit statt Bequemlichkeit":"fr"===i?"La franchise plutôt que le confort":"es"===i?"Franqueza antes que comodidad":"it"===i?"Franchezza, non comodità":"hi"===i?"सुविधा से ज़्यादा स्पष्टता":"id"===i?"Kejujuran di atas kenyamanan":"th"===i?"ตรงไปตรงมามากกว่าความสบายใจ":"ko"===i?"편안함보다 솔직함":"心地よさより率直さ"}],186318),e.s(["careersPage_cultureFit_item4_chip3",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Lift the collective":"pt-BR"===i?"Fortaleça o coletivo":"de"===i?"Das Team stärken":"fr"===i?"Faire grandir le collectif":"es"===i?"Eleva al equipo":"it"===i?"Fai crescere il gruppo":"hi"===i?"टीम को ऊपर उठाएँ":"id"===i?"Majukan bersama":"th"===i?"ยกระดับไปด้วยกัน":"ko"===i?"함께 성장하기":"チーム全体を引き上げる"}],52741)},749335,343204,e=>{"use strict";var a=e.i(420459);e.s(["careersPage_cultureFit_item4_headlineA",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"You want to":"pt-BR"===i?"Você quer":"de"===i?"Du willst":"fr"===i?"Vous voulez":"es"===i?"Quieres":"it"===i?"Vuoi":"hi"===i?"आप चाहते हैं":"id"===i?"Kamu ingin":"th"===i?"คุณอยากจะ":"ko"===i?"우리와 함께":"目指すのは"}],749335),e.s(["careersPage_cultureFit_item4_headlineB",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"build a legacy.":"pt-BR"===i?"construir um legado.":"de"===i?"etwas Bleibendes schaffen.":"fr"===i?"bâtir un héritage.":"es"===i?"construir un legado.":"it"===i?"lasciare il segno.":"hi"===i?"एक lasting विरासत बनाना":"id"===i?"membangun warisan.":"th"===i?"สร้างผลงานที่คงอยู่":"ko"===i?"오래 남을 것을 만들고 싶어 해요.":"後世に残るものを築くこと。"}],343204)},290171,e=>{"use strict";var a=e.i(420459);e.s(["careersPage_cultureFit_label",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"You'll love it here if...":"pt-BR"===i?"Você vai adorar trabalhar aqui se...":"de"===i?"Hier wird es dir gefallen, wenn …":"fr"===i?"Vous vous plairez ici si...":"es"===i?"Te encantará estar aquí si...":"it"===i?"Ti troverai bene qui se...":"hi"===i?"आपको यहाँ अच्छा लगेगा अगर...":"id"===i?"Kamu akan betah di sini jika...":"th"===i?"คุณจะหลงรักที่นี่ถ้า...":"ko"===i?"이런 분이라면 여기서 일하는 게 즐거울 거예요...":"こんな方なら、きっと楽しめます…"}])},837647,e=>{"use strict";var a=e.i(420459);e.s(["careersPage_hero_cta",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"See open positions":"pt-BR"===i?"Ver vagas abertas":"de"===i?"Offene Stellen ansehen":"fr"===i?"Voir les postes à pourvoir":"es"===i?"Ver vacantes disponibles":"it"===i?"Scopri le posizioni aperte":"hi"===i?"खुली भर्तियाँ देखें":"id"===i?"Lihat lowongan tersedia":"th"===i?"ดูตำแหน่งงานที่เปิดรับ":"ko"===i?"채용 공고 보기":"募集中のポジションを見る"}])},754288,e=>{"use strict";var a=e.i(420459);e.s(["careersPage_hero_subtitle",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"We're a team of founders, builders, and scientists. If you're obsessed with impact and excited about democratizing software creation, then you've come to the right place.":"pt-BR"===i?"Somos um time de fundadores, criadores e cientistas. Se você é obcecado por impacto e se empolga com a ideia de democratizar a criação de software, então veio ao lugar certo.":"de"===i?"Wir sind ein Team aus Gründern, Entwicklern und Wissenschaftlern. Wenn du echte Wirkung erzielen willst und dich dafür begeisterst, die Softwareentwicklung zu demokratisieren, bist du hier genau richtig.":"fr"===i?"Nous sommes une équipe de fondateurs, de bâtisseurs et de scientifiques. Si l'impact vous passionne et que l'idée de démocratiser la création de logiciels vous enthousiasme, vous êtes au bon endroit.":"es"===i?"Somos un equipo de fundadores, creadores y científicos. Si te obsesiona el impacto y te entusiasma democratizar la creación de software, has llegado al lugar indicado.":"it"===i?"Siamo un team di fondatori, creatori e scienziati. Se vuoi generare impatto e ti entusiasma l'idea di democratizzare la creazione di software, sei nel posto giusto.":"hi"===i?"हम संस्थापकों, निर्माणकर्ताओं और वैज्ञानिकों की एक टीम हैं। अगर आप प्रभाव के प्रति जुनूनी हैं और सॉफ़्टवेयर निर्माण को सबके लिए सुलभ बनाने को लेकर उत्साहित हैं, तो आप सही जगह आए हैं।":"id"===i?"Kami adalah tim yang terdiri dari para pendiri, kreator, dan ilmuwan. Jika kamu terobsesi dengan dampak dan bersemangat mendemokratisasi pembuatan perangkat lunak, kamu datang ke tempat yang tepat.":"th"===i?"เราคือทีมของผู้ก่อตั้ง นักสร้างสรรค์ และนักวิทยาศาสตร์ หากคุณมุ่งมั่นกับการสร้างผลลัพธ์ที่มีความหมายและตื่นเต้นกับการทำให้การสร้างซอฟต์แวร์เป็นเรื่องที่ทุกคนเข้าถึงได้ คุณก็มาถูกที่แล้ว":"ko"===i?"저희는 창업자, 제작자, 과학자로 이루어진 팀입니다. 임팩트에 진심이고 소프트웨어 제작의 대중화에 설렌다면, 제대로 찾아오셨어요.":"私たちは創業者、作り手、科学者から成るチームです。大きな成果を生み出すことに情熱を注ぎ、ソフトウェア開発をもっと身近にすることにワクワクしているなら、ここはぴったりの場所です。"}])},439686,283040,e=>{"use strict";var a=e.i(420459);e.s(["careersPage_hero_titleLine1",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Unlock":"pt-BR"===i?"Desbloqueie":"de"===i?"Entfessle":"fr"===i?"Libérez":"es"===i?"Desbloquea":"it"===i?"Sblocca":"hi"===i?"खोलें":"id"===i?"Buka":"th"===i?"ปลดล็อก":"ko"===i?"가능성을 열다":"解き放つ"}],439686),e.s(["careersPage_hero_titleLine2",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Creativity":"pt-BR"===i?"Criatividade":"de"===i?"Kreativität":"fr"===i?"Créativité":"es"===i?"Creatividad":"it"===i?"Creatività":"hi"===i?"रचनात्मकता":"id"===i?"Kreativitas":"th"===i?"ความคิดสร้างสรรค์":"ko"===i?"창의력":"創造性"}],283040)}]);

