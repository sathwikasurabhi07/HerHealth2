;!function(){try { var e="undefined"!=typeof globalThis?globalThis:"undefined"!=typeof global?global:"undefined"!=typeof window?window:"undefined"!=typeof self?self:{},n=(new e.Error).stack;n&&((e._debugIds|| (e._debugIds={}))[n]="8f737666-f812-ec47-7c25-07b2d22ed001")}catch(e){}}();
(globalThis.TURBOPACK||(globalThis.TURBOPACK=[])).push(["object"==typeof document?document.currentScript:void 0,963800,e=>{"use strict";var a=e.i(420459);e.s(["sharedProductSection_feature1_description",0,(e={},i={})=>{let t=a.experimentalStaticLocale??i.locale??(0,a.getLocale)();return"en"===t?"Use your native language to describe your idea, then watch Lovable do the rest. Creating for the web is faster and easier than ever before.":"pt-BR"===t?"Use seu idioma nativo para descrever sua ideia e veja a Lovable fazer o resto. Criar para a web ficou mais rápido e fácil do que nunca.":"de"===t?"Beschreibe deine Idee in deiner Muttersprache und sieh zu, wie Lovable den Rest erledigt. Etwas fürs Web zu erstellen war noch nie so schnell und einfach.":"fr"===t?"Utilisez votre langue maternelle pour décrire votre idée, puis laissez Lovable s'occuper du reste. Créer pour le web n'a jamais été aussi rapide et facile.":"es"===t?"Usa tu idioma nativo para describir tu idea y deja que Lovable haga el resto. Crear para la web es más rápido y fácil que nunca.":"it"===t?"Usa la tua lingua per descrivere la tua idea, poi guarda Lovable fare il resto. Creare per il web è più veloce e semplice che mai.":"hi"===t?"अपने विचार को बताने के लिए अपनी मातृभाषा का इस्तेमाल करें, फिर देखें कि Lovable बाकी काम कैसे करता है। वेब के लिए कुछ बनाना अब पहले से कहीं ज़्यादा तेज़ और आसान है।":"id"===t?"Gunakan bahasa Anda sendiri untuk menjelaskan ide Anda, lalu biarkan Lovable mengerjakan sisanya. Membuat sesuatu untuk web kini lebih cepat dan mudah dari sebelumnya.":"th"===t?"ใช้ภาษาของคุณเองเพื่ออธิบายไอเดีย แล้วปล่อยให้ Lovable จัดการที่เหลือ การสร้างสรรค์สำหรับเว็บนั้นเร็วและง่ายกว่าที่เคยเป็นมา":"ko"===t?"모국어로 아이디어를 설명하기만 하면 나머지는 Lovable이 알아서 해드려요. 웹용으로 만드는 일이 그 어느 때보다 빠르고 쉬워졌어요.":"アイデアを普段使う言葉で説明するだけで、あとはLovableにお任せください。ウェブ制作がこれまでになく速く、簡単になります。"}])},526125,e=>{"use strict";var a=e.i(420459);e.s(["sharedProductSection_feature1_title",0,(e={},i={})=>{let t=a.experimentalStaticLocale??i.locale??(0,a.getLocale)();return"en"===t?"20x faster than coding.":"pt-BR"===t?"20x mais rápido que programar.":"de"===t?"20x schneller als Programmieren.":"fr"===t?"20 fois plus rapide que coder.":"es"===t?"20 veces más rápido que programar.":"it"===t?"20 volte più veloce della programmazione.":"hi"===t?"कोडिंग से 20 गुना तेज़।":"id"===t?"20x lebih cepat daripada menulis kode.":"th"===t?"เร็วกว่าการเขียนโค้ด 20 เท่า":"ko"===t?"코딩보다 20배 빠르게.":"コーディングより20倍速く。"}])},966199,e=>{"use strict";var a=e.i(420459);e.s(["sharedProductSection_feature2_description",0,(e={},i={})=>{let t=a.experimentalStaticLocale??i.locale??(0,a.getLocale)();return"en"===t?"Forget about the overhead of frontend engineers or freelancers to maintain your website. Ask in text to change anything.":"pt-BR"===t?"Esqueça o trabalho extra de engenheiros de frontend ou freelancers para manter seu site. Basta pedir por texto para alterar qualquer coisa.":"de"===t?"Vergiss den Aufwand mit Frontend-Entwicklern oder Freelancern, um deine Website zu pflegen. Beschreibe einfach im Text, was du ändern möchtest.":"fr"===t?"Oubliez les contraintes liées aux ingénieurs front-end ou aux freelances pour maintenir votre site web. Demandez simplement les changements par écrit.":"es"===t?"Olvídate de depender de ingenieros de interfaz o profesionales independientes para mantener tu sitio web. Pide cualquier cambio con texto.":"it"===t?"Dimentica i costi legati a sviluppatori frontend o freelancer per mantenere il tuo sito web. Scrivi cosa vuoi cambiare e modifica qualsiasi cosa.":"hi"===t?"अपनी वेबसाइट को बनाए रखने के लिए फ्रंटएंड इंजीनियरों या फ्रीलांसरों के झंझट को भूल जाइए। कुछ भी बदलने के लिए बस टेक्स्ट में बताएं।":"id"===t?"Lupakan repotnya mengandalkan pengembang antarmuka atau pekerja lepas untuk merawat situs Anda. Cukup minta lewat teks untuk mengubah apa pun.":"th"===t?"ลืมภาระในการจ้างวิศวกรฝั่งหน้าเว็บหรือฟรีแลนซ์มาดูแลเว็บไซต์ของคุณไปได้เลย เพียงพิมพ์บอกเพื่อแก้ไขอะไรก็ได้":"ko"===t?"웹사이트를 유지·관리하기 위해 프런트엔드 엔지니어나 프리랜서를 두는 부담은 잊으세요. 무엇이든 텍스트로 요청해 바꿀 수 있어요.":"ウェブサイトの保守にフロントエンドエンジニアやフリーランサーを抱える手間はもう不要です。変更したいことをテキストで伝えるだけ。"}])},511702,e=>{"use strict";var a=e.i(420459);e.s(["sharedProductSection_feature2_title",0,(e={},i={})=>{let t=a.experimentalStaticLocale??i.locale??(0,a.getLocale)();return"en"===t?"Prompt to edit.":"pt-BR"===t?"Edite com comandos.":"de"===t?"Per Texteingabe bearbeiten.":"fr"===t?"Modifiez avec une simple demande.":"es"===t?"Edita con una instrucción.":"it"===t?"Scrivi per modificare.":"hi"===t?"लिखकर बदलाव करें।":"id"===t?"Cukup ketik untuk mengedit.":"th"===t?"พิมพ์เพื่อแก้ไข":"ko"===t?"프롬프트로 편집하세요.":"プロンプトで編集。"}])},425822,e=>{"use strict";var a=e.i(420459);e.s(["sharedProductSection_feature3_description",0,(e={},i={})=>{let t=a.experimentalStaticLocale??i.locale??(0,a.getLocale)();return"en"===t?"Everything that Lovable builds is yours. Sync your codebase to Github and edit in any code editor, export or publish your app instantly with one click.":"pt-BR"===t?"Tudo o que a Lovable cria é seu. Sincronize seu código com o GitHub e edite em qualquer editor de código, exporte ou publique seu app instantaneamente com um clique.":"de"===t?"Alles, was Lovable erstellt, gehört dir. Synchronisiere deinen Code mit GitHub und bearbeite ihn in jedem Code-Editor, exportiere oder veröffentliche deine App sofort mit nur einem Klick.":"fr"===t?"Tout ce que Lovable crée vous appartient. Synchronisez votre code avec GitHub et modifiez-le dans n'importe quel éditeur de code, exportez ou publiez votre application instantanément en un clic.":"es"===t?"Todo lo que crea Lovable es tuyo. Sincroniza tu código con GitHub y edítalo en cualquier editor de código, exporta o publica tu aplicación al instante con un solo clic.":"it"===t?"Tutto ciò che Lovable crea è tuo. Sincronizza il tuo codice con GitHub e modificalo in qualsiasi editor di codice, esporta o pubblica la tua app istantaneamente con un solo clic.":"hi"===t?"Lovable जो कुछ भी बनाता है, वह आपका है। अपने कोडबेस को GitHub से जोड़ें और किसी भी कोड एडिटर में बदलाव करें। एक क्लिक में अपने ऐप को तुरंत एक्सपोर्ट या प्रकाशित करें।":"id"===t?"Semua yang dibuat Lovable adalah milik Anda. Sinkronkan basis kode Anda ke GitHub dan edit di editor kode mana pun, ekspor atau terbitkan aplikasi Anda secara instan dengan satu klik.":"th"===t?"ทุกสิ่งที่ Lovable สร้างขึ้นเป็นของคุณ ซิงค์โค้ดเบสของคุณไปยัง GitHub และแก้ไขในโค้ดเอดิเตอร์ใดก็ได้ ส่งออกหรือเผยแพร่แอปของคุณได้ทันทีด้วยคลิกเดียว":"ko"===t?"Lovable이 만드는 모든 것은 여러분의 것이에요. 코드베이스를 GitHub에 동기화해 원하는 코드 에디터에서 편집하고, 클릭 한 번으로 앱을 즉시 내보내거나 게시하세요.":"Lovableが作るものはすべて自分のものです。コードベースをGitHubに同期して好きなコードエディタで編集したり、ワンクリックでアプリを即座にエクスポート・公開できます。"}])},589077,e=>{"use strict";var a=e.i(420459);e.s(["sharedProductSection_feature3_title",0,(e={},i={})=>{let t=a.experimentalStaticLocale??i.locale??(0,a.getLocale)();return"en"===t?"You own the code.":"pt-BR"===t?"O código é seu.":"de"===t?"Der Code gehört dir.":"fr"===t?"Le code vous appartient.":"es"===t?"El código es tuyo.":"it"===t?"Il codice è tuo.":"hi"===t?"कोड पर आपका अधिकार है।":"id"===t?"Kode sepenuhnya milik Anda.":"th"===t?"โค้ดเป็นของคุณ":"ko"===t?"코드는 여러분의 소유예요.":"コードは自分のもの。"}])},688630,557350,e=>{"use strict";var a=e.i(420459);e.s(["sharedProductSection_tapToView",0,(e={},i={})=>{let t=a.experimentalStaticLocale??i.locale??(0,a.getLocale)();return"en"===t?"Tap to view":"pt-BR"===t?"Toque para visualizar":"de"===t?"Zum Ansehen tippen":"fr"===t?"Appuyez pour voir":"es"===t?"Toca para ver":"it"===t?"Tocca per visualizzare":"hi"===t?"देखने के लिए टैप करें":"id"===t?"Ketuk untuk melihat":"th"===t?"แตะเพื่อดู":"ko"===t?"탭하여 보기":"タップして表示"}],688630),e.s(["sharedProductSection_title",0,(e={},i={})=>{let t=a.experimentalStaticLocale??i.locale??(0,a.getLocale)();return"en"===t?"Build high quality software without writing code.":"pt-BR"===t?"Crie software de alta qualidade sem escrever código.":"de"===t?"Erstelle hochwertige Software, ohne Code zu schreiben.":"fr"===t?"Créez des logiciels de haute qualité sans écrire de code.":"es"===t?"Crea software de alta calidad sin escribir código.":"it"===t?"Crea software di alta qualità senza scrivere codice.":"hi"===t?"बिना कोड लिखे उच्च गुणवत्ता वाला सॉफ़्टवेयर बनाएं।":"id"===t?"Bangun perangkat lunak berkualitas tinggi tanpa menulis kode.":"th"===t?"สร้างซอฟต์แวร์คุณภาพสูงโดยไม่ต้องเขียนโค้ด":"ko"===t?"코드를 작성하지 않고도 고품질 소프트웨어를 만드세요.":"コードを書かずに高品質なソフトウェアを構築。"}],557350)},888410,e=>{"use strict";var a=e.i(420459);e.s(["sharedUseCasesSection_designers_description",0,(e={},i={})=>{let t=a.experimentalStaticLocale??i.locale??(0,a.getLocale)();return"en"===t?"Bring your design idea to life without tedious prototyping work in tools like Figma.":"pt-BR"===t?"Dê vida à sua ideia de design sem o trabalho tedioso de prototipagem em ferramentas como o Figma.":"de"===t?"Erwecke deine Designidee zum Leben, ohne aufwändige Prototyping-Arbeit in Tools wie Figma.":"fr"===t?"Donnez vie à votre idée de design sans le travail fastidieux de prototypage dans des outils comme Figma.":"es"===t?"Da vida a tu idea de diseño sin el tedioso trabajo de prototipado en herramientas como Figma.":"it"===t?"Dai vita alla tua idea di design senza il noioso lavoro di prototipazione in strumenti come Figma.":"hi"===t?"Figma जैसे टूल्स में थकाऊ प्रोटोटाइपिंग के बिना अपने डिज़ाइन के विचार को साकार करें।":"id"===t?"Wujudkan ide desain Anda tanpa repot membuat prototipe di alat seperti Figma.":"th"===t?"เปลี่ยนไอเดียการออกแบบของคุณให้เป็นจริงโดยไม่ต้องเสียเวลาทำงานสร้างต้นแบบอันน่าเบื่อในเครื่องมืออย่าง Figma":"ko"===t?"Figma 같은 도구에서의 번거로운 프로토타이핑 작업 없이 디자인 아이디어를 현실로 만드세요.":"Figmaのようなツールでの面倒なプロトタイピング作業なしで、デザインのアイデアを形にできます。"}])},34943,e=>{"use strict";var a=e.i(420459);e.s(["sharedUseCasesSection_designers_title",0,(e={},i={})=>{let t=a.experimentalStaticLocale??i.locale??(0,a.getLocale)();return"en"===t||"pt-BR"===t?"Designers":"de"===t?"Designer":"fr"===t?"Designers":"es"===t?"Diseñadores":"it"===t?"Designer":"hi"===t?"डिज़ाइनर":"id"===t?"Desainer":"th"===t?"นักออกแบบ":"ko"===t?"디자이너":"デザイナー"}])},778314,e=>{"use strict";var a=e.i(420459);e.s(["sharedUseCasesSection_engineers_description",0,(e={},i={})=>{let t=a.experimentalStaticLocale??i.locale??(0,a.getLocale)();return"en"===t?"Ship an entire frontend in one prompt. Let Lovable fix bugs and do your UI edits.":"pt-BR"===t?"Lance um frontend inteiro com um único comando. Deixe a Lovable corrigir bugs e fazer suas edições de UI.":"de"===t?"Liefere ein komplettes Frontend mit einer einzigen Texteingabe. Lass Lovable Bugs beheben und deine UI-Anpassungen vornehmen.":"fr"===t?"Livrez toute une interface en une seule demande. Laissez Lovable corriger les bugs et modifier votre interface.":"es"===t?"Lanza una interfaz completa con una sola instrucción. Deja que Lovable corrija errores y haga tus cambios de UI.":"it"===t?"Pubblica un'intera interfaccia utente con una sola istruzione. Lascia che Lovable corregga i bug e si occupi delle modifiche all'interfaccia.":"hi"===t?"एक ही निर्देश से पूरा फ्रंटएंड तैयार करें। Lovable से बग ठीक करवाएं और UI में बदलाव करवाएं।":"id"===t?"Luncurkan seluruh tampilan antarmuka hanya dengan satu instruksi. Biarkan Lovable memperbaiki bug dan mengubah UI Anda.":"th"===t?"สร้างฟรอนต์เอนด์ทั้งชุดได้ด้วยพรอมต์เดียว ให้ Lovable แก้บั๊กและจัดการการแก้ไข UI ให้คุณ":"ko"===t?"프롬프트 하나로 전체 프런트엔드를 출시하세요. Lovable이 버그를 수정하고 UI 편집을 처리해 드려요.":"1つのプロンプトでフロントエンド全体を作成できます。バグ修正やUIの編集はLovableに任せましょう。"}])},915028,e=>{"use strict";var a=e.i(420459);e.s(["sharedUseCasesSection_engineers_title",0,(e={},i={})=>{let t=a.experimentalStaticLocale??i.locale??(0,a.getLocale)();return"en"===t?"Human software engineers":"pt-BR"===t?"Engenheiros de software humanos":"de"===t?"Softwareentwickler aus Fleisch und Blut":"fr"===t?"Ingénieurs logiciels humains":"es"===t?"Ingenieros de software humanos":"it"===t?"Ingegneri del software":"hi"===t?"मानव सॉफ़्टवेयर इंजीनियर":"id"===t?"Pengembang perangkat lunak manusia":"th"===t?"วิศวกรซอฟต์แวร์":"ko"===t?"소프트웨어 엔지니어":"人間のソフトウェアエンジニア"}])},479052,e=>{"use strict";var a=e.i(420459);e.s(["sharedUseCasesSection_founders_description",0,(e={},i={})=>{let t=a.experimentalStaticLocale??i.locale??(0,a.getLocale)();return"en"===t?"Iterate and validate in minutes. Launch a full product in less than a day.":"pt-BR"===t?"Itere e valide em minutos. Lance um produto completo em menos de um dia.":"de"===t?"Iteriere und validiere in Minuten. Bring ein vollständiges Produkt in weniger als einem Tag auf den Markt.":"fr"===t?"Itérez et validez en quelques minutes. Lancez un produit complet en moins d'une journée.":"es"===t?"Itera y valida en minutos. Lanza un producto completo en menos de un día.":"it"===t?"Itera e convalida in pochi minuti. Lancia un prodotto completo in meno di un giorno.":"hi"===t?"मिनटों में बदलाव करें और अपने विचार को परखें। एक दिन से भी कम समय में पूरा प्रोडक्ट लॉन्च करें।":"id"===t?"Lakukan iterasi dan validasi dalam hitungan menit. Luncurkan produk lengkap dalam waktu kurang dari sehari.":"th"===t?"ปรับปรุงและตรวจสอบไอเดียได้ในไม่กี่นาที เปิดตัวผลิตภัณฑ์ที่สมบูรณ์ได้ภายในไม่ถึงหนึ่งวัน":"ko"===t?"몇 분 만에 반복하고 검증하세요. 하루도 안 되어 완성된 제품을 출시할 수 있어요.":"数分でアイデアを試し、検証できます。1日もかからずに完全なプロダクトをローンチしましょう。"}])},904460,e=>{"use strict";var a=e.i(420459);e.s(["sharedUseCasesSection_founders_title",0,(e={},i={})=>{let t=a.experimentalStaticLocale??i.locale??(0,a.getLocale)();return"en"===t?"Founders & solopreneurs":"pt-BR"===t?"Fundadores e empreendedores solo":"de"===t?"Gründer & Solo-Unternehmer":"fr"===t?"Fondateurs et solopreneurs":"es"===t?"Fundadores y emprendedores en solitario":"it"===t?"Founder e solopreneur":"hi"===t?"फ़ाउंडर और सोलोप्रेन्योर":"id"===t?"Pendiri & wirausaha solo":"th"===t?"ผู้ก่อตั้งและผู้ประกอบการเดี่ยว":"ko"===t?"창업자 및 1인 창업가":"創業者・ひとり起業家"}])},792641,e=>{"use strict";var a=e.i(420459);e.s(["sharedUseCasesSection_productTeams_description",0,(e={},i={})=>{let t=a.experimentalStaticLocale??i.locale??(0,a.getLocale)();return"en"===t?"Empower non-technical team members to code. Align on abstract ideas by building real prototypes.":"pt-BR"===t?"Capacite membros não técnicos da equipe a programar. Alinhe a equipe em torno de ideias abstratas criando protótipos reais.":"de"===t?"Befähige Teammitglieder ohne technischen Hintergrund zum Programmieren. Stimmt euch über abstrakte Ideen ab, indem ihr echte Prototypen baut.":"fr"===t?"Permettez aux membres non techniques de votre équipe de coder. Mettez tout le monde d'accord sur des idées abstraites en créant de vrais prototypes.":"es"===t?"Permite que los miembros del equipo sin conocimientos técnicos programen. Pónganse de acuerdo sobre ideas abstractas creando prototipos reales.":"it"===t?"Permetti ai membri del team senza competenze tecniche di programmare. Allineatevi su idee astratte costruendo prototipi reali.":"hi"===t?"ग़ैर-तकनीकी टीम सदस्यों को कोड करने की ताक़त दें। असली प्रोटोटाइप बनाकर अमूर्त विचारों पर एकमत हों।":"id"===t?"Berdayakan anggota tim non-teknis untuk membuat kode. Selaraskan ide abstrak dengan membangun prototipe nyata.":"th"===t?"ให้สมาชิกในทีมที่ไม่ใช่สายเทคนิคเขียนโค้ดได้ ทำความเข้าใจไอเดียที่เป็นนามธรรมให้ตรงกันด้วยการสร้างต้นแบบจริง":"ko"===t?"비기술 팀원도 코딩할 수 있도록 지원하세요. 실제 프로토타입을 만들어 추상적인 아이디어에 대한 공감대를 형성하세요.":"技術者でないチームメンバーもコーディングできるようになります。実際のプロトタイプを作りながら、抽象的なアイデアの認識を揃えましょう。"}])},530288,e=>{"use strict";var a=e.i(420459);e.s(["sharedUseCasesSection_productTeams_title",0,(e={},i={})=>{let t=a.experimentalStaticLocale??i.locale??(0,a.getLocale)();return"en"===t?"Product teams":"pt-BR"===t?"Equipes de produto":"de"===t?"Produktteams":"fr"===t?"Équipes produit":"es"===t?"Equipos de producto":"it"===t?"Team di prodotto":"hi"===t?"प्रोडक्ट टीमें":"id"===t?"Tim produk":"th"===t?"ทีมผลิตภัณฑ์":"ko"===t?"제품 팀":"プロダクトチーム"}])},663993,e=>{"use strict";var a=e.i(420459);e.s(["sharedUseCasesSection_title",0,(e={},i={})=>{let t=a.experimentalStaticLocale??i.locale??(0,a.getLocale)();return"en"===t?"A new era for product builders and developers.":"pt-BR"===t?"Uma nova era para criadores de produtos e desenvolvedores.":"de"===t?"Eine neue Ära für Produktmacher und Entwickler.":"fr"===t?"Une nouvelle ère pour les créateurs de produits et les développeurs.":"es"===t?"Una nueva era para los creadores de productos y los desarrolladores.":"it"===t?"Una nuova era per chi crea prodotti e per gli sviluppatori.":"hi"===t?"प्रोडक्ट बनाने वालों और डेवलपर्स के लिए एक नया दौर।":"id"===t?"Era baru untuk para pembuat produk dan pengembang.":"th"===t?"ยุคใหม่สำหรับนักสร้างผลิตภัณฑ์และนักพัฒนา":"ko"===t?"제품 빌더와 개발자를 위한 새로운 시대.":"プロダクトを作る人と開発者のための新しい時代へ。"}])}]);

