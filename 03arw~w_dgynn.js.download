;!function(){try { var e="undefined"!=typeof globalThis?globalThis:"undefined"!=typeof global?global:"undefined"!=typeof window?window:"undefined"!=typeof self?self:{},n=(new e.Error).stack;n&&((e._debugIds|| (e._debugIds={}))[n]="b850edba-ca6b-7523-7a56-a18ad1b7b1e5")}catch(e){}}();
(globalThis.TURBOPACK||(globalThis.TURBOPACK=[])).push(["object"==typeof document?document.currentScript:void 0,940148,e=>{"use strict";var a=e.i(420459);e.s(["programsPage_about_access",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"As a program member, you get direct access to:":"pt-BR"===o?"Como membro do programa, você tem acesso direto a:":"de"===o?"Als Programmmitglied erhältst du direkten Zugang zu:":"fr"===o?"En tant que membre du programme, vous bénéficiez d'un accès direct à :":"es"===o?"Como miembro del programa, obtienes acceso directo a:":"it"===o?"Come membro del programma, ottieni accesso diretto a:":"hi"===o?"कार्यक्रम सदस्य के रूप में, आपको इन तक सीधी पहुँच मिलती है:":"id"===o?"Sebagai anggota program, kamu mendapatkan akses langsung ke:":"th"===o?"ในฐานะสมาชิกโปรแกรม คุณจะเข้าถึงสิ่งเหล่านี้ได้โดยตรง:":"ko"===o?"프로그램 멤버가 되면 다음 혜택을 바로 이용할 수 있어요:":"プログラムメンバーになると、以下に直接アクセスできます："}])},507851,e=>{"use strict";var a=e.i(420459);e.s(["programsPage_about_body",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"Our programs consist of a small group of builders and aren't open to everyone. We look for people who already love Lovable, who show up in their communities, and who want to be part of something bigger.":"pt-BR"===o?"Nossos programas são formados por um pequeno grupo de criadores e não são abertos a todos. Procuramos pessoas que já amam a Lovable, que estão presentes em suas comunidades e que querem fazer parte de algo maior.":"de"===o?"Unsere Programme bestehen aus einer kleinen Gruppe von Menschen, die etwas aufbauen, und sind nicht für alle offen. Wir suchen Menschen, die Lovable bereits lieben, in ihren Communitys aktiv sind und Teil von etwas Größerem sein möchten.":"fr"===o?"Nos programmes réunissent un petit groupe de créateurs et ne sont pas ouverts à tout le monde. Nous recherchons des personnes qui aiment déjà Lovable, qui sont présentes dans leurs communautés et qui veulent participer à quelque chose de plus grand.":"es"===o?"Nuestros programas están formados por un grupo reducido de creadores y no están abiertos a todo el mundo. Buscamos personas que ya aman Lovable, que están presentes en sus comunidades y que quieren formar parte de algo más grande.":"it"===o?"I nostri programmi sono composti da un piccolo gruppo di persone che creano e non sono aperti a tutti. Cerchiamo persone che amano già Lovable, che sono attive nelle proprie comunità e che vogliono far parte di qualcosa di più grande.":"hi"===o?"हमारे प्रोग्राम बिल्डर्स के एक छोटे समूह से बने होते हैं और हर किसी के लिए खुले नहीं हैं. हम ऐसे लोगों की तलाश करते हैं जो पहले से Lovable को पसंद करते हैं, जो अपने समुदायों में सक्रिय रहते हैं, और जो किसी बड़ी चीज़ का हिस्सा बनना चाहते हैं.":"id"===o?"Program kami diikuti oleh sekelompok kecil kreator dan tidak terbuka untuk semua orang. Kami mencari orang yang sudah menyukai Lovable, aktif di komunitasnya, dan ingin menjadi bagian dari sesuatu yang lebih besar.":"th"===o?"โปรแกรมของเราประกอบด้วยกลุ่มผู้สร้างเล็กๆ และไม่ได้เปิดให้ทุกคนเข้าร่วม เรามองหาคนที่หลงรัก Lovable อยู่แล้ว คนที่มีบทบาทในชุมชนของตัวเอง และอยากเป็นส่วนหนึ่งของสิ่งที่ยิ่งใหญ่กว่า":"ko"===o?"저희 프로그램은 무언가를 만드는 사람들의 소규모 그룹으로 구성되며 누구에게나 열려 있지는 않아요. 이미 Lovable을 사랑하고, 자신의 커뮤니티에서 활발히 활동하며, 더 큰 무언가의 일부가 되고 싶은 분들을 찾고 있어요.":"私たちのプログラムは少人数の作り手で構成されており、誰でも参加できるわけではありません。すでにLovableを愛用し、自分のコミュニティで活躍し、より大きな取り組みの一員になりたいと考える方を求めています。"}])},781237,e=>{"use strict";var a=e.i(420459);e.s(["programsPage_about_pill_features",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"Early access to features":"pt-BR"===o?"Acesso antecipado a recursos":"de"===o?"Früher Zugang zu Funktionen":"fr"===o?"Accès anticipé aux fonctionnalités":"es"===o?"Acceso anticipado a funciones":"it"===o?"Accesso anticipato alle funzionalità":"hi"===o?"फ़ीचर्स तक जल्दी पहुँच":"id"===o?"Akses awal ke fitur":"th"===o?"เข้าถึงฟีเจอร์ก่อนใคร":"ko"===o?"새 기능 우선 이용":"機能への早期アクセス"}])},939620,987073,e=>{"use strict";var a=e.i(420459);e.s(["programsPage_about_pill_support",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"Support from Lovable team":"pt-BR"===o?"Suporte da equipe da Lovable":"de"===o?"Unterstützung vom Lovable-Team":"fr"===o?"Assistance de l'équipe Lovable":"es"===o?"Soporte del equipo de Lovable":"it"===o?"Supporto dal team Lovable":"hi"===o?"Lovable टीम से सहायता":"id"===o?"Dukungan dari tim Lovable":"th"===o?"การสนับสนุนจากทีม Lovable":"ko"===o?"Lovable 팀의 지원":"Lovableチームからのサポート"}],939620),e.s(["programsPage_about_pill_tools",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"Internal tools":"pt-BR"===o?"Ferramentas internas":"de"===o?"Interne Tools":"fr"===o?"Outils internes":"es"===o?"Herramientas internas":"it"===o?"Strumenti interni":"hi"===o?"आंतरिक टूल":"id"===o?"Alat internal":"th"===o?"เครื่องมือภายใน":"ko"===o?"내부 도구":"社内ツール"}],987073)},20621,e=>{"use strict";var a=e.i(420459);e.s(["programsPage_about_title",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"What are Lovable Community Programs?":"pt-BR"===o?"O que são os Programas de Comunidade da Lovable?":"de"===o?"Was sind die Lovable Community Programs?":"fr"===o?"Que sont les programmes communautaires Lovable ?":"es"===o?"¿Qué son los programas de la comunidad de Lovable?":"it"===o?"Cosa sono i programmi della community Lovable?":"hi"===o?"Lovable कम्युनिटी प्रोग्राम क्या हैं?":"id"===o?"Apa itu Program Komunitas Lovable?":"th"===o?"โปรแกรมชุมชนของ Lovable คืออะไร?":"ko"===o?"Lovable 커뮤니티 프로그램이란?":"Lovableコミュニティプログラムとは？"}])},451261,29476,e=>{"use strict";var a=e.i(420459);e.s(["programsPage_hero_apply",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"Apply now":"pt-BR"===o?"Candidate-se agora":"de"===o?"Jetzt bewerben":"fr"===o?"Postuler":"es"===o?"Postúlate ahora":"it"===o?"Candidati ora":"hi"===o?"अभी आवेदन करें":"id"===o?"Daftar sekarang":"th"===o?"สมัครเลย":"ko"===o?"지금 지원하기":"今すぐ応募"}],451261),e.s(["programsPage_hero_explore",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"Explore programs":"pt-BR"===o?"Explorar programas":"de"===o?"Programme entdecken":"fr"===o?"Découvrir les programmes":"es"===o?"Explorar programas":"it"===o?"Esplora i programmi":"hi"===o?"प्रोग्राम देखें":"id"===o?"Jelajahi program":"th"===o?"สำรวจโปรแกรม":"ko"===o?"프로그램 둘러보기":"プログラムを見る"}],29476)},619610,e=>{"use strict";var a=e.i(420459);e.s(["programsPage_hero_subtitle",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"A community program for the builders closest to Lovable.":"pt-BR"===o?"Um programa comunitário para os criadores mais próximos da Lovable.":"de"===o?"Ein Community-Programm für die Menschen, die Lovable am nächsten stehen.":"fr"===o?"Un programme communautaire pour les créateurs les plus proches de Lovable.":"es"===o?"Un programa comunitario para los creadores más cercanos a Lovable.":"it"===o?"Un programma per la community dedicato ai creator più vicini a Lovable.":"hi"===o?"Lovable के सबसे करीबी बिल्डर्स के लिए एक कम्युनिटी प्रोग्राम।":"id"===o?"Program komunitas untuk para pembuat yang paling dekat dengan Lovable.":"th"===o?"โปรแกรมชุมชนสำหรับผู้สร้างที่มีส่วนร่วมใกล้ชิดกับ Lovable มากที่สุด":"ko"===o?"Lovable과 가장 가까운 빌더들을 위한 커뮤니티 프로그램이에요.":"Lovableと最も近い距離で関わるビルダーのためのコミュニティプログラム。"}])},49419,e=>{"use strict";var a=e.i(420459);e.s(["programsPage_hero_title_aria",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"Lovable Community Programs":"pt-BR"===o?"Programas de Comunidade da Lovable":"de"===o?"Lovable Community Programs":"fr"===o?"Programmes communautaires Lovable":"es"===o?"Programas de la Comunidad de Lovable":"it"===o?"Programmi per la community di Lovable":"hi"===o?"Lovable कम्युनिटी प्रोग्राम्स":"id"===o?"Program Komunitas Lovable":"th"===o?"โปรแกรมชุมชนของ Lovable":"ko"===o?"Lovable 커뮤니티 프로그램":"Lovable コミュニティプログラム"}])},84013,e=>{"use strict";var a=e.i(420459);e.s(["programsPage_hero_title_community",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"Community":"pt-BR"===o?"Comunidade":"de"===o?"Community":"fr"===o?"Communauté":"es"===o?"Comunidad":"it"===o?"Community":"hi"===o?"कम्युनिटी":"id"===o?"Komunitas":"th"===o?"ชุมชน":"ko"===o?"커뮤니티":"コミュニティ"}])},13558,e=>{"use strict";var a=e.i(420459);e.s(["programsPage_hero_title_lovable",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o||"pt-BR"===o||"de"===o||"fr"===o||"es"===o||"it"===o||"hi"===o||"id"===o||"th"===o,"Lovable"}])},779893,e=>{"use strict";var a=e.i(420459);e.s(["programsPage_process_cta",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"Apply now":"pt-BR"===o?"Candidate-se agora":"de"===o?"Jetzt bewerben":"fr"===o?"Postuler":"es"===o?"Postúlate ahora":"it"===o?"Candidati ora":"hi"===o?"अभी आवेदन करें":"id"===o?"Daftar sekarang":"th"===o?"สมัครเลย":"ko"===o?"지금 지원하기":"今すぐ応募"}])},59715,e=>{"use strict";var a=e.i(420459);e.s(["programsPage_process_step1_description",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"Tell us about yourself and why you want to be part of the program.":"pt-BR"===o?"Conte sobre você e por que deseja fazer parte do programa.":"de"===o?"Erzähl uns von dir und warum du Teil des Programms werden möchtest.":"fr"===o?"Parlez-nous de vous et expliquez pourquoi vous souhaitez rejoindre le programme.":"es"===o?"Cuéntanos sobre ti y por qué quieres formar parte del programa.":"it"===o?"Parlaci di te e del motivo per cui vuoi far parte del programma.":"hi"===o?"हमें अपने बारे में बताएं और बताएं कि आप इस प्रोग्राम का हिस्सा क्यों बनना चाहते हैं।":"id"===o?"Ceritakan tentang diri Anda dan mengapa Anda ingin menjadi bagian dari program ini.":"th"===o?"เล่าเกี่ยวกับตัวคุณและเหตุผลที่อยากเข้าร่วมโปรแกรมนี้":"ko"===o?"자신에 대해, 그리고 이 프로그램에 참여하고 싶은 이유를 알려주세요.":"ご自身について、またこのプログラムに参加したい理由を教えてください。"}])},576812,81055,e=>{"use strict";var a=e.i(420459);e.s(["programsPage_process_step1_number",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o||"pt-BR"===o||"de"===o||"fr"===o||"es"===o||"it"===o||"hi"===o||"id"===o||"th"===o,"01"}],576812),e.s(["programsPage_process_step1_title",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"Apply":"pt-BR"===o?"Inscreva-se":"de"===o?"Bewerben":"fr"===o?"Postuler":"es"===o?"Postular":"it"===o?"Candidati":"hi"===o?"आवेदन करें":"id"===o?"Daftar":"th"===o?"สมัคร":"ko"===o?"지원하기":"応募する"}],81055)},155742,e=>{"use strict";var a=e.i(420459);e.s(["programsPage_process_step2_description",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"We look at every application. If there's a fit, we'll be in touch.":"pt-BR"===o?"Avaliamos todas as inscrições. Se houver compatibilidade, entraremos em contato.":"de"===o?"Wir sehen uns jede Bewerbung an. Wenn es passt, melden wir uns bei dir.":"fr"===o?"Nous examinons chaque candidature. Si le profil correspond, nous vous contacterons.":"es"===o?"Revisamos cada solicitud. Si encajas, nos pondremos en contacto.":"it"===o?"Esaminiamo ogni candidatura. Se c'è affinità, ti contatteremo.":"hi"===o?"हम हर आवेदन को देखते हैं। अगर मेल बैठता है, तो हम आपसे संपर्क करेंगे।":"id"===o?"Kami meninjau setiap pendaftaran. Jika cocok, kami akan menghubungi kamu.":"th"===o?"เราพิจารณาทุกใบสมัคร หากเหมาะสม เราจะติดต่อกลับไป":"ko"===o?"모든 지원서를 검토합니다. 잘 맞는다고 판단되면 연락드릴게요.":"すべての応募に目を通します。双方に合いそうな場合は、こちらからご連絡します。"}])},236887,887646,e=>{"use strict";var a=e.i(420459);e.s(["programsPage_process_step2_number",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o||"pt-BR"===o||"de"===o||"fr"===o||"es"===o||"it"===o||"hi"===o||"id"===o||"th"===o,"02"}],236887),e.s(["programsPage_process_step2_title",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"We review":"pt-BR"===o?"Nós avaliamos":"de"===o?"Wir prüfen":"fr"===o?"Examen de votre candidature":"es"===o?"Revisamos":"it"===o?"Esaminiamo":"hi"===o?"हम समीक्षा करते हैं":"id"===o?"Kami meninjau":"th"===o?"เราพิจารณา":"ko"===o?"검토":"審査します"}],887646)},872844,e=>{"use strict";var a=e.i(420459);e.s(["programsPage_process_step3_description",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"Get onboarded, meet the team, and start building.":"pt-BR"===o?"Passe pela integração, conheça a equipe e comece a construir.":"de"===o?"Durchlaufe das Onboarding, lerne das Team kennen und beginne mit dem Entwickeln.":"fr"===o?"Intégrez le programme, rencontrez l'équipe et commencez à créer.":"es"===o?"Completa la incorporación, conoce al equipo y empieza a crear.":"it"===o?"Completa l'inserimento, conosci il team e inizia a creare.":"hi"===o?"ओरिएंटेशन पूरा करें, टीम से मिलें, और बनाना शुरू करें।":"id"===o?"Ikuti orientasi, kenali tim, dan mulai membangun.":"th"===o?"เข้าร่วมการปฐมนิเทศ พบกับทีม และเริ่มลงมือสร้าง":"ko"===o?"온보딩을 마치고 팀을 만나 제작을 시작하세요.":"オンボーディングを受け、チームと顔を合わせ、さっそく開発を始めましょう。"}])},292690,534034,e=>{"use strict";var a=e.i(420459);e.s(["programsPage_process_step3_number",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o||"pt-BR"===o||"de"===o||"fr"===o||"es"===o||"it"===o||"hi"===o||"id"===o||"th"===o,"03"}],292690),e.s(["programsPage_process_step3_title",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"Join your cohort":"pt-BR"===o?"Junte-se à sua turma":"de"===o?"Werde Teil deiner Gruppe":"fr"===o?"Rejoignez votre cohorte":"es"===o?"Únete a tu cohorte":"it"===o?"Unisciti al tuo gruppo":"hi"===o?"अपने समूह से जुड़ें":"id"===o?"Bergabung dengan angkatanmu":"th"===o?"เข้าร่วมรุ่นของคุณ":"ko"===o?"기수에 합류하기":"同期メンバーに加わる"}],534034)},19728,e=>{"use strict";var a=e.i(420459);e.s(["programsPage_process_subtitle",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"Applications are reviewed on a rolling basis, and spots are limited. Join the waitlist today to be the first to hear about the program!":"pt-BR"===o?"As inscrições são avaliadas continuamente e as vagas são limitadas. Entre na lista de espera hoje para ser o primeiro a saber sobre o programa!":"de"===o?"Bewerbungen werden laufend geprüft, und die Plätze sind begrenzt. Trage dich noch heute auf die Warteliste ein, um als Erstes vom Programm zu erfahren!":"fr"===o?"Les candidatures sont examinées au fil de l'eau, et les places sont limitées. Inscrivez-vous dès aujourd'hui sur la liste d'attente pour être parmi les premiers informés du programme !":"es"===o?"Las solicitudes se revisan de forma continua y las plazas son limitadas. ¡Únete hoy a la lista de espera para enterarte antes que nadie del programa!":"it"===o?"Le candidature vengono esaminate man mano che arrivano e i posti sono limitati. Iscriviti oggi alla lista d'attesa per essere il primo a ricevere notizie sul programma!":"hi"===o?"आवेदनों की समीक्षा प्राप्त होते ही की जाती है, और जगहें सीमित हैं। कार्यक्रम के बारे में सबसे पहले जानने के लिए आज ही प्रतीक्षा सूची में शामिल हों!":"id"===o?"Pendaftaran ditinjau secara berkelanjutan, dan kuota terbatas. Bergabunglah dengan daftar tunggu hari ini agar menjadi yang pertama mengetahui program ini!":"th"===o?"เราจะพิจารณาใบสมัครอย่างต่อเนื่อง และมีจำนวนที่นั่งจำกัด ลงชื่อในรายชื่อรอวันนี้เพื่อเป็นกลุ่มแรกๆ ที่ได้รับข่าวสารเกี่ยวกับโครงการ!":"ko"===o?"지원서는 수시로 검토되며 자리는 한정되어 있습니다. 오늘 대기자 명단에 등록하고 프로그램 소식을 가장 먼저 받아보세요!":"応募は随時審査され、定員には限りがあります。今すぐウェイトリストに登録して、プログラムの最新情報をいち早く受け取りましょう！"}])},244703,e=>{"use strict";var a=e.i(420459);e.s(["programsPage_process_title",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"The application process":"pt-BR"===o?"O processo de inscrição":"de"===o?"Der Bewerbungsprozess":"fr"===o?"Le processus de candidature":"es"===o?"El proceso de solicitud":"it"===o?"Il processo di candidatura":"hi"===o?"आवेदन प्रक्रिया":"id"===o?"Proses pendaftaran":"th"===o?"ขั้นตอนการสมัคร":"ko"===o?"지원 절차":"応募の流れ"}])},692030,93140,31552,906716,305121,e=>{"use strict";var a=e.i(420459);e.s(["programsPage_programs_ambassador_doing",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"Bring Lovable to your local community. Create content that inspires others to build. Run events that bring people together around AI-powered development. Work directly with the Lovable team on what comes next.":"pt-BR"===o?"Leve a Lovable para a sua comunidade local. Crie conteúdo que inspire outras pessoas a construir. Realize eventos que reúnam pessoas em torno do desenvolvimento com tecnologia de IA. Trabalhe diretamente com a equipe da Lovable no que vem a seguir.":"de"===o?"Bringe Lovable in deine lokale Community. Erstelle Inhalte, die andere zum Entwickeln inspirieren. Veranstalte Events, die Menschen rund um KI-gestützte Entwicklung zusammenbringen. Arbeite direkt mit dem Lovable-Team an den nächsten Schritten.":"fr"===o?"Faites connaître Lovable au sein de votre communauté locale. Créez du contenu qui donne envie aux autres de construire. Organisez des événements qui rassemblent les gens autour du développement assisté par l'IA. Travaillez directement avec l'équipe Lovable sur la suite.":"es"===o?"Lleva Lovable a tu comunidad local. Crea contenido que inspire a otros a crear. Organiza eventos que reúnan a las personas en torno al desarrollo impulsado por IA. Trabaja directamente con el equipo de Lovable en lo que viene.":"it"===o?"Porta Lovable nella tua comunità locale. Crea contenuti che ispirino gli altri a realizzare i propri progetti. Organizza eventi che riuniscono le persone attorno allo sviluppo basato sull'AI. Collabora direttamente con il team di Lovable su ciò che verrà dopo.":"hi"===o?"Lovable को अपने स्थानीय समुदाय तक पहुँचाएँ। ऐसी सामग्री बनाएँ जो दूसरों को निर्माण के लिए प्रेरित करे। ऐसे कार्यक्रम आयोजित करें जो लोगों को AI-संचालित विकास के इर्द-गिर्द साथ लाएँ। अगले कदमों पर सीधे Lovable टीम के साथ काम करें।":"id"===o?"Bawa Lovable ke komunitas lokalmu. Buat konten yang menginspirasi orang lain untuk membangun. Selenggarakan acara yang menyatukan orang seputar pengembangan berbasis AI. Bekerja langsung dengan tim Lovable untuk merancang langkah berikutnya.":"th"===o?"นำ Lovable ไปสู่ชุมชนท้องถิ่นของคุณ สร้างคอนเทนต์ที่จุดประกายให้ผู้อื่นอยากลงมือสร้าง จัดกิจกรรมที่เชื่อมผู้คนเข้าด้วยกันผ่านการพัฒนาด้วย AI ทำงานร่วมกับทีม Lovable โดยตรงเพื่อกำหนดก้าวต่อไป":"ko"===o?"Lovable을 여러분의 지역 커뮤니티에 알려보세요. 다른 사람들이 만들도록 영감을 주는 콘텐츠를 제작하세요. AI 기반 개발을 중심으로 사람들을 한자리에 모으는 이벤트를 열어보세요. 앞으로의 방향을 Lovable 팀과 직접 함께 만들어가세요.":"Lovable を地域コミュニティに広めましょう。人々の創作意欲をかき立てるコンテンツを作り、AI を活用した開発をテーマに人々が集まるイベントを開催します。今後の取り組みについて、Lovable チームと直接協力していきます。"}],692030),e.s(["programsPage_programs_ambassador_lookFor1",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"Already love Lovable and use it to build real projects":"pt-BR"===o?"Já amam a Lovable e a usam para construir projetos reais":"de"===o?"Lovable bereits lieben und es nutzen, um echte Projekte zu bauen":"fr"===o?"Aiment déjà Lovable et l'utilisent pour créer de vrais projets":"es"===o?"Ya te encanta Lovable y lo usas para crear proyectos reales":"it"===o?"Ami già Lovable e lo usi per realizzare progetti reali":"hi"===o?"Lovable को पहले से पसंद करते हैं और वास्तविक परियोजनाएँ बनाने के लिए इसका इस्तेमाल करते हैं":"id"===o?"Sudah menyukai Lovable dan menggunakannya untuk membangun proyek nyata":"th"===o?"รัก Lovable อยู่แล้วและใช้สร้างโปรเจกต์จริง":"ko"===o?"이미 Lovable을 좋아하고 실제 프로젝트를 만드는 데 사용하고 있는 분":"すでに Lovable を愛用し、実際のプロジェクトづくりに活用している"}],93140),e.s(["programsPage_programs_ambassador_lookFor2",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"Are active in builder, startup, founder, or creator communities with a network and a voice":"pt-BR"===o?"São ativos em comunidades de builders, startups, fundadores ou criadores, com rede de contatos e voz própria":"de"===o?"Sind aktiv in Entwickler-, Startup-, Gründer- oder Kreativ-Communitys und haben ein Netzwerk und Reichweite":"fr"===o?"Sont actifs dans des communautés de créateurs, de startups, de fondateurs ou de personnes qui construisent des projets, et y disposent d'un réseau et d'une influence":"es"===o?"Participas activamente en comunidades de creadores, startups, fundadores o emprendedores, con una red y una voz propias":"it"===o?"Sei attivo nelle comunità di sviluppatori, startup, fondatori o creativi, con una rete di contatti e una presenza riconosciuta":"hi"===o?"निर्माता, स्टार्टअप, संस्थापक या सृजनकर्ता समुदायों में सक्रिय हैं, और जिनकी पहुँच व प्रभाव है":"id"===o?"Aktif di komunitas pembuat produk, startup, pendiri, atau kreator, serta memiliki jaringan dan pengaruh":"th"===o?"มีบทบาทในชุมชนนักสร้าง สตาร์ทอัพ ผู้ก่อตั้ง หรือครีเอเตอร์ พร้อมเครือข่ายและอิทธิพลในชุมชน":"ko"===o?"빌더, 스타트업, 창업자 또는 크리에이터 커뮤니티에서 활발히 활동하며 네트워크와 영향력을 갖춘 분":"開発者、スタートアップ、創業者、クリエイターのコミュニティで活発に活動し、ネットワークと発信力を持っている"}],31552),e.s(["programsPage_programs_ambassador_lookFor3",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"Have a track record of creating content, running events, or getting people excited about AI":"pt-BR"===o?"Têm um histórico de criação de conteúdo, realização de eventos ou de engajar pessoas em torno da IA":"de"===o?"Haben Erfahrung darin, Inhalte zu erstellen, Events zu veranstalten oder Menschen für KI zu begeistern":"fr"===o?"Ont fait leurs preuves en créant du contenu, en organisant des événements ou en suscitant l'enthousiasme pour l'IA":"es"===o?"Tienes experiencia creando contenido, organizando eventos o entusiasmando a la gente con la IA":"it"===o?"Hai esperienza nella creazione di contenuti, nell'organizzazione di eventi o nel far appassionare le persone all'AI":"hi"===o?"सामग्री बनाने, कार्यक्रम आयोजित करने या लोगों को AI को लेकर उत्साहित करने का अनुभव रखते हैं":"id"===o?"Punya rekam jejak membuat konten, menyelenggarakan acara, atau membuat orang antusias tentang AI":"th"===o?"มีประสบการณ์ในการสร้างคอนเทนต์ จัดกิจกรรม หรือทำให้ผู้คนตื่นเต้นกับ AI":"ko"===o?"콘텐츠 제작, 이벤트 운영, 또는 사람들에게 AI에 대한 관심을 불러일으킨 경험이 있는 분":"コンテンツ制作やイベント運営、AI への関心を高める活動で実績がある"}],906716),e.s(["programsPage_programs_ambassador_lookFor4",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"Take initiative without being asked":"pt-BR"===o?"Tomam iniciativa sem que alguém precise pedir":"de"===o?"Ergreifen Initiative, ohne darum gebeten zu werden":"fr"===o?"Prennent des initiatives sans qu'on le leur demande":"es"===o?"Tomas la iniciativa sin que te lo pidan":"it"===o?"Prendi l'iniziativa senza che te lo si chieda":"hi"===o?"बिना कहे पहल करते हैं":"id"===o?"Berinisiatif tanpa harus diminta":"th"===o?"ลงมือทำด้วยตัวเองโดยไม่ต้องรอให้มีคนบอก":"ko"===o?"누가 시키지 않아도 스스로 주도적으로 행동하는 분":"言われなくても自ら率先して動ける"}],305121)},721058,83739,e=>{"use strict";var a=e.i(420459);e.s(["programsPage_programs_ambassador_ticketLine1",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o||"pt-BR"===o||"de"===o||"fr"===o||"es"===o||"it"===o||"hi"===o||"id"===o||"th"===o,"Lovable"}],721058),e.s(["programsPage_programs_ambassador_ticketLine2",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"Ambassador":"pt-BR"===o?"Embaixador":"de"===o?"Botschafter":"fr"===o?"Ambassadeur":"es"===o?"Embajador":"it"===o?"Ambasciatore":"hi"===o?"एंबेसडर":"id"===o?"Duta":"th"===o?"แอมบาสเดอร์":"ko"===o?"앰배서더":"アンバサダー"}],83739)},717872,e=>{"use strict";var a=e.i(420459);e.s(["programsPage_programs_ambassador_title",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"Lovable Ambassador":"pt-BR"===o?"Embaixador Lovable":"de"===o?"Lovable-Botschafter":"fr"===o?"Ambassadeur Lovable":"es"===o?"Embajador de Lovable":"it"===o?"Lovable Ambassador":"hi"===o?"Lovable एंबेसडर":"id"===o?"Duta Lovable":"th"===o?"Lovable แอมบาสเดอร์":"ko"===o?"Lovable 앰배서더":"Lovable アンバサダー"}])},968550,e=>{"use strict";var a=e.i(420459);e.s(["programsPage_programs_ambassador_whoFor",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"Professionals, community builders, and creators in the tech ecosystem.":"pt-BR"===o?"Profissionais, líderes de comunidade e criadores no ecossistema de tecnologia.":"de"===o?"Fachkräfte, Menschen, die Communitys aufbauen, und Kreative im Tech-Ökosystem.":"fr"===o?"Professionnels, animateurs de communautés et créateurs au sein de l'écosystème tech.":"es"===o?"Profesionales, creadores de comunidad y creadores de contenido del ecosistema tecnológico.":"it"===o?"Professionisti, costruttori di community e creativi nell'ecosistema tecnologico.":"hi"===o?"तकनीकी पारिस्थितिकी तंत्र में पेशेवर, समुदाय बनाने वाले लोग और स␤जनकर्ता।":"id"===o?"Profesional, penggerak komunitas, dan kreator di ekosistem teknologi.":"th"===o?"มืออาชีพ นักสร้างชุมชน และครีเอเตอร์ในระบบนิเวศเทคโนโลยี":"ko"===o?"테크 생태계의 전문가, 커뮤니티 빌더, 크리에이터를 위한 프로그램입니다.":"テックエコシステムで活躍するプロフェッショナル、コミュニティづくりに関わる方、クリエイターの方々。"}])},136334,e=>{"use strict";var a=e.i(420459);e.s(["programsPage_programs_apply",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"Apply now":"pt-BR"===o?"Inscreva-se agora":"de"===o?"Jetzt bewerben":"fr"===o?"Postuler maintenant":"es"===o?"Postúlate ahora":"it"===o?"Candidati ora":"hi"===o?"अभी आवेदन करें":"id"===o?"Daftar sekarang":"th"===o?"สมัครเลย":"ko"===o?"지금 신청하기":"今すぐ応募"}])},839190,74559,163568,925458,964783,e=>{"use strict";var a=e.i(420459);e.s(["programsPage_programs_campus_doing",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"Launch Lovable at your university. Run student courses, hackathons, and Lovable Days that get your peers building with AI. You'll bridge technical and non-technical backgrounds to create real products together. You'll be the go-to person for Lovable on campus, a role that opens doors and builds your profile before you even graduate.":"pt-BR"===o?"Lance o Lovable na sua universidade. Promova cursos para estudantes, hackathons e Lovable Days que incentivam seus colegas a criar com IA. Você conectará perfis técnicos e não técnicos para desenvolver produtos reais juntos. Você será a referência do Lovable no campus, um papel que abre portas e fortalece seu perfil antes mesmo de você se formar.":"de"===o?"Starte Lovable an deiner Universität. Organisiere Kurse für Studierende, Hackathons und Lovable Days, bei denen deine Kommilitoninnen und Kommilitonen mit KI echte Produkte entwickeln. Du verbindest technische und nicht-technische Hintergründe, um gemeinsam echte Produkte zu schaffen. Du wirst die Anlaufstelle für Lovable auf dem Campus – eine Rolle, die dir Türen öffnet und dein Profil schärft, noch bevor du deinen Abschluss machst.":"fr"===o?"Lancez Lovable dans votre université. Animez des cours pour étudiants, des hackathons et des Lovable Days qui incitent vos pairs à créer avec l'IA. Vous ferez le lien entre les profils techniques et non techniques pour créer ensemble de vrais produits. Vous deviendrez la personne de référence pour Lovable sur le campus, un rôle qui ouvre des portes et renforce votre profil avant même l'obtention de votre diplôme.":"es"===o?"Lanza Lovable en tu universidad. Organiza cursos para estudiantes, hackatones y Lovable Days que animen a tus compañeros a crear con IA. Conectarás perfiles técnicos y no técnicos para crear productos reales juntos. Serás la persona de referencia para Lovable en el campus, un rol que abre puertas y refuerza tu perfil incluso antes de graduarte.":"it"===o?"Lancia Lovable nella tua università. Organizza corsi per studenti, hackathon e Lovable Days che aiutano i tuoi compagni a creare con l'AI. Farai da ponte tra percorsi tecnici e non tecnici per creare insieme prodotti reali. Sarai il punto di riferimento per Lovable nel campus, un ruolo che apre porte e valorizza il tuo profilo ancora prima della laurea.":"hi"===o?"अपनी यूनिवर्सिटी में Lovable शुरू करें। छात्रों के लिए कोर्स, हैकाथॉन और Lovable Days आयोजित करें, ताकि आपके साथी AI की मदद से बनाना शुरू करें। आप तकनीकी और गैर-तकनीकी पृष्ठभूमि वाले लोगों को साथ लाकर वास्तविक उत्पाद बनाएंगे। आप कैंपस में Lovable के लिए भरोसेमंद संपर्क बनेंगे, ऐसी भूमिका जो ग्रेजुएशन से पहले ही नए अवसर खोलती है और आपकी पहचान मजबूत करती है।":"id"===o?"Luncurkan Lovable di universitas Anda. Adakan kursus mahasiswa, hackathon, dan Lovable Days yang mengajak teman-teman Anda membuat produk dengan AI. Anda akan menjembatani latar belakang teknis dan non-teknis untuk menciptakan produk nyata bersama. Anda akan menjadi rujukan utama untuk Lovable di kampus, peran yang membuka peluang dan membangun reputasi Anda bahkan sebelum lulus.":"th"===o?"เปิดตัว Lovable ในมหาวิทยาลัยของคุณ จัดคอร์สสำหรับนักศึกษา แฮกกาธอน และ Lovable Days ที่ช่วยให้เพื่อนๆ ได้ลงมือสร้างผลงานด้วย AI คุณจะเป็นสะพานเชื่อมระหว่างคนสายเทคนิคและสายที่ไม่ใช่เทคนิค เพื่อร่วมกันสร้างผลิตภัณฑ์จริง คุณจะเป็นบุคคลหลักที่ทุกคนนึกถึงเมื่อพูดถึง Lovable ในมหาวิทยาลัย บทบาทที่เปิดโอกาสและเสริมโปรไฟล์ของคุณตั้งแต่ก่อนเรียนจบ":"ko"===o?"여러분의 대학에서 Lovable을 알리고 확산해 보세요. 학우들이 AI로 직접 만들어 볼 수 있도록 학생 강좌, 해커톤, Lovable Days를 운영합니다. 기술 전공자와 비전공자가 함께 실제 제품을 만들 수 있도록 연결하는 역할을 하게 됩니다. 캠퍼스에서 Lovable을 가장 잘 아는 사람이 되어, 졸업 전부터 새로운 기회를 만들고 경험을 쌓을 수 있어요.":"所属する大学でLovableを広めましょう。学生向けの講座やハッカソン、仲間がAIでものづくりを始めるきっかけになるLovable Daysを開催します。技術系と非技術系のバックグラウンドをつなぎ、一緒に本物のプロダクトを生み出します。キャンパスにおけるLovableの頼れる存在となり、卒業前から人脈を広げ、自分の実績を築ける役割です。"}],839190),e.s(["programsPage_programs_campus_lookFor1",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"Already build with Lovable and know the product well":"pt-BR"===o?"Já criam com o Lovable e conhecem bem o produto":"de"===o?"Nutzen Lovable bereits und kennen das Produkt gut":"fr"===o?"Vous créez déjà avec Lovable et connaissez bien le produit":"es"===o?"Ya creas con Lovable y conoces bien el producto":"it"===o?"Crei già con Lovable e conosci bene il prodotto":"hi"===o?"पहले से Lovable का उपयोग करके बनाते हैं और उत्पाद को अच्छी तरह जानते हैं":"id"===o?"Sudah pernah membuat produk dengan Lovable dan memahami produknya dengan baik":"th"===o?"สร้างผลงานด้วย Lovable อยู่แล้วและรู้จักผลิตภัณฑ์เป็นอย่างดี":"ko"===o?"이미 Lovable로 직접 만들어 본 경험이 있고 제품을 잘 알고 있는 분":"すでにLovableでものづくりをしていて、プロダクトをよく理解している方"}],74559),e.s(["programsPage_programs_campus_lookFor2",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"Are deeply involved in campus tech, entrepreneurship, or creative communities":"pt-BR"===o?"Estão profundamente envolvidos em comunidades de tecnologia, empreendedorismo ou criatividade no campus":"de"===o?"Sind stark in Tech-, Gründer- oder Kreativ-Communities auf dem Campus engagiert":"fr"===o?"Vous participez activement aux communautés tech, entrepreneuriales ou créatives de votre campus":"es"===o?"Estás muy involucrado en las comunidades de tecnología, emprendimiento o creatividad del campus":"it"===o?"Sei profondamente coinvolto nelle community tecnologiche, imprenditoriali o creative del campus":"hi"===o?"कैंपस के तकनीकी, उद्यमिता या रचनात्मक समुदायों में गहराई से जुड़े हैं":"id"===o?"Terlibat aktif dalam komunitas teknologi, kewirausahaan, atau kreatif di kampus":"th"===o?"มีส่วนร่วมอย่างลึกซึ้งในชุมชนเทคโนโลยี ผู้ประกอบการ หรือชุมชนสายสร้างสรรค์ในมหาวิทยาลัย":"ko"===o?"캠퍼스의 테크, 창업, 또는 창작 커뮤니티에 깊이 참여하고 있는 분":"キャンパスのテック、起業、クリエイティブなコミュニティに深く関わっている方"}],163568),e.s(["programsPage_programs_campus_lookFor3",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"Have experience organizing events, hackathons, or campus initiatives":"pt-BR"===o?"Têm experiência na organização de eventos, hackathons ou iniciativas no campus":"de"===o?"Haben Erfahrung mit der Organisation von Events, Hackathons oder Campus-Initiativen":"fr"===o?"Vous avez de l'expérience dans l'organisation d'événements, de hackathons ou d'initiatives sur le campus":"es"===o?"Tienes experiencia organizando eventos, hackatones o iniciativas en el campus":"it"===o?"Hai esperienza nell'organizzazione di eventi, hackathon o iniziative nel campus":"hi"===o?"इवेंट, हैकाथॉन या कैंपस पहलों को आयोजित करने का अनुभव रखते हैं":"id"===o?"Berpengalaman menyelenggarakan acara, hackathon, atau inisiatif kampus":"th"===o?"มีประสบการณ์ในการจัดงานอีเวนต์ แฮกกาธอน หรือกิจกรรมในมหาวิทยาลัย":"ko"===o?"이벤트, 해커톤, 또는 캠퍼스 활동을 기획해 본 경험이 있는 분":"イベントやハッカソン、キャンパスでの取り組みを企画した経験がある方"}],925458),e.s(["programsPage_programs_campus_lookFor4",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"Can rally peers and create momentum":"pt-BR"===o?"Conseguem mobilizar colegas e gerar engajamento":"de"===o?"Können Kommilitonen mobilisieren und Schwung erzeugen":"fr"===o?"Vous savez mobiliser vos pairs et créer une dynamique":"es"===o?"Sabes movilizar a tus compañeros y generar impulso":"it"===o?"Sai coinvolgere i tuoi compagni e creare slancio":"hi"===o?"साथियों को एकजुट कर सकते हैं और जोश पैदा कर सकते हैं":"id"===o?"Mampu menggerakkan rekan dan menciptakan momentum":"th"===o?"สามารถรวมพลังเพื่อนๆ และสร้างแรงขับเคลื่อนได้":"ko"===o?"동료들을 결집시키고 활기를 불어넣을 수 있는 분":"仲間を巻き込み、盛り上がりを生み出せる方"}],964783)},621963,829979,e=>{"use strict";var a=e.i(420459);e.s(["programsPage_programs_campus_ticketLine1",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"Campus":"pt-BR"===o?"Líder":"de"===o?"Campus":"fr"===o?"Responsable":"es"===o?"Líder de":"it"===o?"Campus":"hi"===o?"कैंपस":"id"===o?"Pemimpin":"th"===o?"ผู้นำ":"ko"===o?"캠퍼스":"キャンパス"}],621963),e.s(["programsPage_programs_campus_ticketLine2",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"Leader":"pt-BR"===o?"no Campus":"de"===o?"Leader":"fr"===o?"campus":"es"===o?"Campus":"it"===o?"Leader":"hi"===o?"लीडर":"id"===o?"Kampus":"th"===o?"ประจำมหาวิทยาลัย":"ko"===o?"리더":"リーダー"}],829979)},830170,e=>{"use strict";var a=e.i(420459);e.s(["programsPage_programs_campus_title",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"Campus Leader":"pt-BR"===o?"Líder no Campus":"de"===o?"Campus-Leader":"fr"===o?"Responsable campus":"es"===o?"Líder de Campus":"it"===o?"Campus Leader":"hi"===o?"कैंपस लीडर":"id"===o?"Pemimpin Kampus":"th"===o?"ผู้นำประจำมหาวิทยาลัย":"ko"===o?"캠퍼스 리더":"キャンパスリーダー"}])},27098,e=>{"use strict";var a=e.i(420459);e.s(["programsPage_programs_campus_whoFor",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"Students ready to lead the AI-building movement on their campus.":"pt-BR"===o?"Estudantes prontos para liderar o movimento de criação com IA no seu campus.":"de"===o?"Studierende, die bereit sind, die Bewegung für KI-gestütztes Entwickeln auf ihrem Campus anzuführen.":"fr"===o?"Des étudiants prêts à mener le mouvement de la création avec l'IA sur leur campus.":"es"===o?"Estudiantes listos para liderar el movimiento de creación con IA en su campus.":"it"===o?"Studenti pronti a guidare nel proprio campus il movimento di chi crea con l'AI.":"hi"===o?"ऐसे छात्र जो अपने कैंपस में AI की मदद से बनाने के आंदोलन का नेतृत्व करने के लिए तैयार हैं।":"id"===o?"Mahasiswa yang siap memimpin gerakan membuat produk dengan AI di kampus mereka.":"th"===o?"นักศึกษาที่พร้อมจะนำขบวนการสร้างผลงานด้วย AI ในมหาวิทยาลัยของตน":"ko"===o?"캠퍼스에서 AI로 만드는 문화를 이끌 준비가 된 학생들.":"自分のキャンパスでAIものづくりムーブメントを牽引する準備ができている学生の方へ。"}])},226284,e=>{"use strict";var a=e.i(420459);e.s(["programsPage_programs_doing_title",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"What you'll be doing":"pt-BR"===o?"O que você vai fazer":"de"===o?"Deine Aufgaben":"fr"===o?"Ce que vous ferez":"es"===o?"Qué harás":"it"===o?"Cosa farai":"hi"===o?"आप क्या करेंगे":"id"===o?"Apa yang akan Anda lakukan":"th"===o?"สิ่งที่คุณจะได้ทำ":"ko"===o?"어떤 일을 하게 되나요":"活動内容"}])},394157,e=>{"use strict";var a=e.i(420459);e.s(["programsPage_programs_lookFor_title",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"What we look for":"pt-BR"===o?"O que buscamos":"de"===o?"Wonach wir suchen":"fr"===o?"Ce que nous recherchons":"es"===o?"Qué buscamos":"it"===o?"Cosa cerchiamo":"hi"===o?"हम क्या तलाशते हैं":"id"===o?"Apa yang kami cari":"th"===o?"คุณสมบัติที่เรามองหา":"ko"===o?"이런 분을 찾고 있어요":"求める人物像"}])},613627,992859,e=>{"use strict";var a=e.i(420459);e.s(["programsPage_programs_title_line1",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"Two programs.":"pt-BR"===o?"Dois programas.":"de"===o?"Zwei Programme.":"fr"===o?"Deux programmes.":"es"===o?"Dos programas.":"it"===o?"Due programmi.":"hi"===o?"दो कार्यक्रम।":"id"===o?"Dua program.":"th"===o?"สองโปรแกรม":"ko"===o?"두 가지 프로그램.":"2つのプログラム。"}],613627),e.s(["programsPage_programs_title_line2",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"One mission.":"pt-BR"===o?"Uma missão.":"de"===o?"Eine Mission.":"fr"===o?"Une mission.":"es"===o?"Una misión.":"it"===o?"Una missione.":"hi"===o?"एक मिशन।":"id"===o?"Satu misi.":"th"===o?"หนึ่งภารกิจ":"ko"===o?"하나의 미션.":"1つのミッション。"}],992859)},657550,e=>{"use strict";var a=e.i(420459);e.s(["programsPage_programs_whoFor_title",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"Who is it for":"pt-BR"===o?"Para quem é":"de"===o?"Für wen ist das Programm?":"fr"===o?"À qui s'adresse ce programme":"es"===o?"Para quién es":"it"===o?"A chi è rivolto":"hi"===o?"यह किसके लिए है":"id"===o?"Untuk siapa ini":"th"===o?"เหมาะกับใคร":"ko"===o?"누구를 위한 프로그램인가요":"対象となる方"}])},873447,428907,680895,e=>{"use strict";var a=e.i(420459);e.s(["programsPage_hero_title_programs",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"Programs":"pt-BR"===o?"Programas":"de"===o?"Programme":"fr"===o?"Programmes":"es"===o?"Programas":"it"===o?"Programmi":"hi"===o?"प्रोग्राम्स":"id"===o?"Program":"th"===o?"โปรแกรม":"ko"===o?"프로그램":"プログラム"}],873447),e.s(["programsPage_ticket_line1",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"Program":"pt-BR"===o?"Membro":"de"===o?"Programm":"fr"===o?"Membre du":"es"===o?"Miembro del":"it"===o?"Membro del":"hi"===o?"कार्यक्रम":"id"===o?"Anggota":"th"===o?"สมาชิก":"ko"===o?"프로그램":"プログラム"}],428907),e.s(["programsPage_ticket_line2",0,(e={},r={})=>{let o=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===o?"Member":"pt-BR"===o?"do Programa":"de"===o?"Mitglied":"fr"===o?"programme":"es"===o?"Programa":"it"===o?"programma":"hi"===o?"सदस्य":"id"===o?"Program":"th"===o?"โปรแกรม":"ko"===o?"멤버":"メンバー"}],680895)}]);

