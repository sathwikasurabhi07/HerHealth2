(globalThis.TURBOPACK||(globalThis.TURBOPACK=[])).push(["object"==typeof document?document.currentScript:void 0,839085,e=>{"use strict";var a=e.i(420459);e.s(["enterpriseFormPage_disclaimer",0,(e={},r={})=>{let i=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===i?"We'll use the information you share to reach out about <lovableLink>lovable.dev</lovableLink> products and services. You can unsubscribe at any time. For details on how we protect your data, check out our <privacyLink>Privacy policy</privacyLink>.":"pt-BR"===i?"Usaremos as informações que você compartilhar para entrar em contato sobre produtos e serviços da <lovableLink>lovable.dev</lovableLink>. Você pode se descadastrar a qualquer momento. Para saber como protegemos seus dados, confira nossa <privacyLink>política de privacidade</privacyLink>.":"de"===i?"Wir verwenden die von dir bereitgestellten Informationen, um dich zu Produkten und Dienstleistungen von <lovableLink>lovable.dev</lovableLink> zu kontaktieren. Du kannst dich jederzeit abmelden. Einzelheiten dazu, wie wir deine Daten schützen, findest du in unserer <privacyLink>Datenschutzerklärung</privacyLink>.":"fr"===i?"Nous utiliserons les informations que vous partagez pour vous contacter au sujet des produits et services <lovableLink>lovable.dev</lovableLink>. Vous pouvez vous désabonner à tout moment. Pour en savoir plus sur la façon dont nous protégeons vos données, consultez notre <privacyLink>politique de confidentialité</privacyLink>.":"es"===i?"Usaremos la información que compartas para ponernos en contacto contigo sobre los productos y servicios de <lovableLink>lovable.dev</lovableLink>. Puedes cancelar la suscripción en cualquier momento. Para conocer cómo protegemos tus datos, consulta nuestra <privacyLink>Política de privacidad</privacyLink>.":"it"===i?"Useremo le informazioni che condividi per contattarti riguardo ai prodotti e servizi di <lovableLink>lovable.dev</lovableLink>. Puoi disiscriverti in qualsiasi momento. Per i dettagli su come proteggiamo i tuoi dati, consulta la nostra <privacyLink>Informativa sulla privacy</privacyLink>.":"hi"===i?"आपके द्वारा साझा की गई जानकारी का उपयोग हम <lovableLink>lovable.dev</lovableLink> के उत्पादों और सेवाओं के बारे में आपसे संपर्क करने के लिए करेंगे। आप कभी भी सदस्यता समाप्त कर सकते हैं। हम आपके डेटा की सुरक्षा कैसे करते हैं, इसकी जानकारी के लिए हमारी <privacyLink>गोपनीयता नीति</privacyLink> देखें।":"id"===i?"Kami akan menggunakan informasi yang Anda bagikan untuk menghubungi Anda terkait produk dan layanan <lovableLink>lovable.dev</lovableLink>. Anda dapat berhenti berlangganan kapan saja. Untuk detail tentang cara kami melindungi data Anda, lihat <privacyLink>Kebijakan privasi</privacyLink> kami.":"th"===i?"เราจะใช้ข้อมูลที่คุณแชร์เพื่อติดต่อคุณเกี่ยวกับผลิตภัณฑ์และบริการของ <lovableLink>lovable.dev</lovableLink> คุณสามารถยกเลิกการรับข่าวสารได้ทุกเมื่อ สำหรับรายละเอียดเกี่ยวกับวิธีที่เราปกป้องข้อมูลของคุณ โปรดดู <privacyLink>นโยบายความเป็นส่วนตัว</privacyLink> ของเรา":"ko"===i?"회원님이 공유해 주신 정보는 <lovableLink>lovable.dev</lovableLink> 제품 및 서비스 안내를 위해 연락드리는 데 사용됩니다. 언제든지 수신을 거부하실 수 있습니다. 데이터 보호 방식에 대한 자세한 내용은 <privacyLink>개인정보 처리방침</privacyLink>을 확인해 주세요.":"お客様にご共有いただいた情報は、<lovableLink>lovable.dev</lovableLink> の製品やサービスに関するご連絡のために使用します。いつでも配信を停止できます。データの保護方法の詳細については、<privacyLink>プライバシーポリシー</privacyLink>をご覧ください。"}])},349940,e=>{"use strict";var a=e.i(420459);e.s(["enterpriseFormPage_field_email_label",0,(e={},r={})=>{let i=a.experimentalStaticLocale??r.locale??(0,a.getLocale)();return"en"===i?"Work email":"pt-BR"===i?"E-mail corporativo":"de"===i?"Geschäftliche E-Mail-Adresse":"fr"===i?"E-mail professionnel":"es"===i?"Correo electrónico de trabajo":"it"===i?"Email di lavoro":"hi"===i?"ऑफिस ईमेल":"id"===i?"Email kerja":"th"===i?"อีเมลที่ทำงาน":"ko"===i?"회사 이메일":"業務用メールアドレス"}])},85522,e=>{"use strict";var a=e.i(420459);e.s(["enterpriseFormPage_field_email_placeholder",0,(e={},r={})=>{let i=a.experimentalStaticLocale??r.locale??(0,a.getLocale