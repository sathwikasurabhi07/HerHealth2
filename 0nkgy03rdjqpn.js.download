;!function(){try { var e="undefined"!=typeof globalThis?globalThis:"undefined"!=typeof global?global:"undefined"!=typeof window?window:"undefined"!=typeof self?self:{},n=(new e.Error).stack;n&&((e._debugIds|| (e._debugIds={}))[n]="50bc5888-e163-e969-52f3-c2e050c7a445")}catch(e){}}();
(globalThis.TURBOPACK||(globalThis.TURBOPACK=[])).push(["object"==typeof document?document.currentScript:void 0,975650,e=>{"use strict";var a=e.i(420459);e.s(["supportPage_community_cta",0,(e={},t={})=>{let o=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===o?"Join Discord":"pt-BR"===o?"Entrar no Discord":"de"===o?"Discord beitreten":"fr"===o?"Rejoindre Discord":"es"===o?"Unirse a Discord":"it"===o?"Unisciti a Discord":"hi"===o?"Discord में शामिल हों":"id"===o?"Bergabung di Discord":"th"===o?"เข้าร่วม Discord":"ko"===o?"Discord에 참여하기":"Discordに参加"}])},311397,e=>{"use strict";var a=e.i(420459);e.s(["supportPage_community_description",0,(e={},t={})=>{let o=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===o?"Connect with other builders on Discord to share, collaborate, and get unstuck.":"pt-BR"===o?"Conecte-se com outros criadores no Discord para compartilhar, colaborar e destravar seu progresso.":"de"===o?"Vernetze dich mit anderen Entwicklerinnen und Entwicklern auf Discord, um dich auszutauschen, zusammenzuarbeiten und Hürden zu überwinden.":"fr"===o?"Échangez avec d'autres créateurs sur Discord pour partager, collaborer et surmonter les blocages.":"es"===o?"Conecta con otros creadores en Discord para compartir, colaborar y desatascarte.":"it"===o?"Connettiti con altri creatori su Discord per condividere, collaborare e superare gli ostacoli.":"hi"===o?"साझा करने, सहयोग करने और अटकने पर मदद पाने के लिए Discord पर ऐप बनाने वाले अन्य लोगों से जुड़ें।":"id"===o?"Terhubung dengan pembuat aplikasi lain di Discord untuk berbagi, berkolaborasi, dan mengatasi kendala.":"th"===o?"เชื่อมต่อกับนักสร้างคนอื่น ๆ บน Discord เพื่อแบ่งปัน ร่วมมือ และก้าวข้ามอุปสรรคไปด้วยกัน":"ko"===o?"Discord에서 다른 제작자들과 연결해 공유하고, 협업하고, 막힌 문제를 해결해 보세요.":"Discordで他のビルダーとつながり、共有・コラボレーションして、行き詰まりを解消しましょう。"}])},844290,e=>{"use strict";var a=e.i(420459);e.s(["supportPage_community_title",0,(e={},t={})=>{let o=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===o?"Ask the Community":"pt-BR"===o?"Pergunte à comunidade":"de"===o?"Die Community fragen":"fr"===o?"Demander à la communauté":"es"===o?"Pregunta a la comunidad":"it"===o?"Chiedi alla community":"hi"===o?"समुदाय से पूछें":"id"===o?"Tanya Komunitas":"th"===o?"สอบถามจากชุมชน":"ko"===o?"커뮤니티에 물어보기":"コミュニティに聞く"}])},268709,e=>{"use strict";var a=e.i(420459);e.s(["supportPage_contactDialog_note",0,(e={},t={})=>{let o=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===o?"We can't debug project-specific issues here - check the <docsLink>Lovable docs</docsLink> for tips and fixes.":"pt-BR"===o?"Não conseguimos depurar problemas específicos do projeto aqui — confira a <docsLink>documentação da Lovable</docsLink> para dicas e soluções.":"de"===o?"Projektspezifische Probleme können wir hier nicht beheben – sieh in der <docsLink>Lovable-Dokumentation</docsLink> nach Tipps und Lösungen.":"fr"===o?"Nous ne pouvons pas déboguer les problèmes spécifiques à un projet ici : consultez la <docsLink>documentation Lovable</docsLink> pour des astuces et des solutions.":"es"===o?"Aquí no podemos depurar problemas específicos de tu proyecto: consulta la <docsLink>documentación de Lovable</docsLink> para obtener consejos y soluciones.":"it"===o?"Qui non possiamo risolvere problemi specifici del progetto: consulta la <docsLink>documentazione di Lovable</docsLink> per consigli e soluzioni.":"hi"===o?"हम यहाँ किसी खास प्रोजेक्ट की समस्याएँ हल नहीं कर सकते - सुझावों और समाधानों के लिए <docsLink>Lovable दस्तावेज़</docsLink> देखें।":"id"===o?"Kami tidak dapat membantu menyelesaikan masalah khusus proyek di sini - lihat <docsLink>dokumentasi Lovable</docsLink> untuk tips dan solusi.":"th"===o?"เราไม่สามารถแก้ไขปัญหาเฉพาะของโปรเจกต์ได้ที่นี่ - ดู <docsLink>เอกสาร Lovable</docsLink> เพื่อรับเคล็ดลับและวิธีแก้ไข":"ko"===o?"여기서는 프로젝트별 문제를 디버깅할 수 없어요. 팁과 해결 방법은 <docsLink>Lovable 문서</docsLink>를 확인해 보세요.":"ここではプロジェクト固有の問題のデバッグはできません。ヒントや解決策については<docsLink>Lovableのドキュメント</docsLink>をご覧ください。"}])},50717,e=>{"use strict";var a=e.i(420459);e.s(["supportPage_contactDialog_responseTime",0,(e={},t={})=>{let o=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===o?"Response time: instant from Docs AI, within 24 hours from our team (mainly weekdays).":"pt-BR"===o?"Tempo de resposta: instantâneo pela IA da documentação, em até 24 horas pela nossa equipe (principalmente em dias úteis).":"de"===o?"Antwortzeit: sofort durch die Dokumentations-KI, innerhalb von 24 Stunden durch unser Team (hauptsächlich werktags).":"fr"===o?"Temps de réponse : instantané avec l'IA de la documentation, sous 24 heures de la part de notre équipe (principalement en semaine).":"es"===o?"Tiempo de respuesta: instantáneo con la IA de la documentación y en un plazo de 24 horas por parte de nuestro equipo (principalmente entre semana).":"it"===o?"Tempo di risposta: immediato dall'AI della documentazione, entro 24 ore dal nostro team (principalmente nei giorni feriali).":"hi"===o?"जवाब का समय: Docs AI से तुरंत, हमारी टीम से 24 घंटे के भीतर (मुख्य रूप से कार्यदिवसों में)।":"id"===o?"Waktu respons: instan dari AI Dokumentasi, dalam 24 jam dari tim kami (terutama hari kerja).":"th"===o?"เวลาตอบกลับ: ทันทีจาก AI ในเอกสาร และภายใน 24 ชั่วโมงจากทีมงานของเรา (ส่วนใหญ่ในวันธรรมดา)":"ko"===o?"응답 시간: Docs AI는 즉시, 팀의 답변은 24시간 이내(주로 평일).":"応答時間：ドキュメントAIからは即時、チームからは24時間以内（主に平日）。"}])},147426,e=>{"use strict";var a=e.i(420459);e.s(["supportPage_contactDialog_title",0,(e={},t={})=>{let o=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===o?"Contact support":"pt-BR"===o?"Falar com o suporte":"de"===o?"Support kontaktieren":"fr"===o?"Contacter le support":"es"===o?"Contactar con soporte":"it"===o?"Contatta l'assistenza":"hi"===o?"सहायता से संपर्क करें":"id"===o?"Hubungi dukungan":"th"===o?"ติดต่อฝ่ายสนับสนุน":"ko"===o?"지원팀에 문의하기":"サポートに問い合わせる"}])},75834,e=>{"use strict";var a=e.i(420459);e.s(["supportPage_contact_cta",0,(e={},t={})=>{let o=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===o?"Contact us":"pt-BR"===o?"Fale conosco":"de"===o?"Kontaktiere uns":"fr"===o?"Nous contacter":"es"===o?"Contáctanos":"it"===o?"Contattaci":"hi"===o?"हमसे संपर्क करें":"id"===o?"Hubungi kami":"th"===o?"ติดต่อเรา":"ko"===o?"문의하기":"お問い合わせ"}])},153298,e=>{"use strict";var a=e.i(420459);e.s(["supportPage_contact_description_v2",0,(e={},t={})=>{let o=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===o?"Direct help for paying users with account, billing, and platform issues. Email <emailLink>support@lovable.dev</emailLink>.":"pt-BR"===o?"Ajuda direta para usuários pagantes com questões de conta, faturamento e plataforma. Envie um e-mail para <emailLink>support@lovable.dev</emailLink>.":"de"===o?"Direkte Hilfe für zahlende Nutzer bei Konto-, Abrechnungs- und Plattformproblemen. Schreib eine E-Mail an <emailLink>support@lovable.dev</emailLink>.":"fr"===o?"Aide directe pour les utilisateurs payants concernant les problèmes de compte, de facturation et de plateforme. Écrivez à <emailLink>support@lovable.dev</emailLink>.":"es"===o?"Ayuda directa para usuarios de pago con problemas de cuenta, facturación y plataforma. Escribe a <emailLink>support@lovable.dev</emailLink>.":"it"===o?"Aiuto diretto per gli utenti paganti su questioni relative ad account, fatturazione e piattaforma. Scrivi a <emailLink>support@lovable.dev</emailLink>.":"hi"===o?"खाते, बिलिंग और प्लेटफ़ॉर्म संबंधी समस्याओं के लिए भुगतान करने वाले उपयोगकर्ताओं को सीधी मदद। <emailLink>support@lovable.dev</emailLink> पर ईमेल करें।":"id"===o?"Bantuan langsung untuk pengguna berbayar terkait masalah akun, penagihan, dan platform. Kirim email ke <emailLink>support@lovable.dev</emailLink>.":"th"===o?"ความช่วยเหลือโดยตรงสำหรับผู้ใช้แบบชำระเงินเกี่ยวกับปัญหาบัญชี การเรียกเก็บเงิน และแพลตฟอร์ม ส่งอีเมลไปที่ <emailLink>support@lovable.dev</emailLink>":"ko"===o?"계정, 결제, 플랫폼 관련 문제가 있는 유료 사용자를 위한 직접 지원입니다. <emailLink>support@lovable.dev</emailLink>로 이메일을 보내 주세요.":"有料ユーザー向けに、アカウント・請求・プラットフォームに関する問題を直接サポートします。<emailLink>support@lovable.dev</emailLink>までメールしてください。"}])},631620,e=>{"use strict";var a=e.i(420459);e.s(["supportPage_contact_title",0,(e={},t={})=>{let o=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===o?"Lovable Support":"pt-BR"===o?"Suporte da Lovable":"de"===o?"Lovable Support":"fr"===o?"Support Lovable":"es"===o?"Soporte de Lovable":"it"===o?"Assistenza Lovable":"hi"===o?"Lovable सहायता":"id"===o?"Dukungan Lovable":"th"===o?"ฝ่ายสนับสนุน Lovable":"ko"===o?"Lovable 지원":"Lovableサポート"}])},673655,e=>{"use strict";var a=e.i(420459);e.s(["supportPage_docs_cta",0,(e={},t={})=>{let o=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===o?"Read the docs":"pt-BR"===o?"Ler a documentação":"de"===o?"Dokumentation lesen":"fr"===o?"Lire la documentation":"es"===o?"Leer la documentación":"it"===o?"Leggi la documentazione":"hi"===o?"दस्तावेज़ पढ़ें":"id"===o?"Baca dokumentasi":"th"===o?"อ่านเอกสาร":"ko"===o?"문서 읽기":"ドキュメントを読む"}])},416788,e=>{"use strict";var a=e.i(420459);e.s(["supportPage_docs_description",0,(e={},t={})=>{let o=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===o?"Guides, best practices, and in-depth references to help you build.":"pt-BR"===o?"Guias, melhores práticas e referências detalhadas para ajudar você a criar.":"de"===o?"Anleitungen, Best Practices und ausführliche Referenzen, die dir beim Erstellen helfen.":"fr"===o?"Des guides, des bonnes pratiques et des références approfondies pour vous aider à créer.":"es"===o?"Guías, buenas prácticas y referencias detalladas para ayudarte a crear.":"it"===o?"Guide, buone pratiche e riferimenti approfonditi per aiutarti a creare.":"hi"===o?"ऐप बनाने में आपकी मदद के लिए मार्गदर्शिकाएँ, सर्वोत्तम तरीके और विस्तृत संदर्भ।":"id"===o?"Panduan, praktik terbaik, dan referensi mendalam untuk membantu Anda membuat aplikasi.":"th"===o?"คู่มือ แนวทางปฏิบัติที่ดีที่สุด และข้อมูลอ้างอิงเชิงลึกเพื่อช่วยให้คุณสร้างโปรเจกต์ได้":"ko"===o?"빌드에 도움이 되는 가이드, 모범 사례, 자세한 참고 자료예요.":"構築に役立つガイド、ベストプラクティス、詳しいリファレンスをご用意しています。"}])},393226,e=>{"use strict";var a=e.i(420459);e.s(["supportPage_docs_title",0,(e={},t={})=>{let o=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===o?"Lovable Documentation":"pt-BR"===o?"Documentação da Lovable":"de"===o?"Lovable-Dokumentation":"fr"===o?"Documentation Lovable":"es"===o?"Documentación de Lovable":"it"===o?"Documentazione di Lovable":"hi"===o?"Lovable दस्तावेज़":"id"===o?"Dokumentasi Lovable":"th"===o?"เอกสาร Lovable":"ko"===o?"Lovable 문서":"Lovableドキュメント"}])},62950,e=>{"use strict";var a=e.i(420459);e.s(["supportPage_explore_subtitle",0,(e={},t={})=>{let o=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===o?"Guides, documentation, and a community of builders - find what you need to move faster.":"pt-BR"===o?"Guias, documentação e uma comunidade de criadores — encontre o que você precisa para avançar mais rápido.":"de"===o?"Anleitungen, Dokumentation und eine Community von Entwicklerinnen und Entwicklern – finde, was du brauchst, um schneller voranzukommen.":"fr"===o?"Des guides, de la documentation et une communauté de créateurs : trouvez ce dont vous avez besoin pour avancer plus vite.":"es"===o?"Guías, documentación y una comunidad de creadores: encuentra lo que necesitas para avanzar más rápido.":"it"===o?"Guide, documentazione e una community di creatori: trova ciò di cui hai bisogno per procedere più rapidamente.":"hi"===o?"मार्गदर्शिकाएँ, दस्तावेज़ और ऐप बनाने वालों का समुदाय - तेज़ी से आगे बढ़ने के लिए जो चाहिए, वह पाएँ।":"id"===o?"Panduan, dokumentasi, dan komunitas pembuat aplikasi - temukan yang Anda butuhkan untuk membuat aplikasi lebih cepat.":"th"===o?"คู่มือ เอกสาร และชุมชนสำหรับผู้สร้าง - ค้นหาสิ่งที่คุณต้องการเพื่อทำงานได้เร็วขึ้น":"ko"===o?"가이드, 문서, 그리고 제작자 커뮤니티까지 — 더 빠르게 나아가는 데 필요한 모든 것을 찾아보세요.":"ガイド、ドキュメント、そしてビルダーのコミュニティ。より速く前進するために必要なものが見つかります。"}])},539994,e=>{"use strict";var a=e.i(420459);e.s(["supportPage_explore_title",0,(e={},t={})=>{let o=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===o?"Explore resources":"pt-BR"===o?"Explore os recursos":"de"===o?"Ressourcen entdecken":"fr"===o?"Explorer les ressources":"es"===o?"Explorar recursos":"it"===o?"Esplora le risorse":"hi"===o?"संसाधन देखें":"id"===o?"Jelajahi sumber daya":"th"===o?"สำรวจแหล่งข้อมูล":"ko"===o?"리소스 둘러보기":"リソースを見る"}])},89955,e=>{"use strict";var a=e.i(420459);e.s(["supportPage_faq_a1",0,(e={},t={})=>{let o=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===o?"Lovable Cloud gives your app a full backend with no setup - a database, user authentication, file storage, and serverless functions. Just describe what you need and Lovable builds it for you.":"pt-BR"===o?"O Lovable Cloud oferece ao seu app uma estrutura de servidor completa sem configuração — banco de dados, autenticação de usuários, armazenamento de arquivos e funções sem servidor. Basta descrever o que você precisa e o Lovable cria para você.":"de"===o?"Lovable Cloud stattet deine App mit einem vollständigen Backend aus – ganz ohne Einrichtung: einer Datenbank, Benutzerauthentifizierung, Dateispeicher und serverlosen Funktionen. Beschreibe einfach, was du brauchst, und Lovable baut es für dich.":"fr"===o?"Lovable Cloud offre à votre application un backend complet sans configuration : une base de données, l'authentification des utilisateurs, le stockage de fichiers et des fonctions sans serveur. Décrivez simplement ce dont vous avez besoin et Lovable le construit pour vous.":"es"===o?"Lovable Cloud le da a tu app un backend completo sin configuración: base de datos, autenticación de usuarios, almacenamiento de archivos y funciones sin servidor. Solo describe lo que necesitas y Lovable lo construye por ti.":"it"===o?"Lovable Cloud offre alla tua app un backend completo senza alcuna configurazione: un database, autenticazione degli utenti, archiviazione dei file e funzioni serverless. Descrivi semplicemente ciò di cui hai bisogno e Lovable lo crea per te.":"hi"===o?"Lovable Cloud आपके ऐप को बिना किसी सेटअप के पूरा बैकएंड देता है - डेटाबेस, उपयोगकर्ता प्रमाणीकरण, फ़ाइल संग्रहण और सर्वरलेस फ़ंक्शन। बस बताइए कि आपको क्या चाहिए और Lovable आपके लिए बना देता है।":"id"===o?"Lovable Cloud memberi aplikasi Anda backend lengkap tanpa penyiapan - basis data, autentikasi pengguna, penyimpanan file, dan fungsi tanpa server. Cukup jelaskan kebutuhan Anda, dan Lovable akan membangunnya untuk Anda.":"th"===o?"Lovable Cloud มอบแบ็กเอนด์ครบครันให้แอปของคุณโดยไม่ต้องตั้งค่าใดๆ ทั้งฐานข้อมูล การยืนยันตัวตนผู้ใช้ พื้นที่จัดเก็บไฟล์ และฟังก์ชันแบบไร้เซิร์ฟเวอร์ เพียงอธิบายสิ่งที่คุณต้องการ แล้ว Lovable จะสร้างให้คุณเอง":"ko"===o?"Lovable Cloud는 별도 설정 없이 앱에 완전한 백엔드를 제공해요. 데이터베이스, 사용자 인증, 파일 저장소, 서버리스 함수까지 모두 포함되죠. 필요한 것을 설명하기만 하면 Lovable이 알아서 만들어 드려요.":"Lovable Cloud は、セットアップ不要でアプリに完全なバックエンドを提供します。データベース、ユーザー認証、ファイルストレージ、サーバーレス関数が揃っています。必要なものを説明するだけで、Lovable が構築します。"}])},308450,e=>{"use strict";var a=e.i(420459);e.s(["supportPage_faq_a2",0,(e={},t={})=>{let o=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===o?"Yes. Lovable ships with 50+ native connectors across databases, analytics, email, content, and productivity tools, with hundreds more available through built-in automation. Most connect seamlessly in a few clicks, so you can add the services your app needs without manual setup.":"pt-BR"===o?"Sim. O Lovable vem com mais de 50 conectores nativos para bancos de dados, análise de dados, e-mail, conteúdo e ferramentas de produtividade, com centenas de outros disponíveis por meio de automação integrada. A maioria se conecta facilmente em poucos cliques, para que você possa adicionar os serviços de que seu app precisa sem configuração manual.":"de"===o?"Ja. Lovable bringt über 50 native Konnektoren für Datenbanken, Analysen, E-Mail, Inhalte und Produktivitätstools mit – und über die integrierte Automatisierung sind Hunderte weitere verfügbar. Die meisten lassen sich nahtlos mit wenigen Klicks verbinden, sodass du die Dienste, die deine App braucht, ohne manuelle Einrichtung hinzufügen kannst.":"fr"===o?"Oui. Lovable est livré avec plus de 50 connecteurs natifs couvrant les bases de données, l'analytique, l'e-mail, le contenu et les outils de productivité, et des centaines d'autres sont disponibles grâce à l'automatisation intégrée. La plupart se connectent en quelques clics, ce qui vous permet d'ajouter les services dont votre application a besoin sans configuration manuelle.":"es"===o?"Sí. Lovable incluye más de 50 conectores nativos para bases de datos, analítica, correo, contenido y herramientas de productividad, con cientos más disponibles mediante automatización integrada. La mayoría se conectan sin problemas en unos pocos clics, así que puedes añadir los servicios que tu app necesita sin configuración manual.":"it"===o?"Sì. Lovable include oltre 50 connettori nativi tra database, analisi, email, contenuti e strumenti di produttività, con centinaia di altri disponibili tramite l'automazione integrata. La maggior parte si collega senza problemi in pochi clic, così puoi aggiungere i servizi di cui la tua app ha bisogno senza configurazioni manuali.":"hi"===o?"हाँ। Lovable में डेटाबेस, एनालिटिक्स, ईमेल, सामग्री और उत्पादकता टूल के लिए 50+ नेटिव कनेक्टर मिलते हैं, और बिल्ट-इन ऑटोमेशन के ज़रिए सैकड़ों और भी उपलब्ध हैं। ज़्यादातर कुछ ही क्लिक में आसानी से जुड़ जाते हैं, इसलिए आप बिना मैन्युअल सेटअप के अपने ऐप के लिए ज़रूरी सेवाएँ जोड़ सकते हैं।":"id"===o?"Ya. Lovable dilengkapi 50+ konektor bawaan untuk basis data, analitik, email, konten, dan alat produktivitas, serta ratusan lainnya yang tersedia melalui otomatisasi bawaan. Sebagian besar dapat terhubung dengan lancar dalam beberapa klik, sehingga Anda dapat menambahkan layanan yang dibutuhkan aplikasi tanpa penyiapan manual.":"th"===o?"ได้ Lovable มาพร้อมตัวเชื่อมต่อในตัวกว่า 50 รายการ ครอบคลุมฐานข้อมูล การวิเคราะห์ข้อมูล อีเมล เนื้อหา และเครื่องมือเพิ่มประสิทธิภาพการทำงาน พร้อมอีกหลายร้อยรายการผ่านระบบอัตโนมัติในตัว ส่วนใหญ่เชื่อมต่อได้อย่างราบรื่นในไม่กี่คลิก คุณจึงเพิ่มบริการที่แอปต้องการได้โดยไม่ต้องตั้งค่าด้วยตนเอง":"ko"===o?"네. Lovable에는 데이터베이스, 분석, 이메일, 콘텐츠, 생산성 도구를 아우르는 50개 이상의 네이티브 커넥터가 기본 제공되며, 내장된 자동화를 통해 수백 개를 더 사용할 수 있어요. 대부분 몇 번의 클릭만으로 손쉽게 연결되므로, 수동 설정 없이 앱에 필요한 서비스를 추가할 수 있어요.":"はい。Lovable には、データベース、分析、メール、コンテンツ、生産性ツールにわたる50以上のネイティブコネクターが備わっており、組み込みの自動化機能を通じてさらに数百のサービスを利用できます。ほとんどは数クリックでスムーズに接続できるため、手動セットアップなしでアプリに必要なサービスを追加できます。"}])},860867,e=>{"use strict";var a=e.i(420459);e.s(["supportPage_faq_a3",0,(e={},t={})=>{let o=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===o?"Yes. Lovable has built-in payments, so you can add subscriptions and one-time checkout to any app. Set up a test checkout in minutes and go live the same day, with your keys stored securely and used only where they are needed.":"pt-BR"===o?"Sim. O Lovable tem pagamentos integrados, então você pode adicionar assinaturas e pagamentos avulsos a qualquer app. Configure um checkout de teste em minutos e entre no ar no mesmo dia, com suas chaves armazenadas com segurança e usadas apenas onde forem necessárias.":"de"===o?"Ja. Lovable hat integrierte Zahlungen, sodass du jeder App Abonnements und einmalige Bezahlvorgänge hinzufügen kannst. Richte einen Test-Checkout in wenigen Minuten ein und geh noch am selben Tag live – deine Schlüssel werden sicher gespeichert und nur dort verwendet, wo sie benötigt werden.":"fr"===o?"Oui. Lovable intègre les paiements, ce qui vous permet d'ajouter des abonnements et des paiements ponctuels à n'importe quelle application. Configurez un paiement de test en quelques minutes et passez en production le jour même, avec vos clés stockées en toute sécurité et utilisées uniquement là où elles sont nécessaires.":"es"===o?"Sí. Lovable tiene pagos integrados, así que puedes añadir suscripciones y pagos únicos a cualquier app. Configura un pago de prueba en minutos y empieza a vender el mismo día, con tus claves almacenadas de forma segura y usadas solo donde se necesitan.":"it"===o?"Sì. Lovable include pagamenti integrati, così puoi aggiungere abbonamenti e pagamenti una tantum a qualsiasi app. Configura un pagamento di prova in pochi minuti e pubblica lo stesso giorno, con le tue chiavi archiviate in modo sicuro e utilizzate solo dove servono.":"hi"===o?"हाँ। Lovable में भुगतान की सुविधा बिल्ट-इन है, इसलिए आप किसी भी ऐप में सदस्यताएँ और एक बार का चेकआउट जोड़ सकते हैं। मिनटों में टेस्ट चेकआउट सेट करें और उसी दिन लाइव हो जाएँ। आपकी कुंजियाँ सुरक्षित रूप से संग्रहीत रहती हैं और केवल वहीं इस्तेमाल होती हैं जहाँ ज़रूरत हो।":"id"===o?"Ya. Lovable memiliki fitur pembayaran bawaan, sehingga Anda dapat menambahkan langganan dan pembayaran satu kali ke aplikasi apa pun. Siapkan alur pembayaran uji coba dalam hitungan menit dan luncurkan di hari yang sama, dengan kunci Anda tersimpan aman dan hanya digunakan di tempat yang diperlukan.":"th"===o?"ได้ Lovable มีระบบการชำระเงินในตัว คุณจึงเพิ่มการสมัครสมาชิกและการชำระเงินแบบครั้งเดียวให้กับแอปใดก็ได้ ตั้งค่าการชำระเงินทดสอบได้ในไม่กี่นาทีและเปิดใช้งานจริงได้ในวันเดียวกัน โดยคีย์ของคุณจะถูกจัดเก็บอย่างปลอดภัยและใช้เฉพาะที่จำเป็นเท่านั้น":"ko"===o?"네. Lovable에는 결제 기능이 기본으로 내장되어 있어, 어떤 앱에든 구독이나 일회성 결제를 추가할 수 있어요. 테스트 결제는 몇 분 만에 설정하고 당일에 바로 출시할 수 있으며, 키는 안전하게 저장되어 필요한 곳에서만 사용돼요.":"はい。Lovable には決済機能が組み込まれているので、どんなアプリにもサブスクリプションや一回限りのチェックアウトを追加できます。テスト用チェックアウトは数分でセットアップでき、同じ日に公開できます。キーは安全に保管され、必要な場所でのみ使用されます。"}])},621498,e=>{"use strict";var a=e.i(420459);e.s(["supportPage_faq_a4",0,(e={},t={})=>{let o=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===o?"Credits are used when you send a message to Lovable, not while you're typing or editing. How many depends on the complexity of the request. You can check your remaining credits and usage anytime in your workspace settings.":"pt-BR"===o?"Os créditos são usados quando você envia uma mensagem ao Lovable, não enquanto está digitando ou editando. A quantidade depende da complexidade da solicitação. Você pode verificar seus créditos restantes e o uso a qualquer momento nas configurações do seu espaço de trabalho.":"de"===o?"Credits werden verbraucht, wenn du eine Nachricht an Lovable sendest, nicht während du tippst oder bearbeitest. Wie viele es sind, hängt von der Komplexität der Anfrage ab. Deine verbleibenden Credits und deine Nutzung kannst du jederzeit in den Einstellungen deines Arbeitsbereichs einsehen.":"fr"===o?"Les crédits sont utilisés lorsque vous envoyez un message à Lovable, et non pendant que vous tapez ou modifiez. Le nombre dépend de la complexité de la demande. Vous pouvez consulter vos crédits restants et votre utilisation à tout moment dans les paramètres de votre espace de travail.":"es"===o?"Los créditos se usan cuando envías un mensaje a Lovable, no mientras escribes o editas. La cantidad depende de la complejidad de la solicitud. Puedes consultar tus créditos restantes y tu uso en cualquier momento en la configuración de tu espacio de trabajo.":"it"===o?"I crediti vengono utilizzati quando invii un messaggio a Lovable, non mentre digiti o modifichi. La quantità dipende dalla complessità della richiesta. Puoi controllare i crediti rimanenti e il loro utilizzo in qualsiasi momento nelle impostazioni della tua area di lavoro.":"hi"===o?"क्रेडिट तब इस्तेमाल होते हैं जब आप Lovable को कोई संदेश भेजते हैं, लिखते या संपादित करते समय नहीं। कितने लगेंगे यह आपके अनुरोध की जटिलता पर निर्भर करता है। आप अपने बचे हुए क्रेडिट और उपयोग को कभी भी अपने कार्यस्थान की सेटिंग में देख सकते हैं।":"id"===o?"Kredit digunakan saat Anda mengirim pesan ke Lovable, bukan saat Anda mengetik atau mengedit. Jumlahnya tergantung pada kompleksitas permintaan. Anda dapat memeriksa sisa kredit dan penggunaan kapan saja di pengaturan ruang kerja Anda.":"th"===o?"เครดิตจะถูกใช้เมื่อคุณส่งข้อความถึง Lovable ไม่ใช่ตอนที่คุณกำลังพิมพ์หรือแก้ไข จำนวนที่ใช้ขึ้นอยู่กับความซับซ้อนของคำขอ คุณสามารถตรวจสอบเครดิตคงเหลือและการใช้งานได้ตลอดเวลาในการตั้งค่าเวิร์กสเปซของคุณ":"ko"===o?"크레딧은 입력하거나 편집하는 중이 아니라 Lovable에 메시지를 보낼 때 사용돼요. 사용량은 요청의 복잡도에 따라 달라져요. 남은 크레딧과 사용량은 워크스페이스 설정에서 언제든지 확인할 수 있어요.":"クレジットは、Lovable にメッセージを送信したときに消費され、入力中や編集中には消費されません。消費量はリクエストの複雑さによって異なります。残りのクレジットと使用状況は、ワークスペース設定でいつでも確認できます。"}])},656156,e=>{"use strict";var a=e.i(420459);e.s(["supportPage_faq_a5",0,(e={},t={})=>{let o=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===o?"Start with the search above and the docs - most questions are answered there instantly. For community help, join our Discord. If you're on a paid plan and need help with your account, billing, or a platform issue, use the support form on this page.":"pt-BR"===o?"Comece pela busca acima e pela documentação — a maioria das perguntas é respondida ali na hora. Para ajuda da comunidade, entre no nosso Discord. Se você tem um plano pago e precisa de ajuda com sua conta, cobrança ou um problema na plataforma, use o formulário de suporte nesta página.":"de"===o?"Beginne mit der Suche oben und der Dokumentation – die meisten Fragen werden dort sofort beantwortet. Hilfe aus der Community findest du in unserem Discord. Wenn du einen kostenpflichtigen Plan hast und Hilfe zu deinem Konto, deiner Abrechnung oder einem Plattformproblem brauchst, nutze das Support-Formular auf dieser Seite.":"fr"===o?"Commencez par la recherche ci-dessus et la documentation : la plupart des questions y trouvent une réponse immédiate. Pour obtenir de l'aide de la communauté, rejoignez notre Discord. Si vous avez un forfait payant et avez besoin d'aide concernant votre compte, votre facturation ou un problème de plateforme, utilisez le formulaire d'assistance de cette page.":"es"===o?"Empieza con la búsqueda de arriba y la documentación: la mayoría de las preguntas se responden ahí al instante. Para ayuda de la comunidad, únete a nuestro Discord. Si tienes un plan de pago y necesitas ayuda con tu cuenta, facturación o un problema de la plataforma, usa el formulario de soporte de esta página.":"it"===o?"Inizia con la ricerca qui sopra e la documentazione: la maggior parte delle domande trova subito una risposta lì. Per ricevere aiuto dalla comunità, entra nel nostro Discord. Se hai un piano a pagamento e hai bisogno di assistenza per il tuo account, la fatturazione o un problema della piattaforma, usa il modulo di supporto in questa pagina.":"hi"===o?"ऊपर दी गई खोज और दस्तावेज़ों से शुरू करें - ज़्यादातर सवालों के जवाब वहीं तुरंत मिल जाते हैं। समुदाय से मदद के लिए हमारे Discord से जुड़ें। अगर आप किसी भुगतान वाले प्लान पर हैं और अपने खाते, बिलिंग या किसी प्लेटफ़ॉर्म समस्या में मदद चाहते हैं, तो इस पेज पर दिए सहायता फ़ॉर्म का उपयोग करें।":"id"===o?"Coba gunakan pencarian di atas dan dokumentasi terlebih dahulu - sebagian besar pertanyaan langsung terjawab di sana. Untuk bantuan komunitas, bergabunglah dengan Discord kami. Jika Anda menggunakan paket berbayar dan membutuhkan bantuan terkait akun, penagihan, atau masalah platform, gunakan formulir dukungan di halaman ini.":"th"===o?"เริ่มต้นด้วยการค้นหาด้านบนและเอกสารคู่มือ คำถามส่วนใหญ่มีคำตอบให้ทันที หากต้องการความช่วยเหลือจากชุมชน ให้เข้าร่วม Discord ของเรา หากคุณใช้แพ็กเกจแบบชำระเงินและต้องการความช่วยเหลือเกี่ยวกับบัญชี การเรียกเก็บเงิน หรือปัญหาของแพลตฟอร์ม ให้ใช้แบบฟอร์มขอความช่วยเหลือในหน้านี้":"ko"===o?"먼저 위의 검색과 문서를 활용해 보세요. 대부분의 궁금증은 바로 해결할 수 있어요. 커뮤니티의 도움이 필요하면 Discord에 참여하세요. 유료 플랜을 사용 중이고 계정, 결제, 플랫폼 관련 문제로 도움이 필요하다면 이 페이지의 지원 양식을 이용하세요.":"まずは上の検索とドキュメントをお試しください。ほとんどの質問はその場ですぐに解決します。コミュニティのサポートが必要な場合は、Discord にご参加ください。有料プランをご利用中で、アカウント、請求、プラットフォームの問題についてサポートが必要な場合は、このページのサポートフォームをご利用ください。"}])},707064,e=>{"use strict";var a=e.i(420459);e.s(["supportPage_faq_q1",0,(e={},t={})=>{let o=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===o?"What can I add to my app with Lovable Cloud?":"pt-BR"===o?"O que posso adicionar ao meu app com o Lovable Cloud?":"de"===o?"Was kann ich meiner App mit Lovable Cloud hinzufügen?":"fr"===o?"Que puis-je ajouter à mon application avec Lovable Cloud ?":"es"===o?"¿Qué puedo añadir a mi app con Lovable Cloud?":"it"===o?"Cosa posso aggiungere alla mia app con Lovable Cloud?":"hi"===o?"Lovable Cloud के साथ मैं अपने ऐप में क्या जोड़ सकता हूँ?":"id"===o?"Apa saja yang bisa saya tambahkan ke aplikasi dengan Lovable Cloud?":"th"===o?"ฉันเพิ่มอะไรลงในแอปได้บ้างด้วย Lovable Cloud?":"ko"===o?"Lovable Cloud로 앱에 무엇을 추가할 수 있나요?":"Lovable Cloud でアプリに何を追加できますか？"}])},116521,e=>{"use strict";var a=e.i(420459);e.s(["supportPage_faq_q2",0,(e={},t={})=>{let o=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===o?"Can I connect other tools and integrations?":"pt-BR"===o?"Posso conectar outras ferramentas e integrações?":"de"===o?"Kann ich andere Tools und Integrationen verbinden?":"fr"===o?"Puis-je connecter d'autres outils et intégrations ?":"es"===o?"¿Puedo conectar otras herramientas e integraciones?":"it"===o?"Posso collegare altri strumenti e integrazioni?":"hi"===o?"क्या मैं दूसरे टूल और इंटीग्रेशन जोड़ सकता हूँ?":"id"===o?"Bisakah saya menghubungkan alat dan integrasi lain?":"th"===o?"ฉันเชื่อมต่อเครื่องมือและการผสานการทำงานอื่นๆ ได้ไหม?":"ko"===o?"다른 도구와 연동할 수 있나요?":"他のツールやインテグレーションを接続できますか？"}])},740772,e=>{"use strict";var a=e.i(420459);e.s(["supportPage_faq_q3",0,(e={},t={})=>{let o=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===o?"Can I accept payments in my app?":"pt-BR"===o?"Posso aceitar pagamentos no meu app?":"de"===o?"Kann ich in meiner App Zahlungen annehmen?":"fr"===o?"Puis-je accepter des paiements dans mon application ?":"es"===o?"¿Puedo aceptar pagos en mi app?":"it"===o?"Posso accettare pagamenti nella mia app?":"hi"===o?"क्या मैं अपने ऐप में पेमेंट ले सकता हूँ?":"id"===o?"Bisakah saya menerima pembayaran di aplikasi saya?":"th"===o?"ฉันรับการชำระเงินในแอปได้ไหม?":"ko"===o?"앱에서 결제를 받을 수 있나요?":"アプリで決済を受け付けられますか？"}])},407145,e=>{"use strict";var a=e.i(420459);e.s(["supportPage_faq_q4",0,(e={},t={})=>{let o=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===o?"How do credits work?":"pt-BR"===o?"Como funcionam os créditos?":"de"===o?"Wie funktionieren Credits?":"fr"===o?"Comment fonctionnent les crédits ?":"es"===o?"¿Cómo funcionan los créditos?":"it"===o?"Come funzionano i crediti?":"hi"===o?"क्रेडिट कैसे काम करते हैं?":"id"===o?"Bagaimana cara kerja kredit?":"th"===o?"เครดิตทำงานอย่างไร?":"ko"===o?"크레딧은 어떻게 사용되나요?":"クレジットの仕組みはどうなっていますか？"}])},349276,e=>{"use strict";var a=e.i(420459);e.s(["supportPage_faq_q5",0,(e={},t={})=>{let o=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===o?"How do I get help with my project?":"pt-BR"===o?"Como consigo ajuda com meu projeto?":"de"===o?"Wie erhalte ich Hilfe zu meinem Projekt?":"fr"===o?"Comment obtenir de l'aide pour mon projet ?":"es"===o?"¿Cómo obtengo ayuda con mi proyecto?":"it"===o?"Come ottengo aiuto per il mio progetto?":"hi"===o?"मुझे अपने प्रोजेक्ट में मदद कैसे मिलेगी?":"id"===o?"Bagaimana cara mendapatkan bantuan untuk proyek saya?":"th"===o?"ฉันจะขอความช่วยเหลือเกี่ยวกับโปรเจกต์ได้อย่างไร?":"ko"===o?"프로젝트에 대한 도움은 어떻게 받나요?":"プロジェクトについてサポートを受けるにはどうすればよいですか？"}])},666237,e=>{"use strict";var a=e.i(420459);e.s(["supportPage_faq_title",0,(e={},t={})=>{let o=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===o?"Frequently Asked Questions":"pt-BR"===o?"Perguntas frequentes":"de"===o?"Häufig gestellte Fragen":"fr"===o?"Questions fréquentes":"es"===o?"Preguntas frecuentes":"it"===o?"Domande frequenti":"hi"===o?"अक्सर पूछे जाने वाले सवाल":"id"===o?"Pertanyaan yang Sering Diajukan":"th"===o?"คำถามที่พบบ่อย":"ko"===o?"자주 묻는 질문":"よくある質問"}])},227087,e=>{"use strict";var a=e.i(420459);e.s(["supportPage_form_attachments",0,(e={},t={})=>{let o=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===o?"Attachments":"pt-BR"===o?"Anexos":"de"===o?"Anhänge":"fr"===o?"Pièces jointes":"es"===o?"Archivos adjuntos":"it"===o?"Allegati":"hi"===o?"अटैचमेंट":"id"===o?"Lampiran":"th"===o?"ไฟล์แนบ":"ko"===o?"첨부 파일":"添付ファイル"}])},503902,e=>{"use strict";var a=e.i(420459);e.s(["supportPage_form_cancel",0,(e={},t={})=>{let o=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===o?"Cancel":"pt-BR"===o?"Cancelar":"de"===o?"Abbrechen":"fr"===o?"Annuler":"es"===o?"Cancelar":"it"===o?"Annulla":"hi"===o?"रद्द करें":"id"===o?"Batal":"th"===o?"ยกเลิก":"ko"===o?"취소":"キャンセル"}])},278467,e=>{"use strict";var a=e.i(420459);e.s(["supportPage_form_email",0,(e={},t={})=>{let o=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===o?"Email*":"pt-BR"===o?"E-mail*":"de"===o?"E-Mail*":"fr"===o?"E-mail*":"es"===o?"Correo electrónico*":"it"===o?"Email*":"hi"===o?"ईमेल*":"id"===o?"Email*":"th"===o?"อีเมล*":"ko"===o?"이메일*":"メールアドレス*"}])},624596,e=>{"use strict";var a=e.i(420459);e.s(["supportPage_form_error",0,(e={},t={})=>{let o=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===o?"Failed to send message. Please try again later.":"pt-BR"===o?"Falha ao enviar a mensagem. Tente novamente mais tarde.":"de"===o?"Nachricht konnte nicht gesendet werden. Bitte versuche es später erneut.":"fr"===o?"Échec de l'envoi du message. Veuillez réessayer plus tard.":"es"===o?"No se pudo enviar el mensaje. Inténtalo de nuevo más tarde.":"it"===o?"Invio del messaggio non riuscito. Riprova più tardi.":"hi"===o?"मैसेज भेजने में विफल। कृपया बाद में फिर से कोशिश करें।":"id"===o?"Gagal mengirim pesan. Silakan coba lagi nanti.":"th"===o?"ส่งข้อความไม่สำเร็จ โปรดลองอีกครั้งในภายหลัง":"ko"===o?"메시지를 보내지 못했어요. 잠시 후 다시 시도해 주세요.":"メッセージの送信に失敗しました。しばらくしてからもう一度お試しください。"}])},193150,166623,e=>{"use strict";var a=e.i(420459);e.s(["supportPage_form_message",0,(e={},t={})=>{let o=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===o?"Message":"pt-BR"===o?"Mensagem":"de"===o?"Nachricht":"fr"===o?"Message":"es"===o?"Mensaje":"it"===o?"Messaggio":"hi"===o?"मैसेज":"id"===o?"Pesan":"th"===o?"ข้อความ":"ko"===o?"메시지":"メッセージ"}],193150),e.s(["supportPage_form_messagePlaceholder",0,(e={},t={})=>{let o=a.experimentalStaticLocale??t.locale