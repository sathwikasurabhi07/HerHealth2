(globalThis.TURBOPACK||(globalThis.TURBOPACK=[])).push(["object"==typeof document?document.currentScript:void 0,839854,926114,455590,931466,570366,598296,537670,931256,611356,936883,e=>{"use strict";var a=e.i(420459);e.s(["sheBuildsPage_about_label",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"What is SheBuilds?":"pt-BR"===i?"O que é o SheBuilds?":"de"===i?"Was ist SheBuilds?":"fr"===i?"Qu'est-ce que SheBuilds ?":"es"===i?"¿Qué es SheBuilds?":"it"===i?"Cos'è SheBuilds?":"hi"===i?"SheBuilds क्या है?":"id"===i?"Apa itu SheBuilds?":"th"===i?"SheBuilds คืออะไร?":"ko"===i?"SheBuilds란?":"SheBuildsとは？"}],839854),e.s(["sheBuildsPage_about_part1",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"SheBuilds is Lovable's home":"pt-BR"===i?"SheBuilds é o espaço da Lovable":"de"===i?"SheBuilds ist Lovables Zuhause":"fr"===i?"SheBuilds est l'espace de Lovable":"es"===i?"SheBuilds es el espacio de Lovable":"it"===i?"SheBuilds è la casa di Lovable":"hi"===i?"SheBuilds, Lovable का घर है":"id"===i?"SheBuilds adalah wadah dari Lovable":"th"===i?"SheBuilds คือบ้านของ Lovable":"ko"===i?"SheBuilds는 Lovable이 마련한":"SheBuildsは、Lovableが提供する"}],926114),e.s(["sheBuildsPage_about_part2",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"for anyone who identifies as a woman whether you've never written a line of code":"pt-BR"===i?"para qualquer pessoa que se identifica como mulher, quer nunca tenha escrito uma linha de código":"de"===i?"für alle, die sich als Frau identifizieren – egal, ob du noch nie eine Zeile Code geschrieben hast":"fr"===i?"pour toute personne qui s'identifie comme une femme, que vous n'ayez jamais écrit une seule ligne de code":"es"===i?"para cualquier persona que se identifique como mujer, ya sea que nunca haya escrito una línea de código":"it"===i?"per chiunque si identifichi come donna, che tu non abbia mai scritto una riga di codice":"hi"===i?"हर उस व्यक्ति के लिए, जो ख़ुद को महिला के रूप में पहचानता/पहचानती है, चाहे आपने कभी कोड की एक लाइन न लिखी हो":"id"===i?"bagi siapa pun yang merasa dirinya perempuan, baik Anda belum pernah menulis satu baris kode pun":"th"===i?"สำหรับทุกคนที่ระบุตัวตนว่าเป็นผู้หญิง ไม่ว่าคุณจะไม่เคยเขียนโค้ดเลยสักบรรทัด":"ko"===i?"코드를 한 줄도 작성해 본 적 없는 분이든":"コードを一行も書いたことがない方も"}],455590),e.s(["sheBuildsPage_about_part3",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"or you've been shipping products for years.":"pt-BR"===i?"ou já trabalhe lançando produtos há anos.":"de"===i?"oder schon seit Jahren Produkte veröffentlichst.":"fr"===i?"ou que vous lanciez des produits depuis des années.":"es"===i?"o que lleve años lanzando productos.":"it"===i?"o che pubblichi prodotti da anni.":"hi"===i?"या आप सालों से उत्पाद लॉन्च कर रही हों।":"id"===i?"maupun Anda sudah merilis produk selama bertahun-tahun.":"th"===i?"หรือคุณเปิดตัวผลิตภัณฑ์มาหลายปีแล้วก็ตาม":"ko"===i?"수년간 제품을 출시해 온 분이든, 여성으로 정체화하는 모든 분을 위한 보금자리예요.":"何年もプロダクトを世に送り出してきた方も、女性であると自認するすべての方のための場所です。"}],931466),e.s(["sheBuildsPage_about_part4",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Through hackathons,":"pt-BR"===i?"Por meio de hackathons,":"de"===i?"Durch Hackathons,":"fr"===i?"À travers des hackathons,":"es"===i?"A través de hackatones,":"it"===i?"Tramite hackathon,":"hi"===i?"हैकाथॉन,":"id"===i?"Melalui hackathon,":"th"===i?"ผ่านแฮกกาธอน ":"ko"===i?"해커톤,":"ハッカソンや"}],570366),e.s(["sheBuildsPage_about_part5",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i||"pt-BR"===i?"webinars":"de"===i?"Webinare":"fr"===i?"des webinaires":"es"===i?"seminarios web":"it"===i?"webinar":"hi"===i?"वेबिनार":"id"===i?"webinar":"th"===i?"เว็บบินาร์":"ko"===i?"웨비나":"ウェビナー"}],598296),e.s(["sheBuildsPage_about_part6",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?", and hands-on learning, SheBuilds gives you the resources, support, and community to go from idea":"pt-BR"===i?"e aprendizado prático, o SheBuilds oferece os recursos, o apoio e a comunidade para você ir da ideia":"de"===i?"und praxisnahes Lernen gibt dir SheBuilds die Ressourcen, die Unterstützung und die Community, um von der Idee":"fr"===i?" et un apprentissage pratique, SheBuilds vous offre les ressources, le soutien et la communauté pour passer de l'idée":"es"===i?" y aprendizaje práctico, SheBuilds te ofrece los recursos, el apoyo y la comunidad para pasar de la idea":"it"===i?" e apprendimento pratico, SheBuilds ti offre le risorse, il supporto e la community per passare dall'idea":"hi"===i?", और व्यावहारिक सीखने के ज़रिए, SheBuilds आपको विचार से आगे बढ़कर":"id"===i?", dan pembelajaran langsung, SheBuilds memberi Anda sumber daya, dukungan, dan komunitas untuk mewujudkan ide":"th"===i?" และการเรียนรู้แบบลงมือทำ SheBuilds มอบทรัพยากร การสนับสนุน และชุมชนที่ช่วยให้คุณก้าวจากไอเดีย":"ko"===i?", 그리고 실습 중심의 학습을 통해, SheBuilds는 아이디어에서":"、実践的な学びを通じて、SheBuildsはアイデアを"}],537670),e.s(["sheBuildsPage_about_part7",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"to real":"pt-BR"===i?"a um produto real":"de"===i?"zum echten,":"fr"===i?"à un vrai":"es"===i?"a un producto real":"it"===i?"a un prodotto vero":"hi"===i?"एक वास्तविक,":"id"===i?"menjadi produk nyata":"th"===i?"ไปสู่ผลิตภัณฑ์จริง":"ko"===i?"실제":"実際の"}],931256),e.s(["sheBuildsPage_about_part8",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?", AI-powered product.":"pt-BR"===i?", impulsionado por IA.":"de"===i?"KI-gestützten Produkt zu gelangen.":"fr"===i?" produit propulsé par l'IA.":"es"===i?" impulsado por IA.":"it"===i?", basato sull'AI.":"hi"===i?" AI-संचालित उत्पाद बनाने तक के संसाधन, सहयोग और समुदाय देता है।":"id"===i?" bertenaga AI.":"th"===i?" ที่ขับเคลื่อนด้วย AI":"ko"===i?" AI 기반 제품으로 나아갈 수 있는 자료와 지원, 커뮤니티를 제공해요.":"AI搭載プロダクトにするためのリソース、サポート、コミュニティを提供します。"}],611356),e.s(["sheBuildsPage_about_title",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"We build and grow together":"pt-BR"===i?"Construímos e crescemos juntas":"de"===i?"Wir bauen und wachsen gemeinsam":"fr"===i?"Nous construisons et grandissons ensemble":"es"===i?"Construimos y crecemos juntas":"it"===i?"Costruiamo e cresciamo insieme":"hi"===i?"हम साथ मिलकर बनाते और बढ़ते हैं":"id"===i?"Kita membangun dan berkembang bersama":"th"===i?"เราสร้างและเติบโตไปด้วยกัน":"ko"===i?"우리는 함께 만들고 함께 성장해요":"ともに作り、ともに成長する"}],936883)},345941,89842,e=>{"use strict";var a=e.i(420459);e.s(["sheBuildsPage_hero_cta_primary",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Upcoming hackathons":"pt-BR"===i?"Próximos hackathons":"de"===i?"Kommende Hackathons":"fr"===i?"Hackathons à venir":"es"===i?"Próximos hackatones":"it"===i?"Prossimi hackathon":"hi"===i?"आगामी हैकाथॉन":"id"===i?"Hackathon mendatang":"th"===i?"แฮกกาธอนที่กำลังจะมาถึง":"ko"===i?"예정된 해커톤":"今後のハッカソン"}],345941),e.s(["sheBuildsPage_hero_cta_secondary",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Join webinar":"pt-BR"===i?"Participar do webinar":"de"===i?"Am Webinar teilnehmen":"fr"===i?"Rejoindre le webinaire":"es"===i?"Únete al seminario web":"it"===i?"Partecipa al webinar":"hi"===i?"वेबिनार में शामिल हों":"id"===i?"Ikuti webinar":"th"===i?"เข้าร่วมเว็บบินาร์":"ko"===i?"웨비나 참여하기":"ウェビナーに参加"}],89842)},515504,e=>{"use strict";var a=e.i(420459);e.s(["sheBuildsPage_hero_subtitle",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Built to amplify women who build.":"pt-BR"===i?"Feito para dar voz às mulheres que constroem.":"de"===i?"Entwickelt, um Frauen zu stärken, die etwas erschaffen.":"fr"===i?"Conçu pour mettre en avant les femmes qui créent.":"es"===i?"Creado para impulsar a las mujeres que crean.":"it"===i?"Creato per dare voce alle donne che costruiscono.":"hi"===i?"निर्माण करने वाली महिलाओं को सशक्त बनाने के लिए बनाया गया।":"id"===i?"Dibuat untuk memberdayakan perempuan yang berkarya.":"th"===i?"สร้างขึ้นเพื่อส่งเสริมพลังของผู้หญิงที่สร้างสรรค์":"ko"===i?"직접 만드는 여성들을 응원하기 위해 만들어졌어요.":"つくる女性たちを後押しするために。"}])},881699,331958,e=>{"use strict";var a=e.i(420459);e.s(["sheBuildsPage_stats_body1",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"On International Women's Day 2025, 120+ community-led events took place across 40+ countries in a single day. 3,100+ women showed up in person, with 3,000+ more on waitlists. Confidence in building with AI tools jumped 50 points in one day.":"pt-BR"===i?"No Dia Internacional da Mulher de 2025, mais de 120 eventos liderados pela comunidade aconteceram em mais de 40 países em um único dia. Mais de 3.100 mulheres compareceram presencialmente, com mais de 3.000 em listas de espera. A confiança em construir com ferramentas de IA aumentou 50 pontos em um dia.":"de"===i?"Am Internationalen Frauentag 2025 fanden an einem einzigen Tag über 120 von der Community organisierte Veranstaltungen in mehr als 40 Ländern statt. Über 3.100 Frauen waren persönlich dabei, mehr als 3.000 weitere standen auf Wartelisten. Das Vertrauen darin, mit KI-Werkzeugen etwas zu entwickeln, stieg an einem Tag um 50 Punkte.":"fr"===i?"Lors de la Journée internationale des droits des femmes 2025, plus de 120 événements organisés par la communauté ont eu lieu dans plus de 40 pays en une seule journée. Plus de 3 100 femmes étaient présentes sur place, et plus de 3 000 autres sur liste d'attente. La confiance dans la création avec les outils d'IA a bondi de 50 points en une journée.":"es"===i?"En el Día Internacional de la Mujer de 2025, se celebraron más de 120 eventos liderados por la comunidad en más de 40 países en un solo día. Más de 3.100 mujeres asistieron en persona, con más de 3.000 en listas de espera. La confianza para construir con herramientas de IA aumentó 50 puntos en un solo día.":"it"===i?"Per la Giornata internazionale della donna 2025, oltre 120 eventi guidati dalla comunità si sono svolti in più di 40 paesi in un solo giorno. Oltre 3.100 donne hanno partecipato di persona, con altre 3.000 in lista d'attesa. La fiducia nel creare con strumenti AI è cresciuta di 50 punti in un solo giorno.":"hi"===i?"अंतर्राष्ट्रीय महिला दिवस 2025 पर, एक ही दिन में 40+ देशों में 120+ समुदाय-संचालित आयोजन हुए। 3,100+ महिलाएँ व्यक्तिगत रूप से शामिल हुईं, और 3,000+ अन्य प्रतीक्षा सूची में रहीं। AI उपकरणों के साथ निर्माण करने का आत्मविश्वास एक ही दिन में 50 अंक बढ़ गया।":"id"===i?"Pada Hari Perempuan Internasional 2025, lebih dari 120 acara yang dipimpin komunitas berlangsung di lebih dari 40 negara dalam satu hari. Lebih dari 3.100 perempuan hadir secara langsung, dengan lebih dari 3.000 lainnya dalam daftar tunggu. Kepercayaan diri dalam berkarya dengan alat AI melonjak 50 poin dalam satu hari.":"th"===i?"ในวันสตรีสากลปี 2025 มีกิจกรรมที่นำโดยชุมชนกว่า 120 งานเกิดขึ้นใน 40 กว่าประเทศภายในวันเดียว ผู้หญิงกว่า 3,100 คนมาร่วมงานด้วยตนเอง และอีกกว่า 3,000 คนอยู่ในรายชื่อรอเข้าร่วม ความมั่นใจในการสร้างสรรค์ด้วยเครื่องมือ AI เพิ่มขึ้น 50 จุดภายในวันเดียว":"ko"===i?"2025년 세계 여성의 날, 하루 동안 40개국 이상에서 120개 이상의 커뮤니티 주도 행사가 열렸어요. 3,100명 이상의 여성이 직접 참여했고, 3,000명 이상이 대기자 명단에 올랐어요. AI 도구로 직접 만드는 것에 대한 자신감이 하루 만에 50포인트 상승했어요.":"2025年の国際女性デーには、1日で40か国以上にわたり、120以上のコミュニティ主導イベントが開催されました。3,100人以上の女性が現地に集まり、さらに3,000人以上がウェイトリストに登録しました。AIツールでものづくりをする自信は、わずか1日で50ポイント上昇しました。"}],881699),e.s(["sheBuildsPage_stats_body2",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"That is not a hackathon stat. That is a movement. SheBuilds is the home for that community, and it is just getting started.":"pt-BR"===i?"Isso não é uma estatística de hackathon. Isso é um movimento. A SheBuilds é o lar dessa comunidade, e está apenas começando.":"de"===i?"Das ist keine Hackathon-Statistik. Das ist eine Bewegung. SheBuilds ist das Zuhause für diese Community – und es geht gerade erst los.":"fr"===i?"Ce n'est pas une simple statistique de hackathon. C'est un mouvement. SheBuilds est le point de ralliement de cette communauté, et ce n'est que le début.":"es"===i?"Eso no es una estadística de hackatón. Es un movimiento. SheBuilds es el hogar de esa comunidad, y esto no ha hecho más que empezar.":"it"===i?"Non è una semplice statistica da hackathon. È un movimento. SheBuilds è la casa di questa comunità, ed è solo all'inizio.":"hi"===i?"यह सिर्फ हैकाथॉन का आँकड़ा नहीं है। यह एक आंदोलन है। SheBuilds उस समुदाय का घर है, और यह तो बस शुरुआत है।":"id"===i?"Itu bukan sekadar statistik hackathon. Itu sebuah gerakan. SheBuilds adalah rumah bagi komunitas tersebut, dan ini baru permulaan.":"th"===i?"นั่นไม่ใช่แค่สถิติของแฮกกาธอน แต่คือการเคลื่อนไหว SheBuilds คือบ้านของชุมชนนี้ และนี่เป็นเพียงจุดเริ่มต้นเท่านั้น":"ko"===i?"이건 단순한 해커톤 통계가 아니에요. 하나의 움직임이에요. SheBuilds는 그 커뮤니티를 위한 공간이며, 이제 막 시작했을 뿐이에요.":"これは単なるハッカソンの数字ではありません。ひとつのムーブメントです。SheBuildsはそのコミュニティの拠点であり、その歩みはまだ始まったばかりです。"}],331958)},874121,e=>{"use strict";var a=e.i(420459);e.s(["sheBuildsPage_stats_contestants",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Women contestants":"pt-BR"===i?"Mulheres participantes":"de"===i?"Teilnehmerinnen":"fr"===i?"Participantes":"es"===i?"Mujeres participantes":"it"===i?"Donne partecipanti":"hi"===i?"महिला प्रतिभागी":"id"===i?"Peserta perempuan":"th"===i?"ผู้เข้าแข่งขันหญิง":"ko"===i?"여성 참가자":"女性参加者"}])},812504,e=>{"use strict";var a=e.i(420459);e.s(["sheBuildsPage_stats_countries",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Countries":"pt-BR"===i?"Países":"de"===i?"Länder":"fr"===i?"Pays":"es"===i?"Países":"it"===i?"Paesi":"hi"===i?"देश":"id"===i?"Negara":"th"===i?"ประเทศ":"ko"===i?"참여 국가":"国"}])},456667,e=>{"use strict";var a=e.i(420459);e.s(["sheBuildsPage_stats_events",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Community-led events":"pt-BR"===i?"Eventos liderados pela comunidade":"de"===i?"Von der Community organisierte Veranstaltungen":"fr"===i?"Événements organisés par la communauté":"es"===i?"Eventos liderados por la comunidad":"it"===i?"Eventi guidati dalla comunità":"hi"===i?"समुदाय-संचालित आयोजन":"id"===i?"Acara yang dipimpin komunitas":"th"===i?"กิจกรรมที่นำโดยชุมชน":"ko"===i?"커뮤니티 주도 행사":"コミュニティ主導イベント"}])},335376,321960,e=>{"use strict";var a=e.i(420459);e.s(["sheBuildsPage_stats_titleLine1",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Real builders.":"pt-BR"===i?"Criadoras de verdade.":"de"===i?"Echte Macherinnen.":"fr"===i?"De vraies créatrices.":"es"===i?"Creadoras reales.":"it"===i?"Creatrici vere.":"hi"===i?"असली निर्माता।":"id"===i?"Para pembangun sungguhan.":"th"===i?"นักสร้างตัวจริง":"ko"===i?"실제로 만드는 사람들.":"本物のつくり手。"}],335376),e.s(["sheBuildsPage_stats_titleLine2",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Real results.":"pt-BR"===i?"Resultados de verdade.":"de"===i?"Echte Ergebnisse.":"fr"===i?"De vrais résultats.":"es"===i?"Resultados reales.":"it"===i?"Risultati veri.":"hi"===i?"असली नतीजे।":"id"===i?"Hasil nyata.":"th"===i?"ผลลัพธ์จริง":"ko"===i?"실질적인 결과.":"本物の成果。"}],321960)},83589,e=>{"use strict";var a=e.i(420459);e.s(["sheBuildsPage_stats_waitlist",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Women on waitlist":"pt-BR"===i?"Mulheres na lista de espera":"de"===i?"Frauen auf der Warteliste":"fr"===i?"Femmes sur liste d'attente":"es"===i?"Mujeres en lista de espera":"it"===i?"Donne in lista d'attesa":"hi"===i?"प्रतीक्षा सूची में महिलाएँ":"id"===i?"Perempuan dalam daftar tunggu":"th"===i?"ผู้หญิงในรายชื่อรอเข้าร่วม":"ko"===i?"대기자 명단에 오른 여성":"ウェイトリストの女性"}])},559161,e=>{"use strict";var a=e.i(420459);e.s(["sheBuildsPage_whatWeBelieve_item1_description",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Anyone with an idea can build with AI today. No technical background needed.":"pt-BR"===i?"Qualquer pessoa com uma ideia pode construir com IA hoje. Sem necessidade de conhecimento técnico.":"de"===i?"Jede Person mit einer Idee kann heute mit KI etwas entwickeln. Kein technischer Hintergrund nötig.":"fr"===i?"Toute personne ayant une idée peut créer avec l'IA dès aujourd'hui. Aucune compétence technique requise.":"es"===i?"Cualquier persona con una idea puede crear con IA hoy. No se necesitan conocimientos técnicos.":"it"===i?"Chiunque abbia un'idea può creare con l'AI già oggi. Nessuna competenza tecnica richiesta.":"hi"===i?"जिसके पास कोई विचार है, वह आज AI की मदद से उसे बना सकता है। किसी तकनीकी पृष्ठभूमि की ज़रूरत नहीं।":"id"===i?"Siapa pun yang punya ide bisa berkarya dengan AI hari ini. Tidak perlu latar belakang teknis.":"th"===i?"ทุกคนที่มีไอเดียสามารถสร้างสรรค์ด้วย AI ได้แล้ววันนี้ โดยไม่ต้องมีพื้นฐานด้านเทคนิค":"ko"===i?"아이디어만 있다면 누구나 오늘 AI로 만들 수 있어요. 기술적 배경은 필요 없어요.":"アイデアさえあれば、今や誰でもAIでものづくりができます。技術的な知識は必要ありません。"}])},488274,997839,e=>{"use strict";var a=e.i(420459);e.s(["sheBuildsPage_whatWeBelieve_item1_number",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i||"pt-BR"===i||"de"===i||"fr"===i||"es"===i||"it"===i||"hi"===i||"id"===i||"th"===i,"01"}],488274),e.s(["sheBuildsPage_whatWeBelieve_item1_title",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"The future is being built with AI. Be the one building it.":"pt-BR"===i?"O futuro está sendo construído com IA. Faça parte dessa construção.":"de"===i?"Die Zukunft entsteht mit KI. Gestalte sie mit.":"fr"===i?"L'avenir se construit avec l'IA. Soyez celle qui le construit.":"es"===i?"El futuro se está construyendo con IA. Sé tú quien lo construya.":"it"===i?"Il futuro si costruisce con l'AI. Sii tu a costruirlo.":"hi"===i?"भविष्य AI की मदद से बनाया जा रहा है। उसे बनाने वालों में आप भी शामिल हों।":"id"===i?"Masa depan sedang dibangun dengan AI. Jadilah salah satu yang membangunnya.":"th"===i?"อนาคตกำลังถูกสร้างขึ้นด้วย AI มาเป็นหนึ่งในผู้สร้างอนาคตนั้น":"ko"===i?"미래는 AI로 만들어지고 있어요. 그 미래를 만드는 사람이 되어 보세요.":"未来はAIでつくられています。その未来をつくる側になりましょう。"}],997839)},644803,e=>{"use strict";var a=e.i(420459);e.s(["sheBuildsPage_whatWeBelieve_item2_description",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Shipping something real, even if imperfect, is worth more than waiting until you feel ready.":"pt-BR"===i?"Lançar algo real, mesmo que imperfeito, vale mais do que esperar até você se sentir pronta.":"de"===i?"Etwas Echtes zu veröffentlichen, auch wenn es nicht perfekt ist, ist mehr wert, als zu warten, bis du dich bereit fühlst.":"fr"===i?"Lancer quelque chose de concret, même imparfait, vaut mieux que d'attendre de se sentir prête.":"es"===i?"Lanzar algo real, aunque sea imperfecto, vale más que esperar hasta sentirte lista.":"it"===i?"Pubblicare qualcosa di reale, anche se imperfetto, vale più che aspettare di sentirti pronta.":"hi"===i?"कुछ असली बनाकर लॉन्च करना, भले ही वह अधूरा हो, तैयार महसूस करने का इंतज़ार करने से कहीं ज़्यादा मायने रखता है।":"id"===i?"Merilis sesuatu yang nyata, meski belum sempurna, lebih berharga daripada menunggu sampai kamu merasa siap.":"th"===i?"การปล่อยผลงานจริงออกมา แม้จะยังไม่สมบูรณ์แบบ ก็มีค่ามากกว่าการรอจนกว่าคุณจะรู้สึกพร้อม":"ko"===i?"완벽하지 않더라도 실제로 무언가를 출시하는 것이 준비됐다고 느낄 때까지 기다리는 것보다 더 가치 있습니다.":"完璧でなくても、実際に何かをリリースすることは、準備が整うまで待つことよりも価値があります。"}])},695768,796842,e=>{"use strict";var a=e.i(420459);e.s(["sheBuildsPage_whatWeBelieve_item2_number",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i||"pt-BR"===i||"de"===i||"fr"===i||"es"===i||"it"===i||"hi"===i||"id"===i||"th"===i,"02"}],695768),e.s(["sheBuildsPage_whatWeBelieve_item2_title",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Ship it anyway":"pt-BR"===i?"Lance mesmo assim":"de"===i?"Trotzdem veröffentlichen":"fr"===i?"Lancez-le quand même":"es"===i?"Publícalo de todos modos":"it"===i?"Pubblicalo comunque":"hi"===i?"फिर भी इसे दुनिया के सामने लाएँ":"id"===i?"Tetap luncurkan":"th"===i?"ปล่อยออกมาเลย":"ko"===i?"일단 출시하세요":"とにかくリリースする"}],796842)},452278,e=>{"use strict";var a=e.i(420459);e.s(["sheBuildsPage_whatWeBelieve_item3_description",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Progress accelerates when you feel supported, seen, and surrounded by people doing the same thing. SheBuilds is that community.":"pt-BR"===i?"O progresso acelera quando você se sente apoiada, reconhecida e cercada por pessoas que estão fazendo a mesma coisa. A SheBuilds é essa comunidade.":"de"===i?"Fortschritt beschleunigt sich, wenn du dich unterstützt und gesehen fühlst und von Menschen umgeben bist, die dasselbe tun. SheBuilds ist genau diese Community.":"fr"===i?"Les progrès s'accélèrent lorsque vous vous sentez soutenue, reconnue et entourée de personnes qui font la même chose. SheBuilds, c'est cette communauté.":"es"===i?"El progreso se acelera cuando te sientes apoyada, reconocida y rodeada de personas que hacen lo mismo. SheBuilds es esa comunidad.":"it"===i?"I progressi accelerano quando ti senti supportata, vista e circondata da persone che fanno la stessa cosa. SheBuilds è proprio questa comunità.":"hi"===i?"जब आपको समर्थन और पहचान मिलती है, और आप ऐसे लोगों से घिरे होते हैं जो वही कर रहे हैं, तो प्रगति तेज़ हो जाती है। SheBuilds वही समुदाय है।":"id"===i?"Kemajuan semakin cepat saat kamu merasa didukung, diperhatikan, dan dikelilingi oleh orang-orang yang melakukan hal yang sama. SheBuilds adalah komunitas itu.":"th"===i?"ความก้าวหน้าจะเร็วขึ้นเมื่อคุณรู้สึกว่ามีคนสนับสนุน มองเห็น และมีคนที่กำลังทำสิ่งเดียวกันอยู่รอบตัว SheBuilds คือคอมมูนิตี้แบบนั้น":"ko"===i?"지지받고, 인정받고, 같은 일을 하는 사람들과 함께할 때 성장은 더 빨라집니다. SheBuilds가 바로 그런 커뮤니티입니다.":"支えられ、理解され、同じことに取り組む仲間に囲まれていると、前進は加速します。SheBuildsはそんなコミュニティです。"}])},258703,751004,e=>{"use strict";var a=e.i(420459);e.s(["sheBuildsPage_whatWeBelieve_item3_number",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i||"pt-BR"===i||"de"===i||"fr"===i||"es"===i||"it"===i||"hi"===i||"id"===i||"th"===i,"03"}],258703),e.s(["sheBuildsPage_whatWeBelieve_item3_title",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Build with people who get it":"pt-BR"===i?"Construa com pessoas que entendem":"de"===i?"Bau mit Menschen, die es verstehen":"fr"===i?"Créez avec des personnes qui vous comprennent":"es"===i?"Crea con personas que lo entienden":"it"===i?"Crea con persone che ti capiscono":"hi"===i?"ऐसे लोगों के साथ बनाएँ जो इसे समझते हैं":"id"===i?"Berkarya bersama orang-orang yang paham":"th"===i?"สร้างไปกับคนที่เข้าใจคุณ":"ko"===i?"공감하는 사람들과 함께 만들어가세요":"理解し合える仲間と作り上げる"}],751004)},987249,e=>{"use strict";var a=e.i(420459);e.s(["sheBuildsPage_whatWeBelieve_item4_description",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Full-time job, kids, stolen hours on a Sunday. SheBuilds is designed for the way you actually live, not the way you wish you had time to.":"pt-BR"===i?"Emprego de tempo integral, filhos, horas roubadas em um domingo. A SheBuilds foi pensada para a forma como você realmente vive, não para uma rotina idealizada para a qual você gostaria de ter tempo.":"de"===i?"Vollzeitjob, Kinder, ein paar gestohlene Stunden am Sonntag. SheBuilds ist auf dein echtes Leben ausgelegt – nicht auf das, für das du dir mehr Zeit wünschst.":"fr"===i?"Un emploi à temps plein, des enfants, quelques heures volées un dimanche. SheBuilds est conçu pour votre vie telle qu'elle est vraiment, pas telle que vous aimeriez avoir le temps de la vivre.":"es"===i?"Trabajo de tiempo completo, hijos, horas robadas un domingo. SheBuilds está diseñado para la forma en que realmente vives, no para la que desearías tener tiempo de vivir.":"it"===i?"Un lavoro a tempo pieno, i figli, ore rubate alla domenica. SheBuilds è pensato per come vivi davvero, non per la vita per cui vorresti avere tempo.":"hi"===i?"फुल-टाइम नौकरी, बच्चे, रविवार को किसी तरह निकाले गए कुछ घंटे। SheBuilds आपकी असल ज़िंदगी के हिसाब से बनाया गया है, न कि उस आदर्श दिनचर्या के हिसाब से जिसके लिए आप चाहते हैं कि आपके पास समय हो।":"id"===i?"Pekerjaan penuh waktu, anak-anak, waktu curian di hari Minggu. SheBuilds dirancang untuk kehidupan yang benar-benar kamu jalani, bukan kehidupan yang kamu harap sempat kamu jalani.":"th"===i?"งานประจำ ลูกๆ หรือเวลาที่แอบเจียดมาได้ในวันอาทิตย์ SheBuilds ออกแบบมาเพื่อชีวิตจริงของคุณ ไม่ใช่ชีวิตในแบบที่คุณอยากจะมีเวลามากกว่านี้":"ko"===i?"풀타임 업무, 육아, 일요일에 겨우 낸 시간까지. SheBuilds는 시간이 충분한 이상적인 삶이 아니라 실제 살아가는 방식에 맞춰 설계됐어요.":"フルタイムの仕事、子育て、日曜日に捻出したわずかな時間。SheBuildsは、理想の時間割ではなく、現実の暮らしに合わせて設計されています。"}])},516448,436608,e=>{"use strict";var a=e.i(420459);e.s(["sheBuildsPage_whatWeBelieve_item4_number",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i||"pt-BR"===i||"de"===i||"fr"===i||"es"===i||"it"===i||"hi"===i||"id"===i||"th"===i,"04"}],516448),e.s(["sheBuildsPage_whatWeBelieve_item4_title",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Built around your real life.":"pt-BR"===i?"Pensada para a sua vida real.":"de"===i?"Für dein echtes Leben gemacht.":"fr"===i?"Pensé pour votre vraie vie.":"es"===i?"Pensado para tu vida real.":"it"===i?"Pensato per la tua vita reale.":"hi"===i?"आपकी असली ज़िंदगी के हिसाब से बनाया गया।":"id"===i?"Dirancang sesuai kehidupan nyatamu.":"th"===i?"ออกแบบมาเพื่อชีวิตจริงของคุณ":"ko"===i?"현실적인 삶에 맞춰 설계했어요":"現実の暮らしに寄り添う設計。"}],436608)},964874,e=>{"use strict";var a=e.i(420459);e.s(["sheBuildsPage_whatWeBelieve_title",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"What we believe":"pt-BR"===i?"No que acreditamos":"de"===i?"Woran wir glauben":"fr"===i?"Ce en quoi nous croyons":"es"===i?"En qué creemos":"it"===i?"In cosa crediamo":"hi"===i?"हम क्या मानते हैं":"id"===i?"Apa yang kami yakini":"th"===i?"สิ่งที่เราเชื่อ":"ko"===i?"우리가 믿는 것":"私たちが信じていること"}])}]);

//# debugId=94867832-7755-60ae-9d06-c91c80d3dfdf
//# sourceMappingURL=0gj2b8zui-x9m.js.map