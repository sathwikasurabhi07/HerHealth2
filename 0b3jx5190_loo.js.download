;!function(){try { var e="undefined"!=typeof globalThis?globalThis:"undefined"!=typeof global?global:"undefined"!=typeof window?window:"undefined"!=typeof self?self:{},n=(new e.Error).stack;n&&((e._debugIds|| (e._debugIds={}))[n]="0a4bc758-e180-be42-9517-f44a8622cd37")}catch(e){}}();
(globalThis.TURBOPACK||(globalThis.TURBOPACK=[])).push(["object"==typeof document?document.currentScript:void 0,353947,52520,179488,e=>{"use strict";var a=e.i(420459);e.s(["discordPage_champions_part1",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Lovable Champions are the people who show up every day. Not because they have to, but because they genuinely want to help others build. You'll spot them by the Champion":"pt-BR"===i?"Os Campeões Lovable são as pessoas que aparecem todos os dias. Não por obrigação, mas porque realmente querem ajudar os outros a criar. Você vai reconhecê-los pelo selo de Campeão":"de"===i?"Lovable Champions sind die Menschen, die jeden Tag da sind. Nicht weil sie müssen, sondern weil sie anderen wirklich beim Bauen helfen wollen. Du erkennst sie am Champion-":"fr"===i?"Les Champions Lovable sont les personnes présentes chaque jour. Non pas parce qu'elles le doivent, mais parce qu'elles veulent sincèrement aider les autres à créer. Vous les reconnaîtrez au badge Champion":"es"===i?"Los campeones de Lovable son las personas que están presentes cada día. No porque tengan que hacerlo, sino porque de verdad quieren ayudar a otros a crear. Los reconocerás por la insignia de campeón":"it"===i?"I Lovable Champion sono le persone che ci sono ogni giorno. Non perché devono, ma perché vogliono davvero aiutare gli altri a creare. Li riconoscerai dal badge Champion":"hi"===i?"Lovable चैंपियंस वे लोग हैं जो हर दिन मौजूद रहते हैं. इसलिए नहीं कि उन्हें ऐसा करना पड़ता है, बल्कि इसलिए कि वे सच में दूसरों को चीज़ें बनाने में मदद करना चाहते हैं. आप उन्हें उनके यूज़रनेम के बगल में चैंपियन":"id"===i?"Lovable Champions adalah orang-orang yang hadir setiap hari. Bukan karena terpaksa, tetapi karena mereka benar-benar ingin membantu orang lain membuat sesuatu. Anda bisa mengenali mereka dari lencana Champion":"th"===i?"Lovable Champions คือคนที่แวะมาทุกวัน ไม่ใช่เพราะต้องมา แต่เพราะอยากช่วยให้คนอื่นได้สร้างสรรค์ผลงานจริง ๆ คุณจะสังเกตเห็นพวกเขาได้จากป้าย Champion":"ko"===i?"Lovable Champions는 매일 커뮤니티에 참여하는 사람들이에요. 의무감 때문이 아니라, 진심으로 다른 사람들이 만들 수 있도록 돕고 싶어서죠. 사용자 이름 옆의 Champion":"Lovable Championsは、毎日参加してくれる人たちです。義務だからではなく、心から他の人の制作を手伝いたいと思っているからこそ。ユーザー名の横にあるChampion"}],353947),e.s(["discordPage_champions_part2",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"or Super Champion":"pt-BR"===i?"ou Super Campeão":"de"===i?"oder Super-Champion-":"fr"===i?"ou Super Champion":"es"===i?"o supercampeón":"it"===i?"o Super Champion":"hi"===i?"या सुपर चैंपियन":"id"===i?"atau Super Champion":"th"===i?"หรือ Super Champion":"ko"===i?"또는 Super Champion":"またはSuper Champion"}],52520),e.s(["discordPage_champions_part3",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"badge next to their username.":"pt-BR"===i?"ao lado do nome de usuário.":"de"===i?"Abzeichen neben ihrem Benutzernamen.":"fr"===i?"à côté de leur nom d'utilisateur.":"es"===i?"junto a su nombre de usuario.":"it"===i?"accanto al loro nome utente.":"hi"===i?"बैज से पहचान सकते हैं.":"id"===i?"di samping nama pengguna mereka.":"th"===i?"ที่อยู่ข้างชื่อผู้ใช้ของพวกเขา":"ko"===i?"배지로 이들을 알아볼 수 있어요.":"バッジが目印です。"}],179488)},194926,e=>{"use strict";var a=e.i(420459);e.s(["discordPage_champions_title",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Meet the Champions":"pt-BR"===i?"Conheça os Campeões":"de"===i?"Lerne die Champions kennen":"fr"===i?"Découvrez les Champions":"es"===i?"Conoce a los campeones":"it"===i?"Scopri i Champion":"hi"===i?"चैंपियंस से मिलिए":"id"===i?"Kenalan dengan para Champion":"th"===i?"พบกับเหล่า Champions":"ko"===i?"챔피언을 만나보세요":"Championsを紹介します"}])},719241,e=>{"use strict";var a=e.i(420459);e.s(["discordPage_community_card1_label",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Active members":"pt-BR"===i?"Membros ativos":"de"===i?"Aktive Mitglieder":"fr"===i?"Membres actifs":"es"===i?"Miembros activos":"it"===i?"Membri attivi":"hi"===i?"सक्रिय सदस्य":"id"===i?"Anggota aktif":"th"===i?"สมาชิกที่ใช้งานอยู่":"ko"===i?"활성 멤버":"アクティブメンバー"}])},170482,e=>{"use strict";var a=e.i(420459);e.s(["discordPage_community_card1_value",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"160,000+":"pt-BR"===i||"de"===i?"160.000+":"fr"===i?"160 000+":"es"===i||"it"===i?"160.000+":"hi"===i?"160,000+":"id"===i?"160.000+":("th"===i,"160,000+")}])},31644,e=>{"use strict";var a=e.i(420459);e.s(["discordPage_community_card2_label",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Continuous activity":"pt-BR"===i?"Atividade contínua":"de"===i?"Durchgehende Aktivität":"fr"===i?"Activité continue":"es"===i?"Actividad continua":"it"===i?"Attività continua":"hi"===i?"लगातार गतिविधि":"id"===i?"Aktivitas berkelanjutan":"th"===i?"กิจกรรมต่อเนื่อง":"ko"===i?"지속적인 활동":"継続的なアクティビティ"}])},784044,e=>{"use strict";var a=e.i(420459);e.s(["discordPage_community_card2_value",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"3,000+ hours":"pt-BR"===i?"3.000+ horas":"de"===i?"3.000+ Stunden":"fr"===i?"Plus de 3 000 heures":"es"===i?"3.000+ horas":"it"===i?"Oltre 3.000 ore":"hi"===i?"3,000+ घंटे":"id"===i?"3.000+ jam":"th"===i?"3,000+ ชั่วโมง":"ko"===i?"3,000시간+":"3,000+時間"}])},691372,e=>{"use strict";var a=e.i(420459);e.s(["discordPage_community_card3_label",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Someone's always on":"pt-BR"===i?"Sempre tem alguém online":"de"===i?"Es ist immer jemand online":"fr"===i?"Toujours quelqu'un de connecté":"es"===i?"Siempre hay alguien conectado":"it"===i?"C'è sempre qualcuno online":"hi"===i?"कोई न कोई हमेशा मौजूद रहता है":"id"===i?"Selalu ada yang online":"th"===i?"มีคนออนไลน์อยู่เสมอ":"ko"===i?"언제나 누군가 함께해요":"いつでも誰かがオンライン"}])},599845,e=>{"use strict";var a=e.i(420459);e.s(["discordPage_community_card3_value",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Day, night & weekends":"pt-BR"===i?"Dia, noite e fins de semana":"de"===i?"Tagsüber, nachts & am Wochenende":"fr"===i?"Jour, nuit et week-ends":"es"===i?"Día, noche y fines de semana":"it"===i?"Giorno, notte e nei weekend":"hi"===i?"दिन, रात और सप्ताहांत":"id"===i?"Siang, malam & akhir pekan":"th"===i?"ทั้งกลางวัน กลางคืน และวันหยุดสุดสัปดาห์":"ko"===i?"낮, 밤, 그리고 주말에도":"昼も夜も週末も"}])},614011,858539,798168,502123,e=>{"use strict";var a=e.i(420459);e.s(["discordPage_community_part1",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"The Lovable Discord":"pt-BR"===i?"O Discord da Lovable":"de"===i?"Der Lovable Discord":"fr"===i?"Le Discord de Lovable":"es"===i?"El Discord de Lovable":"it"===i?"Il Discord di Lovable":"hi"===i?"Lovable Discord":"id"===i?"Discord Lovable":"th"===i?"Discord ของ Lovable":"ko"===i?"Lovable Discord는":"Lovable の Discord"}],614011),e.s(["discordPage_community_part2",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"is one of the most active builder communities in the world. At any given moment, someone is shipping":"pt-BR"===i?"é uma das comunidades de criadores mais ativas do mundo. A qualquer momento, alguém está lançando algo":"de"===i?"ist eine der aktivsten Communitys für Entwicklerinnen, Entwickler und Kreative der Welt. In jedem Moment veröffentlicht gerade jemand etwas,":"fr"===i?"est l'une des communautés de créateurs les plus actives au monde. À tout moment, quelqu'un est en train de publier un projet,":"es"===i?"es una de las comunidades de creadores más activas del mundo. En cualquier momento, alguien está lanzando algo":"it"===i?"è una delle comunità di persone che creano con Lovable più attive al mondo. In ogni momento, qualcuno sta lanciando un progetto":"hi"===i?"दुनिया के सबसे सक्रिय निर्माता समुदायों में से एक है। किसी भी समय, कोई न कोई अपना प्रोजेक्ट लॉन्च कर रहा होता है,":"id"===i?"adalah salah satu komunitas pembuat paling aktif di dunia. Kapan pun, selalu ada yang merilis karya":"th"===i?"เป็นหนึ่งในคอมมูนิตี้ของนักสร้างที่คึกคักที่สุดในโลก ในทุกช่วงเวลา จะมีคนกำลังปล่อยผลงาน":"ko"===i?"전 세계에서 가장 활발한 빌더 커뮤니티 중 하나예요. 언제든 누군가는 무언가를 출시하고 있고":"は、世界で最も活発なビルダーコミュニティの一つです。いつでも誰かがプロダクトを公開し"}],858539),e.s(["discordPage_community_part3",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"someone is sharing a tip":"pt-BR"===i?"alguém está compartilhando uma dica":"de"===i?"jemand teilt einen Tipp,":"fr"===i?"quelqu'un partage une astuce,":"es"===i?"alguien está compartiendo un consejo":"it"===i?"qualcuno sta condividendo un consiglio":"hi"===i?"कोई सुझाव साझा कर रहा होता है,":"id"===i?"ada yang berbagi tips":"th"===i?"มีคนกำลังแบ่งปันเคล็ดลับ":"ko"===i?"누군가는 팁을 공유하고 있으며":"誰かがヒントを共有し"}],798168),e.s(["discordPage_community_part4",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"and someone else already has the answer you're looking for.":"pt-BR"===i?"e outra pessoa já tem a resposta que você está procurando.":"de"===i?"und jemand anderes hat bereits die Antwort, die du suchst.":"fr"===i?"et quelqu'un d'autre a déjà la réponse que vous cherchez.":"es"===i?"y alguien más ya tiene la respuesta que estás buscando.":"it"===i?"e qualcun altro ha già la risposta che stai cercando.":"hi"===i?"और किसी और के पास पहले से ही वह जवाब होता है जिसे आप ढूंढ रहे हैं।":"id"===i?"dan ada pula yang sudah punya jawaban yang sedang kamu cari.":"th"===i?"และมีอีกคนที่มีคำตอบที่คุณกำลังมองหาอยู่แล้ว":"ko"===i?"또 다른 누군가는 이미 여러분이 찾고 있는 답을 알고 있어요.":"そして探している答えを、他の誰かがすでに知っています。"}],502123)},980146,e=>{"use strict";var a=e.i(420459);e.s(["discordPage_cta_joinDiscord",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Join the Discord":"pt-BR"===i?"Entrar no Discord":"de"===i?"Dem Discord beitreten":"fr"===i?"Rejoindre le Discord":"es"===i?"Únete al Discord":"it"===i?"Unisciti al Discord":"hi"===i?"Discord से जुड़ें":"id"===i?"Gabung ke Discord":"th"===i?"เข้าร่วม Discord":"ko"===i?"Discord 참여하기":"Discord に参加する"}])},19445,e=>{"use strict";var a=e.i(420459);e.s(["discordPage_hero_subtitle",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"160,000+ builders are shipping real products together, right now. Ask questions, share what you're building, and find the people who get it.":"pt-BR"===i?"Mais de 160.000 criadores estão lançando produtos reais juntos, agora mesmo. Faça perguntas, compartilhe o que você está criando e encontre pessoas que sabem como é.":"de"===i?"Über 160.000 Entwickler bringen gerade jetzt gemeinsam echte Produkte auf den Markt. Stelle Fragen, teile, woran du arbeitest, und finde die Menschen, die dich verstehen.":"fr"===i?"Plus de 160 000 créateurs lancent de vrais produits ensemble, en ce moment même. Posez vos questions, partagez vos créations et rencontrez ceux qui vous comprennent.":"es"===i?"Más de 160.000 creadores están lanzando productos reales juntos, ahora mismo. Haz preguntas, comparte lo que estás creando y encuentra a las personas que te entienden.":"it"===i?"Oltre 160.000 creator stanno lanciando prodotti reali insieme, proprio ora. Fai domande, condividi ciò che stai creando e trova persone che ti capiscono.":"hi"===i?"1,60,000+ निर्माता अभी साथ मिलकर वास्तविक उत्पाद लॉन्च कर रहे हैं। सवाल पूछें, जो आप बना रहे हैं उसे साझा करें, और ऐसे लोगों से मिलें जो आपकी बात समझते हैं।":"id"===i?"160.000+ pembuat sedang merilis produk nyata bersama, saat ini juga. Ajukan pertanyaan, bagikan apa yang sedang kamu buat, dan temukan orang-orang yang memahaminya.":"th"===i?"นักสร้างมากกว่า 160,000 คนกำลังเปิดตัวผลิตภัณฑ์จริงร่วมกันอยู่ตอนนี้ ถามคำถาม แชร์สิ่งที่คุณกำลังสร้าง และพบผู้คนที่เข้าใจคุณ":"ko"===i?"160,000명 이상의 빌더가 지금 이 순간에도 실제 제품을 함께 출시하고 있어요. 질문하고, 만들고 있는 것을 공유하고, 마음이 통하는 사람들을 만나보세요.":"16万人以上のビルダーが、今この瞬間も実際のプロダクトを一緒にリリースしています。質問したり、開発中のものを共有したり、そして分かり合える仲間を見つけましょう。"}])},980330,204992,e=>{"use strict";var a=e.i(420459);e.s(["discordPage_hero_titleLine1",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Join the online":"pt-BR"===i?"Junte-se à comunidade":"de"===i?"Tritt der Online-":"fr"===i?"Rejoignez la communauté":"es"===i?"Únete a la comunidad":"it"===i?"Unisciti alla community":"hi"===i?"ऑनलाइन समुदाय से":"id"===i?"Bergabung dengan komunitas":"th"===i?"เข้าร่วมคอมมูนิตี้":"ko"===i?"온라인 커뮤니티에":"オンライン"}],980330),e.s(["discordPage_hero_titleLine2",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"community":"pt-BR"===i?"online":"de"===i?"Community bei":"fr"===i?"en ligne":"es"===i?"en línea":"it"===i?"online":"hi"===i?"जुड़ें":"id"===i?"online":"th"===i?"ออนไลน์":"ko"===i?"참여하세요":"コミュニティに参加"}],204992)},701131,102548,e=>{"use strict";var a=e.i(420459);e.s(["discordPage_most_card1_description",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Ask your question or join Dev Chat Live to get real answers from experienced builders. Get help quickly, skip the tickets, and learn from people who've been there.":"pt-BR"===i?"Faça sua pergunta ou participe do Dev Chat Live para receber respostas reais de criadores experientes. Receba ajuda rapidamente, evite abrir chamados e aprenda com quem já passou por isso.":"de"===i?"Stelle deine Frage oder nimm an Dev Chat Live teil, um echte Antworten von erfahrenen Entwicklern zu bekommen. Erhalte schnell Hilfe, spare dir die Tickets und lerne von Menschen, die das schon durchgemacht haben.":"fr"===i?"Posez votre question ou rejoignez le Dev Chat Live pour obtenir de vraies réponses de créateurs expérimentés. Obtenez de l'aide rapidement, oubliez les tickets et apprenez auprès de ceux qui sont déjà passés par là.":"es"===i?"Haz tu pregunta o únete a Dev Chat Live para obtener respuestas reales de creadores con experiencia. Recibe ayuda rápidamente, evita las solicitudes de soporte y aprende de quienes ya han pasado por ahí.":"it"===i?"Fai la tua domanda o partecipa alla Dev Chat Live per ottenere risposte concrete da creator esperti. Ricevi aiuto velocemente, evita i ticket e impara da chi ci è già passato.":"hi"===i?"अपना सवाल पूछें या Dev Chat Live में शामिल होकर अनुभवी निर्माताओं से ठोस जवाब पाएं। जल्दी मदद पाएं, सपोर्ट टिकट से बचें, और उन लोगों से सीखें जो पहले इसी रास्ते से गुजर चुके हैं।":"id"===i?"Ajukan pertanyaanmu atau ikuti Dev Chat Live untuk mendapatkan jawaban nyata dari pembuat berpengalaman. Dapatkan bantuan dengan cepat, tanpa perlu membuat tiket, dan belajar dari orang-orang yang sudah mengalaminya.":"th"===i?"ถามคำถามของคุณหรือเข้าร่วมแชตสดสำหรับนักพัฒนาเพื่อรับคำตอบจริงจากนักสร้างผู้มากประสบการณ์ รับความช่วยเหลืออย่างรวดเร็ว ไม่ต้องเสียเวลาส่งคำขอความช่วยเหลือ และเรียนรู้จากคนที่เคยผ่านมาแล้ว":"ko"===i?"질문을 올리거나 개발자 라이브 채팅에 참여해 경험 많은 빌더들에게 실질적인 답변을 받아보세요. 지원 티켓을 만들 필요 없이 빠르게 도움을 받고, 먼저 경험한 사람들에게서 배워보세요.":"質問を投稿するか、Dev Chat Live に参加して、経験豊富なビルダーから実践的な回答を得ましょう。すばやくサポートを受け、チケットの手間を省き、実際に経験した人たちから学べます。"}],701131),e.s(["discordPage_most_card1_linkLabel",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i||"pt-BR"===i||"de"===i||"fr"===i||"es"===i||"it"===i||"hi"===i||"id"===i||"th"===i,"#community-support"}],102548)},696725,e=>{"use strict";var a=e.i(420459);e.s(["discordPage_most_card1_title",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Get help":"pt-BR"===i?"Receba ajuda":"de"===i?"Hilfe bekommen":"fr"===i?"Obtenir de l'aide":"es"===i?"Recibe ayuda":"it"===i?"Ottieni aiuto":"hi"===i?"मदद पाएं":"id"===i?"Dapatkan bantuan":"th"===i?"รับความช่วยเหลือ":"ko"===i?"도움 받기":"サポートを受ける"}])},176019,218629,e=>{"use strict";var a=e.i(420459);e.s(["discordPage_most_card2_description",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?`Shipped something? Show it off.
The community celebrates every build, big or small.
And if you want honest feedback, you'll get that too.`:"pt-BR"===i?`Lan\xe7ou algo? Mostre para todo mundo.
A comunidade celebra cada projeto, grande ou pequeno.
E se voc\xea quiser um feedback honesto, vai receber isso tamb\xe9m.`:"de"===i?`Etwas fertiggestellt? Zeig es her.
Die Community feiert jedes Projekt, ob gro\xdf oder klein.
Und wenn du ehrliches Feedback m\xf6chtest, bekommst du auch das.`:"fr"===i?`Vous avez lanc\xe9 quelque chose ? Montrez-le.
La communaut\xe9 c\xe9l\xe8bre chaque cr\xe9ation, grande ou petite.
Et si vous voulez un retour honn\xeate, vous l'aurez aussi.`:"es"===i?`\xbfLanzaste algo? Pres\xfamelo.
La comunidad celebra cada creaci\xf3n, grande o peque\xf1a.
Y si quieres comentarios sinceros, tambi\xe9n los tendr\xe1s.`:"it"===i?`Hai realizzato qualcosa? Mostralo.
La community celebra ogni creazione, grande o piccola.
E se vuoi un feedback sincero, otterrai anche quello.`:"hi"===i?`कुछ लॉन्च किया है? उसे दिखाएं।
समुदाय हर निर्माण का जश्न मनाता है, चाहे वह बड़ा हो या छोटा।
और अगर आपको ईमानदार प्रतिक्रिया चाहिए, तो वह भी मिलेगी।`:"id"===i?`Baru merilis sesuatu? Pamerkan.
Komunitas merayakan setiap karya, besar atau kecil.
Dan jika kamu ingin masukan yang jujur, kamu juga akan mendapatkannya.`:"th"===i?`สร้างอะไรเสร็จแล้วเหรอ? มาอวดกันเลย
คอมมูนิตี้ร่วมฉลองทุกผลงาน ไม่ว่าจะเล็กหรือใหญ่
และถ้าคุณอยากได้ฟีดแบ็กแบบตรงไปตรงมา คุณก็จะได้รับเช่นกัน`:"ko"===i?`무언가를 출시하셨나요? 마음껏 자랑하세요.
커뮤니티는 크든 작든 모든 결과물을 함께 축하해요.
솔직한 피드백을 원한다면, 그것도 받을 수 있어요.`:`何かをリリースしましたか？ぜひ見せてください。
コミュニティは大小問わずすべての成果を称えます。
そして率直なフィードバックが欲しいなら、それも得られます。`}],176019),e.s(["discordPage_most_card2_linkLabel",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i||"pt-BR"===i||"de"===i||"fr"===i||"es"===i||"it"===i||"hi"===i||"id"===i||"th"===i,"#lovable-built-showcase"}],218629)},348793,e=>{"use strict";var a=e.i(420459);e.s(["discordPage_most_card2_title",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Share wins":"pt-BR"===i?"Compartilhe conquistas":"de"===i?"Erfolge teilen":"fr"===i?"Partager ses réussites":"es"===i?"Comparte tus logros":"it"===i?"Condividi i tuoi successi":"hi"===i?"अपनी जीत साझा करें":"id"===i?"Bagikan pencapaian":"th"===i?"แชร์ความสำเร็จ":"ko"===i?"성과 공유하기":"成果を共有する"}])},293690,220187,e=>{"use strict";var a=e.i(420459);e.s(["discordPage_most_card3_description",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Live chats with the people building Lovable, every Tuesday and Thursday at 1pm ET. Ask anything, get real answers, and hear what's coming next. The CEO has been known to stop by.":"pt-BR"===i?"Bate-papos ao vivo com as pessoas que desenvolvem a Lovable, toda terça e quinta-feira às 13h (ET). Pergunte qualquer coisa, receba respostas reais e descubra o que vem por aí. O CEO também costuma aparecer por lá.":"de"===i?"Live-Chats mit den Menschen, die Lovable entwickeln, jeden Dienstag und Donnerstag um 13 Uhr ET. Frag alles, bekomme echte Antworten und erfahre, was als Nächstes kommt. Auch der CEO schaut bekanntlich mal vorbei.":"fr"===i?"Des discussions en direct avec les personnes qui développent Lovable, chaque mardi et jeudi à 13h (heure de l'Est). Posez toutes vos questions, obtenez de vraies réponses et découvrez ce qui arrive ensuite. Le PDG s'y invite parfois.":"es"===i?"Charlas en vivo con las personas que crean Lovable, todos los martes y jueves a la 1 p. m., hora del Este. Pregunta lo que quieras, obtén respuestas reales y entérate de lo que viene. El director ejecutivo ha pasado por ahí alguna vez.":"it"===i?"Chat dal vivo con le persone che creano Lovable, ogni martedì e giovedì alle 13:00 ET. Chiedi qualsiasi cosa, ricevi risposte concrete e scopri cosa arriverà. È capitato che anche il CEO facesse un salto.":"hi"===i?"Lovable बनाने वाली टीम के साथ हर मंगलवार और गुरुवार दोपहर 1 बजे ET पर लाइव बातचीत। कुछ भी पूछें, ठोस जवाब पाएं, और जानें कि आगे क्या आने वाला है। CEO भी कभी-कभी शामिल हो जाते हैं।":"id"===i?"Obrolan langsung dengan orang-orang di balik Lovable, setiap Selasa dan Kamis pukul 13.00 ET. Tanyakan apa saja, dapatkan jawaban nyata, dan dengar apa yang akan datang berikutnya. CEO pun dikenal sesekali mampir.":"th"===i?"พูดคุยสดกับทีมที่สร้าง Lovable ทุกวันอังคารและวันพฤหัสบดี เวลา 13:00 น. ET ถามได้ทุกเรื่อง รับคำตอบจริง และฟังว่ามีอะไรกำลังจะมา บางครั้งซีอีโอก็แวะมาด้วย":"ko"===i?"매주 화요일과 목요일 오후 1시(ET)에 Lovable을 만드는 사람들과 라이브 채팅을 나눠요. 무엇이든 물어보고, 진짜 답변을 듣고, 앞으로의 계획을 미리 확인하세요. CEO가 직접 들르기도 한답니다.":"Lovable を開発している人たちとのライブチャットを、毎週火曜と木曜の東部時間午後1時に開催。何でも質問して実践的な回答を得たり、今後の予定を聞いたりできます。CEO がふらりと立ち寄ることもあります。"}],293690),e.s(["discordPage_most_card3_linkLabel",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i||"pt-BR"===i||"de"===i||"fr"===i||"es"===i||"it"===i||"hi"===i||"id"===i||"th"===i,"Discord"}],220187)},465380,e=>{"use strict";var a=e.i(420459);e.s(["discordPage_most_card3_title",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Join weekly sessions":"pt-BR"===i?"Participe das sessões semanais":"de"===i?"An wöchentlichen Terminen teilnehmen":"fr"===i?"Participer aux sessions hebdomadaires":"es"===i?"Únete a las sesiones semanales":"it"===i?"Partecipa alle sessioni settimanali":"hi"===i?"साप्ताहिक सत्रों में शामिल हों":"id"===i?"Ikuti sesi mingguan":"th"===i?"เข้าร่วมเซสชันประจำสัปดาห์":"ko"===i?"주간 세션 참여하기":"毎週のセッションに参加"}])},875595,e=>{"use strict";var a=e.i(420459);e.s(["discordPage_most_cardLinkPrefix",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Join":"pt-BR"===i?"Participar":"de"===i?"Beitreten":"fr"===i?"Rejoindre":"es"===i?"Únete":"it"===i?"Unisciti":"hi"===i?"जुड़ें":"id"===i?"Gabung":"th"===i?"เข้าร่วม":"ko"===i?"참여하기":"参加"}])}]);

