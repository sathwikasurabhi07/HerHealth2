愛を込めて`};e.s(["communityEventsPage_testimonials_title",0,sZ],117419),e.i(117419);var sX=e.i(620849),s0=e.i(999790),s1=e.i(846614),s2=e.i(724910),s3=e.i(537071),s4=e.i(972271),s5=e.i(417580),s8=e.i(897471),s6=e.i(236850),s9=e.i(607412);let s7=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Apply here":"pt-BR"===t?"Inscreva-se aqui":"de"===t?"Hier bewerben":"fr"===t?"Postulez ici":"es"===t?"Postúlate aquí":"it"===t?"Candidati qui":"hi"===t?"यहाँ आवेदन करें":"id"===t?"Daftar di sini":"th"===t?"สมัครที่นี่":"ko"===t?"여기서 신청하기":"こちらから応募"};e.s(["communityPage_eventsMap_cta",0,s7],785366),e.i(785366);let le=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Join or host a Lovable community event near you":"pt-BR"===t?"Participe ou organize um evento da comunidade Lovable perto de você":"de"===t?"Nimm an einem Lovable-Community-Event in deiner Nähe teil oder veranstalte selbst eines":"fr"===t?"Rejoignez ou organisez un événement de la communauté Lovable près de chez vous":"es"===t?"Únete a un evento de la comunidad de Lovable cerca de ti u organiza uno":"it"===t?"Partecipa o organizza un evento della community Lovable vicino a te":"hi"===t?"अपने आस-पास किसी Lovable सामुदायिक कार्यक्रम में शामिल हों या उसे आयोजित करें":"id"===t?"Gabung atau selenggarakan acara komunitas Lovable di dekatmu":"th"===t?"เข้าร่วมหรือจัดงานอีเวนต์ชุมชน Lovable ใกล้คุณ":"ko"===t?"가까운 곳에서 열리는 Lovable 커뮤니티 이벤트에 참여하거나 직접 개최하세요":"近くのLovableコミュニティイベントに参加、または開催しよう"};e.s(["communityPage_eventsMap_title",0,le],50374),e.i(50374);let la=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?" — we're happy to help.":"pt-BR"===t?" — teremos prazer em ajudar.":"de"===t?" – wir helfen dir gerne weiter.":"fr"===t?" — nous serons ravis de vous aider.":"es"===t?" — estaremos encantados de ayudarte.":"it"===t?" — siamo felici di aiutarti.":"hi"===t?" — हमें मदद करके खुशी होगी।":"id"===t?" — kami dengan senang hati membantu.":"th"===t?" — เรายินดีช่วยเหลือ":"ko"===t?" — 기꺼이 도와드리겠습니다.":"までお気軽にお問い合わせください。"};e.s(["communityPage_faq10_answer_post",0,la],483568),e.i(483568);let lt=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Reach out at ":"pt-BR"===t?"Entre em contato pelo ":"de"===t?"Melde dich unter ":"fr"===t?"Contactez-nous à ":"es"===t?"Escríbenos a ":"it"===t?"Contattaci all'indirizzo ":"hi"===t?"संपर्क करें: ":"id"===t?"Hubungi kami di ":"th"===t?"ติดต่อเราได้ที่ ":"ko"===t?"문의는 ":"ご連絡は "};e.s(["communityPage_faq10_answer_pre",0,lt],326020),e.i(326020);let li=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"I have a question not listed here.":"pt-BR"===t?"Tenho uma dúvida que não está listada aqui.":"de"===t?"Ich habe eine Frage, die hier nicht aufgeführt ist.":"fr"===t?"J'ai une question qui ne figure pas ici.":"es"===t?"Tengo una pregunta que no aparece aquí.":"it"===t?"Ho una domanda che non è elencata qui.":"hi"===t?"मेरा एक सवाल है जो यहाँ सूचीबद्ध नहीं है।":"id"===t?"Saya punya pertanyaan yang tidak tercantum di sini.":"th"===t?"ฉันมีคำถามที่ไม่ได้อยู่ในรายการนี้":"ko"===t?"여기에 없는 질문이 있어요.":"ここに載っていない質問があります。"};e.s(["communityPage_faq10_question",0,li],414591),e.i(414591);let lo=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?" where 160K+ builders are active around the clock, or join IRL by attending a community event near you. Online is instant and always available. IRL events happen globally every week.":"pt-BR"===t?" onde mais de 160 mil criadores estão ativos 24 horas por dia, ou participe presencialmente comparecendo a um evento da comunidade perto de você. O online é instantâneo e está sempre disponível. Os eventos presenciais acontecem em todo o mundo toda semana.":"de"===t?", wo über 160.000 Macher:innen rund um die Uhr aktiv sind, oder komm vor Ort dazu, indem du ein Community-Event in deiner Nähe besuchst. Online ist sofort und jederzeit verfügbar. Veranstaltungen vor Ort finden jede Woche weltweit statt.":"fr"===t?" où plus de 160 000 créateurs sont actifs 24h/24, ou rejoignez-nous en personne en participant à un événement de la communauté près de chez vous. En ligne, c'est instantané et toujours disponible. Les événements en personne ont lieu partout dans le monde chaque semaine.":"es"===t?" donde más de 160K creadores están activos a todas horas, o únete en persona asistiendo a un evento de la comunidad cerca de ti. Unirse en línea es inmediato y siempre está disponible. Los eventos en persona se celebran en todo el mundo cada semana.":"it"===t?" dove oltre 160.000 creator sono attivi 24 ore su 24, oppure partecipa di persona a un evento della community vicino a te. La modalità online è immediata e sempre disponibile. Gli eventi di persona si svolgono in tutto il mondo ogni settimana.":"hi"===t?" जहाँ 160K+ निर्माता चौबीसों घंटे सक्रिय रहते हैं, या अपने आस-पास किसी सामुदायिक कार्यक्रम में शामिल होकर आमने-सामने जुड़ें। ऑनलाइन जुड़ना तुरंत और हमेशा उपलब्ध है। आमने-सामने कार्यक्रम हर हफ्ते दुनिया भर में होते हैं।":"id"===t?", tempat 160K+ builder aktif sepanjang waktu, atau bergabung secara langsung dengan menghadiri acara komunitas di dekatmu. Online tersedia secara instan dan kapan saja. Acara langsung berlangsung di seluruh dunia setiap minggu.":"th"===t?" ที่ซึ่งมีผู้สร้าง 160K+ คนใช้งานอยู่ตลอดเวลา หรือเข้าร่วมแบบเจอตัวจริงด้วยการไปงานอีเวนต์ชุมชนใกล้คุณ ช่องทางออนไลน์เข้าร่วมได้ทันทีและพร้อมเสมอ ส่วนอีเวนต์แบบเจอตัวจริงจัดขึ้นทั่วโลกทุกสัปดาห์":"ko"===t?"에서 16만 명 이상의 빌더들이 24시간 내내 활동하고 있습니다. 또는 가까운 곳의 커뮤니티 이벤트에 참석해 오프라인으로 참여하세요. 온라인은 즉시, 언제든지 이용할 수 있습니다. 오프라인 이벤트는 매주 전 세계에서 열립니다.":"では16万人以上のビルダーが24時間活動しています。また、近くのコミュニティイベントに参加すればリアルでもつながれます。オンラインなら今すぐ、いつでも参加可能。リアルイベントは毎週世界各地で開催されています。"};e.s(["communityPage_faq1_answer_post",0,lo],752965),e.i(752965);let ln=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Two ways in: join online through our ":"pt-BR"===t?"Duas formas de participar: entre online pela nossa ":"de"===t?"Du hast zwei Möglichkeiten: Tritt online über unsere ":"fr"===t?"Deux façons de participer : rejoignez-nous en ligne via notre ":"es"===t?"Dos formas de participar: únete en línea a través de nuestra ":"it"===t?"Due modi per entrare: partecipa online tramite la nostra ":"hi"===t?"जुड़ने के दो तरीके हैं: हमारे ":"id"===t?"Dua cara untuk bergabung: gabung online melalui ":"th"===t?"เข้าร่วมได้สองทาง: เข้าร่วมออนไลน์ผ่าน ":"ko"===t?"참여 방법은 두 가지입니다. 온라인으로는 ":"参加方法は2つ。オンラインで参加するには "};e.s(["communityPage_faq1_answer_pre",0,ln],266312),e.i(266312);let lr=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"How do I join the Lovable community?":"pt-BR"===t?"Como faço para entrar na comunidade da Lovable?":"de"===t?"Wie trete ich der Lovable Community bei?":"fr"===t?"Comment rejoindre la communauté Lovable ?":"es"===t?"¿Cómo me uno a la comunidad de Lovable?":"it"===t?"Come faccio a unirmi alla community di Lovable?":"hi"===t?"Lovable कम्युनिटी में कैसे शामिल हो सकता/सकती हूँ?":"id"===t?"Bagaimana cara bergabung dengan komunitas Lovable?":"th"===t?"ฉันจะเข้าร่วมชุมชน Lovable ได้อย่างไร":"ko"===t?"Lovable 커뮤니티에 어떻게 참여하나요?":"Lovableコミュニティに参加するにはどうすればよいですか？"};e.s(["communityPage_faq1_question",0,lr],734669),e.i(734669);let ls=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Not at all. The community includes people of all skill levels, from first-time builders to experienced developers. Many of our most active members started with zero coding experience.":"pt-BR"===t?"De jeito nenhum. A comunidade reúne pessoas de todos os níveis de experiência, desde quem está criando pela primeira vez até desenvolvedores experientes. Muitos dos nossos membros mais ativos começaram sem nenhuma experiência em programação.":"de"===t?"Überhaupt nicht. Die Community umfasst Menschen mit allen Kenntnisstufen, von Personen, die zum ersten Mal etwas bauen, bis hin zu erfahrenen Entwicklerinnen und Entwicklern. Viele unserer aktivsten Mitglieder haben ganz ohne Programmiererfahrung angefangen.":"fr"===t?"Pas du tout. La communauté rassemble des personnes de tous niveaux, des créateurs débutants aux développeurs expérimentés. Bon nombre de nos membres les plus actifs ont commencé sans aucune expérience en programmation.":"es"===t?"Para nada. La comunidad incluye a personas de todos los niveles, desde quienes crean por primera vez hasta desarrolladores con experiencia. Muchos de nuestros miembros más activos empezaron sin ninguna experiencia en programación.":"it"===t?"Niente affatto. La community include persone di ogni livello di competenza, dai creatori alle prime armi agli sviluppatori esperti. Molti dei nostri membri più attivi hanno iniziato senza alcuna esperienza di programmazione.":"hi"===t?"बिल्कुल नहीं। कम्युनिटी में हर स्किल लेवल के लोग हैं, पहली बार बिल्ड करने वालों से लेकर अनुभवी डेवलपर्स तक। हमारे कई सबसे सक्रिय मेंबर्स ने बिना किसी कोडिंग अनुभव के शुरुआत की थी।":"id"===t?"Sama sekali tidak. Komunitas ini terbuka untuk semua tingkat keahlian, mulai dari pembuat pemula hingga pengembang berpengalaman. Banyak anggota kami yang paling aktif memulai tanpa pengalaman pemrograman sama sekali.":"th"===t?"ไม่จำเป็นเลย ชุมชนของเราเปิดรับผู้คนทุกระดับทักษะ ตั้งแต่ผู้เริ่มสร้างครั้งแรกไปจนถึงนักพัฒนาที่มีประสบการณ์ สมาชิกที่กระตือรือร้นที่สุดของเราหลายคนเริ่มต้นโดยไม่มีประสบการณ์การเขียนโค้ดเลย":"ko"===t?"전혀 그렇지 않아요. 커뮤니티에는 처음 빌드를 시작하는 분부터 숙련된 개발자까지 모든 수준의 사람들이 함께합니다. 가장 활발하게 활동하는 회원 중 상당수가 코딩 경험이 전혀 없는 상태에서 시작했어요.":"まったく必要ありません。このコミュニティには、初めてのビルダーから経験豊富な開発者まで、あらゆるスキルレベルの方が参加しています。最もアクティブなメンバーの多くも、コーディング経験ゼロからスタートしました。"};e.s(["communityPage_faq2_answer",0,ls],356254),e.i(356254);let ll=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Do I need to be technical to get involved?":"pt-BR"===t?"Preciso ter conhecimento técnico para participar?":"de"===t?"Muss ich technisch versiert sein, um mitzumachen?":"fr"===t?"Faut-il avoir un profil technique pour participer ?":"es"===t?"¿Necesito tener conocimientos técnicos para participar?":"it"===t?"Devo avere competenze tecniche per partecipare?":"hi"===t?"क्या इसमें शामिल होने के लिए टेक्निकल होना ज़रूरी है?":"id"===t?"Apakah saya harus paham teknis untuk ikut serta?":"th"===t?"ฉันต้องมีความรู้ด้านเทคนิคถึงจะเข้าร่วมได้ไหม":"ko"===t?"참여하려면 기술 지식이 필요한가요?":"参加するには技術的な知識が必要ですか？"};e.s(["communityPage_faq2_question",0,ll],387775),e.i(387775);let lc=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Both are cohort-based programs. Ambassadors are for professionals and community builders in the broader tech ecosystem. Campus Leaders are for students who want to activate their university community. Apply to the one that fits where you are right now.":"pt-BR"===t?"Ambos são programas organizados em turmas. O programa de Embaixadores é voltado para profissionais e organizadores de comunidades no ecossistema de tecnologia em geral. Os Líderes de Campus são para estudantes que querem mobilizar a comunidade da sua universidade. Candidate-se ao que melhor se encaixa no seu momento atual.":"de"===t?"Beide sind kohortenbasierte Programme. Ambassadors richten sich an Fachleute und Menschen, die Communitys im breiteren Tech-Ökosystem aufbauen. Campus Leaders sind für Studierende, die ihre Hochschul-Community mobilisieren möchten. Bewirb dich für das Programm, das gerade am besten zu dir passt.":"fr"===t?"Les deux sont des programmes organisés par cohortes. Le programme Ambassadors s'adresse aux professionnels et aux animateurs de communauté de l'écosystème tech au sens large. Le programme Campus Leaders est destiné aux étudiants qui souhaitent dynamiser la communauté de leur université. Postulez à celui qui correspond le mieux à votre situation actuelle.":"es"===t?"Ambos son programas basados en cohortes. El programa Ambassadors está pensado para profesionales y promotores de comunidades del ecosistema tecnológico en general. Campus Leaders es para estudiantes que quieren dinamizar la comunidad de su universidad. Postúlate al que mejor se ajuste a tu situación actual.":"it"===t?"Entrambi sono programmi organizzati in coorti. Gli Ambassador sono pensati per professionisti e persone che animano community nell'ecosistema tecnologico più ampio. I Campus Leader sono per studenti che vogliono coinvolgere la community della propria università. Candidati al programma più adatto alla tua situazione attuale.":"hi"===t?"दोनों ही समूह-आधारित कार्यक्रम हैं। एम्बेसडर व्यापक टेक इकोसिस्टम के प्रोफेशनल्स और कम्युनिटी बिल्डर्स के लिए हैं। कैंपस लीडर्स उन छात्रों के लिए हैं जो अपनी यूनिवर्सिटी कम्युनिटी को सक्रिय करना चाहते हैं। जो आपकी मौजूदा स्थिति से मेल खाता हो, उसके लिए आवेदन करें।":"id"===t?"Keduanya adalah program berbasis kohort. Ambassador ditujukan untuk para profesional dan penggerak komunitas di ekosistem teknologi yang lebih luas. Campus Leader ditujukan untuk mahasiswa yang ingin menggerakkan komunitas kampus mereka. Daftarlah ke program yang paling sesuai dengan posisi Anda saat ini.":"th"===t?"ทั้งสองเป็นโปรแกรมแบบเป็นรุ่น Ambassador เหมาะสำหรับมืออาชีพและผู้สร้างชุมชนในแวดวงเทคโนโลยี ส่วน Campus Leader เหมาะสำหรับนักศึกษาที่ต้องการสร้างความคึกคักให้ชุมชนในมหาวิทยาลัยของตน สมัครโปรแกรมที่เหมาะกับคุณที่สุดในตอนนี้":"ko"===t?"둘 다 기수 기반 프로그램이에요. 앰배서더는 더 넓은 기술 생태계에 있는 전문가와 커뮤니티 빌더를 위한 프로그램이고, 캠퍼스 리더는 자신의 대학 커뮤니티를 활성화하고 싶은 학생을 위한 프로그램이에요. 지금 본인의 상황에 맞는 프로그램에 지원하세요.":"どちらもコホート制のプログラムです。アンバサダーは、より広いテックエコシステムで活動するプロフェッショナルやコミュニティビルダー向けです。キャンパスリーダーは、自分の大学コミュニティを盛り上げたい学生向けです。現在の状況に合う方にご応募ください。"};e.s(["communityPage_faq3_answer",0,lc],253354),e.i(253354);let lu=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"What's the difference between Ambassador and Campus Leader?":"pt-BR"===t?"Qual é a diferença entre Embaixador e Líder de Campus?":"de"===t?"Was ist der Unterschied zwischen Ambassador und Campus Leader?":"fr"===t?"Quelle est la différence entre Ambassador et Campus Leader ?":"es"===t?"¿Cuál es la diferencia entre Ambassador y Campus Leader?":"it"===t?"Qual è la differenza tra Ambassador e Campus Leader?":"hi"===t?"एम्बेसडर और कैंपस लीडर में क्या अंतर है?":"id"===t?"Apa perbedaan antara Ambassador dan Campus Leader?":"th"===t?"Ambassador กับ Campus Leader ต่างกันอย่างไร":"ko"===t?"앰배서더와 캠퍼스 리더의 차이는 무엇인가요?":"アンバサダーとキャンパスリーダーの違いは何ですか？"};e.s(["communityPage_faq3_question",0,lu],528117),e.i(528117);let ld=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Community Events page":"pt-BR"===t?"página de Eventos da Comunidade":"de"===t?"Community-Events-Seite":"fr"===t?"page Événements de la communauté":"es"===t?"página de Eventos de la comunidad":"it"===t?"pagina Eventi della community":"hi"===t?"कम्युनिटी इवेंट्स पेज":"id"===t?"halaman Acara Komunitas":"th"===t?"หน้ากิจกรรมชุมชน":"ko"===t?"커뮤니티 이벤트 페이지":"コミュニティイベントページ"};e.s(["communityPage_faq4_answer_link",0,ld],299191),e.i(299191);let lp=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?" to browse upcoming events near you or apply to host your own.":"pt-BR"===t?" para explorar os próximos eventos perto de você ou candidatar-se a organizar o seu próprio.":"de"===t?", um kommende Events in deiner Nähe zu finden oder dich dafür zu bewerben, selbst eines auszurichten.":"fr"===t?" pour parcourir les prochains événements près de chez vous ou postuler pour organiser le vôtre.":"es"===t?" para explorar próximos eventos cerca de ti o postularte para organizar el tuyo.":"it"===t?" per scoprire i prossimi eventi vicino a te o candidarti a ospitarne uno tuo.":"hi"===t?" पर जाकर अपने आस-पास के आने वाले इवेंट्स देखें या खुद का इवेंट होस्ट करने के लिए अप्लाई करें।":"id"===t?" untuk melihat acara mendatang di dekat Anda atau mendaftar untuk mengadakan acara sendiri.":"th"===t?" เพื่อค้นหากิจกรรมที่กำลังจะจัดขึ้นใกล้คุณ หรือสมัครเป็นผู้จัดกิจกรรมของคุณเอง":"ko"===t?"를 방문해 가까운 곳에서 열리는 이벤트를 둘러보거나 직접 이벤트를 주최해 보세요.":"で、お近くで開催予定のイベントを探したり、イベント主催に応募したりできます。"};e.s(["communityPage_faq4_answer_post",0,lp],225866),e.i(225866);let lm=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Head to our ":"pt-BR"===t?"Acesse nossa ":"de"===t?"Besuche unsere ":"fr"===t?"Rendez-vous sur notre ":"es"===t?"Visita nuestra ":"it"===t?"Vai alla nostra ":"hi"===t?"हमारे ":"id"===t?"Kunjungi ":"th"===t?"ไปที่":""};e.s(["communityPage_faq4_answer_pre",0,lm],45363),e.i(45363);let lg=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"How do I find or host a Lovable event?":"pt-BR"===t?"Como faço para encontrar ou organizar um evento da Lovable?":"de"===t?"Wie finde oder veranstalte ich ein Lovable-Event?":"fr"===t?"Comment trouver ou organiser un événement Lovable ?":"es"===t?"¿Cómo encuentro u organizo un evento de Lovable?":"it"===t?"Come faccio a trovare o ospitare un evento Lovable?":"hi"===t?"Lovable इवेंट कैसे खोजूँ या होस्ट करूँ?":"id"===t?"Bagaimana cara menemukan atau menjadi tuan rumah acara Lovable?":"th"===t?"ฉันจะค้นหาหรือจัดกิจกรรม Lovable ได้อย่างไร":"ko"===t?"Lovable 이벤트를 어떻게 찾거나 주최하나요?":"Lovableのイベントを見つけたり、開催したりするにはどうすればよいですか？"};e.s(["communityPage_faq4_question",0,lg],846321),e.i(846321);let lb=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"SheBuilds page":"pt-BR"===t?"página do SheBuilds":"de"===t?"SheBuilds-Seite":"fr"===t?"page SheBuilds":"es"===t?"página de SheBuilds":"it"===t?"pagina SheBuilds":"hi"===t?"SheBuilds पेज":"id"===t?"halaman SheBuilds":"th"===t?"หน้า SheBuilds":"ko"===t?"SheBuilds 페이지":"SheBuildsページ"};e.s(["communityPage_faq5_answer_link",0,lb],128153),e.i(128153);let lh=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"SheBuilds is a community initiative for women and she/her-identifying creators, running 48-hour buildathons throughout the year. Learn more on the ":"pt-BR"===t?"O SheBuilds é uma iniciativa da comunidade para mulheres e pessoas criadoras que se identificam no feminino, com maratonas de criação de 48 horas ao longo do ano. Saiba mais na ":"de"===t?"SheBuilds ist eine Community-Initiative für Frauen und Kreative mit sie/ihr-Pronomen, die das ganze Jahr über 48-stündige Buildathons veranstaltet. Erfahre mehr auf der ":"fr"===t?"SheBuilds est une initiative communautaire pour les femmes et les créatrices qui s'identifient au féminin. Elle organise des marathons de création de 48 heures tout au long de l'année. Pour en savoir plus, consultez la ":"es"===t?"SheBuilds es una iniciativa comunitaria para mujeres y creadoras que usan pronombres femeninos, con maratones de creación de 48 horas a lo largo del año. Más información en la ":"it"===t?"SheBuilds è un'iniziativa della community per donne e persone che si identificano al femminile e creano progetti, con maratone di creazione di 48 ore durante tutto l'anno. Scopri di più sulla ":"hi"===t?"SheBuilds महिलाओं और she/her पहचान रखने वाले क्रिएटर्स के लिए एक सामुदायिक पहल है, जिसके तहत साल भर 48 घंटे के बिल्डाथॉन होते हैं। इसके बारे में और जानने के लिए ":"id"===t?"SheBuilds adalah inisiatif komunitas untuk perempuan dan kreator yang mengidentifikasi diri dengan kata ganti she/her, dengan buildathon 48 jam yang diadakan sepanjang tahun. Pelajari selengkapnya di ":"th"===t?"SheBuilds คือโครงการชุมชนสำหรับผู้หญิงและครีเอเตอร์ที่นิยามตนเองว่าเป็นผู้หญิง โดยจัดกิจกรรมสร้างโปรเจกต์แบบมาราธอน 48 ชั่วโมงตลอดทั้งปี เรียนรู้เพิ่มเติมได้ที่":"ko"===t?"SheBuilds는 여성 및 여성으로 정체화하는 크리에이터를 위한 커뮤니티 활동으로, 연중 48시간 빌더톤을 열고 있어요. 자세한 내용은 ":"SheBuildsは、女性やshe/herの代名詞を使うクリエイターのためのコミュニティ活動で、年間を通じて48時間のビルドイベントを開催しています。詳しくは、"};e.s(["communityPage_faq5_answer_pre",0,lh],651370),e.i(651370);let lv=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"What is SheBuilds?":"pt-BR"===t?"O que é o SheBuilds?":"de"===t?"Was ist SheBuilds?":"fr"===t?"Qu'est-ce que SheBuilds ?":"es"===t?"¿Qué es SheBuilds?":"it"===t?"Cos'è SheBuilds?":"hi"===t?"SheBuilds क्या है?":"id"===t?"Apa itu SheBuilds?":"th"===t?"SheBuilds คืออะไร":"ko"===t?"SheBuilds란 무엇인가요?":"SheBuildsとは何ですか？"};e.s(["communityPage_faq5_question",0,lv],974529),e.i(974529);let l_=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"You should apply to the program that best fits you. You can always participate in the broader community (Discord, events, SheBuilds) alongside any program.":"pt-BR"===t?"Você deve se candidatar ao programa que melhor combina com você. É sempre possível participar da comunidade em geral (Discord, eventos, SheBuilds) junto com qualquer programa.":"de"===t?"Du solltest dich für das Programm bewerben, das am besten zu dir passt. Daneben kannst du jederzeit an der breiteren Community teilnehmen (Discord, Events, SheBuilds).":"fr"===t?"Vous devriez postuler au programme qui vous correspond le mieux. Vous pouvez toujours participer à la communauté au sens large (Discord, événements, SheBuilds) en parallèle de n'importe quel programme.":"es"===t?"Te recomendamos postular al programa que mejor se ajuste a ti. Siempre puedes participar en la comunidad en general (Discord, eventos, SheBuilds) junto con cualquier programa.":"it"===t?"Dovresti candidarti al programma più adatto a te. Puoi sempre partecipare alla community più ampia (Discord, eventi, SheBuilds) insieme a qualsiasi programma.":"hi"===t?"आपको उस प्रोग्राम के लिए अप्लाई करना चाहिए जो आपके लिए सबसे उपयुक्त हो। आप किसी भी प्रोग्राम के साथ-साथ व्यापक कम्युनिटी (Discord, इवेंट्स, SheBuilds) में हमेशा हिस्सा ले सकते हैं।":"id"===t?"Sebaiknya Anda mendaftar ke program yang paling sesuai dengan Anda. Anda selalu bisa ikut serta dalam komunitas yang lebih luas (Discord, acara, SheBuilds) bersamaan dengan program apa pun.":"th"===t?"คุณควรสมัครเข้าร่วมโปรแกรมที่เหมาะกับคุณมากที่สุด และคุณสามารถเข้าร่วมชุมชนในวงกว้างได้เสมอ (Discord กิจกรรมต่าง ๆ SheBuilds) ควบคู่ไปกับโปรแกรมใดก็ได้":"ko"===t?"본인에게 가장 잘 맞는 프로그램에 지원하세요. 어떤 프로그램에 참여하든 더 넓은 커뮤니티(Discord, 이벤트, SheBuilds)에 언제든 함께할 수 있어요.":"自分に最も合ったプログラムに応募してください。どのプログラムに参加していても、より広いコミュニティ（Discord、イベント、SheBuilds）にはいつでも参加できます。"};e.s(["communityPage_faq6_answer",0,l_],569757),e.i(569757);let lf=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Can I be part of multiple community programs?":"pt-BR"===t?"Posso participar de vários programas da comunidade?":"de"===t?"Kann ich an mehreren Community-Programmen teilnehmen?":"fr"===t?"Puis-je participer à plusieurs programmes communautaires ?":"es"===t?"¿Puedo formar parte de varios programas de la comunidad?":"it"===t?"Posso far parte di più programmi della community?":"hi"===t?"क्या मैं एक से ज़्यादा कम्युनिटी प्रोग्राम का हिस्सा बन सकता हूँ?":"id"===t?"Bisakah saya menjadi bagian dari beberapa program komunitas sekaligus?":"th"===t?"ฉันสามารถเข้าร่วมหลายโปรแกรมชุมชนพร้อมกันได้ไหม":"ko"===t?"여러 커뮤니티 프로그램에 동시에 참여할 수 있나요?":"複数のコミュニティプログラムに参加できますか？"};e.s(["communityPage_faq6_question",0,lf],802631),e.i(802631);let lk=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Very. Discord has 160K+ members across every timezone, events happen globally every week, and community programs run quarterly cohorts. There's always something going on.":"pt-BR"===t?"Muito ativa. O Discord tem mais de 160 mil membros em todos os fusos horários, há eventos pelo mundo todo toda semana e os programas da comunidade têm turmas trimestrais. Sempre tem algo acontecendo.":"de"===t?"Sehr. Discord hat über 160.000 Mitglieder in allen Zeitzonen, Events finden wöchentlich weltweit statt, und Community-Programme laufen in vierteljährlichen Kohorten. Es ist immer etwas los.":"fr"===t?"Très active. Discord compte plus de 160 000 membres répartis sur tous les fuseaux horaires, des événements ont lieu partout dans le monde chaque semaine et les programmes communautaires proposent des cohortes trimestrielles. Il se passe toujours quelque chose.":"es"===t?"Muy activa. Discord tiene más de 160K miembros en todas las zonas horarias, los eventos ocurren cada semana en todo el mundo y los programas de la comunidad tienen cohortes trimestrales. Siempre hay algo en marcha.":"it"===t?"Molto attiva. Discord conta oltre 160.000 membri in tutti i fusi orari, ogni settimana si svolgono eventi in tutto il mondo e i programmi della community si organizzano in cicli trimestrali. C'è sempre qualcosa in corso.":"hi"===t?"बहुत ज़्यादा। Discord में हर टाइमज़ोन के 160K+ मेंबर्स हैं, इवेंट्स हर हफ़्ते दुनिया भर में होते हैं, और कम्युनिटी प्रोग्राम हर तिमाही नए कोहोर्ट चलाते हैं। हमेशा कुछ न कुछ चलता रहता है।":"id"===t?"Sangat aktif. Discord memiliki 160K+ anggota dari berbagai zona waktu, acara berlangsung secara global setiap minggu, dan program komunitas menjalankan kohort setiap kuartal. Selalu ada kegiatan.":"th"===t?"กระตือรือร้นมาก Discord มีสมาชิกกว่า 160,000 คนจากทุกเขตเวลา มีกิจกรรมเกิดขึ้นทั่วโลกทุกสัปดาห์ และโปรแกรมชุมชนเปิดรุ่นใหม่ทุกไตรมาส มีอะไรเกิดขึ้นอยู่ตลอดเวลา":"ko"===t?"매우 활발해요. Discord에는 모든 시간대에 걸쳐 16만 명 이상의 회원이 있고, 전 세계에서 매주 이벤트가 열리며, 커뮤니티 프로그램은 분기별 기수로 운영됩니다. 언제나 무언가가 일어나고 있어요.":"とても活発です。Discordにはあらゆるタイムゾーンにまたがって16万人以上のメンバーが在籍し、イベントは毎週世界中で開催され、コミュニティプログラムは四半期ごとのコホートで運営されています。常に何かが行われています。"};e.s(["communityPage_faq7_answer",0,lk],79590),e.i(79590);let lL=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"How active is the community?":"pt-BR"===t?"A comunidade é muito ativa?":"de"===t?"Wie aktiv ist die Community?":"fr"===t?"À quel point la communauté est-elle active ?":"es"===t?"¿Qué tan activa es la comunidad?":"it"===t?"Quanto è attiva la community?":"hi"===t?"कम्युनिटी कितनी सक्रिय है?":"id"===t?"Seberapa aktif komunitasnya?":"th"===t?"ชุมชนนี้กระตือรือร้นแค่ไหน":"ko"===t?"커뮤니티는 얼마나 활발한가요?":"コミュニティはどのくらい活発ですか？"};e.s(["communityPage_faq7_question",0,lL],968629),e.i(968629);let lP=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Most Discord channels and resources are in English, but community events happen in local languages around the world. Many ambassadors and campus leaders run events in their native language.":"pt-BR"===t?"A maioria dos canais e recursos no Discord está em inglês, mas os eventos da comunidade acontecem em idiomas locais pelo mundo todo. Muitos embaixadores e líderes de campus organizam eventos no próprio idioma.":"de"===t?"Die meisten Discord-Kanäle und Ressourcen sind auf Englisch, aber Community-Events finden weltweit in den jeweiligen Landessprachen statt. Viele Ambassadors und Campus Leaders veranstalten Events in ihrer Muttersprache.":"fr"===t?"La plupart des salons Discord et des ressources sont en anglais, mais les événements communautaires se déroulent dans les langues locales partout dans le monde. De nombreux ambassadeurs et responsables de campus organisent des événements dans leur langue maternelle.":"es"===t?"La mayoría de los canales y recursos de Discord están en inglés, pero los eventos de la comunidad se realizan en idiomas locales en todo el mundo. Muchos embajadores y líderes universitarios organizan eventos en su idioma nativo.":"it"===t?"La maggior parte dei canali Discord e delle risorse è in inglese, ma gli eventi della community si svolgono nelle lingue locali in tutto il mondo. Molti ambassador e leader universitari organizzano eventi nella propria lingua madre.":"hi"===t?"ज़्यादातर Discord चैनल और रिसोर्सेज़ अंग्रेज़ी में हैं, लेकिन कम्युनिटी इवेंट्स दुनिया भर में स्थानीय भाषाओं में होते हैं। कई एम्बेसडर और कैंपस लीडर अपनी मातृभाषा में इवेंट्स चलाते हैं।":"id"===t?"Sebagian besar kanal dan sumber daya di Discord menggunakan bahasa Inggris, tetapi acara komunitas berlangsung dalam bahasa lokal di seluruh dunia. Banyak Ambassador dan Campus Leader menyelenggarakan acara dalam bahasa asli mereka.":"th"===t?"ช่อง Discord และแหล่งข้อมูลส่วนใหญ่เป็นภาษาอังกฤษ แต่กิจกรรมชุมชนจัดขึ้นในภาษาท้องถิ่นทั่วโลก Ambassador และ Campus Leader หลายคนจัดกิจกรรมในภาษาแม่ของตน":"ko"===t?"대부분의 Discord 채널과 자료는 영어로 되어 있지만, 커뮤니티 이벤트는 전 세계 각지에서 현지 언어로 진행됩니다. 많은 앰배서더와 캠퍼스 리더가 자신의 모국어로 이벤트를 운영하고 있어요.":"ほとんどのDiscordチャンネルやリソースは英語ですが、コミュニティイベントは世界各地でその土地の言語で開催されています。多くのアンバサダーやキャンパスリーダーが、母国語でイベントを運営しています。"};e.s(["communityPage_faq8_answer",0,lP],418125),e.i(418125);let ly=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Do I need to speak English to participate?":"pt-BR"===t?"Preciso falar inglês para participar?":"de"===t?"Muss ich Englisch sprechen, um teilzunehmen?":"fr"===t?"Faut-il parler anglais pour participer ?":"es"===t?"¿Necesito hablar inglés para participar?":"it"===t?"Devo parlare inglese per partecipare?":"hi"===t?"क्या हिस्सा लेने के लिए अंग्रेज़ी बोलना ज़रूरी है?":"id"===t?"Apakah saya harus bisa berbahasa Inggris untuk ikut serta?":"th"===t?"ฉันต้องพูดภาษาอังกฤษได้ถึงจะเข้าร่วมได้ไหม":"ko"===t?"참여하려면 영어를 할 줄 알아야 하나요?":"参加するには英語が話せる必要がありますか？"};e.s(["communityPage_faq8_question",0,ly],539984),e.i(539984);let lS=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Nothing. Discord is free, events are free, program applications are free, and SheBuilds buildathons are free to join.":"pt-BR"===t?"Nada. O Discord é gratuito, os eventos são gratuitos, as candidaturas aos programas são gratuitas e a participação nas maratonas de criação do SheBuilds também é gratuita.":"de"===t?"Nichts. Discord ist kostenlos, Events sind kostenlos, Programmbewerbungen sind kostenlos und die Teilnahme an SheBuilds-Buildathons ist kostenlos.":"fr"===t?"Rien. Discord est gratuit, les événements sont gratuits, les candidatures aux programmes sont gratuites et la participation aux marathons de création SheBuilds est gratuite.":"es"===t?"Nada. Discord es gratis, los eventos son gratis, las postulaciones a los programas son gratis y unirse a los maratones de creación de SheBuilds también es gratis.":"it"===t?"Niente. Discord è gratuito, gli eventi sono gratuiti, le candidature ai programmi sono gratuite e le maratone di creazione di SheBuilds sono gratuite.":"hi"===t?"कोई शुल्क नहीं। Discord मुफ़्त है, इवेंट्स मुफ़्त हैं, प्रोग्राम आवेदन मुफ़्त हैं, और SheBuilds बिल्डाथॉन में शामिल होना भी मुफ़्त है।":"id"===t?"Tidak ada biaya. Discord gratis, acara gratis, pendaftaran program gratis, dan buildathon SheBuilds gratis untuk diikuti.":"th"===t?"ไม่มีค่าใช้จ่ายใด ๆ Discord ฟรี กิจกรรมฟรี การสมัครเข้าร่วมโปรแกรมฟรี และการเข้าร่วมกิจกรรมสร้างโปรเจกต์แบบมาราธอนของ SheBuilds ก็ฟรีเช่นกัน":"ko"===t?"아무 비용도 들지 않아요. Discord도 무료, 이벤트도 무료, 프로그램 지원도 무료이며, SheBuilds 빌더톤도 무료로 참여할 수 있어요.":"何もかかりません。Discordは無料、イベントも無料、プログラムへの応募も無料、SheBuildsのビルドイベントも無料で参加できます。"};e.s(["communityPage_faq9_answer",0,lS],488815),e.i(488815);let lw=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"What does it cost?":"pt-BR"===t?"Quanto custa?":"de"===t?"Was kostet das?":"fr"===t?"Combien ça coûte ?":"es"===t?"¿Cuánto cuesta?":"it"===t?"Quanto costa?":"hi"===t?"इसकी लागत कितनी है?":"id"===t?"Berapa biayanya?":"th"===t?"มีค่าใช้จ่ายเท่าไหร่":"ko"===t?"비용은 얼마인가요?":"費用はどのくらいかかりますか？"};e.s(["communityPage_faq9_question",0,lw],260310),e.i(260310);let lz=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Frequently asked questions":"pt-BR"===t?"Perguntas frequentes":"de"===t?"Häufig gestellte Fragen":"fr"===t?"Questions fréquentes":"es"===t?"Preguntas frecuentes":"it"===t?"Domande frequenti":"hi"===t?"अक्सर पूछे जाने वाले सवाल":"id"===t?"Pertanyaan yang sering diajukan":"th"===t?"คำถามที่พบบ่อย":"ko"===t?"자주 묻는 질문":"よくある質問"};e.s(["communityPage_faq_title",0,lz],217753),e.i(217753);var lA=e.i(628637),lq=e.i(575711),lx=e.i(329841),lC=e.i(762439),lB=e.i(553791),lR=e.i(73951),lT=e.i(76318),lI=e.i(367993),lj=e.i(404167),lD=e.i(642016),lE=e.i(246180),lM=e.i(800582),lG=e.i(56260),lO=e.i(219338),lN=e.i(966492),lF=e.i(754069),lH=e.i(812499),lW=e.i(470834),lU=e.i(793973);let lV=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Join the Lovable community of founders, creators, and builders. Connect, collaborate, and get support while building products with AI.":"pt-BR"===t?"Junte-se à comunidade Lovable de fundadores, criadores e desenvolvedores. Conecte-se, colabore e receba suporte enquanto cria produtos com IA.":"de"===t?"Werde Teil der Lovable Community aus Gründer:innen, Kreativen und Macher:innen. Vernetze dich, arbeite zusammen und erhalte Unterstützung, während du mit KI Produkte entwickelst.":"fr"===t?"Rejoignez la communauté Lovable de fondateurs, de créateurs et de développeurs. Connectez-vous, collaborez et obtenez de l'aide pendant que vous créez des produits avec l'IA.":"es"===t?"Únete a la comunidad de Lovable formada por fundadores, creadores y desarrolladores. Conecta, colabora y recibe apoyo mientras creas productos con IA.":"it"===t?"Unisciti alla comunità Lovable di fondatori, creativi e persone che costruiscono prodotti. Connettiti, collabora e ricevi supporto mentre crei prodotti con l'AI.":"hi"===t?"Lovable के संस्थापकों, रचनाकारों और निर्माताओं के समुदाय से जुड़ें। AI के साथ उत्पाद बनाते हुए लोगों से जुड़ें, सहयोग करें और सहायता पाएं।":"id"===t?"Bergabunglah dengan komunitas Lovable yang berisi para pendiri, kreator, dan pembuat. Jalin koneksi, berkolaborasi, dan dapatkan dukungan sambil membangun produk dengan AI.":"th"===t?"เข้าร่วมชุมชน Lovable ของผู้ก่อตั้ง ครีเอเตอร์ และนักสร้างสรรค์ เชื่อมต่อ ทำงานร่วมกัน และรับการสนับสนุนในขณะที่สร้างผลิตภัณฑ์ด้วย AI":"ko"===t?"창업자, 크리에이터, 빌더가 모인 Lovable 커뮤니티에 참여하세요. AI로 제품을 만들며 소통하고, 협업하고, 도움을 받을 수 있어요.":"創業者、クリエイター、ビルダーが集まるLovableコミュニティに参加しましょう。AIでプロダクトを作りながら、つながり、協力し、サポートを得られます。"};e.s(["communityPage_meta_description",0,lV],793159),e.i(793159);let lK=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Join the Lovable Community | Lovable Discord or Browse Events":"pt-BR"===t?"Junte-se à comunidade Lovable | Discord da Lovable ou explore eventos":"de"===t?"Werde Teil der Lovable Community | Lovable Discord oder Events entdecken":"fr"===t?"Rejoignez la communauté Lovable | Le Discord de Lovable ou les événements à venir":"es"===t?"Únete a la comunidad de Lovable | Discord de Lovable o explora eventos":"it"===t?"Unisciti alla comunità Lovable | Discord di Lovable o esplora gli eventi":"hi"===t?"Lovable समुदाय से जुड़ें | Lovable Discord या कार्यक्रम देखें":"id"===t?"Bergabung dengan Komunitas Lovable | Discord Lovable atau Jelajahi Acara":"th"===t?"เข้าร่วมชุมชน Lovable | Discord ของ Lovable หรือเลือกดูกิจกรรม":"ko"===t?"Lovable 커뮤니티 참여하기 | Lovable Discord 또는 이벤트 둘러보기":"Lovableコミュニティに参加 | LovableのDiscordやイベントを見る"};e.s(["communityPage_meta_title",0,lK],296159),e.i(296159);let l$=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Explore partnerships":"pt-BR"===t?"Explorar parcerias":"de"===t?"Partnerschaften entdecken":"fr"===t?"Découvrir les partenariats":"es"===t?"Explorar colaboraciones":"it"===t?"Esplora le partnership":"hi"===t?"साझेदारी के विकल्प देखें":"id"===t?"Jelajahi kemitraan":"th"===t?"สำรวจความร่วมมือ":"ko"===t?"파트너십 살펴보기":"パートナーシップを詳しく見る"};e.s(["communityPage_partner_cta",0,l$],407349),e.i(407349);let lQ=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Partnerships are for organizations who want to formally collaborate with Lovable: educators, incubators, content creators, and teams exploring product integrations. If you're building content, teaching others, running a course or accelerator, or exploring how Lovable fits into your ecosystem, reach out to our Partnerships team.":"pt-BR"===t?"As parcerias são para organizações que querem colaborar formalmente com a Lovable: educadores, incubadoras, criadores de conteúdo e equipes que exploram integrações de produtos. Se você cria conteúdo, ensina outras pessoas, conduz um curso ou aceleradora, ou está explorando como a Lovable se encaixa no seu ecossistema, fale com nossa equipe de Parcerias.":"de"===t?"Partnerschaften richten sich an Organisationen, die offiziell mit Lovable zusammenarbeiten möchten: Bildungseinrichtungen, Inkubatoren, Inhaltsersteller:innen und Teams, die Produktintegrationen erkunden. Wenn du Inhalte erstellst, andere unterrichtest, einen Kurs oder ein Accelerator-Programm leitest oder erkunden möchtest, wie Lovable in dein Ökosystem passt, wende dich an unser Partnerschaftsteam.":"fr"===t?"Les partenariats s'adressent aux organisations qui souhaitent collaborer officiellement avec Lovable : enseignants, incubateurs, créateurs de contenu et équipes explorant des intégrations de produits. Si vous créez du contenu, formez les autres, animez un cours ou un accélérateur, ou explorez la façon dont Lovable s'intègre à votre écosystème, contactez notre équipe Partenariats.":"es"===t?"Las colaboraciones están dirigidas a organizaciones que quieren trabajar formalmente con Lovable: educadores, incubadoras, creadores de contenido y equipos que exploran integraciones de producto. Si creas contenido, enseñas a otras personas, impartes un curso o diriges una aceleradora, o estás explorando cómo encaja Lovable en tu ecosistema, ponte en contacto con nuestro equipo de colaboraciones.":"it"===t?"Le partnership sono pensate per le organizzazioni che vogliono collaborare formalmente con Lovable: educatori, incubatori, creatori di contenuti e team che valutano integrazioni con i propri prodotti. Se crei contenuti, insegni ad altri, gestisci un corso o un acceleratore oppure stai valutando come Lovable si inserisce nel tuo ecosistema, contatta il nostro team delle partnership.":"hi"===t?"साझेदारियां उन संगठनों के लिए हैं जो Lovable के साथ औपचारिक रूप से सहयोग करना चाहते हैं: शिक्षक, इनक्यूबेटर, सामग्री बनाने वाले लोग और उत्पाद एकीकरण तलाशने वाली टीमें। अगर आप सामग्री बना रहे हैं, दूसरों को सिखा रहे हैं, कोई पाठ्यक्रम या एक्सेलरेटर चला रहे हैं, या यह समझना चाहते हैं कि Lovable आपके परिवेश में कैसे काम आ सकता है, तो हमारी साझेदारी टीम से संपर्क करें।":"id"===t?"Kemitraan ditujukan bagi organisasi yang ingin berkolaborasi secara resmi dengan Lovable: pendidik, inkubator, kreator konten, dan tim yang menjajaki integrasi produk. Jika Anda membuat konten, mengajar orang lain, menjalankan kursus atau akselerator, atau menjajaki bagaimana Lovable cocok dengan ekosistem Anda, hubungi tim Kemitraan kami.":"th"===t?"ความร่วมมือนี้สำหรับองค์กรที่ต้องการร่วมงานกับ Lovable อย่างเป็นทางการ ไม่ว่าจะเป็นนักการศึกษา ผู้บ่มเพาะธุรกิจ ครีเอเตอร์คอนเทนต์ และทีมที่กำลังสำรวจการผสานรวมผลิตภัณฑ์ หากคุณกำลังสร้างคอนเทนต์ สอนผู้อื่น จัดคอร์สหรือโครงการเร่งการเติบโต หรือสำรวจว่า Lovable เข้ากับระบบนิเวศของคุณได้อย่างไร ติดต่อทีมความร่วมมือของเราได้เลย":"ko"===t?"파트너십은 Lovable과 공식적으로 협업하고자 하는 조직을 위한 프로그램이에요. 교육자, 인큐베이터, 콘텐츠 크리에이터, 제품 연동을 모색하는 팀이 대상이에요. 콘텐츠를 만들거나, 다른 사람을 가르치거나, 강좌나 액셀러레이터를 운영하거나, Lovable이 여러분의 생태계에 어떻게 어울릴지 고민하고 있다면 파트너십 팀에 연락해 주세요.":"パートナーシップは、Lovableと正式に協力したい組織のためのものです。教育者、インキュベーター、コンテンツクリエイター、プロダクト連携を検討しているチームなどが対象です。コンテンツを制作している方、他の人に教えている方、コースやアクセラレーターを運営している方、またはLovableをご自身のエコシステムにどう組み込めるか検討している方は、ぜひパートナーシップチームにご連絡ください。"};e.s(["communityPage_partner_subtitle",0,lQ],60284),e.i(60284);let lY=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Partner with Lovable":"pt-BR"===t?"Seja parceiro da Lovable":"de"===t?"Werde Partner von Lovable":"fr"===t?"Devenez partenaire de Lovable":"es"===t?"Colabora con Lovable":"it"===t?"Diventa partner di Lovable":"hi"===t?"Lovable के साथ साझेदारी करें":"id"===t?"Bermitra dengan Lovable":"th"===t?"ร่วมเป็นพาร์ทเนอร์กับ Lovable":"ko"===t?"Lovable과 파트너 되기":"Lovableとパートナーになる"};e.s(["communityPage_partner_title",0,lY],72613),e.i(72613);var lJ=e.i(319913),lZ=e.i(389013),lX=e.i(494998),l0=e.i(916055),l1=e.i(832356),l2=e.i(998632),l3=e.i(82639),l4=e.i(232742);let l5=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Countries with Ambassadors":"pt-BR"===t?"Países com embaixadores":"de"===t?"Länder mit Botschafter:innen":"fr"===t?"Pays avec des ambassadeurs":"es"===t?"Países con embajadores":"it"===t?"Paesi con ambasciatori":"hi"===t?"राजदूतों वाले देश":"id"===t?"Negara dengan Duta":"th"===t?"ประเทศที่มีแอมบาสเดอร์":"ko"===t?"앰배서더가 있는 국가":"アンバサダーがいる国"};e.s(["communityPage_stats_countries",0,l5],186886),e.i(186886);let l8=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Discord members":"pt-BR"===t?"Membros no Discord":"de"===t?"Discord-Mitglieder":"fr"===t?"Membres Discord":"es"===t?"Miembros de Discord":"it"===t?"Membri su Discord":"hi"===t?"Discord सदस्य":"id"===t?"Anggota Discord":"th"===t?"สมาชิก Discord":"ko"===t?"Discord 멤버":"Discordメンバー"};e.s(["communityPage_stats_discord",0,l8],668856),e.i(668856);let l6=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Events hosted globally":"pt-BR"===t?"Eventos realizados globalmente":"de"===t?"Weltweit veranstaltete Events":"fr"===t?"Événements organisés dans le monde entier":"es"===t?"Eventos celebrados en todo el mundo":"it"===t?"Eventi ospitati in tutto il mondo":"hi"===t?"दुनिया भर में आयोजित कार्यक्रम":"id"===t?"Acara yang diselenggarakan secara global":"th"===t?"กิจกรรมที่จัดขึ้นทั่วโลก":"ko"===t?"전 세계에서 열린 이벤트":"世界各地で開催されたイベント"};e.s(["communityPage_stats_events",0,l6],195410),e.i(195410);let l9=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Hackathons, buildathons, workshops.":"pt-BR"===t?"Hackathons, maratonas de criação, workshops.":"de"===t?"Hackathons, Buildathons, Workshops.":"fr"===t?"Hackathons, marathons de création, ateliers.":"es"===t?"Hackatones, maratones de creación, talleres.":"it"===t?"Hackathon, maratone di creazione, workshop.":"hi"===t?"हैकाथॉन, निर्माण कार्यक्रम और कार्यशालाएं।":"id"===t?"Hackathon, buildathon, dan lokakarya.":"th"===t?"แฮกกาธอน กิจกรรมสร้างผลงานแบบมาราธอน และเวิร์กช็อป":"ko"===t?"해커톤, 빌더톤, 워크숍.":"ハッカソン、ビルドイベント、ワークショップ。"};e.s(["communityPage_stats_eventsTagline1",0,l9],926241),e.i(926241);let l7=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Every event looks different, but they all share the same energy: a room full of people shipping something real. Every event is organized and hosted by community members, with support from Lovable.":"pt-BR"===t?"Cada evento é diferente, mas todos compartilham a mesma energia: uma sala cheia de pessoas lançando algo real. Cada evento é organizado e realizado por membros da comunidade, com o apoio da Lovable.":"de"===t?"Jedes Event ist anders, aber sie alle teilen dieselbe Energie: ein Raum voller Menschen, die etwas Echtes auf die Beine stellen. Jedes Event wird von Community-Mitgliedern organisiert und ausgerichtet, mit Unterstützung von Lovable.":"fr"===t?"Chaque événement est différent, mais ils partagent tous la même énergie : une salle remplie de personnes qui concrétisent quelque chose de réel. Chaque événement est organisé et animé par des membres de la communauté, avec le soutien de Lovable.":"es"===t?"Cada evento es distinto, pero todos comparten la misma energía: una sala llena de gente lanzando algo real. Cada evento está organizado y dirigido por miembros de la comunidad, con el apoyo de Lovable.":"it"===t?"Ogni evento è diverso, ma tutti condividono la stessa energia: una stanza piena di persone che lanciano qualcosa di concreto. Ogni evento è organizzato e ospitato dai membri della comunità, con il supporto di Lovable.":"hi"===t?"हर कार्यक्रम अलग होता है, लेकिन सभी में वही ऊर्जा होती है: ऐसे लोग जो मिलकर कुछ वास्तविक बना रहे हों। हर कार्यक्रम समुदाय के सदस्य Lovable के सहयोग से आयोजित करते हैं।":"id"===t?"Setiap acara terlihat berbeda, tetapi semuanya memiliki energi yang sama: ruangan penuh orang yang mewujudkan sesuatu yang nyata. Setiap acara diorganisasi dan diselenggarakan oleh anggota komunitas, dengan dukungan dari Lovable.":"th"===t?"ทุกกิจกรรมแตกต่างกันไป แต่ทั้งหมดมีพลังแบบเดียวกัน นั่นคือห้องที่เต็มไปด้วยผู้คนที่กำลังสร้างผลงานจริง ทุกกิจกรรมจัดและดำเนินการโดยสมาชิกในชุมชน พร้อมการสนับสนุนจาก Lovable":"ko"===t?"모든 이벤트는 저마다 다르지만, 모두 같은 에너지를 공유해요. 바로 실제 제품을 만들어 내는 사람들로 가득 찬 공간이죠. 모든 이벤트는 Lovable의 지원을 받아 커뮤니티 멤버들이 직접 기획하고 진행해요.":"イベントの形はそれぞれ異なりますが、どれも同じエネルギーにあふれています。本物のプロダクトを生み出そうとする人々で満ちた空間です。すべてのイベントは、Lovableのサポートのもと、コミュニティメンバーによって企画・開催されています。"};e.s(["communityPage_stats_eventsTagline2",0,l7],274424),e.i(274424);let ce=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Community leaders":"pt-BR"===t?"Líderes da comunidade":"de"===t?"Community-Leiter:innen":"fr"===t?"Responsables de la communauté":"es"===t?"Líderes de la comunidad":"it"===t?"Responsabili della comunità":"hi"===t?"समुदाय के अगुआ":"id"===t?"Pemimpin komunitas":"th"===t?"ผู้นำชุมชน":"ko"===t?"커뮤니티 리더":"コミュニティリーダー"};e.s(["communityPage_stats_leaders",0,ce],504684),e.i(504684);let ca=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Real builders, real community, real impact":"pt-BR"===t?"Criadores reais, comunidade real, impacto real":"de"===t?"Echte Macher:innen, echte Community, echte Wirkung":"fr"===t?"De vrais créateurs, une vraie communauté, un vrai impact":"es"===t?"Creadores reales, comunidad real, impacto real":"it"===t?"Creatori reali, una comunità reale, un impatto reale":"hi"===t?"असली निर्माता, असली समुदाय, असली प्रभाव":"id"===t?"Pembuat nyata, komunitas nyata, dampak nyata":"th"===t?"นักสร้างสรรค์ตัวจริง ชุมชนตัวจริง ผลลัพธ์ที่จับต้องได้จริง":"ko"===t?"실제 제품을 만드는 사람들, 살아 있는 커뮤니티, 확실한 영향력":"本物のビルダー、本物のコミュニティ、本物のインパクト"};e.s(["communityPage_testimonials_title",0,ca],161219),e.i(161219);var ct=e.i(154145);let ci=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Power your app with connectors":"pt-BR"===t?"Turbine seu aplicativo com conectores":"de"===t?"Erweitere deine App mit Konnektoren":"fr"===t?"Boostez votre application avec des connecteurs":"es"===t?"Potencia tu aplicación con conectores":"it"===t?"Potenzia la tua app con i connettori":"hi"===t?"कनेक्टरों की मदद से अपने ऐप को शक्तिशाली बनाएँ":"id"===t?"Optimalkan aplikasi Anda dengan konektor":"th"===t?"เพิ่มพลังให้แอปของคุณด้วยตัวเชื่อมต่อ":"ko"===t?"커넥터로 앱의 기능을 확장하세요":"コネクタを使ってアプリを強化しましょう"};e.s(["connectorsBanner_title",0,ci],842280),e.i(842280);let co=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Find the right connector for your workflow.":"pt-BR"===t?"Encontre o conector certo para o seu fluxo de trabalho.":"de"===t?"Finde den passenden Konnektor für deinen Workflow.":"fr"===t?"Trouvez le connecteur adapté à votre flux de travail.":"es"===t?"Encuentra el conector adecuado para tu flujo de trabajo.":"it"===t?"Trova il connettore giusto per il tuo flusso di lavoro.":"hi"===t?"अपने वर्कफ़्लो के लिए सही कनेक्टर खोजें।":"id"===t?"Temukan konektor yang tepat untuk alur kerja Anda.":"th"===t?"ค้นหาตัวเชื่อมต่อที่เหมาะกับเวิร์กโฟลว์ของคุณ":"ko"===t?"워크플로에 맞는 커넥터를 찾아보세요.":"ワークフローに最適なコネクタを見つけましょう。"};e.s(["connectorsPage_allConnectors_subtitle",0,co],162601),e.i(162601);let cn=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Explore all connectors":"pt-BR"===t?"Explore todos os conectores":"de"===t?"Alle Konnektoren entdecken":"fr"===t?"Explorer tous les connecteurs":"es"===t?"Explora todos los conectores":"it"===t?"Esplora tutti i connettori":"hi"===t?"सभी कनेक्टर देखें":"id"===t?"Jelajahi semua konektor":"th"===t?"สำรวจตัวเชื่อมต่อทั้งหมด":"ko"===t?"모든 커넥터 살펴보기":"すべてのコネクタを見る"};e.s(["connectorsPage_allConnectors_title",0,cn],378),e.i(378);let cr=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Connect your own MCP":"pt-BR"===t?"Conecte seu próprio MCP":"de"===t?"Eigenen MCP verbinden":"fr"===t?"Connectez votre propre MCP":"es"===t?"Conecta tu propio MCP":"it"===t?"Collega il tuo MCP":"hi"===t?"अपना MCP जोड़ें":"id"===t?"Hubungkan MCP Anda sendiri":"th"===t?"เชื่อมต่อ MCP ของคุณเอง":"ko"===t?"나만의 MCP 연결하기":"独自のMCPを接続する"};e.s(["connectorsPage_cards_card1_cta",0,cr],721739),e.i(721739);let cs=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"You're not limited to our connector list. Add any service through the integrations hub. Configure once and use across every app you build. New connectors ship every week, but you never have to wait for one.":"pt-BR"===t?"Você não está limitado à nossa lista de conectores. Adicione qualquer serviço pela central de integrações. Configure uma vez e use em todos os aplicativos que você criar. Novos conectores são lançados toda semana, mas você nunca precisa esperar por um.":"de"===t?"Du bist nicht auf unsere Konnektorenliste beschränkt. Füge jeden beliebigen Dienst über den Integrations-Hub hinzu. Einmal einrichten und in jeder App nutzen, die du erstellst. Jede Woche kommen neue Konnektoren hinzu, aber du musst nie auf einen warten.":"fr"===t?"Vous n'êtes pas limité à notre liste de connecteurs. Ajoutez n'importe quel service via le centre d'intégrations. Configurez-le une seule fois et utilisez-le dans toutes les applications que vous créez. De nouveaux connecteurs sont publiés chaque semaine, mais vous n'avez jamais besoin d'attendre.":"es"===t?"No estás limitado a nuestra lista de conectores. Añade cualquier servicio a través del centro de integraciones. Configúralo una vez y úsalo en todas las aplicaciones que crees. Cada semana lanzamos nuevos conectores, pero nunca tienes que esperar a que llegue uno.":"it"===t?"Non sei limitato al nostro elenco di connettori. Aggiungi qualsiasi servizio tramite l'hub delle integrazioni. Configuralo una volta e usalo in tutte le app che crei. Nuovi connettori arrivano ogni settimana, ma non devi mai aspettarne uno.":"hi"===t?"आप हमारी कनेक्टर सूची तक सीमित नहीं हैं। इंटीग्रेशन हब के ज़रिए कोई भी सेवा जोड़ें। एक बार सेट अप करें और अपने बनाए हर ऐप में इसका उपयोग करें। हर हफ़्ते नए कनेक्टर आते हैं, लेकिन आपको किसी का इंतज़ार नहीं करना पड़ता।":"id"===t?"Anda tidak terbatas pada daftar konektor kami. Tambahkan layanan apa pun melalui pusat integrasi. Konfigurasikan sekali dan gunakan di setiap aplikasi yang Anda bangun. Konektor baru dirilis setiap minggu, tetapi Anda tidak perlu menunggu konektor tertentu tersedia.":"th"===t?"คุณไม่ได้จำกัดอยู่แค่รายการตัวเชื่อมต่อของเรา เพิ่มบริการใดก็ได้ผ่านศูนย์รวมการผสานการทำงาน ตั้งค่าเพียงครั้งเดียวและใช้ได้กับทุกแอปที่คุณสร้าง มีตัวเชื่อมต่อใหม่ออกมาทุกสัปดาห์ แต่คุณไม่จำเป็นต้องรอ":"ko"===t?"제공되는 커넥터 목록에만 제한되지 않아요. 통합 허브를 통해 어떤 서비스든 추가하세요. 한 번 설정하면 만드는 모든 앱에서 사용할 수 있어요. 새 커넥터는 매주 출시되지만 기다릴 필요는 없어요.":"コネクタはこのリストに限りません。インテグレーションハブから、あらゆるサービスを追加できます。一度設定すれば、構築するすべてのアプリで利用できます。新しいコネクタは毎週追加されますが、それを待つ必要はありません。"};e.s(["connectorsPage_cards_card1_description",0,cs],422903),e.i(422903);let cl=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Any API. Any MCP server. Any tool.":"pt-BR"===t?"Qualquer API. Qualquer servidor MCP. Qualquer ferramenta.":"de"===t?"Jede API. Jeder MCP-Server. Jedes Tool.":"fr"===t?"N'importe quelle API. N'importe quel serveur MCP. N'importe quel outil.":"es"===t?"Cualquier API. Cualquier servidor MCP. Cualquier herramienta.":"it"===t?"Qualsiasi API. Qualsiasi server MCP. Qualsiasi strumento.":"hi"===t?"कोई भी API। कोई भी MCP सर्वर। कोई भी टूल।":"id"===t?"API apa pun. Server MCP apa pun. Alat apa pun.":"th"===t?"ทุก API ทุกเซิร์ฟเวอร์ MCP ทุกเครื่องมือ":"ko"===t?"어떤 API든, 어떤 MCP 서버든, 어떤 도구든.":"あらゆるAPI、あらゆるMCPサーバー、あらゆるツール。"};e.s(["connectorsPage_cards_card1_title",0,cl],81592),e.i(81592);let cc=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Get in touch":"pt-BR"===t?"Entre em contato":"de"===t?"Kontakt aufnehmen":"fr"===t?"Contactez-nous":"es"===t?"Ponte en contacto":"it"===t?"Contattaci":"hi"===t?"संपर्क करें":"id"===t?"Hubungi kami":"th"===t?"ติดต่อเรา":"ko"===t?"문의하기":"お問い合わせ"};e.s(["connectorsPage_cards_card2_cta",0,cc],143455),e.i(143455);let cu=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Our team will partner with you to map your workflows, understand your data, and build what you need. Book time to walk us through your setup.":"pt-BR"===t?"Nossa equipe vai trabalhar com você para mapear seus fluxos de trabalho, entender seus dados e criar o que você precisa. Agende um horário para nos mostrar a sua configuração.":"de"===t?"Unser Team arbeitet mit dir zusammen, um deine Workflows abzubilden, deine Daten zu verstehen und genau das zu entwickeln, was du brauchst. Vereinbare einen Termin und zeig uns dein Setup.":"fr"===t?"Notre équipe collaborera avec vous pour cartographier vos flux de travail, comprendre vos données et créer ce dont vous avez besoin. Réservez un créneau pour nous présenter votre configuration.":"es"===t?"Nuestro equipo colaborará contigo para entender tus flujos de trabajo, comprender tus datos y crear lo que necesitas. Reserva un momento para mostrarnos tu configuración.":"it"===t?"Il nostro team collaborerà con te per mappare i tuoi flussi di lavoro, comprendere i tuoi dati e creare ciò di cui hai bisogno. Prenota un incontro per illustrarci la tua configurazione.":"hi"===t?"हमारी टीम आपके वर्कफ़्लो को समझने, आपके डेटा को जानने और आपकी ज़रूरत की चीज़ बनाने में आपके साथ मिलकर काम करेगी। अपना सेटअप हमें दिखाने के लिए समय बुक करें।":"id"===t?"Tim kami akan bekerja sama dengan Anda untuk memetakan alur kerja, memahami data, dan membangun apa yang Anda butuhkan. Jadwalkan waktu untuk menjelaskan pengaturan Anda kepada kami.":"th"===t?"ทีมงานของเราจะร่วมมือกับคุณเพื่อทำความเข้าใจเวิร์กโฟลว์ ข้อมูลของคุณ และสร้างสิ่งที่คุณต้องการ จองเวลาเพื่ออธิบายการตั้งค่าของคุณให้เราฟัง":"ko"===t?"저희 팀이 함께 워크플로를 파악하고, 데이터를 이해하며, 필요한 기능을 만들어 드릴게요. 시간을 예약해 현재 설정을 설명해 주세요.":"私たちのチームがお客様と連携し、ワークフローを整理し、データを理解したうえで、必要なものを構築します。お時間をご予約いただき、お使いの環境について教えてください。"};e.s(["connectorsPage_cards_card2_description",0,cu],433252),e.i(433252);let cd=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"More complex requirements?":"pt-BR"===t?"Requisitos mais complexos?":"de"===t?"Komplexere Anforderungen?":"fr"===t?"Des besoins plus complexes ?":"es"===t?"¿Tienes requisitos más complejos?":"it"===t?"Hai requisiti più complessi?":"hi"===t?"ज़्यादा जटिल ज़रूरतें हैं?":"id"===t?"Kebutuhan yang lebih kompleks?":"th"===t?"มีความต้องการที่ซับซ้อนกว่านี้ใช่ไหม":"ko"===t?"더 복잡한 요구 사항이 있으신가요?":"より複雑な要件がありますか？"};e.s(["connectorsPage_cards_card2_title",0,cd],287606),e.i(287606);let cp=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Back to connectors":"pt-BR"===t?"Voltar aos conectores":"de"===t?"Zurück zu den Konnektoren":"fr"===t?"Retour aux connecteurs":"es"===t?"Volver a los conectores":"it"===t?"Torna ai connettori":"hi"===t?"कनेक्टर पर वापस जाएँ":"id"===t?"Kembali ke konektor":"th"===t?"กลับไปที่ตัวเชื่อมต่อ":"ko"===t?"커넥터로 돌아가기":"コネクタ一覧に戻る"};e.s(["connectorsPage_detail_backToConnectors",0,cp],397194),e.i(397194);let cm=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Explore all connectors":"pt-BR"===t?"Explore todos os conectores":"de"===t?"Alle Konnektoren entdecken":"fr"===t?"Explorer tous les connecteurs":"es"===t?"Explora todos los conectores":"it"===t?"Esplora tutti i connettori":"hi"===t?"सभी कनेक्टर देखें":"id"===t?"Jelajahi semua konektor":"th"===t?"สำรวจตัวเชื่อมต่อทั้งหมด":"ko"===t?"모든 커넥터 살펴보기":"すべてのコネクタを見る"};e.s(["connectorsPage_detail_exploreAll",0,cm],162554),e.i(162554);let cg=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"How to get started":"pt-BR"===t?"Como começar":"de"===t?"So legst du los":"fr"===t?"Comment commencer":"es"===t?"Cómo empezar":"it"===t?"Come iniziare":"hi"===t?"शुरुआत कैसे करें":"id"===t?"Cara memulai":"th"===t?"วิธีเริ่มต้นใช้งาน":"ko"===t?"시작하는 방법":"始め方"};e.s(["connectorsPage_detail_howToGetStarted",0,cg],201802),e.i(201802);let cb=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Learn more":"pt-BR"===t?"Saiba mais":"de"===t?"Mehr erfahren":"fr"===t?"En savoir plus":"es"===t?"Más información":"it"===t?"Scopri di più":"hi"===t?"और जानें":"id"===t?"Pelajari lebih lanjut":"th"===t?"ดูเพิ่มเติม":"ko"===t?"자세히 알아보기":"詳しく見る"};e.s(["connectorsPage_detail_learnMore",0,cb],275939),e.i(275939);let ch=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Resources":"pt-BR"===t?"Recursos":"de"===t?"Ressourcen":"fr"===t?"Ressources":"es"===t?"Recursos":"it"===t?"Risorse":"hi"===t?"संसाधन":"id"===t?"Sumber daya":"th"===t?"แหล่งข้อมูล":"ko"===t?"리소스":"リソース"};e.s(["connectorsPage_detail_resources",0,ch],187409),e.i(187409);let cv=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Start building":"pt-BR"===t?"Comece a criar":"de"===t?"Jetzt loslegen":"fr"===t?"Commencer à créer":"es"===t?"Empieza a crear":"it"===t?"Inizia a creare":"hi"===t?"बनाना शुरू करें":"id"===t?"Mulai membuat":"th"===t?"เริ่มสร้างได้เลย":"ko"===t?"만들기 시작하기":"構築を始める"};e.s(["connectorsPage_detail_startBuilding",0,cv],535250),e.i(535250);let c_=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"What you can build":"pt-BR"===t?"O que você pode criar":"de"===t?"Was du erstellen kannst":"fr"===t?"Ce que vous pouvez créer":"es"===t?"Lo que puedes crear":"it"===t?"Cosa puoi creare":"hi"===t?"आप क्या बना सकते हैं":"id"===t?"Apa yang dapat Anda bangun":"th"===t?"สิ่งที่คุณสร้างได้":"ko"===t?"만들 수 있는 것":"作れるもの"};e.s(["connectorsPage_detail_whatYouCanBuild",0,c_],984612),e.i(984612);let cf=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"What’s included":"pt-BR"===t?"O que está incluído":"de"===t?"Was enthalten ist":"fr"===t?"Ce qui est inclus":"es"===t?"Qué incluye":"it"===t?"Cosa è incluso":"hi"===t?"इसमें क्या शामिल है":"id"===t?"Apa saja yang disertakan":"th"===t?"สิ่งที่รวมอยู่ด้วย":"ko"===t?"포함된 항목":"含まれるもの"};e.s(["connectorsPage_detail_whatsIncluded",0,cf],885996),e.i(885996);let ck=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Works well with":"pt-BR"===t?"Funciona bem com":"de"===t?"Passt gut zu":"fr"===t?"Fonctionne bien avec":"es"===t?"Funciona bien con":"it"===t?"Funziona bene con":"hi"===t?"इनके साथ अच्छी तरह काम करता है":"id"===t?"Cocok digunakan dengan":"th"===t?"ทำงานร่วมกับได้ดี":"ko"===t?"함께 사용하기 좋은 도구":"相性の良い連携"};e.s(["connectorsPage_detail_worksWellWith",0,ck],649791),e.i(649791);let cL=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Connectors let Lovable read and write data from your favorite tools. Once you enable a connector, Lovable can pull in live data, trigger actions, and build features that stay in sync with your existing stack.":"pt-BR"===t?"Os conectores permitem que o Lovable leia dados das suas ferramentas favoritas e grave dados nelas. Depois de ativar um conector, o Lovable pode trazer dados em tempo real, disparar ações e criar funcionalidades que ficam em sincronia com seu conjunto de ferramentas atual.":"de"===t?"Mit Konnektoren kann Lovable Daten in deinen bevorzugten Tools lesen und schreiben. Sobald du einen Konnektor aktivierst, kann Lovable Live-Daten abrufen, Aktionen auslösen und Funktionen erstellen, die mit deinem bestehenden Stack synchron bleiben.":"fr"===t?"Les connecteurs permettent à Lovable de lire et d'écrire des données depuis vos outils favoris. Une fois qu'un connecteur est activé, Lovable peut récupérer des données en temps réel, déclencher des actions et créer des fonctionnalités qui restent synchronisées avec votre environnement existant.":"es"===t?"Los conectores permiten que Lovable lea datos de tus herramientas favoritas y escriba en ellas. Una vez que activas un conector, Lovable puede importar datos en tiempo real, activar acciones y crear funciones que se mantienen sincronizadas con tu conjunto de herramientas actual.":"it"===t?"I connettori permettono a Lovable di leggere e scrivere dati nei tuoi strumenti preferiti. Una volta attivato un connettore, Lovable può recuperare dati in tempo reale, attivare azioni e creare funzionalità che restano sincronizzate con il tuo stack esistente.":"hi"===t?"कनेक्टर Lovable को आपके पसंदीदा टूल से डेटा पढ़ने और लिखने देते हैं। जब आप कोई कनेक्टर सक्षम करते हैं, तो Lovable लाइव डेटा ला सकता है, कार्रवाइयाँ ट्रिगर कर सकता है और ऐसे फ़ीचर बना सकता है जो आपके मौजूदा स्टैक के साथ सिंक में रहें।":"id"===t?"Konektor memungkinkan Lovable membaca dan menulis data dari alat favorit Anda. Setelah Anda mengaktifkan konektor, Lovable dapat mengambil data langsung, memicu tindakan, dan membangun fitur yang tetap sinkron dengan rangkaian teknologi Anda yang sudah ada.":"th"===t?"ตัวเชื่อมต่อช่วยให้ Lovable อ่านและเขียนข้อมูลจากเครื่องมือที่คุณชื่นชอบได้ เมื่อคุณเปิดใช้งานตัวเชื่อมต่อ Lovable จะสามารถดึงข้อมูลแบบเรียลไทม์ เรียกใช้การดำเนินการต่าง ๆ และสร้างฟีเจอร์ที่ซิงค์กับชุดเครื่องมือที่คุณใช้อยู่ได้ตลอด":"ko"===t?"커넥터를 사용하면 Lovable이 즐겨 쓰는 도구에서 데이터를 읽고 쓸 수 있어요. 커넥터를 활성화하면 Lovable이 실시간 데이터를 가져오고, 작업을 실행하며, 기존 스택과 동기화되는 기능을 만들 수 있어요.":"コネクタを使うと、Lovableが普段お使いのツールからデータを読み書きできるようになります。コネクタを有効にすると、Lovableはリアルタイムのデータを取り込み、アクションを実行し、既存の環境と同期し続ける機能を構築できます。"};e.s(["connectorsPage_faq1_answer",0,cL],681154),e.i(681154);let cP=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"How do connectors work in Lovable?":"pt-BR"===t?"Como funcionam os conectores no Lovable?":"de"===t?"Wie funktionieren Konnektoren in Lovable?":"fr"===t?"Comment fonctionnent les connecteurs dans Lovable ?":"es"===t?"¿Cómo funcionan los conectores en Lovable?":"it"===t?"Come funzionano i connettori in Lovable?":"hi"===t?"Lovable में कनेक्टर कैसे काम करते हैं?":"id"===t?"Bagaimana cara kerja konektor di Lovable?":"th"===t?"ตัวเชื่อมต่อทำงานอย่างไรใน Lovable?":"ko"===t?"Lovable에서 커넥터는 어떻게 작동하나요?":"Lovableでコネクタはどのように機能しますか？"};e.s(["connectorsPage_faq1_question",0,cP],236379),e.i(236379);let cy=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"We support tools like Linear, Notion, Stripe, Slack, Shopify, Google Workspace, and more. New connectors are added regularly — check the full list on this page.":"pt-BR"===t?"Oferecemos suporte a ferramentas como Linear, Notion, Stripe, Slack, Shopify, Google Workspace e muito mais. Novos conectores são adicionados regularmente — confira a lista completa nesta página.":"de"===t?"Wir unterstützen Tools wie Linear, Notion, Stripe, Slack, Shopify, Google Workspace und mehr. Regelmäßig kommen neue Konnektoren hinzu – die vollständige Liste findest du auf dieser Seite.":"fr"===t?"Nous prenons en charge des outils comme Linear, Notion, Stripe, Slack, Shopify, Google Workspace, et bien d'autres. De nouveaux connecteurs sont ajoutés régulièrement — consultez la liste complète sur cette page.":"es"===t?"Admitimos herramientas como Linear, Notion, Stripe, Slack, Shopify, Google Workspace y más. Se añaden nuevos conectores con regularidad; consulta la lista completa en esta página.":"it"===t?"Supportiamo strumenti come Linear, Notion, Stripe, Slack, Shopify, Google Workspace e altri ancora. Nuovi connettori vengono aggiunti regolarmente: consulta l'elenco completo in questa pagina.":"hi"===t?"हम Linear, Notion, Stripe, Slack, Shopify, Google Workspace और कई अन्य टूल का समर्थन करते हैं। नए कनेक्टर नियमित रूप से जोड़े जाते हैं — पूरी सूची इस पेज पर देखें।":"id"===t?"Kami mendukung alat seperti Linear, Notion, Stripe, Slack, Shopify, Google Workspace, dan lainnya. Konektor baru ditambahkan secara berkala — lihat daftar lengkapnya di halaman ini.":"th"===t?"เรารองรับเครื่องมืออย่าง Linear, Notion, Stripe, Slack, Shopify, Google Workspace และอื่น ๆ อีกมากมาย เรามีการเพิ่มคอนเนกเตอร์ใหม่ ๆ อยู่เป็นประจำ — ดูรายการทั้งหมดได้ที่หน้านี้":"ko"===t?"Linear, Notion, Stripe, Slack, Shopify, Google Workspace 등의 도구를 지원해요. 새로운 커넥터가 정기적으로 추가되니, 이 페이지에서 전체 목록을 확인하세요.":"Linear、Notion、Stripe、Slack、Shopify、Google Workspace などのツールに対応しています。新しいコネクターも定期的に追加されています。すべての一覧はこのページでご確認ください。"};e.s(["connectorsPage_faq2_answer",0,cy],595005),e.i(595005);let cS=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Which connectors are available?":"pt-BR"===t?"Quais conectores estão disponíveis?":"de"===t?"Welche Konnektoren sind verfügbar?":"fr"===t?"Quels connecteurs sont disponibles ?":"es"===t?"¿Qué conectores están disponibles?":"it"===t?"Quali connettori sono disponibili?":"hi"===t?"कौन-कौन से कनेक्टर उपलब्ध हैं?":"id"===t?"Konektor apa saja yang tersedia?":"th"===t?"มีคอนเนกเตอร์ใดให้ใช้งานบ้าง?":"ko"===t?"어떤 커넥터를 사용할 수 있나요?":"利用できるコネクターはどれですか？"};e.s(["connectorsPage_faq2_question",0,cS],732954),e.i(732954);let cw=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"From your Lovable project, open the integrations panel and select the connector you want. Follow the setup steps and Lovable will be ready to use your data.":"pt-BR"===t?"No seu projeto da Lovable, abra o painel de integrações e selecione o conector desejado. Siga as etapas de configuração e a Lovable estará pronta para usar seus dados.":"de"===t?"Öffne in deinem Lovable-Projekt den Integrationsbereich und wähle den gewünschten Konnektor aus. Folge den Einrichtungsschritten, und Lovable ist bereit, deine Daten zu nutzen.":"fr"===t?"Depuis votre projet Lovable, ouvrez le panneau des intégrations et sélectionnez le connecteur souhaité. Suivez les étapes de configuration et Lovable sera prêt à utiliser vos données.":"es"===t?"Desde tu proyecto de Lovable, abre el panel de integraciones y selecciona el conector que quieras. Sigue los pasos de configuración y Lovable estará listo para usar tus datos.":"it"===t?"Dal tuo progetto Lovable, apri il pannello delle integrazioni e seleziona il connettore che desideri. Segui i passaggi di configurazione e Lovable sarà pronto a usare i tuoi dati.":"hi"===t?"अपने Lovable प्रोजेक्ट में, एकीकरण पैनल खोलें और मनचाहा कनेक्टर चुनें। सेटअप के चरण पूरे करें और Lovable आपके डेटा का उपयोग करने के लिए तैयार हो जाएगा।":"id"===t?"Dari proyek Lovable Anda, buka panel integrasi dan pilih konektor yang Anda inginkan. Ikuti langkah-langkah penyiapan, dan Lovable siap menggunakan data Anda.":"th"===t?"จากโปรเจกต์ Lovable ของคุณ ให้เปิดแผงการเชื่อมต่อแล้วเลือกคอนเนกเตอร์ที่ต้องการ ทำตามขั้นตอนการตั้งค่า แล้ว Lovable ก็พร้อมใช้งานข้อมูลของคุณได้ทันที":"ko"===t?"Lovable 프로젝트에서 통합 패널을 열고 원하는 커넥터를 선택하세요. 설정 단계를 따르면 Lovable이 데이터를 사용할 준비가 됩니다.":"Lovable プロジェクトでインテグレーションパネルを開き、使いたいコネクターを選択します。セットアップ手順に従えば、Lovable がデータを利用できるようになります。"};e.s(["connectorsPage_faq3_answer",0,cw],554241),e.i(554241);let cz=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"How do I add a connector to my project?":"pt-BR"===t?"Como adiciono um conector ao meu projeto?":"de"===t?"Wie füge ich meinem Projekt einen Konnektor hinzu?":"fr"===t?"Comment ajouter un connecteur à mon projet ?":"es"===t?"¿Cómo añado un conector a mi proyecto?":"it"===t?"Come aggiungo un connettore al mio progetto?":"hi"===t?"मैं अपने प्रोजेक्ट में कनेक्टर कैसे जोड़ूँ?":"id"===t?"Bagaimana cara menambahkan konektor ke proyek saya?":"th"===t?"ฉันจะเพิ่มคอนเนกเตอร์เข้าไปในโปรเจกต์ได้อย่างไร?":"ko"===t?"프로젝트에 커넥터를 어떻게 추가하나요?":"プロジェクトにコネクターを追加するにはどうすればいいですか？"};e.s(["connectorsPage_faq3_question",0,cz],204592),e.i(204592);let cA=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Yes. Lovable supports the MCP (Model Context Protocol) standard, so you can connect any tool with an API. Select “Connect it yourself” to get started.":"pt-BR"===t?"Sim. A Lovable oferece suporte ao padrão MCP (Model Context Protocol), então você pode conectar qualquer ferramenta com uma API. Selecione “Conectar por conta própria” para começar.":"de"===t?"Ja. Lovable unterstützt den MCP-Standard (Model Context Protocol), sodass du jedes Tool mit einer API verbinden kannst. Wähle „Selbst verbinden“, um loszulegen.":"fr"===t?"Oui. Lovable prend en charge le standard MCP (Model Context Protocol), ce qui vous permet de connecter n'importe quel outil doté d'une API. Sélectionnez « Connectez-le vous-même » pour commencer.":"es"===t?"Sí. Lovable es compatible con el estándar MCP (Model Context Protocol), por lo que puedes conectar cualquier herramienta que tenga una API. Selecciona «Conéctalo tú mismo» para empezar.":"it"===t?"Sì. Lovable supporta lo standard MCP (Model Context Protocol), quindi puoi collegare qualsiasi strumento dotato di API. Seleziona “Collegalo tu stesso” per iniziare.":"hi"===t?"हाँ। Lovable MCP (Model Context Protocol) मानक का समर्थन करता है, इसलिए आप API वाले किसी भी टूल को जोड़ सकते हैं। शुरू करने के लिए “इसे खुद जोड़ें” चुनें।":"id"===t?"Bisa. Lovable mendukung standar MCP (Model Context Protocol), jadi Anda dapat menghubungkan alat apa pun yang memiliki API. Pilih “Hubungkan sendiri” untuk memulai.":"th"===t?"ได้เลย Lovable รองรับมาตรฐาน MCP (Model Context Protocol) คุณจึงสามารถเชื่อมต่อเครื่องมือใดก็ได้ที่มี API เพียงเลือก “เชื่อมต่อด้วยตัวเอง” เพื่อเริ่มต้นใช้งาน":"ko"===t?"네. Lovable은 MCP(Model Context Protocol) 표준을 지원하므로 API가 있는 모든 도구를 연결할 수 있어요. “직접 연결하기”를 선택해 시작하세요.":"はい。Lovable は MCP（Model Context Protocol）標準に対応しているため、API を持つあらゆるツールに接続できます。「自分で接続する」を選択して始めましょう。"};e.s(["connectorsPage_faq4_answer",0,cA],31280),e.i(31280);let cq=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Can I connect a tool that isn’t listed?":"pt-BR"===t?"Posso conectar uma ferramenta que não está na lista?":"de"===t?"Kann ich ein Tool verbinden, das nicht aufgeführt ist?":"fr"===t?"Puis-je connecter un outil qui n'est pas dans la liste ?":"es"===t?"¿Puedo conectar una herramienta que no aparece en la lista?":"it"===t?"Posso collegare uno strumento non presente nell'elenco?":"hi"===t?"क्या मैं सूची में न दिया गया टूल जोड़ सकता हूँ?":"id"===t?"Bisakah saya menghubungkan alat yang tidak ada dalam daftar?":"th"===t?"ฉันเชื่อมต่อเครื่องมือที่ไม่อยู่ในรายการได้ไหม?":"ko"===t?"목록에 없는 도구도 연결할 수 있나요?":"一覧にないツールに接続できますか？"};e.s(["connectorsPage_faq4_question",0,cq],511525),e.i(511525);let cx=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Connectors themselves don’t cost credits. Credits are only used when Lovable generates or modifies code. Connecting to your tools is free.":"pt-BR"===t?"Os conectores em si não consomem créditos. Os créditos são usados apenas quando a Lovable gera ou modifica código. Conectar suas ferramentas é gratuito.":"de"===t?"Konnektoren selbst kosten keine Credits. Credits werden nur verbraucht, wenn Lovable Code generiert oder ändert. Das Verbinden deiner Tools ist kostenlos.":"fr"===t?"Les connecteurs eux-mêmes ne coûtent pas de crédits. Les crédits ne sont utilisés que lorsque Lovable génère ou modifie du code. Connecter vos outils est gratuit.":"es"===t?"Los conectores en sí no consumen créditos. Los créditos solo se usan cuando Lovable genera o modifica código. Conectar tus herramientas es gratis.":"it"===t?"I connettori in sé non costano crediti. I crediti vengono utilizzati solo quando Lovable genera o modifica codice. Collegare i tuoi strumenti è gratuito.":"hi"===t?"कनेक्टर खुद कोई क्रेडिट खर्च नहीं करते। क्रेडिट केवल तब उपयोग होते हैं जब Lovable कोड बनाता या संशोधित करता है। अपने टूल जोड़ना मुफ़्त है।":"id"===t?"Konektor itu sendiri tidak menggunakan kredit. Kredit hanya digunakan saat Lovable membuat atau mengubah kode. Menghubungkan alat Anda gratis.":"th"===t?"ตัวคอนเนกเตอร์เองไม่ใช้เครดิต เครดิตจะถูกใช้เฉพาะเมื่อ Lovable สร้างหรือแก้ไขโค้ดเท่านั้น การเชื่อมต่อกับเครื่องมือของคุณนั้นฟรี":"ko"===t?"커넥터 자체는 크레딧을 사용하지 않아요. 크레딧은 Lovable이 코드를 생성하거나 수정할 때만 사용돼요. 도구 연결은 무료예요.":"コネクター自体ではクレジットは消費されません。クレジットは Lovable がコードを生成または変更するときにのみ使用されます。ツールへの接続は無料です。"};e.s(["connectorsPage_faq5_answer",0,cx],652361),e.i(652361);let cC=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Do connectors use my Lovable credits?":"pt-BR"===t?"Os conectores consomem meus créditos da Lovable?":"de"===t?"Verbrauchen Konnektoren meine Lovable-Credits?":"fr"===t?"Les connecteurs utilisent-ils mes crédits Lovable ?":"es"===t?"¿Los conectores consumen mis créditos de Lovable?":"it"===t?"I connettori consumano i miei crediti Lovable?":"hi"===t?"क्या कनेक्टर मेरे Lovable क्रेडिट का उपयोग करते हैं?":"id"===t?"Apakah konektor menggunakan kredit Lovable saya?":"th"===t?"คอนเนกเตอร์ใช้เครดิต Lovable ของฉันหรือไม่?":"ko"===t?"커넥터가 Lovable 크레딧을 사용하나요?":"コネクターは Lovable のクレジットを消費しますか？"};e.s(["connectorsPage_faq5_question",0,cC],554618),e.i(554618);let cB=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Frequently asked questions":"pt-BR"===t?"Perguntas frequentes":"de"===t?"Häufig gestellte Fragen":"fr"===t?"Questions fréquentes":"es"===t?"Preguntas frecuentes":"it"===t?"Domande frequenti":"hi"===t?"अक्सर पूछे जाने वाले सवाल":"id"===t?"Pertanyaan yang sering diajukan":"th"===t?"คำถามที่พบบ่อย":"ko"===t?"자주 묻는 질문":"よくある質問"};e.s(["connectorsPage_faqTitle",0,cB],819973),e.i(819973);let cR=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Your backlog, your docs, your data. Lovable reads them and builds from them.":"pt-BR"===t?"Suas tarefas pendentes, seus documentos, seus dados. A Lovable lê tudo isso e cria a partir desse contexto.":"de"===t?"Dein Backlog, deine Dokumentation, deine Daten. Lovable liest sie und baut darauf auf.":"fr"===t?"Votre carnet de tâches, vos documents, vos données. Lovable les lit et s'en sert pour créer.":"es"===t?"Tu lista de pendientes, tus documentos, tus datos. Lovable los lee y crea a partir de ellos.":"it"===t?"Il tuo backlog, i tuoi documenti, i tuoi dati. Lovable li legge e ci costruisce sopra.":"hi"===t?"आपका बैकलॉग, आपके दस्तावेज़, आपका डेटा। Lovable उन्हें पढ़ता है और उनके आधार पर बनाता है।":"id"===t?"Daftar tugas Anda, dokumen Anda, data Anda. Lovable membaca semuanya dan membangun berdasarkan konteks tersebut.":"th"===t?"งานค้างของคุณ เอกสารของคุณ ข้อมูลของคุณ Lovable อ่านทั้งหมดและสร้างขึ้นมาจากสิ่งเหล่านั้น":"ko"===t?"백로그, 문서, 데이터. Lovable이 이를 읽고 바탕으로 만들어줘요.":"普段使っているバックログ、ドキュメント、データ。Lovable がそれらを読み取り、活用してアプリを作成します。"};e.s(["connectorsPage_featured_subtitle",0,cR],467771),e.i(467771);let cT=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Featured connectors":"pt-BR"===t?"Conectores em destaque":"de"===t?"Empfohlene Konnektoren":"fr"===t?"Connecteurs en vedette":"es"===t?"Conectores destacados":"it"===t?"Connettori in evidenza":"hi"===t?"प्रमुख कनेक्टर":"id"===t?"Konektor unggulan":"th"===t?"คอนเนกเตอร์แนะนำ":"ko"===t?"추천 커넥터":"注目のコネクター"};e.s(["connectorsPage_featured_title",0,cT],843841),e.i(843841);var cI=e.i(242769),cj=e.i(536366),cD=e.i(964923),cE=e.i(76503),cM=e.i(873620);let cG=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Connect Linear, Notion, Stripe, Slack, and more. Lovable builds with all of it.":"pt-BR"===t?"Conecte Linear, Notion, Stripe, Slack e muito mais. A Lovable cria usando tudo isso.":"de"===t?"Verbinde Linear, Notion, Stripe, Slack und mehr. Lovable nutzt all das zum Bauen.":"fr"===t?"Connectez Linear, Notion, Stripe, Slack et plus encore. Lovable s'appuie sur tout cela pour créer.":"es"===t?"Conecta Linear, Notion, Stripe, Slack y más. Lovable crea con todo eso.":"it"===t?"Collega Linear, Notion, Stripe, Slack e altri ancora. Lovable usa tutto questo per creare.":"hi"===t?"Linear, Notion, Stripe, Slack और अन्य टूल जोड़ें। Lovable इन सबका उपयोग करके बनाता है।":"id"===t?"Hubungkan Linear, Notion, Stripe, Slack, dan lainnya. Lovable menggunakan semuanya untuk membangun.":"th"===t?"เชื่อมต่อ Linear, Notion, Stripe, Slack และอื่น ๆ อีกมากมาย Lovable สร้างทุกอย่างขึ้นมาจากสิ่งเหล่านี้":"ko"===t?"Linear, Notion, Stripe, Slack 등을 연결하세요. Lovable이 이 모든 것을 바탕으로 만들어줘요.":"Linear、Notion、Stripe、Slack などに接続できます。Lovable はそれらを活用してアプリを作成します。"};e.s(["connectorsPage_meta_description",0,cG],932646),e.i(932646);let cO=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Lovable connectors | Build from what you already use":"pt-BR"===t?"Conectores da Lovable | Construa a partir do que você já usa":"de"===t?"Lovable-Konnektoren | Erstelle aus dem, was du bereits nutzt":"fr"===t?"Connecteurs Lovable | Créez à partir de ce que vous utilisez déjà":"es"===t?"Conectores de Lovable | Construye a partir de lo que ya usas":"it"===t?"Connettori Lovable | Crea partendo da ciò che usi già":"hi"===t?"Lovable कनेक्टर | उसी से बनाएँ जो आप पहले से उपयोग करते हैं":"id"===t?"Konektor Lovable | Bangun dengan alat yang sudah Anda gunakan":"th"===t?"คอนเนกเตอร์ Lovable | สร้างจากสิ่งที่คุณใช้อยู่แล้ว":"ko"===t?"Lovable 커넥터 | 이미 사용 중인 것으로 만들어보세요":"Lovable コネクター | 普段使っているツールを活かして作成"};e.s(["connectorsPage_meta_title",0,cO],498140),e.i(498140);let cN=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Connectors":"pt-BR"===t?"Conectores":"de"===t?"Konnektoren":"fr"===t?"Connecteurs":"es"===t?"Conectores":"it"===t?"Connettori":"hi"===t?"कनेक्टर":"id"===t?"Konektor":"th"===t?"คอนเนกเตอร์":"ko"===t?"커넥터":"コネクター"};e.s(["connectorsPage_sidebar_heading",0,cN],953821),e.i(953821);var cF=e.i(772209),cH=e.i(169929),cW=e.i(384142),cU=e.i(478673),cV=e.i(191227),cK=e.i(594183),c$=e.i(573248),cQ=e.i(73788),cY=e.i(393658),cJ=e.i(587295),cZ=e.i(132257),cX=e.i(172398),c0=e.i(811382),c1=e.i(198870),c2=e.i(462072),c3=e.i(5981),c4=e.i(661375),c5=e.i(267545),c8=e.i(102572),c6=e.i(14385),c9=e.i(506197),c7=e.i(833611),ue=e.i(135672),ua=e.i(199229),ut=e.i(308457),ui=e.i(308773),uo=e.i(584553),un=e.i(179377),ur=e.i(553964),us=e.i(784843);let ul=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"You get full visual control with React and Tailwind to make Lovable apps match your design files exactly. Workspace Themes can be used to keep design standards consistent across projects.":"pt-BR"===t?"Você tem controle visual total com React e Tailwind para que os aplicativos da Lovable correspondam exatamente aos seus arquivos de design. Os temas do espaço de trabalho podem ser usados para manter os padrões de design consistentes entre projetos.":"de"===t?"Mit React und Tailwind hast du volle visuelle Kontrolle, damit deine Lovable-Apps exakt zu deinen Designdateien passen. Mit Arbeitsbereich-Themes kannst du Designstandards über Projekte hinweg einheitlich halten.":"fr"===t?"Vous bénéficiez d'un contrôle visuel total avec React et Tailwind pour que vos applications Lovable correspondent exactement à vos fichiers de conception. Les thèmes d'espace de travail permettent de maintenir des normes de conception cohérentes entre les projets.":"es"===t?"Obtienes control visual total con React y Tailwind para que las aplicaciones de Lovable coincidan exactamente con tus archivos de diseño. Puedes usar los temas del espacio de trabajo para mantener estándares de diseño coherentes en todos los proyectos.":"it"===t?"Hai il pieno controllo visivo con React e Tailwind per far corrispondere esattamente le app Lovable ai tuoi file di design. I temi dell'area di lavoro possono essere usati per mantenere coerenti gli standard di design tra i progetti.":"hi"===t?"React और Tailwind के साथ आपको पूरा दृश्य नियंत्रण मिलता है, ताकि Lovable ऐप्स आपकी डिज़ाइन फ़ाइलों से बिल्कुल मेल खाएँ। सभी प्रोजेक्ट में डिज़ाइन मानकों को एक जैसा बनाए रखने के लिए वर्कस्पेस थीम का उपयोग किया जा सकता है।":"id"===t?"Anda mendapatkan kontrol visual penuh dengan React dan Tailwind untuk membuat aplikasi Lovable sesuai persis dengan berkas desain Anda. Tema ruang kerja dapat digunakan untuk menjaga standar desain tetap konsisten di seluruh proyek.":"th"===t?"คุณจะควบคุมงานออกแบบด้านภาพได้อย่างเต็มที่ด้วย React และ Tailwind เพื่อให้แอป Lovable ตรงกับไฟล์ดีไซน์ของคุณอย่างแม่นยำ สามารถใช้ธีมของเวิร์กสเปซเพื่อรักษามาตรฐานการออกแบบให้สอดคล้องกันในทุกโปรเจกต์":"ko"===t?"React와 Tailwind로 시각 요소를 자유롭게 제어해 Lovable 앱을 디자인 파일과 정확히 일치시킬 수 있어요. 워크스페이스 테마를 사용하면 프로젝트 전반에서 디자인 표준을 일관되게 유지할 수 있어요.":"React と Tailwind による完全なビジュアル制御で、Lovable アプリをデザインファイルに正確に一致させることができます。Workspace Themes を使えば、プロジェクト全体でデザイン基準を一貫して保てます。"};e.s(["designersPage_faq1_answer",0,ul],567547),e.i(567547);let uc=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Will my Lovable apps match my design files?":"pt-BR"===t?"Meus apps do Lovable vão corresponder aos meus arquivos de design?":"de"===t?"Werden meine Lovable-Apps zu meinen Designdateien passen?":"fr"===t?"Mes applications Lovable correspondront-elles à mes fichiers de design ?":"es"===t?"¿Mis aplicaciones de Lovable coincidirán con mis archivos de diseño?":"it"===t?"Le mie app Lovable rispecchieranno i miei file di design?":"hi"===t?"क्या मेरे Lovable ऐप्स मेरी डिज़ाइन फ़ाइलों से मेल खाएँगे?":"id"===t?"Apakah aplikasi Lovable saya akan sesuai dengan file desain saya?":"th"===t?"แอป Lovable ของฉันจะตรงกับไฟล์ดีไซน์ของฉันไหม":"ko"===t?"Lovable 앱이 제 디자인 파일과 일치하나요?":"作成したLovableアプリはデザインファイルと一致しますか？"};e.s(["designersPage_faq1_question",0,uc],959287),e.i(959287);let uu=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Yes, you can hand off to developers at any time. Code can sync to GitHub from day one, so developers can pull it, review it, and extend it whenever you're ready.":"pt-BR"===t?"Sim, você pode entregar o projeto aos desenvolvedores a qualquer momento. O código pode ser sincronizado com o GitHub desde o primeiro dia, para que os desenvolvedores possam baixá-lo, revisá-lo e expandi-lo quando você quiser.":"de"===t?"Ja, du kannst die Übergabe an Entwickler jederzeit vornehmen. Der Code kann von Anfang an mit GitHub synchronisiert werden, sodass Entwickler ihn abrufen, prüfen und erweitern können, sobald du bereit bist.":"fr"===t?"Oui, vous pouvez transmettre le projet aux développeurs à tout moment. Le code peut être synchronisé avec GitHub dès le premier jour, afin que les développeurs puissent le récupérer, le relire et le faire évoluer quand vous le souhaitez.":"es"===t?"Sí, puedes entregar el proyecto a los desarrolladores en cualquier momento. El código puede sincronizarse con GitHub desde el primer día para que puedan clonarlo, revisarlo y ampliarlo cuando quieras.":"it"===t?"Sì, puoi passare il lavoro agli sviluppatori in qualsiasi momento. Il codice può sincronizzarsi con GitHub fin dal primo giorno, così gli sviluppatori possono scaricarlo, revisionarlo ed estenderlo quando vuoi.":"hi"===t?"हाँ, आप किसी भी समय काम डेवलपर्स को सौंप सकते हैं। कोड पहले दिन से GitHub से सिंक हो सकता है, ताकि डेवलपर्स उसे ले सकें, उसकी समीक्षा कर सकें और जब आप तैयार हों तो उसे आगे विकसित कर सकें।":"id"===t?"Ya, Anda bisa menyerahkannya kepada pengembang kapan saja. Kode dapat disinkronkan ke GitHub sejak hari pertama, sehingga pengembang dapat mengambil, meninjau, dan mengembangkannya kapan pun Anda siap.":"th"===t?"ได้ คุณสามารถส่งต่อให้นักพัฒนาได้ทุกเมื่อ โค้ดสามารถซิงก์กับ GitHub ได้ตั้งแต่วันแรก นักพัฒนาจึงดึงโค้ด รีวิว และต่อยอดได้เมื่อคุณพร้อม":"ko"===t?"네, 언제든지 개발자에게 인계할 수 있어요. 코드는 첫날부터 GitHub에 동기화할 수 있어서, 준비되면 개발자가 코드를 가져와 검토하고 확장할 수 있어요.":"はい、いつでも開発者に引き継げます。コードは初日からGitHubに同期できるので、必要なタイミングで開発者が取得し、レビューし、拡張できます。"};e.s(["designersPage_faq2_answer",0,uu],544216),e.i(544216);let ud=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Can I hand off to developers later?":"pt-BR"===t?"Posso entregar o projeto aos desenvolvedores depois?":"de"===t?"Kann ich später an Entwickler übergeben?":"fr"===t?"Puis-je transmettre le projet aux développeurs plus tard ?":"es"===t?"¿Puedo entregar el proyecto a los desarrolladores más adelante?":"it"===t?"Posso passare il lavoro agli sviluppatori in un secondo momento?":"hi"===t?"क्या मैं बाद में यह काम डेवलपर्स को सौंप सकता हूँ?":"id"===t?"Bisakah saya menyerahkannya kepada pengembang nanti?":"th"===t?"ฉันส่งต่อให้นักพัฒนาในภายหลังได้ไหม":"ko"===t?"나중에 개발자에게 인계할 수 있나요?":"後から開発者に引き継ぐことはできますか？"};e.s(["designersPage_faq2_question",0,ud],12837),e.i(12837);let up=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Lovable's tech stack is built on React, Supabase and Tailwind CSS. These are modern, well-documented tools that any developer can work with.":"pt-BR"===t?"A stack de tecnologia do Lovable é construída sobre React, Supabase e Tailwind CSS. São ferramentas modernas e bem documentadas com as quais qualquer desenvolvedor consegue trabalhar.":"de"===t?"Der Tech-Stack von Lovable basiert auf React, Supabase und Tailwind CSS. Das sind moderne, gut dokumentierte Tools, mit denen jeder Entwickler arbeiten kann.":"fr"===t?"La stack technique de Lovable repose sur React, Supabase et Tailwind CSS. Ce sont des outils modernes et bien documentés avec lesquels n'importe quel développeur peut travailler.":"es"===t?"La pila tecnológica de Lovable está construida sobre React, Supabase y Tailwind CSS. Son herramientas modernas y bien documentadas con las que puede trabajar cualquier desarrollador.":"it"===t?"Lo stack tecnologico di Lovable è basato su React, Supabase e Tailwind CSS. Sono strumenti moderni e ben documentati con cui qualsiasi sviluppatore può lavorare.":"hi"===t?"Lovable का टेक स्टैक React, Supabase और Tailwind CSS पर बना है। ये आधुनिक, अच्छी तरह डॉक्युमेंटेड टूल्स हैं जिनके साथ कोई भी डेवलपर काम कर सकता है।":"id"===t?"Teknologi yang digunakan Lovable dibangun di atas React, Supabase, dan Tailwind CSS. Ini adalah alat modern dengan dokumentasi yang baik dan dapat digunakan oleh pengembang mana pun.":"th"===t?"Lovable สร้างด้วย React, Supabase และ Tailwind CSS ซึ่งเป็นชุดเครื่องมือสมัยใหม่ที่มีเอกสารครบถ้วนและนักพัฒนาสามารถใช้งานต่อได้ง่าย":"ko"===t?"Lovable의 기술 스택은 React, Supabase, Tailwind CSS를 기반으로 해요. 모두 현대적이고 문서화가 잘 되어 있어 어떤 개발자든 다룰 수 있는 도구예요.":"Lovableの技術スタックはReact、Supabase、Tailwind CSSで構築されています。これらはモダンで十分にドキュメント化されたツールであり、どんな開発者でも扱えます。"};e.s(["designersPage_faq3_answer",0,up],764154),e.i(764154);let um=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"What tech stack does Lovable use?":"pt-BR"===t?"Qual stack de tecnologia o Lovable usa?":"de"===t?"Welchen Tech-Stack verwendet Lovable?":"fr"===t?"Quelle stack technique Lovable utilise-t-il ?":"es"===t?"¿Qué pila tecnológica usa Lovable?":"it"===t?"Quale stack tecnologico usa Lovable?":"hi"===t?"Lovable किस टेक स्टैक का उपयोग करता है?":"id"===t?"Teknologi apa yang digunakan Lovable?":"th"===t?"Lovable ใช้ชุดเทคโนโลยีอะไร":"ko"===t?"Lovable은 어떤 기술 스택을 사용하나요?":"Lovableはどんな技術スタックを使っていますか？"};e.s(["designersPage_faq3_question",0,um],553708),e.i(553708);let ug=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Figma prototyping creates clickable prototypes without backend functionality. Lovable differs as it creates a working code with databases, authentication, integrations and APIs. With Lovable you can ship real products to production, not just stakeholder demos.":"pt-BR"===t?"A prototipagem no Figma cria protótipos clicáveis sem funcionalidade de backend. O Lovable é diferente porque cria um código funcional com bancos de dados, autenticação, integrações e APIs. Com o Lovable, você pode lançar produtos reais em produção, não apenas demonstrações para partes interessadas.":"de"===t?"Figma-Prototyping erstellt klickbare Prototypen ohne Backend-Funktionalität. Lovable unterscheidet sich davon, indem es funktionierenden Code mit Datenbanken, Authentifizierung, Integrationen und APIs erstellt. Mit Lovable kannst du echte Produkte in die Produktion bringen – nicht nur Demos für Stakeholder.":"fr"===t?"Le prototypage Figma crée des prototypes cliquables sans fonctionnalités côté serveur. Lovable se distingue en créant une application fonctionnelle avec bases de données, authentification, intégrations et API. Avec Lovable, vous pouvez déployer de vrais produits en production, et pas seulement des démos pour les parties prenantes.":"es"===t?"El prototipado en Figma crea prototipos interactivos sin funcionalidad de servidor. Lovable se diferencia porque genera código funcional con bases de datos, autenticación, integraciones y API. Con Lovable puedes lanzar productos reales a producción, no solo demostraciones para las partes interesadas.":"it"===t?"La prototipazione con Figma crea prototipi cliccabili senza funzionalità di backend. Lovable è diverso perché crea codice funzionante con database, autenticazione, integrazioni e API. Con Lovable puoi pubblicare prodotti reali in produzione, non solo demo per gli stakeholder.":"hi"===t?"Figma प्रोटोटाइपिंग बैकएंड कार्यक्षमता के बिना क्लिक करने योग्य प्रोटोटाइप बनाती है। Lovable इससे अलग है क्योंकि यह डेटाबेस, ऑथेंटिकेशन, इंटीग्रेशन और API के साथ चलने वाला कोड बनाती है। Lovable के साथ आप सिर्फ़ स्टेकहोल्डर डेमो ही नहीं, बल्कि असली प्रोडक्ट को प्रोडक्शन में भेज सकते हैं।":"id"===t?"Pembuatan prototipe di Figma menghasilkan prototipe yang bisa diklik tanpa fungsionalitas backend. Lovable berbeda karena menghasilkan kode yang berfungsi dengan basis data, autentikasi, integrasi, dan API. Dengan Lovable, Anda bisa merilis produk nyata ke produksi, bukan sekadar demo untuk pemangku kepentingan.":"th"===t?"การสร้างต้นแบบใน Figma สร้างต้นแบบที่คลิกได้แต่ไม่มีฟังก์ชันฝั่งแบ็กเอนด์ Lovable แตกต่างออกไปเพราะสร้างโค้ดที่ใช้งานได้จริงพร้อมฐานข้อมูล การยืนยันตัวตน การเชื่อมต่อ และ API ด้วย Lovable คุณสามารถส่งผลิตภัณฑ์จริงขึ้นสู่การใช้งานได้ ไม่ใช่แค่เดโมสำหรับผู้มีส่วนได้ส่วนเสีย":"ko"===t?"Figma 프로토타이핑은 백엔드 기능 없이 클릭 가능한 프로토타입을 만들어요. Lovable은 데이터베이스, 인증, 통합, API를 갖춘 실제 작동하는 코드를 만든다는 점에서 달라요. Lovable로는 이해관계자용 데모뿐만 아니라 실제 제품을 프로덕션에 배포할 수 있어요.":"Figmaのプロトタイピングは、バックエンド機能のないクリック可能なプロトタイプを作成します。Lovableはこれと異なり、データベース、認証、連携、APIを備えた動作するコードを作成します。Lovableなら、関係者向けのデモにとどまらず、本物のプロダクトを本番環境にリリースできます。"};e.s(["designersPage_faq4_answer",0,ug],781521),e.i(781521);let ub=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"How is this different from Figma prototyping?":"pt-BR"===t?"Como isso é diferente da prototipagem no Figma?":"de"===t?"Wie unterscheidet sich das vom Figma-Prototyping?":"fr"===t?"En quoi est-ce différent du prototypage Figma ?":"es"===t?"¿En qué se diferencia esto del prototipado en Figma?":"it"===t?"In cosa è diverso dalla prototipazione con Figma?":"hi"===t?"यह Figma प्रोटोटाइपिंग से कैसे अलग है?":"id"===t?"Apa bedanya ini dengan pembuatan prototipe di Figma?":"th"===t?"สิ่งนี้แตกต่างจากการสร้างต้นแบบใน Figma อย่างไร":"ko"===t?"Figma 프로토타이핑과는 어떻게 다른가요?":"Figmaのプロトタイピングとどう違うのですか？"};e.s(["designersPage_faq4_question",0,ub],224897),e.i(224897);let uh=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Lovable differs from Webflow and Framer in that it builds full-stack apps with backends. Webflow and Framer build marketing sites only. Different tools for different jobs.":"pt-BR"===t?"O Lovable se diferencia do Webflow e do Framer porque cria aplicativos full-stack com back-end. O Webflow e o Framer criam apenas sites de marketing. Ferramentas diferentes para necessidades diferentes.":"de"===t?"Lovable unterscheidet sich von Webflow und Framer dadurch, dass es Full-Stack-Apps mit Backends erstellt. Webflow und Framer erstellen nur Marketing-Websites. Unterschiedliche Tools für unterschiedliche Aufgaben.":"fr"===t?"Lovable se distingue de Webflow et Framer parce qu'il crée des applications complètes avec une partie serveur. Webflow et Framer ne créent que des sites marketing. Des outils différents pour des besoins différents.":"es"===t?"Lovable se diferencia de Webflow y Framer en que crea aplicaciones completas con servidor incluido. Webflow y Framer solo crean sitios de marketing. Herramientas distintas para tareas distintas.":"it"===t?"Lovable si distingue da Webflow e Framer perché crea app full-stack con backend. Webflow e Framer creano solo siti di marketing. Strumenti diversi per lavori diversi.":"hi"===t?"Lovable, Webflow और Framer से इस मायने में अलग है कि यह बैकएंड के साथ फ़ुल-स्टैक ऐप्स बनाता है। Webflow और Framer सिर्फ़ मार्केटिंग साइट्स बनाते हैं। अलग कामों के लिए अलग टूल्स।":"id"===t?"Lovable berbeda dari Webflow dan Framer karena membangun aplikasi full-stack dengan backend. Webflow dan Framer hanya membangun situs pemasaran. Alat berbeda untuk kebutuhan berbeda.":"th"===t?"Lovable แตกต่างจาก Webflow และ Framer ตรงที่สร้างแอปแบบฟูลสแตกพร้อมแบ็กเอนด์ ส่วน Webflow และ Framer สร้างได้เฉพาะเว็บไซต์การตลาด เครื่องมือต่างกันสำหรับงานที่ต่างกัน":"ko"===t?"Lovable은 백엔드를 갖춘 풀스택 앱을 만든다는 점에서 Webflow나 Framer와 달라요. Webflow와 Framer는 마케팅 사이트만 만들어요. 용도에 따라 도구가 다른 거죠.":"Lovableは、バックエンドを備えたフルスタックアプリを構築する点でWebflowやFramerと異なります。WebflowとFramerはマーケティングサイトのみを構築します。用途が違えば、適したツールも異なります。"};e.s(["designersPage_faq5_answer",0,uh],142417),e.i(142417);let uv=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"How is this different from Webflow or Framer?":"pt-BR"===t?"Como isso é diferente do Webflow ou do Framer?":"de"===t?"Wie unterscheidet sich das von Webflow oder Framer?":"fr"===t?"En quoi est-ce différent de Webflow ou Framer ?":"es"===t?"¿En qué se diferencia esto de Webflow o Framer?":"it"===t?"In cosa è diverso da Webflow o Framer?":"hi"===t?"यह Webflow या Framer से कैसे अलग है?":"id"===t?"Apa bedanya ini dengan Webflow atau Framer?":"th"===t?"สิ่งนี้แตกต่างจาก Webflow หรือ Framer อย่างไร":"ko"===t?"Webflow나 Framer와는 어떻게 다른가요?":"WebflowやFramerとどう違うのですか？"};e.s(["designersPage_faq5_question",0,uv],86650),e.i(86650);let u_=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Frequently asked questions":"pt-BR"===t?"Perguntas frequentes":"de"===t?"Häufig gestellte Fragen":"fr"===t?"Questions fréquentes":"es"===t?"Preguntas frecuentes":"it"===t?"Domande frequenti":"hi"===t?"अक्सर पूछे जाने वाले सवाल":"id"===t?"Pertanyaan yang sering diajukan":"th"===t?"คำถามที่พบบ่อย":"ko"===t?"자주 묻는 질문":"よくある質問"};e.s(["designersPage_faqTitle",0,u_],371018),e.i(371018);let uf=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Static screens don't show what happens when data is missing, a user makes a mistake, or permissions change. Prototype flows with real state, logic, and role-based behavior so you can test interaction decisions, not just visual polish.":"pt-BR"===t?"Telas estáticas não mostram o que acontece quando faltam dados, quando um usuário comete um erro ou quando as permissões mudam. Prototipe fluxos com estado, lógica e comportamento baseado em funções reais para testar decisões de interação, não apenas o acabamento visual.":"de"===t?"Statische Screens zeigen nicht, was passiert, wenn Daten fehlen, ein Nutzer einen Fehler macht oder sich Berechtigungen ändern. Erstelle Prototypen von Abläufen mit echtem Zustand, Logik und rollenbasiertem Verhalten, damit du Interaktionsentscheidungen testen kannst – nicht nur den optischen Feinschliff.":"fr"===t?"Les écrans statiques ne montrent pas ce qui se passe lorsqu'une donnée est manquante, qu'un utilisateur fait une erreur ou que les permissions changent. Prototypez des parcours avec un état réel, une logique réelle et des comportements fondés sur les rôles, afin de tester vos décisions d'interaction, et pas seulement la finition visuelle.":"es"===t?"Las pantallas estáticas no muestran qué ocurre cuando faltan datos, un usuario comete un error o cambian los permisos. Prototipa flujos con estado, lógica y comportamiento basado en roles reales para que puedas probar decisiones de interacción, no solo el acabado visual.":"it"===t?"Le schermate statiche non mostrano cosa succede quando mancano dei dati, quando un utente commette un errore o quando cambiano i permessi. Prototipa flussi con stato reale, logica reale e comportamenti basati sui ruoli, così puoi testare le decisioni di interazione e non solo la cura visiva.":"hi"===t?"स्टैटिक स्क्रीन यह नहीं दिखातीं कि जब डेटा गायब हो, यूज़र कोई गलती करे, या अनुमतियाँ बदल जाएँ तो क्या होता है। असली स्टेट, लॉजिक और रोल-आधारित व्यवहार के साथ फ़्लो प्रोटोटाइप करें, ताकि आप सिर्फ़ विज़ुअल फ़िनिशिंग ही नहीं, बल्कि इंटरैक्शन से जुड़े फ़ैसले भी टेस्ट कर सकें।":"id"===t?"Layar statis tidak menunjukkan apa yang terjadi saat data tidak ada, pengguna melakukan kesalahan, atau izin berubah. Buat prototipe alur dengan status, logika, dan perilaku berbasis peran yang nyata sehingga Anda bisa menguji keputusan interaksi, bukan sekadar tampilan visual.":"th"===t?"หน้าจอแบบสแตติกไม่แสดงสิ่งที่จะเกิดขึ้นเมื่อไม่มีข้อมูล ผู้ใช้ทำผิดพลาด หรือสิทธิ์การเข้าถึงเปลี่ยนไป สร้างต้นแบบโฟลว์ด้วยสถานะ ตรรกะ และพฤติกรรมตามบทบาทจริง เพื่อให้คุณทดสอบการตัดสินใจเกี่ยวกับการใช้งานได้ ไม่ใช่แค่ความสวยงามของหน้าจอ":"ko"===t?"정적인 화면은 데이터가 없거나, 사용자가 실수하거나, 권한이 바뀔 때 어떤 일이 생기는지 보여주지 못해요. 실제 상태, 로직, 역할 기반 동작이 담긴 플로우를 프로토타이핑하면 시각적 완성도뿐 아니라 인터랙션 결정까지 테스트할 수 있어요.":"静的な画面では、データが欠けているとき、ユーザーがミスをしたとき、権限が変わったときに何が起こるかを示せません。実際の状態、ロジック、役割に応じた挙動を伴うフローをプロトタイプ化することで、見た目の仕上がりだけでなく、操作上の判断もテストできます。"};e.s(["designersPage_feature1_description",0,uf],912452),e.i(912452);let uk=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Prototype behavior, not just layout":"pt-BR"===t?"Prototipe o comportamento, não apenas o layout":"de"===t?"Verhalten prototypisieren, nicht nur das Layout":"fr"===t?"Prototypez le comportement, pas seulement la mise en page":"es"===t?"Prototipa el comportamiento, no solo el diseño":"it"===t?"Prototipa il comportamento, non solo il layout":"hi"===t?"सिर्फ़ लेआउट नहीं, व्यवहार का प्रोटोटाइप बनाएँ":"id"===t?"Buat prototipe perilaku, bukan hanya tata letak":"th"===t?"สร้างต้นแบบพฤติกรรม ไม่ใช่แค่เลย์เอาต์":"ko"===t?"레이아웃이 아닌 동작을 프로토타이핑하세요":"レイアウトだけでなく、挙動をプロトタイプする"};e.s(["designersPage_feature1_title",0,uk],318187),e.i(318187);let uL=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Most product risk lives in the edge cases: error states, loading, retries, empty dashboards, and partial setup. Prototype those scenarios directly so teams can agree on expected behavior before implementation work begins.":"pt-BR"===t?"A maior parte do risco do produto está nos casos extremos: estados de erro, carregamento, novas tentativas, painéis vazios e configuração parcial. Prototipe esses cenários diretamente para que as equipes possam concordar sobre o comportamento esperado antes do início da implementação.":"de"===t?"Das größte Produktrisiko steckt in den Randfällen: Fehlerzustände, Ladevorgänge, Wiederholungsversuche, leere Dashboards und unvollständige Einrichtung. Erstelle Prototypen dieser Szenarien direkt, damit sich Teams auf das erwartete Verhalten einigen können, bevor die Umsetzung beginnt.":"fr"===t?"La plupart des risques produit se cachent dans les cas limites : états d'erreur, chargement, nouvelles tentatives, tableaux de bord vides et configurations partielles. Prototypez ces scénarios directement pour que les équipes s'accordent sur le comportement attendu avant le début de l'implémentation.":"es"===t?"La mayor parte del riesgo del producto está en los casos límite: estados de error, carga, reintentos, paneles vacíos y configuraciones parciales. Prototipa esos escenarios directamente para que los equipos puedan acordar el comportamiento esperado antes de que comience la implementación.":"it"===t?"Gran parte del rischio di prodotto risiede nei casi limite: stati di errore, caricamento, nuovi tentativi, dashboard vuote e configurazioni parziali. Prototipa direttamente questi scenari, così i team possono concordare il comportamento atteso prima che inizi l'implementazione.":"hi"===t?"ज़्यादातर प्रोडक्ट जोखिम एज केस में छिपा होता है: एरर स्टेट, लोडिंग, रिट्राई, खाली डैशबोर्ड और अधूरा सेटअप। इन परिदृश्यों को सीधे प्रोटोटाइप करें, ताकि टीमें इम्प्लीमेंटेशन शुरू होने से पहले अपेक्षित व्यवहार पर सहमत हो सकें।":"id"===t?"Sebagian besar risiko produk ada pada skenario kasus khusus: status kesalahan, pemuatan, percobaan ulang, dasbor kosong, dan penyiapan parsial. Buat prototipe skenario tersebut secara langsung agar tim bisa menyepakati perilaku yang diharapkan sebelum pekerjaan implementasi dimulai.":"th"===t?"ความเสี่ยงของผลิตภัณฑ์ส่วนใหญ่อยู่ในกรณีขอบ เช่น สถานะข้อผิดพลาด การโหลด การลองใหม่ แดชบอร์ดว่าง และการตั้งค่าที่ยังไม่สมบูรณ์ สร้างต้นแบบสถานการณ์เหล่านี้โดยตรง เพื่อให้ทีมตกลงพฤติกรรมที่คาดหวังได้ก่อนเริ่มพัฒนา":"ko"===t?"제품 리스크의 대부분은 엣지 케이스에 숨어 있어요. 오류 상태, 로딩, 재시도, 빈 대시보드, 부분적인 설정 같은 것들이죠. 이런 시나리오를 직접 프로토타이핑하면 구현 작업을 시작하기 전에 팀이 기대 동작에 합의할 수 있어요.":"プロダクトのリスクの多くは、エラー状態、読み込み中、リトライ、空のダッシュボード、設定途中といったエッジケースに潜んでいます。こうしたシナリオを直接プロトタイプ化することで、実装作業が始まる前にチームで期待する挙動について合意できます。"};e.s(["designersPage_feature2_description",0,uL],541357),e.i(541357);let uP=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?'Design the "unhappy paths"':"pt-BR"===t?"Projete os caminhos de exceção":"de"===t?"Gestalte die Problemfälle":"fr"===t?"Concevez les « parcours problématiques »":"es"===t?"Diseña los casos problemáticos":"it"===t?"Progetta gli scenari negativi":"hi"===t?"समस्या वाले फ़्लो भी डिज़ाइन करें":"id"===t?'Rancang "alur yang tidak ideal"':"th"===t?'ออกแบบ "เส้นทางที่ไม่ราบรื่น"':"ko"===t?'"예외 상황"까지 디자인하세요':"エラーや例外パターンをデザインする"};e.s(["designersPage_feature2_title",0,uP],218929),e.i(218929);let uy=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Many products behave differently depending on who's using them. Prototype admin vs member flows, gated actions, and restricted views so stakeholders can evaluate UX tradeoffs and feasibility without a long spec thread.":"pt-BR"===t?"Muitos produtos se comportam de forma diferente dependendo de quem os usa. Prototipe fluxos de administrador e membro, ações restritas e visualizações limitadas para que as partes interessadas possam avaliar as decisões de UX e a viabilidade sem uma longa troca de especificações.":"de"===t?"Viele Produkte verhalten sich je nach Nutzer unterschiedlich. Erstelle Prototypen von Abläufen für Admins und Mitglieder, eingeschränkten Aktionen und geschützten Ansichten, damit Stakeholder UX-Kompromisse und Machbarkeit bewerten können – ohne langwierige Spezifikationsdiskussionen.":"fr"===t?"De nombreux produits se comportent différemment selon qui les utilise. Prototypez les parcours administrateur et membre, les actions restreintes et les vues limitées afin que les parties prenantes puissent évaluer les compromis UX et la faisabilité sans un long échange de spécifications.":"es"===t?"Muchos productos se comportan de forma diferente según quién los use. Prototipa flujos para administradores y miembros, acciones con permisos y vistas restringidas para que las partes interesadas puedan evaluar los compromisos de UX y la viabilidad sin un largo hilo de especificaciones.":"it"===t?"Molti prodotti si comportano in modo diverso a seconda di chi li usa. Prototipa i flussi admin rispetto a quelli dei membri, le azioni vincolate e le viste con restrizioni, così gli stakeholder possono valutare i compromessi di UX e la fattibilità senza un lungo scambio di specifiche.":"hi"===t?"कई प्रोडक्ट इस आधार पर अलग व्यवहार करते हैं कि उन्हें कौन इस्तेमाल कर रहा है। एडमिन बनाम मेंबर फ़्लो, गेटेड एक्शन और प्रतिबंधित व्यू को प्रोटोटाइप करें, ताकि स्टेकहोल्डर लंबे स्पेक थ्रेड के बिना UX ट्रेडऑफ़ और व्यवहार्यता का आकलन कर सकें।":"id"===t?"Banyak produk berperilaku berbeda tergantung siapa yang menggunakannya. Buat prototipe alur untuk admin dan anggota, tindakan yang dibatasi, dan tampilan terbatas sehingga pemangku kepentingan bisa mengevaluasi kompromi UX dan kelayakan tanpa rangkaian spesifikasi yang panjang.":"th"===t?"ผลิตภัณฑ์จำนวนมากทำงานแตกต่างกันตามผู้ใช้งาน สร้างต้นแบบโฟลว์ของผู้ดูแลระบบและสมาชิก การดำเนินการที่ต้องมีสิทธิ์ และมุมมองที่ถูกจำกัด เพื่อให้ผู้มีส่วนได้ส่วนเสียประเมินข้อแลกเปลี่ยนด้าน UX และความเป็นไปได้ได้โดยไม่ต้องอ่านสเปคยาว ๆ":"ko"===t?"많은 제품이 사용자에 따라 다르게 동작해요. 관리자와 구성원 각각의 플로우, 제한된 액션, 접근이 막힌 화면을 프로토타이핑하면 이해관계자가 긴 사양서 없이도 UX 절충점과 실현 가능성을 평가할 수 있어요.":"多くのプロダクトは、誰が使うかによって挙動が変わります。管理者とメンバーのフロー、制限されたアクション、表示の制約をプロトタイプ化することで、関係者は長い仕様のやり取りなしにUXのトレードオフや実現性を評価できます。"};e.s(["designersPage_feature3_description",0,uy],152960),e.i(152960);let uS=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Model permissions and access":"pt-BR"===t?"Modele permissões e acesso":"de"===t?"Berechtigungen und Zugriff modellieren":"fr"===t?"Modélisez les permissions et les accès":"es"===t?"Modela permisos y acceso":"it"===t?"Modella permessi e accessi":"hi"===t?"अनुमतियों और एक्सेस को मॉडल करें":"id"===t?"Modelkan izin dan akses":"th"===t?"จำลองสิทธิ์และการเข้าถึง":"ko"===t?"권한과 접근을 모델링하세요":"権限とアクセスをモデル化する"};e.s(["designersPage_feature3_title",0,uS],576899),e.i(576899);let uw=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Onboarding is where intent meets reality: step order, required inputs, defaults, and drop-off points. Build onboarding flows with branching paths and setup steps so you can evaluate whether the product feels understandable and complete.":"pt-BR"===t?"O onboarding é onde a intenção encontra a realidade: ordem das etapas, entradas obrigatórias, padrões e pontos de desistência. Crie fluxos de onboarding com caminhos ramificados e etapas de configuração para avaliar se o produto parece compreensível e completo.":"de"===t?"Beim Onboarding trifft die Absicht auf die Realität: Reihenfolge der Schritte, erforderliche Eingaben, Standardwerte und Absprungpunkte. Erstelle Onboarding-Abläufe mit verzweigten Pfaden und Einrichtungsschritten, damit du beurteilen kannst, ob sich das Produkt verständlich und vollständig anfühlt.":"fr"===t?"L'accueil des nouveaux utilisateurs est le moment où l'intention rencontre la réalité : ordre des étapes, champs obligatoires, valeurs par défaut et points d'abandon. Construisez des parcours d'accueil avec des chemins ramifiés et des étapes de configuration afin d'évaluer si le produit semble compréhensible et complet.":"es"===t?"La incorporación de usuarios es donde la intención se pone a prueba: el orden de los pasos, los campos obligatorios, los valores predeterminados y los puntos de abandono. Crea flujos de incorporación con caminos ramificados y pasos de configuración para evaluar si el producto resulta comprensible y completo.":"it"===t?"L'onboarding è dove l'intento incontra la realtà: ordine dei passaggi, input richiesti, valori predefiniti e punti di abbandono. Crea flussi di onboarding con percorsi ramificati e passaggi di configurazione, così puoi valutare se il prodotto risulta comprensibile e completo.":"hi"===t?"ऑनबोर्डिंग वह जगह है जहाँ इरादा हकीकत से मिलता है: स्टेप का क्रम, ज़रूरी इनपुट, डिफ़ॉल्ट और ड्रॉप-ऑफ़ पॉइंट। ब्रांचिंग पाथ और सेटअप स्टेप्स के साथ ऑनबोर्डिंग फ़्लो बनाएँ, ताकि आप आकलन कर सकें कि प्रोडक्ट समझ में आने योग्य और पूरा लगता है या नहीं।":"id"===t?"Orientasi pengguna adalah titik ketika niat bertemu kenyataan: urutan langkah, masukan yang diperlukan, nilai bawaan, dan titik ketika pengguna berhenti. Bangun alur orientasi dengan jalur bercabang dan langkah penyiapan sehingga Anda bisa mengevaluasi apakah produk terasa mudah dipahami dan lengkap.":"th"===t?"การออนบอร์ดคือจุดที่เจตนามาบรรจบกับความเป็นจริง ทั้งลำดับขั้นตอน อินพุตที่จำเป็น ค่าเริ่มต้น และจุดที่ผู้ใช้เลิกใช้งาน สร้างโฟลว์การออนบอร์ดด้วยเส้นทางแบบแยกสาขาและขั้นตอนการตั้งค่า เพื่อให้คุณประเมินได้ว่าผลิตภัณฑ์เข้าใจง่ายและครบถ้วนหรือไม่":"ko"===t?"온보딩은 의도가 현실과 만나는 지점이에요. 단계 순서, 필수 입력, 기본값, 이탈 지점 등이 모이죠. 분기 경로와 설정 단계가 포함된 온보딩 플로우를 만들면 제품이 이해하기 쉽고 완성도 있게 느껴지는지 평가할 수 있어요.":"オンボーディングでは、意図した体験が実際に機能するかが問われます。ステップの順序、必須の入力項目、デフォルト値、離脱ポイントなどが重要になります。分岐するパスと設定ステップを備えたオンボーディングフローを構築することで、プロダクトが分かりやすく、完成度が高いと感じられるかどうかを評価できます。"};e.s(["designersPage_feature4_description",0,uw],193135),e.i(193135);let uz=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Prototype time-to-value":"pt-BR"===t?"Prototipe o caminho até o valor":"de"===t?"Zeit bis zum Mehrwert prototypisieren":"fr"===t?"Prototypez le délai d'obtention de valeur":"es"===t?"Prototipa el recorrido hasta el primer valor":"it"===t?"Prototipa il tempo al valore":"hi"===t?"मूल्य तक पहुँचने का समय प्रोटोटाइप करें":"id"===t?"Buat prototipe waktu hingga pengguna merasakan manfaat":"th"===t?"สร้างต้นแบบเส้นทางสู่คุณค่าแรก":"ko"===t?"가치 실현까지의 시간을 프로토타이핑하세요":"価値を感じるまでの流れをプロトタイプする"};e.s(["designersPage_feature4_title",0,uz],235876),e.i(235876);let uA=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Design intent often gets lost between Figma frames, tickets, and meetings. A working prototype gives teams a shared reference point: what happens, when it happens, and what changes after each action.":"pt-BR"===t?"A intenção de design muitas vezes se perde entre os frames do Figma, os tickets e as reuniões. Um protótipo funcional dá às equipes um ponto de referência compartilhado: o que acontece, quando acontece e o que muda após cada ação.":"de"===t?"Die Designabsicht geht oft zwischen Figma-Frames, Tickets und Meetings verloren. Ein funktionierender Prototyp gibt Teams einen gemeinsamen Bezugspunkt: was passiert, wann es passiert und was sich nach jeder Aktion ändert.":"fr"===t?"L'intention de design se perd souvent entre les écrans Figma, les tickets et les réunions. Un prototype fonctionnel offre aux équipes un point de référence commun : ce qui se passe, quand cela se passe et ce qui change après chaque action.":"es"===t?"La intención de diseño suele perderse entre las pantallas de Figma, los tickets y las reuniones. Un prototipo funcional ofrece a los equipos un punto de referencia común: qué ocurre, cuándo ocurre y qué cambia después de cada acción.":"it"===t?"L'intento progettuale spesso si perde tra i frame di Figma, i ticket e le riunioni. Un prototipo funzionante offre ai team un punto di riferimento comune: cosa succede, quando succede e cosa cambia dopo ogni azione.":"hi"===t?"डिज़ाइन का इरादा अक्सर Figma फ़्रेम्स, टिकट्स और मीटिंग्स के बीच खो जाता है। एक चलता हुआ प्रोटोटाइप टीमों को एक साझा संदर्भ बिंदु देता है: क्या होता है, कब होता है, और हर एक्शन के बाद क्या बदलता है।":"id"===t?"Maksud desain sering hilang di antara bingkai Figma, tiket, dan rapat. Prototipe yang berfungsi memberi tim titik acuan bersama: apa yang terjadi, kapan terjadi, dan apa yang berubah setelah setiap aksi.":"th"===t?"เจตนาของดีไซน์มักหายไประหว่างเฟรมใน Figma ทิกเก็ต และการประชุม ต้นแบบที่ใช้งานได้ช่วยให้ทีมมีจุดอ้างอิงร่วมกันว่าอะไรเกิดขึ้น เกิดขึ้นเมื่อไร และอะไรเปลี่ยนไปหลังจากแต่ละการกระทำ":"ko"===t?"디자인 의도는 Figma 프레임, 티켓, 회의 사이에서 종종 사라져 버려요. 작동하는 프로토타입은 팀에게 공통의 기준점을 제공해요. 무슨 일이, 언제 일어나고, 각 동작 후에 무엇이 바뀌는지 말이죠.":"デザインの意図は、Figmaのフレーム、チケット、ミーティングの間で見失われがちです。動作するプロトタイプは、何が起こるのか、いつ起こるのか、各アクションの後で何が変わるのかという、チーム共通の参照点になります。"};e.s(["designersPage_feature5_description",0,uA],779423),e.i(779423);let uq=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Replace interpretation with something clickable":"pt-BR"===t?"Substitua a interpretação por algo clicável":"de"===t?"Ersetze Interpretation durch etwas Klickbares":"fr"===t?"Remplacez l'interprétation par quelque chose de cliquable":"es"===t?"Reemplaza la interpretación por algo clicable":"it"===t?"Sostituisci l'interpretazione con qualcosa di cliccabile":"hi"===t?"अनुमान की जगह क्लिक करने योग्य प्रोटोटाइप दें":"id"===t?"Ganti interpretasi dengan sesuatu yang bisa diklik":"th"===t?"แทนที่การตีความด้วยสิ่งที่คลิกได้":"ko"===t?"해석 대신 클릭할 수 있는 것으로 대체하세요":"解釈ではなく、クリックできるものを共有する"};e.s(["designersPage_feature5_title",0,uq],603098),e.i(603098);var ux=e.i(450207),uC=e.i(147389),uB=e.i(241020),uR=e.i(88610),uT=e.i(719158);let uI=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Bring your designs to life with Lovable. Get full visual control, AI image generation, and production-ready prototypes without waiting on engineering.":"pt-BR"===t?"Dê vida aos seus projetos com o Lovable. Tenha controle visual total, geração de imagens com IA e protótipos prontos para produção sem depender da engenharia.":"de"===t?"Erwecke deine Designs mit Lovable zum Leben. Erhalte volle visuelle Kontrolle, KI-Bildgenerierung und produktionsreife Prototypen, ohne auf die Entwicklung warten zu müssen.":"fr"===t?"Donnez vie à vos designs avec Lovable. Profitez d'un contrôle visuel total, de la génération d'images par IA et de prototypes prêts pour la production, sans attendre l'équipe technique.":"es"===t?"Da vida a tus diseños con Lovable. Obtén control visual total, generación de imágenes con IA y prototipos listos para producción sin esperar a ingeniería.":"it"===t?"Dai vita ai tuoi design con Lovable. Ottieni il pieno controllo visivo, la generazione di immagini con l'AI e prototipi pronti per la produzione senza aspettare lo sviluppo.":"hi"===t?"Lovable के साथ अपने डिज़ाइन को साकार करें. इंजीनियरिंग का इंतज़ार किए बिना पूरा दृश्य नियंत्रण, AI से इमेज बनाना, और प्रोडक्शन के लिए तैयार प्रोटोटाइप पाएँ.":"id"===t?"Wujudkan desain Anda bersama Lovable. Dapatkan kontrol visual penuh, pembuatan gambar dengan AI, dan prototipe siap produksi tanpa menunggu tim teknis.":"th"===t?"เปลี่ยนงานออกแบบของคุณให้เป็นจริงด้วย Lovable ควบคุมงานภาพได้เต็มที่ สร้างภาพด้วย AI และได้ต้นแบบพร้อมใช้งานจริงโดยไม่ต้องรอทีมวิศวกรรม":"ko"===t?"Lovable로 디자인을 현실로 구현하세요. 엔지니어링을 기다릴 필요 없이 완벽한 시각적 제어, AI 이미지 생성, 그리고 바로 사용할 수 있는 프로토타입을 만나보세요.":"Lovableでデザインを形にしましょう。完全なビジュアルコントロール、AIによる画像生成、そしてエンジニアリングを待たずに本番環境対応のプロトタイプを実現できます。"};e.s(["designersPage_meta_description",0,uI],702083),e.i(702083);let uj=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"AI Tools for Designers | Best No-Code App Builder for Designers | Lovable":"pt-BR"===t?"Ferramentas de IA para designers | Melhor criador de aplicativos sem código para designers | Lovable":"de"===t?"KI-Tools für Designer | Bester No-Code-App-Builder für Designer | Lovable":"fr"===t?"Outils IA pour designers | Le meilleur créateur d'applications sans code pour designers | Lovable":"es"===t?"Herramientas de IA para diseñadores | El mejor creador de apps sin código para diseñadores | Lovable":"it"===t?"Strumenti AI per designer | Il miglior strumento no-code per creare app per designer | Lovable":"hi"===t?"डिज़ाइनरों के लिए AI टूल | डिज़ाइनरों के लिए बेहतरीन नो-कोड ऐप बिल्डर | Lovable":"id"===t?"Alat AI untuk Desainer | Pembuat Aplikasi Tanpa Kode Terbaik untuk Desainer | Lovable":"th"===t?"เครื่องมือ AI สำหรับนักออกแบบ | เครื่องมือสร้างแอปแบบไม่ต้องเขียนโค้ดที่ดีที่สุดสำหรับนักออกแบบ | Lovable":"ko"===t?"디자이너를 위한 AI 도구 | 디자이너를 위한 최고의 노코드 앱 빌더 | Lovable":"デザイナー向けAIツール | デザイナーに最適なノーコードアプリビルダー | Lovable"};e.s(["designersPage_meta_title",0,uj],592503),e.i(592503);let uD=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Screens aren't enough":"pt-BR"===t?"Telas não são suficientes":"de"===t?"Screens reichen nicht aus":"fr"===t?"Les écrans ne suffisent pas":"es"===t?"Las pantallas no bastan":"it"===t?"Le schermate non bastano":"hi"===t?"सिर्फ़ स्क्रीन काफ़ी नहीं हैं":"id"===t?"Tampilan layar saja tidak cukup":"th"===t?"แค่หน้าจอไม่เพียงพอ":"ko"===t?"화면만으로는 충분하지 않아요":"画面だけでは足りません"};e.s(["designersPage_section_title",0,uD],631528),e.i(631528);let uE=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Come build":"pt-BR"===t?"Venha criar":"de"===t?"Baue etwas mit":"fr"===t?"Venez créer":"es"===t?"Ven a crear":"it"===t?"Vieni a creare":"hi"===t?"आइए कुछ Lovable":"id"===t?"Mari buat":"th"===t?"มาสร้าง":"ko"===t?"함께 만들어요":"さあ、つくろう"};e.s(["discordPage_build_titleLine1",0,uE],865378),e.i(865378);let uM=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"something Lovable":"pt-BR"===t?"algo com Lovable":"de"===t?"Lovable":"fr"===t?"quelque chose avec Lovable":"es"===t?"algo con Lovable":"it"===t?"qualcosa con Lovable":"hi"===t?"बनाएँ":"id"===t?"sesuatu dengan Lovable":"th"===t?"สิ่งดี ๆ ด้วย Lovable":"ko"===t?"Lovable로 멋진 것을 만들어 보세요":"Lovableで何かを"};e.s(["discordPage_build_titleLine2",0,uM],220322),e.i(220322);var uG=e.i(353947),uO=e.i(52520),uN=e.i(179488),uF=e.i(194926),uH=e.i(719241),uW=e.i(170482),uU=e.i(31644),uV=e.i(784044),uK=e.i(691372),u$=e.i(599845),uQ=e.i(614011),uY=e.i(858539),uJ=e.i(798168),uZ=e.i(502123),uX=e.i(980146);let u0=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"The Lovable Discord is the online home of the Lovable community. It's a space for builders and creators of all skill levels to connect, share their work, and grow together. Whether you're just getting started or building for clients, there's a place for you here.":"pt-BR"===t?"O Discord da Lovable é a casa online da comunidade Lovable. É um espaço para criadores de todos os níveis se conectarem, compartilharem seu trabalho e crescerem juntos. Seja você iniciante ou alguém que cria projetos para clientes, há um lugar para você aqui.":"de"===t?"Der Lovable Discord ist die Online-Heimat der Lovable-Community. Er ist ein Ort für Entwicklerinnen, Entwickler und Kreative aller Erfahrungsstufen, um sich zu vernetzen, ihre Arbeit zu teilen und gemeinsam zu wachsen. Egal, ob du gerade erst anfängst oder Projekte für Kunden umsetzt – hier ist Platz für dich.":"fr"===t?"Le Discord de Lovable est le point de rassemblement en ligne de la communauté Lovable. C'est un espace où les créateurs de tous niveaux peuvent échanger, partager leur travail et progresser ensemble. Que vous débutiez ou que vous travailliez pour des clients, vous avez votre place ici.":"es"===t?"El Discord de Lovable es el hogar en línea de la comunidad de Lovable. Es un espacio para que creadores de todos los niveles se conecten, compartan su trabajo y crezcan juntos. Tanto si estás empezando como si creas proyectos para clientes, aquí tienes tu lugar.":"it"===t?"Il Discord di Lovable è il punto di ritrovo online della comunità Lovable. È uno spazio in cui persone che creano, a ogni livello di esperienza, possono connettersi, condividere il proprio lavoro e crescere insieme. Che tu stia appena iniziando o stia sviluppando per dei clienti, qui c'è un posto per te.":"hi"===t?"Lovable Discord, Lovable समुदाय का ऑनलाइन घर है। यह हर कौशल स्तर के निर्माताओं के लिए जुड़ने, अपना काम साझा करने और साथ मिलकर आगे बढ़ने की जगह है। चाहे आप अभी शुरुआत कर रहे हों या ग्राहकों के लिए बना रहे हों, यहाँ आपके लिए जगह है।":"id"===t?"Discord Lovable adalah rumah online bagi komunitas Lovable. Ini adalah ruang bagi para pembuat dan kreator dari semua tingkat keahlian untuk terhubung, berbagi karya, dan berkembang bersama. Baik kamu baru memulai maupun membangun untuk klien, ada tempat untukmu di sini.":"th"===t?"Discord ของ Lovable คือบ้านออนไลน์ของคอมมูนิตี้ Lovable เป็นพื้นที่ให้นักสร้างและครีเอเตอร์ทุกระดับฝีมือได้มาเชื่อมต่อ แบ่งปันผลงาน และเติบโตไปด้วยกัน ไม่ว่าคุณจะเพิ่งเริ่มต้นหรือกำลังสร้างงานให้ลูกค้า ที่นี่ก็มีที่สำหรับคุณ":"ko"===t?"Lovable Discord는 Lovable 커뮤니티의 온라인 공간이에요. 모든 실력 수준의 빌더와 크리에이터가 서로 연결되고, 작업물을 공유하며, 함께 성장하는 곳이죠. 이제 막 시작했든 클라이언트를 위해 만들고 있든, 여기에는 여러분을 위한 자리가 있어요.":"Lovable の Discord は、Lovable コミュニティのオンライン拠点です。あらゆるスキルレベルのビルダーやクリエイターがつながり、作品を共有し、ともに成長できる場所です。始めたばかりの方でも、クライアント向けに開発している方でも、自分に合った場所が見つかります。"};e.s(["discordPage_faq1_answer",0,u0],810961),e.i(810961);let u1=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"What is the Lovable Discord and who is it for?":"pt-BR"===t?"O que é o Discord da Lovable e para quem ele é?":"de"===t?"Was ist der Lovable Discord und für wen ist er gedacht?":"fr"===t?"Qu'est-ce que le Discord de Lovable et à qui s'adresse-t-il ?":"es"===t?"¿Qué es el Discord de Lovable y para quién es?":"it"===t?"Cos'è il Discord di Lovable e a chi è rivolto?":"hi"===t?"Lovable Discord क्या है और यह किसके लिए है?":"id"===t?"Apa itu Discord Lovable dan untuk siapa?":"th"===t?"Discord ของ Lovable คืออะไร และเหมาะกับใคร?":"ko"===t?"Lovable Discord는 무엇이고 누구를 위한 곳인가요?":"Lovable の Discord とは何ですか？誰のためのものですか？"};e.s(["discordPage_faq1_question",0,u1],884499),e.i(884499);let u2=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Nope. The Discord is open to everyone. You don't need a Lovable account at all to join and start getting involved.":"pt-BR"===t?"Não. O Discord é aberto a todos. Você não precisa de uma conta na Lovable para entrar e começar a participar.":"de"===t?"Nein. Der Discord steht allen offen. Du brauchst überhaupt kein Lovable-Konto, um beizutreten und dich einzubringen.":"fr"===t?"Non. Le Discord est ouvert à tous. Vous n'avez besoin d'aucun compte Lovable pour le rejoindre et commencer à participer.":"es"===t?"No. El Discord está abierto a todo el mundo. No necesitas ninguna cuenta de Lovable para unirte y empezar a participar.":"it"===t?"No. Il Discord è aperto a tutti. Non hai bisogno di alcun account Lovable per unirti e iniziare a partecipare.":"hi"===t?"नहीं। Discord सभी के लिए खुला है। जुड़ने और भाग लेना शुरू करने के लिए आपको Lovable खाते की बिल्कुल भी ज़रूरत नहीं है।":"id"===t?"Tidak. Discord ini terbuka untuk semua orang. Kamu sama sekali tidak perlu akun Lovable untuk bergabung dan mulai aktif di dalamnya.":"th"===t?"ไม่จำเป็นเลย Discord เปิดให้ทุกคนเข้าร่วม คุณไม่จำเป็นต้องมีบัญชี Lovable เลยก็สามารถเข้าร่วมและเริ่มมีส่วนร่วมได้":"ko"===t?"아니요. Discord는 누구에게나 열려 있어요. 참여하고 활동을 시작하는 데 Lovable 계정이 전혀 필요하지 않아요.":"いいえ。Discord は誰にでも開かれています。参加して活動を始めるのに、Lovable アカウントは一切必要ありません。"};e.s(["discordPage_faq2_answer",0,u2],868737),e.i(868737);let u3=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Do I need a paid Lovable account to join?":"pt-BR"===t?"Preciso de uma conta paga na Lovable para entrar?":"de"===t?"Brauche ich ein kostenpflichtiges Lovable-Konto, um beizutreten?":"fr"===t?"Dois-je avoir un compte Lovable payant pour le rejoindre ?":"es"===t?"¿Necesito una cuenta de pago de Lovable para unirme?":"it"===t?"Mi serve un account Lovable a pagamento per unirmi?":"hi"===t?"क्या जुड़ने के लिए मुझे सशुल्क Lovable खाते की ज़रूरत है?":"id"===t?"Apakah saya perlu akun Lovable berbayar untuk bergabung?":"th"===t?"ฉันต้องมีบัญชี Lovable แบบเสียเงินถึงจะเข้าร่วมได้ไหม?":"ko"===t?"참여하려면 유료 Lovable 계정이 필요한가요?":"参加するには有料の Lovable アカウントが必要ですか？"};e.s(["discordPage_faq2_question",0,u3],400605),e.i(400605);let u4=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Not at all. The community includes complete beginners and experienced builders alike. What matters most is curiosity and a willingness to help others learn and build.":"pt-BR"===t?"De jeito nenhum. A comunidade inclui tanto iniciantes completos quanto criadores experientes. O que mais importa é a curiosidade e a disposição para ajudar os outros a aprender e criar.":"de"===t?"Überhaupt nicht. Zur Community gehören sowohl absolute Anfängerinnen und Anfänger als auch erfahrene Entwicklerinnen, Entwickler und Kreative. Am wichtigsten sind Neugier und die Bereitschaft, anderen beim Lernen und Umsetzen ihrer Ideen zu helfen.":"fr"===t?"Pas du tout. La communauté réunit aussi bien des grands débutants que des créateurs expérimentés. Ce qui compte le plus, c'est la curiosité et l'envie d'aider les autres à apprendre et à créer.":"es"===t?"Para nada. La comunidad incluye tanto a principiantes absolutos como a creadores con experiencia. Lo que más importa es la curiosidad y las ganas de ayudar a otros a aprender y crear.":"it"===t?"Per niente. La comunità include sia chi è alle prime armi sia persone esperte nella creazione di progetti. Ciò che conta di più è la curiosità e la voglia di aiutare gli altri a imparare e creare.":"hi"===t?"बिल्कुल नहीं। इस समुदाय में पूरी तरह नए लोग और अनुभवी निर्माता, दोनों शामिल हैं। सबसे ज़्यादा मायने जिज्ञासा और दूसरों को सीखने व बनाने में मदद करने की इच्छा रखती है।":"id"===t?"Sama sekali tidak. Komunitas ini mencakup pemula yang benar-benar baru maupun pembuat berpengalaman. Yang paling penting adalah rasa ingin tahu dan kemauan untuk membantu orang lain belajar dan membangun.":"th"===t?"ไม่จำเป็นเลย คอมมูนิตี้นี้มีทั้งมือใหม่หัดสร้างและนักสร้างที่มีประสบการณ์ สิ่งที่สำคัญที่สุดคือความอยากรู้อยากเห็นและความเต็มใจที่จะช่วยให้คนอื่นได้เรียนรู้และสร้างสรรค์":"ko"===t?"전혀 그렇지 않아요. 커뮤니티에는 완전 초보자부터 숙련된 빌더까지 모두 함께해요. 가장 중요한 건 호기심과 다른 사람들이 배우고 만들도록 돕고자 하는 마음이에요.":"まったく必要ありません。コミュニティには、まったくの初心者から経験豊富なビルダーまで、さまざまな方が参加しています。最も大切なのは、好奇心と、他の人の学びや開発を手伝おうとする気持ちです。"};e.s(["discordPage_faq3_answer",0,u4],206160),e.i(206160);let u5=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Do I need to be technical?":"pt-BR"===t?"Preciso ter conhecimento técnico?":"de"===t?"Muss ich technisch versiert sein?":"fr"===t?"Dois-je avoir des compétences techniques ?":"es"===t?"¿Necesito tener conocimientos técnicos?":"it"===t?"Devo avere competenze tecniche?":"hi"===t?"क्या तकनीकी ज्ञान होना ज़रूरी है?":"id"===t?"Apakah saya harus paham teknis?":"th"===t?"ฉันจำเป็นต้องมีความรู้ทางเทคนิคไหม?":"ko"===t?"기술적인 지식이 있어야 하나요?":"技術的な知識が必要ですか？"};e.s(["discordPage_faq3_question",0,u5],125471),e.i(125471);let u8=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Yes. The community and Champions are happy to dig into project-specific questions, whether that's a build challenge, an integration, or something that's just not working the way you expected. Note: Discord is not an official support platform. All assistance comes from fellow builders. For official support, visit <supportLink>Lovable support</supportLink>.":"pt-BR"===t?"Sim. A comunidade e os Champions têm prazer em se aprofundar em dúvidas específicas de projetos, seja um desafio de desenvolvimento, uma integração ou algo que simplesmente não está funcionando como você esperava. Observação: o Discord não é uma plataforma oficial de suporte. Toda a ajuda vem de outros criadores. Para suporte oficial, acesse <supportLink>o suporte da Lovable</supportLink>.":"de"===t?"Ja. Die Community und die Champions gehen gerne auf projektspezifische Fragen ein – sei es eine Herausforderung bei der Umsetzung, eine Integration oder etwas, das einfach nicht so funktioniert, wie du es erwartet hast. Hinweis: Discord ist keine offizielle Support-Plattform. Jede Unterstützung kommt von anderen Community-Mitgliedern. Für offiziellen Support besuche <supportLink>Lovable-Support</supportLink>.":"fr"===t?"Oui. La communauté et les Champions se feront un plaisir d'examiner vos questions spécifiques à un projet, qu'il s'agisse d'un défi de développement, d'une intégration ou de quelque chose qui ne fonctionne pas comme prévu. Remarque : Discord n'est pas une plateforme d'assistance officielle. Toute l'aide provient d'autres créateurs. Pour une assistance officielle, consultez <supportLink>l'assistance Lovable</supportLink>.":"es"===t?"Sí. La comunidad y los Champions están encantados de ayudarte con preguntas específicas sobre tu proyecto, ya sea un reto de desarrollo, una integración o algo que simplemente no funciona como esperabas. Nota: Discord no es una plataforma de soporte oficial. Toda la ayuda proviene de otros creadores. Para soporte oficial, visita <supportLink>el soporte de Lovable</supportLink>.":"it"===t?"Sì. La comunità e i Champion sono felici di approfondire domande specifiche sui progetti, che si tratti di una sfida di sviluppo, di un'integrazione o di qualcosa che semplicemente non funziona come ti aspettavi. Nota: Discord non è una piattaforma di supporto ufficiale. Tutta l'assistenza arriva da altri membri della comunità. Per il supporto ufficiale, visita <supportLink>il supporto di Lovable</supportLink>.":"hi"===t?"हाँ। समुदाय और Champions आपके प्रोजेक्ट-विशेष सवालों में गहराई से मदद करने के लिए तैयार रहते हैं, चाहे वह बनाने से जुड़ी चुनौती हो, कोई एकीकरण हो, या कुछ ऐसा हो जो आपकी उम्मीद के मुताबिक काम नहीं कर रहा हो। ध्यान दें: Discord कोई आधिकारिक सहायता प्लेटफ़ॉर्म नहीं है। सारी मदद साथी निर्माताओं से आती है। आधिकारिक सहायता के लिए, <supportLink>Lovable सहायता</supportLink> पर जाएँ।":"id"===t?"Ya. Komunitas dan para Champion dengan senang hati membantu pertanyaan spesifik tentang proyekmu, entah itu tantangan dalam membangun, integrasi, atau sesuatu yang tidak berjalan seperti yang kamu harapkan. Catatan: Discord bukan platform dukungan resmi. Semua bantuan berasal dari sesama pembuat. Untuk dukungan resmi, kunjungi <supportLink>dukungan Lovable</supportLink>.":"th"===t?"ได้แน่นอน คอมมูนิตี้และเหล่า Champions ยินดีช่วยเจาะลึกคำถามเฉพาะของแต่ละโปรเจกต์ ไม่ว่าจะเป็นความท้าทายในการสร้าง การเชื่อมต่อระบบ หรือสิ่งที่ทำงานไม่เป็นไปอย่างที่คุณคาดไว้ หมายเหตุ: Discord ไม่ใช่ช่องทางสนับสนุนอย่างเป็นทางการ ความช่วยเหลือทั้งหมดมาจากเพื่อนนักสร้างด้วยกัน สำหรับการสนับสนุนอย่างเป็นทางการ โปรดไปที่ <supportLink>ฝ่ายสนับสนุนของ Lovable</supportLink>":"ko"===t?"네. 커뮤니티와 챔피언들은 빌드 문제, 연동 문제, 예상대로 작동하지 않는 문제 등 프로젝트별 질문을 기꺼이 함께 파고들어요. 참고: Discord는 공식 지원 플랫폼이 아니에요. 모든 도움은 동료 빌더들로부터 제공돼요. 공식 지원이 필요하면 <supportLink>Lovable 지원</supportLink>을 방문하세요.":"はい。コミュニティのメンバーや Champions は、開発上の課題、連携、期待どおりに動かないことなど、プロジェクト固有の質問にも喜んで相談に乗ります。注意：Discord は公式のサポートプラットフォームではありません。すべてのサポートは仲間のビルダーによるものです。公式サポートについては <supportLink>Lovable サポート</supportLink> をご覧ください。"};e.s(["discordPage_faq4_answer",0,u8],518418),e.i(518418);let u6=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Can I get help with my specific project?":"pt-BR"===t?"Posso receber ajuda com o meu projeto específico?":"de"===t?"Kann ich Hilfe zu meinem konkreten Projekt bekommen?":"fr"===t?"Puis-je obtenir de l'aide pour mon projet spécifique ?":"es"===t?"¿Puedo recibir ayuda con mi proyecto específico?":"it"===t?"Posso ricevere aiuto per il mio progetto specifico?":"hi"===t?"क्या मुझे अपने किसी खास प्रोजेक्ट में मदद मिल सकती है?":"id"===t?"Bisakah saya mendapat bantuan untuk proyek spesifik saya?":"th"===t?"ฉันขอความช่วยเหลือเกี่ยวกับโปรเจกต์ของฉันโดยเฉพาะได้ไหม?":"ko"===t?"제 프로젝트에 대한 도움을 받을 수 있나요?":"自分のプロジェクトについて助けてもらえますか？"};e.s(["discordPage_faq4_question",0,u6],602583),e.i(602583);let u9=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"A Discord server is like a Slack workspace — a shared space with channels for different topics and purposes. The Lovable server has channels for support, showcasing builds, announcements, and more.":"pt-BR"===t?"Um servidor do Discord é como um espaço de trabalho do Slack — um espaço compartilhado com canais para diferentes tópicos e finalidades. O servidor da Lovable tem canais para suporte, divulgação de projetos, anúncios e muito mais.":"de"===t?"Ein Discord-Server ist wie ein Slack-Workspace – ein gemeinsamer Raum mit Kanälen für verschiedene Themen und Zwecke. Der Lovable-Server hat Kanäle für Support, Projektvorstellungen, Ankündigungen und vieles mehr.":"fr"===t?"Un serveur Discord, c'est comme un espace de travail Slack — un espace partagé avec des salons dédiés à différents sujets et objectifs. Le serveur Lovable comporte des salons pour l'assistance, la présentation de projets, les annonces et bien plus encore.":"es"===t?"Un servidor de Discord es como un espacio de trabajo de Slack: un espacio compartido con canales para distintos temas y propósitos. El servidor de Lovable tiene canales para soporte, mostrar proyectos, anuncios y mucho más.":"it"===t?"Un server Discord è come uno spazio di lavoro Slack: uno spazio condiviso con canali dedicati a diversi argomenti e scopi. Il server di Lovable ha canali per il supporto, la presentazione dei progetti, gli annunci e molto altro.":"hi"===t?"एक Discord सर्वर Slack कार्यस्थल की तरह होता है — अलग-अलग विषयों और उद्देश्यों के लिए चैनलों वाली एक साझा जगह। Lovable सर्वर में सहायता, बनाए गए काम दिखाने, घोषणाओं और बहुत कुछ के लिए चैनल हैं।":"id"===t?"Server Discord itu seperti ruang kerja Slack — sebuah ruang bersama dengan kanal untuk berbagai topik dan tujuan. Server Lovable punya kanal untuk dukungan, memamerkan hasil karya, pengumuman, dan banyak lagi.":"th"===t?"เซิร์ฟเวอร์ Discord ก็เหมือนกับเวิร์กสเปซของ Slack เป็นพื้นที่ร่วมที่มีช่องสำหรับหัวข้อและวัตถุประสงค์ต่าง ๆ เซิร์ฟเวอร์ของ Lovable มีช่องสำหรับการสนับสนุน การโชว์ผลงาน การประกาศ และอื่น ๆ อีกมากมาย":"ko"===t?"Discord 서버는 Slack 워크스페이스와 비슷해요 — 다양한 주제와 목적에 맞는 채널이 있는 공유 공간이죠. Lovable 서버에는 지원, 빌드 자랑, 공지 등을 위한 채널이 있어요.":"Discord サーバーは Slack ワークスペースのようなもので、さまざまなトピックや目的に応じたチャンネルを備えた共有スペースです。Lovable サーバーには、サポート、ビルドの紹介、お知らせなどのチャンネルがあります。"};e.s(["discordPage_faq5_answer",0,u9],967593),e.i(967593);let u7=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?'What\'s a Discord "server"?':"pt-BR"===t?'O que é um "servidor" do Discord?':"de"===t?'Was ist ein Discord-"Server"?':"fr"===t?"Qu'est-ce qu'un « serveur » Discord ?":"es"===t?"¿Qué es un «servidor» de Discord?":"it"===t?'Cos\'è un "server" Discord?':"hi"===t?'Discord "सर्वर" क्या होता है?':"id"===t?'Apa itu "server" Discord?':"th"===t?"เซิร์ฟเวอร์ Discord คืออะไร?":"ko"===t?'Discord "서버"가 뭔가요?':"Discord の「サーバー」とは何ですか？"};e.s(["discordPage_faq5_question",0,u7],749236),e.i(749236);let de=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Create a Discord account at discord.com if you don't have one, then join the Lovable server at <discordLink>https://discord.gg/lovable-dev</discordLink>. Once you're in, an onboarding flow will help you find your way around.":"pt-BR"===t?"Crie uma conta no Discord em discord.com, caso ainda não tenha, e entre no servidor da Lovable em <discordLink>https://discord.gg/lovable-dev</discordLink>. Assim que entrar, um fluxo de boas-vindas vai ajudar você a se orientar.":"de"===t?"Erstelle ein Discord-Konto auf discord.com, falls du noch keins hast, und tritt dann dem Lovable-Server unter <discordLink>https://discord.gg/lovable-dev</discordLink> bei. Sobald du drin bist, hilft dir eine kurze Einführung, dich zurechtzufinden.":"fr"===t?"Créez un compte Discord sur discord.com si vous n'en avez pas, puis rejoignez le serveur Lovable sur <discordLink>https://discord.gg/lovable-dev</discordLink>. Une fois sur le serveur, un parcours d'accueil vous aidera à vous repérer.":"es"===t?"Crea una cuenta de Discord en discord.com si aún no tienes una, y luego únete al servidor de Lovable en <discordLink>https://discord.gg/lovable-dev</discordLink>. Una vez dentro, un proceso de bienvenida te ayudará a orientarte.":"it"===t?"Crea un account Discord su discord.com se non ne hai uno, poi unisciti al server di Lovable su <discordLink>https://discord.gg/lovable-dev</discordLink>. Una volta entrato, una procedura introduttiva ti aiuterà a orientarti.":"hi"===t?"अगर आपके पास Discord खाता नहीं है, तो discord.com पर एक बनाएँ, फिर <discordLink>https://discord.gg/lovable-dev</discordLink> पर Lovable सर्वर से जुड़ें। अंदर आने के बाद, शुरुआती मार्गदर्शन आपको सर्वर को समझने और सही जगहों तक पहुँचने में मदद करेगा।":"id"===t?"Buat akun Discord di discord.com jika kamu belum punya, lalu gabung ke server Lovable di <discordLink>https://discord.gg/lovable-dev</discordLink>. Setelah masuk, alur orientasi akan membantumu mengenal seluk-beluknya.":"th"===t?"สร้างบัญชี Discord ที่ discord.com หากคุณยังไม่มี จากนั้นเข้าร่วมเซิร์ฟเวอร์ของ Lovable ที่ <discordLink>https://discord.gg/lovable-dev</discordLink> เมื่อเข้ามาแล้ว ขั้นตอนการเริ่มต้นใช้งานจะช่วยให้คุณคุ้นเคยกับการใช้งานได้":"ko"===t?"계정이 없다면 discord.com에서 Discord 계정을 만든 다음, <discordLink>https://discord.gg/lovable-dev</discordLink>에서 Lovable 서버에 참여하세요. 들어오시면 온보딩 과정이 서버 이용 방법을 안내해 드릴 거예요.":"アカウントをお持ちでない場合は discord.com で Discord アカウントを作成し、<discordLink>https://discord.gg/lovable-dev</discordLink> から Lovable サーバーに参加してください。参加後は、オンボーディングで使い方が案内されます。"};e.s(["discordPage_faq6_answer",0,de],604020),e.i(604020);let da=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"How do I get started?":"pt-BR"===t?"Como faço para começar?":"de"===t?"Wie fange ich an?":"fr"===t?"Comment commencer ?":"es"===t?"¿Cómo empiezo?":"it"===t?"Come inizio?":"hi"===t?"मैं शुरुआत कैसे करूँ?":"id"===t?"Bagaimana cara memulai?":"th"===t?"ฉันจะเริ่มต้นได้อย่างไร?":"ko"===t?"어떻게 시작하나요?":"どうやって始めればいいですか？"};e.s(["discordPage_faq6_question",0,da],811212),e.i(811212);let dt=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Champions are recognized members who've shown leadership, helpfulness, and a genuine commitment to the community over time. Keep showing up, keep helping others, and keep building. The path tends to find people who are already living it.":"pt-BR"===t?"Champions são membros reconhecidos que demonstraram liderança, prestatividade e um compromisso genuíno com a comunidade ao longo do tempo. Continue participando, ajudando outras pessoas e criando. O caminho costuma encontrar quem já vive esse espírito.":"de"===t?"Champions sind anerkannte Mitglieder, die über die Zeit Führungsstärke, Hilfsbereitschaft und ein echtes Engagement für die Community gezeigt haben. Sei weiterhin präsent, hilf anderen und setze weiter eigene Projekte um. Der Weg findet meist die Menschen, die ihn bereits leben.":"fr"===t?"Les Champions sont des membres reconnus qui ont fait preuve de leadership, de serviabilité et d'un véritable engagement envers la communauté au fil du temps. Continuez à être présent, à aider les autres et à créer. Ce statut a tendance à trouver les personnes qui le vivent déjà.":"es"===t?"Los Champions son miembros reconocidos que han demostrado liderazgo, disposición a ayudar y un compromiso genuino con la comunidad a lo largo del tiempo. Sigue participando, sigue ayudando a los demás y sigue creando. El reconocimiento suele llegar a quienes ya actúan así.":"it"===t?"I Champion sono membri riconosciuti che nel tempo hanno dimostrato leadership, disponibilità e un autentico impegno verso la comunità. Continua a partecipare, continua ad aiutare gli altri e continua a creare. Il riconoscimento tende ad arrivare a chi incarna già questi valori.":"hi"===t?"चैंपियंस वे मान्यता प्राप्त सदस्य होते हैं जिन्होंने समय के साथ नेतृत्व, मददगार रवैया और समुदाय के प्रति सच्ची प्रतिबद्धता दिखाई है। आते रहें, दूसरों की मदद करते रहें और बनाते रहें। यह राह अक्सर उन लोगों तक खुद पहुँच जाती है जो पहले से ऐसा कर रहे होते हैं।":"id"===t?"Champion adalah anggota terpilih yang telah menunjukkan kepemimpinan, kesediaan membantu, dan komitmen yang tulus terhadap komunitas dari waktu ke waktu. Teruslah hadir, teruslah membantu orang lain, dan teruslah membangun. Jalan ini cenderung menemukan orang-orang yang memang sudah menjalaninya.":"th"===t?"Champions คือสมาชิกที่ได้รับการยอมรับจากการแสดงความเป็นผู้นำ ความเต็มใจช่วยเหลือ และความมุ่งมั่นต่อคอมมูนิตี้อย่างแท้จริงมาอย่างต่อเนื่อง แค่เข้ามามีส่วนร่วมอย่างสม่ำเสมอ ช่วยเหลือผู้อื่นต่อไป และสร้างสรรค์ผลงานต่อไป เส้นทางนี้มักเปิดรับคนที่ทำสิ่งเหล่านี้อยู่แล้ว":"ko"===t?"챔피언은 시간이 지나면서 리더십, 도움을 주는 태도, 커뮤니티에 대한 진정한 헌신을 보여준 인정받는 멤버예요. 계속 참여하고, 계속 다른 사람들을 돕고, 계속 만들어 보세요. 그렇게 하다 보면 자연스럽게 챔피언이 되는 길이 열릴 거예요.":"Champions は、時間をかけてリーダーシップ、協力的な姿勢、コミュニティへの真摯な貢献を示してきたメンバーです。参加し続け、他の人を助け続け、開発を続けてください。そうした姿勢を続けている人に、自然と道が開けていきます。"};e.s(["discordPage_faq7_answer",0,dt],290243),e.i(290243);let di=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"How do I become a Champion?":"pt-BR"===t?"Como faço para me tornar um Champion?":"de"===t?"Wie werde ich Champion?":"fr"===t?"Comment devenir Champion ?":"es"===t?"¿Cómo me convierto en Champion?":"it"===t?"Come divento un Champion?":"hi"===t?"मैं चैंपियन कैसे बनूँ?":"id"===t?"Bagaimana cara menjadi Champion?":"th"===t?"ฉันจะเป็น Champion ได้อย่างไร?":"ko"===t?"어떻게 챔피언이 되나요?":"どうすれば Champion になれますか？"};e.s(["discordPage_faq7_question",0,di],711217),e.i(711217);let dn=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Frequently asked questions":"pt-BR"===t?"Perguntas frequentes":"de"===t?"Häufig gestellte Fragen":"fr"===t?"Questions fréquentes":"es"===t?"Preguntas frecuentes":"it"===t?"Domande frequenti":"hi"===t?"अक्सर पूछे जाने वाले सवाल":"id"===t?"Pertanyaan yang sering diajukan":"th"===t?"คำถามที่พบบ่อย":"ko"===t?"자주 묻는 질문":"よくある質問"};e.s(["discordPage_faq_title",0,dn],50377),e.i(50377);var dr=e.i(19445),ds=e.i(980330),dl=e.i(204992);let dc=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Join 160,000+ builders in the Lovable Discord. Get help, share what you're building, meet Champions, and build with the community.":"pt-BR"===t?"Junte-se a mais de 160.000 criadores no Discord da Lovable. Receba ajuda, compartilhe o que você está criando, conheça os Campeões e crie com a comunidade.":"de"===t?"Tritt über 160.000 Entwicklern im Lovable Discord bei. Hol dir Hilfe, teile, woran du arbeitest, triff Champions und entwickle mit der Community.":"fr"===t?"Rejoignez plus de 160 000 créateurs sur le Discord de Lovable. Obtenez de l'aide, partagez vos créations, rencontrez les Champions et créez avec la communauté.":"es"===t?"Únete a más de 160.000 creadores en el Discord de Lovable. Recibe ayuda, comparte lo que estás creando, conoce a Champions y crea con la comunidad.":"it"===t?"Unisciti a oltre 160.000 creator nel Discord di Lovable. Ottieni aiuto, condividi ciò che stai creando, incontra i membri di spicco della community e crea insieme agli altri.":"hi"===t?"Lovable Discord में 1,60,000+ निर्माताओं से जुड़ें। मदद पाएं, जो आप बना रहे हैं उसे साझा करें, चैंपियंस से मिलें, और समुदाय के साथ बनाएं।":"id"===t?"Bergabunglah dengan 160.000+ pembuat di Discord Lovable. Dapatkan bantuan, bagikan apa yang sedang kamu buat, temui para Champion, dan berkarya bersama komunitas.":"th"===t?"เข้าร่วมกับนักสร้างมากกว่า 160,000 คนใน Lovable Discord รับความช่วยเหลือ แชร์สิ่งที่คุณกำลังสร้าง พบกับเหล่าแชมเปียน และสร้างไปพร้อมกับคอมมูนิตี้":"ko"===t?"Lovable Discord에서 160,000명 이상의 빌더와 함께하세요. 도움을 받고, 만들고 있는 것을 공유하고, 챔피언들을 만나고, 커뮤니티와 함께 만들어 보세요.":"Lovable の Discord で16万人以上のビルダーに加わりましょう。サポートを受けたり、開発中のものを共有したり、Champions と出会ったり、コミュニティと一緒に開発できます。"};e.s(["discordPage_meta_description",0,dc],918915),e.i(918915);let du=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Join the Lovable Discord | Lovable":"pt-BR"===t?"Entre no Discord da Lovable | Lovable":"de"===t?"Tritt dem Lovable Discord bei | Lovable":"fr"===t?"Rejoignez le Discord de Lovable | Lovable":"es"===t?"Únete al Discord de Lovable | Lovable":"it"===t?"Unisciti al Discord di Lovable | Lovable":"hi"===t?"Lovable Discord से जुड़ें | Lovable":"id"===t?"Bergabung dengan Discord Lovable | Lovable":"th"===t?"เข้าร่วม Lovable Discord | Lovable":"ko"===t?"Lovable Discord 참여하기 | Lovable":"Lovable の Discord に参加 | Lovable"};e.s(["discordPage_meta_title",0,du],141382),e.i(141382);var dd=e.i(701131),dp=e.i(102548),dm=e.i(696725),dg=e.i(176019),db=e.i(218629),dh=e.i(348793),dv=e.i(293690),d_=e.i(220187),df=e.i(465380),dk=e.i(875595);let dL=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"The Lovable Discord is more than a place to ask questions. It's where builders learn from each other, celebrate wins, and go from stuck to shipped.":"pt-BR"===t?"O Discord da Lovable é mais do que um lugar para fazer perguntas. É onde criadores aprendem uns com os outros, celebram conquistas e deixam de estar travados para lançar seus projetos.":"de"===t?"Der Lovable Discord ist mehr als nur ein Ort, um Fragen zu stellen. Hier lernen Entwickler voneinander, feiern Erfolge und bringen ihre Projekte vom Stillstand bis zum Launch.":"fr"===t?"Le Discord de Lovable est bien plus qu'un endroit pour poser des questions. C'est là que les créateurs apprennent les uns des autres, célèbrent leurs réussites et passent du blocage à la réalisation.":"es"===t?"El Discord de Lovable es más que un lugar para hacer preguntas. Es donde los creadores aprenden unos de otros, celebran sus logros y pasan de estar atascados a lanzar sus proyectos.":"it"===t?"Il Discord di Lovable è molto più di un posto dove fare domande. È dove i creator imparano gli uni dagli altri, celebrano i successi e passano dal blocco al lancio.":"hi"===t?"Lovable Discord सिर्फ सवाल पूछने की जगह नहीं है। यह वह जगह है जहां निर्माता एक-दूसरे से सीखते हैं, अपनी सफलताओं का जश्न मनाते हैं, और अटके रहने से लॉन्च करने तक का सफर तय करते हैं।":"id"===t?"Discord Lovable lebih dari sekadar tempat untuk bertanya. Di sinilah para pembuat saling belajar, merayakan pencapaian, dan bergerak dari buntu sampai berhasil merilis karya.":"th"===t?"Lovable Discord เป็นมากกว่าที่ไว้ถามคำถาม ที่นี่คือที่ที่นักสร้างเรียนรู้จากกันและกัน ร่วมฉลองความสำเร็จ และก้าวจากจุดที่ติดขัดไปสู่การปล่อยผลงานได้สำเร็จ":"ko"===t?"Lovable Discord는 단순히 질문하는 공간 그 이상이에요. 빌더들이 서로에게서 배우고, 성과를 축하하며, 막힌 상태에서 출시까지 나아가는 곳이죠.":"Lovable の Discord は、単に質問する場所以上のものです。ビルダー同士が学び合い、成果を称え合い、行き詰まりから完成へと進む場所です。"};e.s(["discordPage_most_description",0,dL],820609),e.i(820609);let dP=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"How to get":"pt-BR"===t?"Como aproveitar":"de"===t?"So holst du":"fr"===t?"Comment en tirer":"es"===t?"Cómo sacarle":"it"===t?"Come trarne":"hi"===t?"इसका पूरा फायदा":"id"===t?"Cara memaksimalkan":"th"===t?"วิธีใช้ประโยชน์":"ko"===t?"100% 활용하는":"最大限に"};e.s(["discordPage_most_titleLine1",0,dP],705608),e.i(705608);let dy=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"the most out of it":"pt-BR"===t?"ao máximo":"de"===t?"das Beste heraus":"fr"===t?"le meilleur parti":"es"===t?"el máximo provecho":"it"===t?"il massimo":"hi"===t?"कैसे उठाएं":"id"===t?"manfaatnya":"th"===t?"ให้ได้มากที่สุด":"ko"===t?"방법":"活用する方法"};e.s(["discordPage_most_titleLine2",0,dy],616018),e.i(616018);let dS=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"The Lovable Discord community is the right home for builders who want to push each other to realize their creative vision!":"pt-BR"===t?"A comunidade do Discord da Lovable é o lar certo para criadores que querem incentivar uns aos outros a realizar sua visão criativa!":"de"===t?"Die Lovable Discord-Community ist das richtige Zuhause für Entwickler, die sich gegenseitig anspornen wollen, ihre kreative Vision zu verwirklichen!":"fr"===t?"La communauté Discord de Lovable est le foyer idéal pour les créateurs qui veulent se pousser mutuellement à concrétiser leur vision créative !":"es"===t?"¡La comunidad de Discord de Lovable es el hogar ideal para creadores que quieren impulsarse mutuamente a hacer realidad su visión creativa!":"it"===t?"La community Discord di Lovable è la casa giusta per i creator che vogliono spronarsi a vicenda a realizzare la propria visione creativa!":"hi"===t?"Lovable Discord समुदाय उन निर्माताओं के लिए सही जगह है जो एक-दूसरे को अपनी रचनात्मक सोच साकार करने के लिए प्रेरित करना चाहते हैं!":"id"===t?"Komunitas Discord Lovable adalah rumah yang tepat bagi para pembuat yang ingin saling mendorong untuk mewujudkan visi kreatif mereka!":"th"===t?"คอมมูนิตี้ Lovable Discord คือบ้านที่ใช่สำหรับนักสร้างที่อยากผลักดันกันและกันให้เปลี่ยนวิสัยทัศน์สร้างสรรค์ให้เป็นจริง!":"ko"===t?"Lovable Discord 커뮤니티는 서로를 자극하며 창의적인 비전을 실현하고 싶은 빌더들에게 딱 맞는 보금자리예요!":"Lovable の Discord コミュニティは、互いに高め合い、創造的なビジョンを実現したいビルダーにとって、まさにぴったりの居場所です！"};e.s(["discordPage_testimonial1_quote",0,dS],967241),e.i(967241);let dw=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Lovable's Discord community is one of a kind. The drive to build & help is unmatched – you gotta see it to believe it!":"pt-BR"===t?"A comunidade do Discord da Lovable é única. A vontade de construir e ajudar é incomparável – você precisa ver para crer!":"de"===t?"Die Discord-Community von Lovable ist einzigartig. Der Antrieb zu entwickeln und zu helfen ist unübertroffen – das muss man gesehen haben, um es zu glauben!":"fr"===t?"La communauté Discord de Lovable est unique en son genre. L'envie de créer et d'aider est inégalée – il faut le voir pour le croire !":"es"===t?"La comunidad de Discord de Lovable es única. Las ganas de crear y ayudar no tienen comparación: ¡tienes que verlo para creerlo!":"it"===t?"La community Discord di Lovable è unica nel suo genere. La voglia di creare e aiutare è impareggiabile: bisogna vederla per crederci!":"hi"===t?"Lovable का Discord समुदाय अपने आप में बेमिसाल है। यहां बनाने और मदद करने का जज़्बा लाजवाब है – यकीन करने के लिए आपको इसे खुद देखना होगा!":"id"===t?"Komunitas Discord Lovable benar-benar unik. Semangat untuk berkarya & membantu tiada tandingannya – kamu harus melihatnya sendiri untuk percaya!":"th"===t?"คอมมูนิตี้ Discord ของ Lovable นั้นไม่เหมือนใคร แรงผลักดันในการสร้างและช่วยเหลือกันนั้นหาที่เปรียบไม่ได้ – คุณต้องมาเห็นเองถึงจะเชื่อ!":"ko"===t?"Lovable의 Discord 커뮤니티는 정말 독보적이에요. 만들고 돕고자 하는 열정은 비할 데가 없죠 – 직접 봐야 믿을 수 있을 거예요!":"Lovable の Discord コミュニティは唯一無二です。作りたい・助けたいという熱意は他に類を見ません。実際に見れば信じられるはずです！"};e.s(["discordPage_testimonial2_quote",0,dw],597602),e.i(597602);let dz=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"You join the Lovable Discord to fix a bug, get feedback, or share what you built - and you walk out with real support and a few new friends who follow your entire builder journey. I don't build alone anymore.":"pt-BR"===t?"Você entra no Discord da Lovable para corrigir um bug, receber feedback ou compartilhar o que criou — e sai de lá com apoio de verdade e alguns novos amigos que acompanham toda a sua jornada como criador. Não construo mais sozinho.":"de"===t?"Du trittst dem Lovable Discord bei, um einen Fehler zu beheben, Feedback zu bekommen oder zu teilen, was du gebaut hast – und gehst mit echter Unterstützung und ein paar neuen Freunden wieder raus, die deinen gesamten Weg als Entwickler begleiten. Ich baue nicht mehr allein.":"fr"===t?"Vous rejoignez le Discord de Lovable pour corriger un bug, obtenir des retours ou partager ce que vous avez créé — et vous en repartez avec un vrai soutien et quelques nouveaux amis qui suivent tout votre parcours de créateur. Désormais, je ne crée plus seul.":"es"===t?"Te unes al Discord de Lovable para corregir un error, recibir comentarios o compartir lo que has creado, y sales con apoyo real y algunos nuevos amigos que siguen todo tu recorrido como creador. Ya no creo en solitario.":"it"===t?"Entri nel Discord di Lovable per risolvere un bug, ricevere feedback o condividere ciò che hai creato — e ne esci con un supporto concreto e qualche nuovo amico che segue tutto il tuo percorso da creatore. Non creo più da solo.":"hi"===t?"आप Lovable Discord पर किसी बग को ठीक करने, फ़ीडबैक पाने या अपनी बनाई चीज़ साझा करने आते हैं - और लौटते समय आपको असली सहयोग और कुछ नए दोस्त मिलते हैं, जो आपके पूरे सफ़र में साथ रहते हैं। अब मुझे अकेले नहीं बनाना पड़ता।":"id"===t?"Kamu bergabung dengan Discord Lovable untuk memperbaiki bug, mendapatkan masukan, atau berbagi karya yang kamu buat - lalu mendapatkan dukungan nyata dan beberapa teman baru yang mengikuti seluruh perjalananmu sebagai builder. Aku tidak lagi merasa membangun sendirian.":"th"===t?"คุณเข้าร่วม Discord ของ Lovable เพื่อแก้บั๊ก รับฟีดแบ็ก หรือแชร์สิ่งที่คุณสร้าง แล้วคุณก็ได้รับการสนับสนุนจริง ๆ พร้อมเพื่อนใหม่ ๆ ที่คอยติดตามเส้นทางการสร้างสรรค์ของคุณตลอด ตอนนี้ฉันไม่ได้สร้างอะไรอยู่คนเดียวอีกต่อไปแล้ว":"ko"===t?"버그를 고치거나, 피드백을 받거나, 만든 걸 공유하려고 Lovable Discord에 들어갔다가 진짜 도움과 함께 빌더 여정을 끝까지 함께해 주는 새 친구들까지 얻고 나오게 돼요. 이제 더 이상 혼자 만들지 않아요.":"バグを直したり、フィードバックをもらったり、作ったものを共有したりするためにLovableのDiscordに参加すると、心強いサポートや、ものづくりの歩みをずっと応援してくれる新しい仲間に出会えます。もう一人で作っている感じはしません。"};e.s(["discordPage_testimonial3_quote",0,dz],471279),e.i(471279);let dA=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"From the community":"pt-BR"===t?"Da comunidade":"de"===t?"Aus der Community":"fr"===t?"De la communauté":"es"===t?"De la comunidad":"it"===t?"Dalla community":"hi"===t?"समुदाय की ओर से":"id"===t?"Dari komunitas":"th"===t?"จากคอมมูนิตี้":"ko"===t?"커뮤니티에서":"コミュニティから"};e.s(["discordPage_testimonials_titleLine1",0,dA],847275),e.i(847275);let dq=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"with love":"pt-BR"===t?"com carinho":"de"===t?"mit Liebe":"fr"===t?"avec amour":"es"===t?"con cariño":"it"===t?"con amore":"hi"===t?"प्यार के साथ":"id"===t?"dengan penuh cinta":"th"===t?"ด้วยความรัก":"ko"===t?"사랑을 담아":"愛を込めて"};e.s(["discordPage_testimonials_titleLine2",0,dq],572802),e.i(572802);let dx=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"It's a bit empty here. Publish your own app store page to appear here!":"pt-BR"===t?"Está um pouco vazio por aqui. Publique a página do seu app na loja para aparecer aqui!":"de"===t?"Hier ist es noch etwas leer. Veröffentliche deine eigene App-Store-Seite, um hier zu erscheinen!":"fr"===t?"C'est un peu vide ici. Publiez votre propre page de boutique d'applications pour apparaître ici !":"es"===t?"Esto está un poco vacío. ¡Publica tu propia página de tienda de apps para aparecer aquí!":"it"===t?"Qui è un po' vuoto. Pubblica la pagina della tua app nello store per comparire qui!":"hi"===t?"यहाँ थोड़ा खाली है। यहाँ दिखने के लिए अपना खुद का ऐप स्टोर पेज प्रकाशित करें!":"id"===t?"Di sini masih agak kosong. Terbitkan halaman toko aplikasi milikmu sendiri agar muncul di sini!":"th"===t?"ที่นี่ยังว่างอยู่นิดหน่อย เผยแพร่หน้าแอปสโตร์ของคุณเองเพื่อให้แสดงที่นี่!":"ko"===t?"여기가 조금 비어 있네요. 나만의 앱 스토어 페이지를 게시하면 여기에 표시돼요!":"ここはまだ少し寂しいです。自分のアプリストアページを公開して、ここに表示させましょう！"};e.s(["discoverPage_emptyState",0,dx],830229),e.i(830229);let dC=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Apps for builders":"pt-BR"===t?"Apps para criadores":"de"===t?"Apps für Entwickler":"fr"===t?"Applications pour les créateurs":"es"===t?"Apps para creadores":"it"===t?"App per chi crea":"hi"===t?"निर्माताओं के लिए ऐप्स":"id"===t?"Aplikasi untuk kreator":"th"===t?"แอปสำหรับนักสร้าง":"ko"===t?"빌더를 위한 앱":"ビルダー向けのアプリ"};e.s(["discoverPage_section_builders",0,dC],125548),e.i(125548);let dB=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Apps to run your company":"pt-BR"===t?"Apps para gerenciar sua empresa":"de"===t?"Apps für dein Unternehmen":"fr"===t?"Applications pour gérer votre entreprise":"es"===t?"Apps para gestionar tu empresa":"it"===t?"App per gestire la tua azienda":"hi"===t?"अपनी कंपनी चलाने के लिए ऐप्स":"id"===t?"Aplikasi untuk menjalankan perusahaanmu":"th"===t?"แอปสำหรับบริหารบริษัทของคุณ":"ko"===t?"회사 운영을 위한 앱":"会社運営のためのアプリ"};e.s(["discoverPage_section_company",0,dB],174195),e.i(174195);let dR=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Personal apps & entertainment":"pt-BR"===t?"Apps pessoais e entretenimento":"de"===t?"Persönliche Apps & Unterhaltung":"fr"===t?"Applications personnelles et divertissement":"es"===t?"Apps personales y entretenimiento":"it"===t?"App personali e intrattenimento":"hi"===t?"निजी ऐप्स और मनोरंजन":"id"===t?"Aplikasi pribadi & hiburan":"th"===t?"แอปส่วนตัวและความบันเทิง":"ko"===t?"개인용 앱 & 엔터테인먼트":"個人向けアプリ＆エンターテインメント"};e.s(["discoverPage_section_entertainment",0,dR],117676),e.i(117676);let dT=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Featured apps":"pt-BR"===t?"Apps em destaque":"de"===t?"Vorgestellte Apps":"fr"===t?"Applications en vedette":"es"===t?"Apps destacadas":"it"===t?"App in evidenza":"hi"===t?"चुनिंदा ऐप्स":"id"===t?"Aplikasi unggulan":"th"===t?"แอปแนะนำ":"ko"===t?"추천 앱":"注目のアプリ"};e.s(["discoverPage_section_featured",0,dT],842998),e.i(842998);let dI=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Apps for marketing & content":"pt-BR"===t?"Apps para marketing e conteúdo":"de"===t?"Apps für Marketing & Inhalte":"fr"===t?"Applications pour le marketing et le contenu":"es"===t?"Apps para marketing y contenido":"it"===t?"App per marketing e contenuti":"hi"===t?"मार्केटिंग और कंटेंट के लिए ऐप्स":"id"===t?"Aplikasi untuk pemasaran & konten":"th"===t?"แอปสำหรับการตลาดและคอนเทนต์":"ko"===t?"마케팅 & 콘텐츠를 위한 앱":"マーケティング＆コンテンツ向けのアプリ"};e.s(["discoverPage_section_marketing",0,dI],456680),e.i(456680);let dj=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Apps loved by the community":"pt-BR"===t?"Apps amados pela comunidade":"de"===t?"Beliebte Apps aus der Community":"fr"===t?"Applications adorées par la communauté":"es"===t?"Apps que la comunidad adora":"it"===t?"App amate dalla community":"hi"===t?"समुदाय के पसंदीदा ऐप्स":"id"===t?"Aplikasi favorit komunitas":"th"===t?"แอปที่คอมมูนิตี้ชื่นชอบ":"ko"===t?"커뮤니티가 사랑하는 앱":"コミュニティに愛されているアプリ"};e.s(["discoverPage_section_popular",0,dj],483340),e.i(483340);let dD=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Visit project":"pt-BR"===t?"Visitar projeto":"de"===t?"Projekt ansehen":"fr"===t?"Voir le projet":"es"===t?"Visitar proyecto":"it"===t?"Visita il progetto":"hi"===t?"प्रोजेक्ट देखें":"id"===t?"Kunjungi proyek":"th"===t?"ดูโปรเจกต์":"ko"===t?"프로젝트 보기":"プロジェクトを見る"};e.s(["discoverPage_visitProject",0,dD],295601),e.i(295601);let dE=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"This DPA does not establish a joint controllership arrangement under Article 26 of the GDPR.":"pt-BR"===t?"Este DPA não estabelece uma relação de controle conjunto nos termos do Artigo 26 do GDPR.":"de"===t?"Dieser AVV begründet keine gemeinsame Verantwortlichkeit gemäß Artikel 26 der DSGVO.":"fr"===t?"Le présent accord de traitement des données n'établit pas de relation de responsables conjoints du traitement au titre de l'article 26 du RGPD.":"es"===t?"Este DPA no establece un acuerdo de corresponsabilidad del tratamiento en virtud del Artículo 26 del RGPD.":"it"===t?"Il presente DPA non istituisce un accordo di contitolarità ai sensi dell'articolo 26 del GDPR.":"hi"===t?"यह DPA GDPR के अनुच्छेद 26 के तहत संयुक्त नियंत्रण व्यवस्था स्थापित नहीं करता है।":"id"===t?"DPA ini tidak membentuk pengaturan pengendalian bersama berdasarkan Pasal 26 GDPR.":"th"===t?"DPA ฉบับนี้ไม่ได้สร้างข้อตกลงการควบคุมร่วมภายใต้มาตรา 26 ของ GDPR":"ko"===t?"본 DPA는 GDPR 제26조에 따른 공동 개인정보처리자 관계를 성립시키지 않습니다.":"本DPAは、GDPR第26条に基づく共同管理者の取り決めを構成するものではありません。"};e.s(["dpaPage_acknowledge1",0,dE],212526),e.i(212526);let dM=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Each party remains solely responsible for its own compliance with Applicable Data Protection Laws in respect of its separate processing activities.":"pt-BR"===t?"Cada parte permanece exclusivamente responsável por sua própria conformidade com as Leis de Proteção de Dados Aplicáveis em relação às suas atividades independentes de tratamento.":"de"===t?"Jede Partei bleibt allein für ihre eigene Einhaltung der geltenden Datenschutzgesetze in Bezug auf ihre jeweiligen Verarbeitungstätigkeiten verantwortlich.":"fr"===t?"Chaque partie demeure seule responsable de sa propre conformité aux lois applicables en matière de protection des données concernant ses activités de traitement distinctes.":"es"===t?"Cada parte sigue siendo la única responsable de su propio cumplimiento de las Leyes de Protección de Datos Aplicables respecto a sus actividades de tratamiento independientes.":"it"===t?"Ciascuna parte resta unica responsabile della propria conformità alle Leggi sulla Protezione dei Dati Applicabili in relazione alle proprie attività di trattamento distinte.":"hi"===t?"प्रत्येक पक्ष अपनी अलग प्रसंस्करण गतिविधियों के संबंध में लागू डेटा संरक्षण कानूनों के अनुपालन के लिए स्वयं पूरी तरह से जिम्मेदार रहता है।":"id"===t?"Masing-masing pihak tetap bertanggung jawab sepenuhnya atas kepatuhannya sendiri terhadap Hukum Perlindungan Data yang Berlaku sehubungan dengan aktivitas pemrosesannya yang terpisah.":"th"===t?"แต่ละฝ่ายยังคงรับผิดชอบแต่เพียงผู้เดียวในการปฏิบัติตามกฎหมายคุ้มครองข้อมูลที่บังคับใช้ในส่วนของกิจกรรมการประมวลผลที่แยกจากกันของตน":"ko"===t?"각 당사자는 자신의 개별적인 처리 활동과 관련하여 적용 가능한 데이터 보호법 준수에 대해 단독으로 책임을 집니다.":"各当事者は、それぞれ個別の処理活動に関して、適用されるデータ保護法の遵守について単独で責任を負うものとします。"};e.s(["dpaPage_acknowledge2",0,dM],675572),e.i(675572);let dG=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Lovable processes Customer Personal Data solely on behalf of and under the instructions of the Customer.":"pt-BR"===t?"A Lovable processa os Dados Pessoais do Cliente exclusivamente em nome e conforme as instruções do Cliente.":"de"===t?"Lovable verarbeitet personenbezogene Daten des Kunden ausschließlich im Auftrag und nach den Weisungen des Kunden.":"fr"===t?"Lovable traite les données personnelles du Client uniquement pour le compte et selon les instructions du Client.":"es"===t?"Lovable trata los Datos Personales del Cliente únicamente por cuenta del Cliente y siguiendo sus instrucciones.":"it"===t?"Lovable tratta i Dati Personali del Cliente esclusivamente per conto e secondo le istruzioni del Cliente.":"hi"===t?"Lovable ग्राहक के व्यक्तिगत डेटा का प्रसंस्करण केवल ग्राहक की ओर से और उसके निर्देशों के अनुसार ही करता है।":"id"===t?"Lovable memproses Data Pribadi Pelanggan semata-mata atas nama dan berdasarkan instruksi Pelanggan.":"th"===t?"Lovable ประมวลผลข้อมูลส่วนบุคคลของลูกค้าในนามของและภายใต้คำสั่งของลูกค้าเท่านั้น":"ko"===t?"Lovable은 고객을 대신하여 고객의 지시에 따라서만 고객 개인 데이터를 처리합니다.":"Lovableは、お客様の個人データを、お客様の代わりに、かつお客様の指示に基づいてのみ処理します。"};e.s(["dpaPage_acknowledge3",0,dG],398983),e.i(398983);let dO=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Lovable may process Service Data, Log Data, aggregated data, and de-identified data as an independent controller solely for analytics, security, billing, and product-development purposes.":"pt-BR"===t?"A Lovable pode processar Dados de Serviço, Dados de Log, dados agregados e dados desidentificados como controladora independente, exclusivamente para fins de análise, segurança, faturamento e desenvolvimento de produto.":"de"===t?"Lovable darf Servicedaten, Protokolldaten, aggregierte Daten und de-identifizierte Daten als unabhängiger Verantwortlicher ausschließlich für Analyse-, Sicherheits-, Abrechnungs- und Produktentwicklungszwecke verarbeiten.":"fr"===t?"Lovable peut traiter les données de service, les données de journalisation, les données agrégées et les données anonymisées en tant que responsable indépendant du traitement, uniquement à des fins d'analyse, de sécurité, de facturation et de développement de produit.":"es"===t?"Lovable puede tratar los Datos del Servicio, los Datos de Registro, los datos agregados y los datos anonimizados como responsable independiente del tratamiento, únicamente con fines de análisis, seguridad, facturación y desarrollo de producto.":"it"===t?"Lovable può trattare i Dati di Servizio, i Dati di Log, i dati aggregati e i dati anonimizzati in qualità di titolare autonomo esclusivamente per finalità di analisi, sicurezza, fatturazione e sviluppo del prodotto.":"hi"===t?"Lovable सेवा डेटा, लॉग डेटा, समेकित डेटा और पहचान-रहित डेटा का स्वतंत्र नियंत्रक के रूप में केवल विश्लेषण, सुरक्षा, बिलिंग और उत्पाद-विकास उद्देश्यों के लिए प्रसंस्करण कर सकता है।":"id"===t?"Lovable dapat memproses Data Layanan, Data Log, data agregat, dan data yang telah dideidentifikasi sebagai pengendali independen semata-mata untuk tujuan analitik, keamanan, penagihan, dan pengembangan produk.":"th"===t?"Lovable อาจประมวลผลข้อมูลบริการ ข้อมูลบันทึก ข้อมูลแบบรวม และข้อมูลที่ไม่ระบุตัวตนในฐานะผู้ควบคุมข้อมูลอิสระ เพื่อวัตถุประสงค์ด้านการวิเคราะห์ ความปลอดภัย การเรียกเก็บเงิน และการพัฒนาผลิตภัณฑ์เท่านั้น":"ko"===t?"Lovable은 분석, 보안, 청구 및 제품 개발 목적으로만 서비스 데이터, 로그 데이터, 집계 데이터, 비식별화 데이터를 독립적인 개인정보처리자로서 처리할 수 있습니다.":"Lovableは、分析、セキュリティ、請求、および製品開発の目的に限り、独立した管理者としてサービスデータ、ログデータ、集約データ、および非識別化データを処理することがあります。"};e.s(["dpaPage_acknowledge4",0,dO],973460),e.i(973460);let dN=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Lovable does not engage in automated decision-making with legal or similarly significant effects on Data Subjects.":"pt-BR"===t?"A Lovable não realiza tomada de decisão automatizada que produza efeitos jurídicos ou efeitos igualmente significativos sobre os Titulares dos Dados.":"de"===t?"Lovable nimmt keine automatisierte Entscheidungsfindung mit rechtlichen oder ähnlich erheblichen Auswirkungen auf betroffene Personen vor.":"fr"===t?"Lovable ne procède à aucune prise de décision automatisée produisant des effets juridiques ou des effets significatifs similaires à l'égard des personnes concernées.":"es"===t?"Lovable no realiza toma de decisiones automatizada con efectos jurídicos o de importancia similar sobre los Interesados.":"it"===t?"Lovable non effettua processi decisionali automatizzati con effetti giuridici o analogamente significativi sugli Interessati.":"hi"===t?"Lovable डेटा विषयों पर कानूनी या समान रूप से महत्वपूर्ण प्रभाव डालने वाले स्वचालित निर्णय-निर्माण में शामिल नहीं होता है।":"id"===t?"Lovable tidak melakukan pengambilan keputusan otomatis yang menimbulkan dampak hukum atau dampak signifikan serupa terhadap Subjek Data.":"th"===t?"Lovable ไม่ได้ดำเนินการตัดสินใจแบบอัตโนมัติที่มีผลทางกฎหมายหรือผลกระทบสำคัญในลักษณะเดียวกันต่อเจ้าของข้อมูล":"ko"===t?"Lovable은 정보주체에게 법적 효과 또는 그에 준하는 중대한 영향을 미치는 자동화된 의사결정을 수행하지 않습니다.":"Lovableは、データ主体に対して法的効果またはそれに類する重大な影響を及ぼす自動化された意思決定を行いません。"};e.s(["dpaPage_acknowledge5",0,dN],638682),e.i(638682);let dF=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Annex 1 - Description of Processing":"pt-BR"===t?"Anexo 1 — Descrição do Processamento":"de"===t?"Anhang 1 – Beschreibung der Verarbeitung":"fr"===t?"Annexe 1 - Description du traitement":"es"===t?"Anexo 1 - Descripción del Tratamiento":"it"===t?"Allegato 1 - Descrizione del trattamento":"hi"===t?"अनुलग्नक 1 - प्रसंस्करण का विवरण":"id"===t?"Lampiran 1 - Deskripsi Pemrosesan":"th"===t?"ภาคผนวก 1 - คำอธิบายการประมวลผล":"ko"===t?"부속서 1 - 처리에 관한 설명":"別紙1 - 処理の説明"};e.s(["dpaPage_annex1_title",0,dF],152887),e.i(152887);let dH=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"We have appointed a Data Protection Officer (DPO) that you can contact at:":"pt-BR"===t?"Nomeamos um Encarregado de Proteção de Dados (DPO) que você pode contatar em:":"de"===t?"Wir haben einen Datenschutzbeauftragten (DSB) ernannt, den Sie wie folgt erreichen können:":"fr"===t?"Nous avons désigné un délégué à la protection des données (DPO) que vous pouvez contacter à l'adresse suivante :":"es"===t?"Hemos designado a un Delegado de Protección de Datos (DPO) con quien puede ponerse en contacto en:":"it"===t?"Abbiamo nominato un Responsabile della Protezione dei Dati (DPO) che puoi contattare all'indirizzo:":"hi"===t?"हमने एक डेटा संरक्षण अधिकारी (DPO) नियुक्त किया है जिनसे आप यहाँ संपर्क कर सकते हैं:":"id"===t?"Kami telah menunjuk Petugas Perlindungan Data (DPO) yang dapat Anda hubungi di:":"th"===t?"เราได้แต่งตั้งเจ้าหน้าที่คุ้มครองข้อมูล (DPO) ที่คุณสามารถติดต่อได้ที่:":"ko"===t?"당사는 데이터 보호 책임자(DPO)를 임명하였으며, 다음 연락처로 문의하실 수 있습니다:":"当社はデータ保護責任者（DPO）を任命しており、以下の連絡先までお問い合わせいただけます："};e.s(["dpaPage_dpoIntro",0,dH],437609),e.i(437609);let dW=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?'This Data Processing Agreement ("DPA") forms part of the Terms of Service ordered by the Customer under an Order Form (the "Agreement") between Lovable and the Customer.':"pt-BR"===t?'Este Acordo de Processamento de Dados ("DPA") faz parte dos Termos de Serviço solicitados pelo Cliente por meio de um Formulário de Pedido (o "Acordo") entre a Lovable e o Cliente.':"de"===t?"Dieser Auftragsverarbeitungsvertrag („AVV“) ist Bestandteil der vom Kunden im Rahmen eines Bestellformulars bestellten Nutzungsbedingungen (die „Vereinbarung“) zwischen Lovable und dem Kunden.":"fr"===t?"Le présent accord de traitement des données (« DPA ») fait partie des Conditions d'utilisation applicables au Client au titre d'un bon de commande (le « Contrat ») conclu entre Lovable et le Client.":"es"===t?'Este Acuerdo de Tratamiento de Datos ("DPA") forma parte de las Condiciones del Servicio contratadas por el Cliente mediante un Formulario de Pedido (el "Acuerdo") entre Lovable y el Cliente.':"it"===t?'Il presente Accordo sul Trattamento dei Dati ("DPA") fa parte dei Termini di Servizio ordinati dal Cliente tramite un Modulo d\'Ordine (l\'"Accordo") tra Lovable e il Cliente.':"hi"===t?'यह डेटा प्रसंस्करण अनुबंध ("DPA") Lovable और ग्राहक के बीच ऑर्डर फ़ॉर्म के तहत ग्राहक द्वारा ऑर्डर की गई सेवा की शर्तों ("अनुबंध") का हिस्सा है।':"id"===t?'Perjanjian Pemrosesan Data ("DPA") ini merupakan bagian dari Ketentuan Layanan yang dipesan oleh Pelanggan berdasarkan Formulir Pemesanan ("Perjanjian") antara Lovable dan Pelanggan.':"th"===t?'ข้อตกลงการประมวลผลข้อมูลนี้ ("DPA") ถือเป็นส่วนหนึ่งของข้อกำหนดการให้บริการที่ลูกค้าสั่งซื้อภายใต้แบบฟอร์มคำสั่งซื้อ ("ข้อตกลง") ระหว่าง Lovable และลูกค้า':"ko"===t?'본 데이터 처리 계약("DPA")은 주문서(이하 "계약")에 따라 고객이 주문한 서비스 약관의 일부를 구성하며, Lovable과 고객 간에 체결됩니다.':"本データ処理契約（「DPA」）は、Lovableとお客様との間の注文書に基づきお客様が注文した利用規約（「本契約」）の一部を構成します。"};e.s(["dpaPage_intro",0,dW],187630),e.i(187630);let dU=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Last updated: November 6, 2025":"pt-BR"===t?"Última atualização: 6 de novembro de 2025":"de"===t?"Zuletzt aktualisiert: 6. November 2025":"fr"===t?"Dernière mise à jour : 6 novembre 2025":"es"===t?"Última actualización: 6 de noviembre de 2025":"it"===t?"Ultimo aggiornamento: 6 novembre 2025":"hi"===t?"अंतिम अपडेट: 6 नवंबर, 2025":"id"===t?"Terakhir diperbarui: 6 November 2025":"th"===t?"อัปเดตล่าสุด: 6 พฤศจิกายน 2025":"ko"===t?"최종 업데이트: 2025년 11월 6일":"最終更新日：2025年11月6日"};e.s(["dpaPage_lastUpdated",0,dU],412933),e.i(412933);let dV=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Terms outlining how personal data is processed, protected, and handled between parties in compliance with data protection laws.":"pt-BR"===t?"Termos que descrevem como os dados pessoais são processados, protegidos e tratados entre as partes em conformidade com as leis de proteção de dados.":"de"===t?"Bedingungen, die festlegen, wie personenbezogene Daten zwischen den Parteien in Übereinstimmung mit den Datenschutzgesetzen verarbeitet, geschützt und gehandhabt werden.":"fr"===t?"Conditions décrivant comment les données personnelles sont traitées, protégées et gérées entre les parties, conformément aux lois sur la protection des données.":"es"===t?"Términos que describen cómo se procesan, protegen y gestionan los datos personales entre las partes, en cumplimiento de las leyes de protección de datos.":"it"===t?"Termini che descrivono come i dati personali vengono trattati, protetti e gestiti tra le parti in conformità alle leggi sulla protezione dei dati.":"hi"===t?"ये शर्तें बताती हैं कि पक्षों के बीच व्यक्तिगत डेटा को डेटा सुरक्षा कानूनों के अनुपालन में कैसे संसाधित, सुरक्षित और प्रबंधित किया जाता है।":"id"===t?"Ketentuan yang menjelaskan bagaimana data pribadi diproses, dilindungi, dan ditangani antara para pihak sesuai dengan undang-undang perlindungan data.":"th"===t?"ข้อกำหนดที่ระบุวิธีการประมวลผล ปกป้อง และจัดการข้อมูลส่วนบุคคลระหว่างคู่สัญญาตามกฎหมายคุ้มครองข้อมูล":"ko"===t?"데이터 보호법을 준수하여 당사자 간에 개인 데이터가 처리, 보호, 취급되는 방식을 규정하는 약관입니다.":"個人データを当事者間でどのように処理、保護、取り扱うかを、データ保護法に準拠して定める規約です。"};e.s(["dpaPage_meta_description",0,dV],670974),e.i(670974);let dK=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Lovable Data Processing Agreement":"pt-BR"===t?"Acordo de Processamento de Dados da Lovable":"de"===t?"Lovable-Auftragsverarbeitungsvertrag":"fr"===t?"Accord de traitement des données Lovable":"es"===t?"Acuerdo de Procesamiento de Datos de Lovable":"it"===t?"Accordo sul trattamento dei dati di Lovable":"hi"===t?"Lovable डेटा प्रसंस्करण समझौता":"id"===t?"Perjanjian Pemrosesan Data Lovable":"th"===t?"ข้อตกลงการประมวลผลข้อมูลของ Lovable":"ko"===t?"Lovable 데이터 처리 계약":"Lovable データ処理契約"};e.s(["dpaPage_meta_title",0,dK],964879),e.i(964879);let d$=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"The parties expressly acknowledge and agree that:":"pt-BR"===t?"As partes reconhecem e concordam expressamente que:":"de"===t?"Die Parteien erkennen ausdrücklich an und vereinbaren, dass:":"fr"===t?"Les parties reconnaissent et conviennent expressément que :":"es"===t?"Las partes reconocen y aceptan expresamente que:":"it"===t?"Le parti riconoscono e concordano espressamente quanto segue:":"hi"===t?"पक्ष स्पष्ट रूप से स्वीकार करते हैं और सहमत होते हैं कि:":"id"===t?"Para pihak secara tegas mengakui dan menyetujui bahwa:":"th"===t?"คู่สัญญาทั้งสองฝ่ายรับทราบและตกลงอย่างชัดแจ้งว่า:":"ko"===t?"당사자는 다음 사항을 명시적으로 인정하고 이에 동의합니다:":"両当事者は、以下の事項を明示的に確認し、同意します。"};e.s(["dpaPage_partiesAcknowledge",0,d$],196914),e.i(196914);let dQ=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"10. Use of Customer Data for Artificial Intelligence and Machine Learning":"pt-BR"===t?"10. Uso de Dados do Cliente para Inteligência Artificial e Aprendizado de Máquina":"de"===t?"10. Nutzung von Kundendaten für künstliche Intelligenz und maschinelles Lernen":"fr"===t?"10. Utilisation des données client pour l'intelligence artificielle et l'apprentissage automatique":"es"===t?"10. Uso de los Datos del Cliente para Inteligencia Artificial y Aprendizaje Automático":"it"===t?"10. Utilizzo dei dati dei clienti per l'intelligenza artifi