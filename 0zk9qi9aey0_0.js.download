;e.s(["dpaPage_section9_title",0,pe],683094),e.i(683094);let pa=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"If you're on a Business or Enterprise plan, your usage includes our Data Processing Agreement (DPA). A signed version is available":"pt-BR"===t?"Se você está em um plano Business ou Enterprise, seu uso inclui nosso Acordo de Processamento de Dados (DPA). Uma versão assinada está disponível":"de"===t?"Wenn Sie einen Business- oder Enterprise-Tarif nutzen, gilt unser Auftragsverarbeitungsvertrag (DPA) für Ihre Nutzung. Eine unterzeichnete Version ist verfügbar":"fr"===t?"Si vous avez un forfait Business ou Enterprise, votre utilisation inclut notre accord de traitement des données (DPA). Une version signée est disponible":"es"===t?"Si tienes un plan Business o Enterprise, tu uso incluye nuestro Acuerdo de Procesamiento de Datos (DPA). Hay una versión firmada disponible":"it"===t?"Se hai un piano Business o Enterprise, il tuo utilizzo include il nostro Accordo sul trattamento dei dati (DPA). È disponibile una versione firmata":"hi"===t?"अगर आप Business या Enterprise प्लान पर हैं, तो आपके उपयोग में हमारा डेटा प्रसंस्करण समझौता (DPA) शामिल है। हस्ताक्षरित संस्करण उपलब्ध है":"id"===t?"Jika Anda menggunakan paket Business atau Enterprise, penggunaan Anda mencakup Perjanjian Pemrosesan Data (DPA) kami. Versi yang telah ditandatangani tersedia":"th"===t?"หากคุณใช้แพ็กเกจ Business หรือ Enterprise การใช้งานของคุณจะรวมข้อตกลงการประมวลผลข้อมูล (DPA) ของเราไว้ด้วย โดยมีเวอร์ชันที่ลงนามแล้วให้บริการ":"ko"===t?"비즈니스 또는 엔터프라이즈 플랜을 이용 중이라면 데이터 처리 계약(DPA)이 이용에 포함됩니다. 서명된 버전은 여기에서 확인할 수 있습니다":"ビジネスプランまたはエンタープライズプランをご利用の場合、ご利用にはデータ処理契約（DPA）が含まれます。署名済みのバージョンもご用意しています"};e.s(["dpaPage_signedVersionNote",0,pa],465576),e.i(465576);let pt=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"here":"pt-BR"===t?"aqui":"de"===t?"hier":"fr"===t?"ici":"es"===t?"aquí":"it"===t?"qui":"hi"===t?"यहाँ":"id"===t?"di sini":"th"===t?"ที่นี่":"ko"===t?"여기":"こちら"};e.s(["dpaPage_signedVersionNote_linkText",0,pt],768105),e.i(768105);let pi=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Data Processing Agreement":"pt-BR"===t?"Contrato de Processamento de Dados":"de"===t?"Auftragsverarbeitungsvertrag":"fr"===t?"Accord de traitement des données":"es"===t?"Acuerdo de tratamiento de datos":"it"===t?"Accordo sul trattamento dei dati":"hi"===t?"डेटा प्रोसेसिंग अनुबंध":"id"===t?"Perjanjian Pemrosesan Data":"th"===t?"ข้อตกลงการประมวลผลข้อมูล":"ko"===t?"데이터 처리 계약":"データ処理契約"};e.s(["dpaPage_title",0,pi],346974),e.i(346974);var po=e.i(274063),pn=e.i(21865),pr=e.i(21627),ps=e.i(839085),pl=e.i(349940),pc=e.i(85522),pu=e.i(896392),pd=e.i(71091),pp=e.i(554663),pm=e.i(513305),pg=e.i(634126),pb=e.i(306200),ph=e.i(794176),pv=e.i(430275),p_=e.i(900631),pf=e.i(879980),pk=e.i(76448),pL=e.i(694519),pP=e.i(975041),py=e.i(19865);let pS=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Get in touch with Lovable to learn how we can help your team ship faster with our enterprise AI platform.":"pt-BR"===t?"Entre em contato com a Lovable para saber como podemos ajudar sua equipe a lançar mais rápido com nossa plataforma de IA para empresas.":"de"===t?"Nimm Kontakt mit Lovable auf und erfahre, wie wir deinem Team helfen, mit unserer Enterprise-KI-Plattform schneller Ergebnisse zu liefern.":"fr"===t?"Contactez Lovable pour découvrir comment nous pouvons aider votre équipe à livrer plus vite grâce à notre plateforme d'IA pour les entreprises.":"es"===t?"Ponte en contacto con Lovable para descubrir cómo podemos ayudar a tu equipo a lanzar más rápido con nuestra plataforma de IA empresarial.":"it"===t?"Contatta Lovable per scoprire come possiamo aiutare il tuo team a rilasciare più velocemente con la nostra piattaforma AI enterprise.":"hi"===t?"Lovable से संपर्क करें और जानें कि हमारा एंटरप्राइज़ AI प्लेटफ़ॉर्म आपकी टीम को तेज़ी से काम पूरा करने में कैसे मदद कर सकता है।":"id"===t?"Hubungi Lovable untuk mengetahui bagaimana kami dapat membantu tim Anda merilis lebih cepat dengan platform AI enterprise kami.":"th"===t?"ติดต่อ Lovable เพื่อดูว่าเราจะช่วยให้ทีมของคุณส่งมอบงานได้เร็วขึ้นด้วยแพลตฟอร์ม AI สำหรับองค์กรของเราได้อย่างไร":"ko"===t?"엔터프라이즈 AI 플랫폼으로 팀이 더 빠르게 출시할 수 있도록 Lovable이 어떻게 도와드릴 수 있는지 문의해 보세요.":"Lovable にお問い合わせいただき、エンタープライズ向け AI プラットフォームでチームがより速くリリースできる方法をご確認ください。"};e.s(["enterpriseFormPage_meta_description",0,pS],916917),e.i(916917);let pw=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Get in touch with Lovable to learn how we can help your team ship faster with our enterprise AI platform.":"pt-BR"===t?"Entre em contato com a Lovable para saber como podemos ajudar sua equipe a lançar mais rápido com nossa plataforma de IA para empresas.":"de"===t?"Nimm Kontakt mit Lovable auf und erfahre, wie wir deinem Team helfen, mit unserer Enterprise-KI-Plattform schneller Ergebnisse zu liefern.":"fr"===t?"Contactez Lovable pour découvrir comment nous pouvons aider votre équipe à livrer plus vite grâce à notre plateforme d'IA pour les entreprises.":"es"===t?"Ponte en contacto con Lovable para descubrir cómo podemos ayudar a tu equipo a lanzar más rápido con nuestra plataforma de IA empresarial.":"it"===t?"Contatta Lovable per scoprire come possiamo aiutare il tuo team a rilasciare più velocemente con la nostra piattaforma AI enterprise.":"hi"===t?"Lovable से संपर्क करें और जानें कि हमारा एंटरप्राइज़ AI प्लेटफ़ॉर्म आपकी टीम को तेज़ी से काम पूरा करने में कैसे मदद कर सकता है।":"id"===t?"Hubungi Lovable untuk mengetahui bagaimana kami dapat membantu tim Anda merilis lebih cepat dengan platform AI enterprise kami.":"th"===t?"ติดต่อ Lovable เพื่อดูว่าเราจะช่วยให้ทีมของคุณส่งมอบงานได้เร็วขึ้นด้วยแพลตฟอร์ม AI สำหรับองค์กรของเราได้อย่างไร":"ko"===t?"엔터프라이즈 AI 플랫폼으로 팀이 더 빠르게 출시할 수 있도록 Lovable이 어떻게 도와드릴 수 있는지 문의해 보세요.":"Lovable にお問い合わせいただき、エンタープライズ向け AI プラットフォームでチームがより速くリリースできる方法をご確認ください。"};e.s(["enterpriseFormPage_meta_og_description",0,pw],411417),e.i(411417);let pz=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Enterprise":"pt-BR"===t?"Empresas":"de"===t?"Enterprise":"fr"===t?"Entreprise":"es"===t?"Empresas":"it"===t?"Enterprise":"hi"===t?"एंटरप्राइज़":"id"===t?"Enterprise":"th"===t?"องค์กร":"ko"===t?"엔터프라이즈":"エンタープライズ"};e.s(["enterpriseFormPage_meta_og_title",0,pz],413274),e.i(413274);let pA=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Enterprise | Lovable":"pt-BR"===t?"Empresas | Lovable":"de"===t?"Enterprise | Lovable":"fr"===t?"Entreprise | Lovable":"es"===t?"Empresas | Lovable":"it"===t?"Enterprise | Lovable":"hi"===t?"एंटरप्राइज़ | Lovable":"id"===t?"Enterprise | Lovable":"th"===t?"องค์กร | Lovable":"ko"===t?"엔터프라이즈 | Lovable":"エンタープライズ | Lovable"};e.s(["enterpriseFormPage_meta_title",0,pA],680466),e.i(680466);var pq=e.i(330970),px=e.i(61238),pC=e.i(690181),pB=e.i(413372),pR=e.i(8198),pT=e.i(974251),pI=e.i(6354),pj=e.i(952395),pD=e.i(735987),pE=e.i(260576),pM=e.i(473773),pG=e.i(17888),pO=e.i(908084),pN=e.i(307069),pF=e.i(281266),pH=e.i(745961),pW=e.i(799585),pU=e.i(93174),pV=e.i(459447),pK=e.i(525634),p$=e.i(528005),pQ=e.i(457139),pY=e.i(505625);let pJ=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"You own the code on your Lovable apps completely, you can sync/export code to GitHub at any point in time. There is no lock-in, use GitHub to review PRs and keep building in your toolchain. Lovable apps are built on a modern tech stack using React, Supabase and Tailwind, that any developer can work with.":"pt-BR"===t?"Você é dono de todo o código dos seus apps Lovable e pode sincronizar/exportar o código para o GitHub a qualquer momento. Não há aprisionamento à plataforma; use o GitHub para revisar PRs e continue desenvolvendo no seu fluxo de ferramentas. Os apps Lovable são criados com um stack tecnológico moderno usando React, Supabase e Tailwind, com o qual qualquer desenvolvedor pode trabalhar.":"de"===t?"Du besitzt den Code deiner Lovable-Apps vollständig und kannst den Code jederzeit mit GitHub synchronisieren oder exportieren. Es gibt keine Bindung – nutze GitHub, um PRs zu überprüfen, und entwickle in deiner gewohnten Toolchain weiter. Lovable-Apps basieren auf einem modernen Tech-Stack mit React, Supabase und Tailwind, mit dem jede Entwicklerin und jeder Entwickler arbeiten kann.":"fr"===t?"Vous êtes pleinement propriétaire du code de vos applications Lovable et pouvez le synchroniser ou l’exporter vers GitHub à tout moment. Il n’y a aucun verrouillage propriétaire : utilisez GitHub pour relire les demandes de fusion et continuez à développer avec votre chaîne d’outils. Les applications Lovable reposent sur une base technique moderne avec React, Supabase et Tailwind, sur laquelle tout développeur peut travailler.":"es"===t?"Eres dueño por completo del código de tus aplicaciones de Lovable; puedes sincronizar o exportar el código a GitHub en cualquier momento. No hay dependencia exclusiva: usa GitHub para revisar solicitudes de cambios y sigue desarrollando con tus herramientas. Las aplicaciones de Lovable se crean sobre una pila tecnológica moderna con React, Supabase y Tailwind, con la que puede trabajar cualquier desarrollador.":"it"===t?"Il codice delle tue app Lovable è interamente di tua proprietà e puoi sincronizzarlo o esportarlo su GitHub in qualsiasi momento. Non c'è alcun vincolo: usa GitHub per esaminare le pull request e continua a sviluppare con i tuoi strumenti. Le app Lovable sono costruite su uno stack tecnologico moderno con React, Supabase e Tailwind, con cui qualsiasi sviluppatore può lavorare.":"hi"===t?"आपके Lovable ऐप्स के कोड पर पूरी तरह आपका स्वामित्व होता है, आप किसी भी समय कोड को GitHub पर सिंक/एक्सपोर्ट कर सकते हैं। कोई लॉक-इन नहीं है, PR की समीक्षा करने के लिए GitHub का उपयोग करें और अपने मौजूदा टूलचेन में बनाना जारी रखें। Lovable ऐप्स React, Supabase और Tailwind का उपयोग करते हुए एक आधुनिक टेक स्टैक पर बनाए जाते हैं, जिसके साथ कोई भी डेवलपर काम कर सकता है।":"id"===t?"Anda sepenuhnya memiliki kode aplikasi Lovable Anda, dan dapat menyinkronkan/mengekspor kode ke GitHub kapan saja. Tidak ada ketergantungan platform; gunakan GitHub untuk meninjau PR dan terus membangun dengan rangkaian alat kerja Anda. Aplikasi Lovable dibangun di atas tumpukan teknologi modern menggunakan React, Supabase, dan Tailwind, sehingga dapat dikerjakan oleh pengembang mana pun.":"th"===t?"คุณเป็นเจ้าของโค้ดในแอป Lovable ของคุณอย่างสมบูรณ์ และสามารถซิงค์หรือส่งออกโค้ดไปยัง GitHub ได้ทุกเมื่อ ไม่มีการผูกมัด คุณสามารถใช้ GitHub เพื่อรีวิว PR และพัฒนาต่อในชุดเครื่องมือเดิมของคุณได้ แอป Lovable สร้างด้วยเทคสแต็กสมัยใหม่อย่าง React, Supabase และ Tailwind ซึ่งนักพัฒนาทั่วไปสามารถทำงานต่อได้":"ko"===t?"Lovable 앱의 코드는 전적으로 고객님의 소유이며, 언제든지 GitHub로 코드를 동기화하거나 내보낼 수 있습니다. 종속 없이 GitHub로 PR을 검토하고 기존 도구 체인에서 계속 개발할 수 있습니다. Lovable 앱은 React, Supabase, Tailwind를 사용하는 최신 기술 스택으로 구축되어 어떤 개발자든 함께 작업할 수 있습니다.":"Lovableアプリのコードは完全にお客様の所有物であり、いつでもGitHubにコードを同期・エクスポートできます。ロックインは一切なく、GitHubでPRをレビューしながら、お使いのツールチェーンで開発を続けられます。LovableアプリはReact、Supabase、Tailwindを使った最新の技術スタックで構築されており、どの開発者でも扱えます。"};e.s(["enterpriseLandingPage_faq1_answer",0,pJ],960332),e.i(960332);let pZ=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"How does code ownership work?":"pt-BR"===t?"Como funciona a propriedade do código?":"de"===t?"Wie funktioniert das Code-Eigentum?":"fr"===t?"Comment fonctionne la propriété du code ?":"es"===t?"¿Cómo funciona la propiedad del código?":"it"===t?"Come funziona la proprietà del codice?":"hi"===t?"कोड स्वामित्व कैसे काम करता है?":"id"===t?"Bagaimana cara kerja kepemilikan kode?":"th"===t?"สิทธิ์ความเป็นเจ้าของโค้ดเป็นอย่างไร?":"ko"===t?"코드 소유권은 어떻게 작동하나요?":"コードの所有権はどのような仕組みですか？"};e.s(["enterpriseLandingPage_faq1_question",0,pZ],367574),e.i(367574);let pX=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Lovable is certified through SOC 2 Type II and ISO 27001. Enterprise features include SSO/SAML, SCIM provisioning, role-based access control, and audit logs. We support GDPR compliance.":"pt-BR"===t?"A Lovable é certificada pelas normas SOC 2 Type II e ISO 27001. Os recursos para empresas incluem SSO/SAML, provisionamento SCIM, controle de acesso baseado em funções e logs de auditoria. Oferecemos suporte à conformidade com o GDPR.":"de"===t?"Lovable ist nach SOC 2 Type II und ISO 27001 zertifiziert. Zu den Enterprise-Funktionen gehören SSO/SAML, SCIM-Provisionierung, rollenbasierte Zugriffssteuerung und Audit-Logs. Wir unterstützen die DSGVO-Konformität.":"fr"===t?"Lovable est certifié SOC 2 Type II et ISO 27001. Les fonctionnalités entreprise incluent le SSO/SAML, le provisionnement SCIM, le contrôle d'accès basé sur les rôles et les journaux d'audit. Nous prenons en charge la conformité au RGPD.":"es"===t?"Lovable cuenta con las certificaciones SOC 2 Type II e ISO 27001. Las funciones para empresas incluyen SSO/SAML, aprovisionamiento SCIM, control de acceso basado en roles y registros de auditoría. Ofrecemos compatibilidad con el RGPD.":"it"===t?"Lovable è certificata SOC 2 Type II e ISO 27001. Le funzionalità aziendali includono SSO/SAML, provisioning SCIM, controllo degli accessi basato sui ruoli e log di audit. Supportiamo la conformità al GDPR.":"hi"===t?"Lovable SOC 2 Type II और ISO 27001 प्रमाणित है। एंटरप्राइज़ सुविधाओं में SSO/SAML, SCIM प्रोविज़निंग, रोल-आधारित एक्सेस कंट्रोल, और ऑडिट लॉग शामिल हैं। हम GDPR अनुपालन का समर्थन करते हैं।":"id"===t?"Lovable tersertifikasi SOC 2 Type II dan ISO 27001. Fitur untuk perusahaan mencakup SSO/SAML, penyediaan SCIM, kontrol akses berbasis peran, dan log audit. Kami mendukung kepatuhan GDPR.":"th"===t?"Lovable ได้รับการรับรอง SOC 2 Type II และ ISO 27001 ฟีเจอร์สำหรับองค์กรประกอบด้วย SSO/SAML, การจัดสรรผู้ใช้ผ่าน SCIM, การควบคุมการเข้าถึงตามบทบาท และบันทึกการตรวจสอบ เรารองรับการปฏิบัติตาม GDPR":"ko"===t?"Lovable은 SOC 2 Type II 및 ISO 27001 인증을 받았습니다. 엔터프라이즈 기능에는 SSO/SAML, SCIM 프로비저닝, 역할 기반 액세스 제어, 감사 로그가 포함됩니다. GDPR 준수도 지원합니다.":"LovableはSOC 2 Type IIおよびISO 27001の認証を取得しています。エンタープライズ機能には、SSO/SAML、SCIMプロビジョニング、ロールベースのアクセス制御、監査ログが含まれます。GDPRへの準拠もサポートしています。"};e.s(["enterpriseLandingPage_faq2_answer",0,pX],58013),e.i(58013);let p0=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"What security certifications do you have?":"pt-BR"===t?"Quais certificações de segurança vocês possuem?":"de"===t?"Welche Sicherheitszertifizierungen habt ihr?":"fr"===t?"Quelles certifications de sécurité possédez-vous ?":"es"===t?"¿Qué certificaciones de seguridad tienen?":"it"===t?"Quali certificazioni di sicurezza avete?":"hi"===t?"आपके पास कौन-से सुरक्षा प्रमाणन हैं?":"id"===t?"Sertifikasi keamanan apa saja yang Anda miliki?":"th"===t?"คุณมีใบรับรองด้านความปลอดภัยอะไรบ้าง?":"ko"===t?"어떤 보안 인증을 보유하고 있나요?":"どのようなセキュリティ認証を取得していますか？"};e.s(["enterpriseLandingPage_faq2_question",0,p0],595884),e.i(595884);let p1=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Cursor helps engineers write code faster. Lovable lets entire teams build together - PMs, designers and operators create working software while engineers keep control via a standard tech stack and GitHub PRs.":"pt-BR"===t?"O Cursor ajuda engenheiros a escrever código mais rápido. A Lovable permite que equipes inteiras criem juntas — gerentes de produto, designers e operadores criam software funcional enquanto os engenheiros mantêm o controle por meio de um stack tecnológico padrão e PRs no GitHub.":"de"===t?"Cursor hilft Entwicklerinnen und Entwicklern, schneller Code zu schreiben. Mit Lovable können ganze Teams gemeinsam Software entwickeln – Produktmanager, Designer und Operations-Teams erstellen funktionierende Software, während Entwicklerinnen und Entwickler über einen Standard-Technologie-Stack und GitHub-PRs die Kontrolle behalten.":"fr"===t?"Cursor aide les ingénieurs à écrire du code plus rapidement. Lovable permet à des équipes entières de créer ensemble : les chefs de produit, les designers et les équipes opérationnelles produisent des logiciels fonctionnels pendant que les ingénieurs gardent le contrôle grâce à une base technique standard et aux demandes de fusion GitHub.":"es"===t?"Cursor ayuda a los ingenieros a escribir código más rápido. Lovable permite que equipos enteros construyan juntos: responsables de producto, diseñadores y operadores crean software funcional mientras los ingenieros mantienen el control mediante una pila tecnológica estándar y solicitudes de cambios en GitHub.":"it"===t?"Cursor aiuta gli ingegneri a scrivere codice più velocemente. Lovable consente a interi team di sviluppare insieme: product manager, designer e operatori creano software funzionante mentre gli ingegneri mantengono il controllo grazie a uno stack tecnologico standard e alle pull request di GitHub.":"hi"===t?"Cursor इंजीनियरों को तेज़ी से कोड लिखने में मदद करता है। Lovable पूरी टीमों को एक साथ निर्माण करने देता है - PM, डिज़ाइनर और ऑपरेटर काम करने वाला सॉफ़्टवेयर बनाते हैं, जबकि इंजीनियर एक मानक टेक स्टैक और GitHub PR के ज़रिए नियंत्रण बनाए रखते हैं।":"id"===t?"Cursor membantu insinyur menulis kode lebih cepat. Lovable memungkinkan seluruh tim membangun bersama - manajer produk, desainer, dan operator membuat perangkat lunak yang berfungsi sementara insinyur tetap memegang kendali melalui tumpukan teknologi standar dan pull request GitHub.":"th"===t?"Cursor ช่วยให้วิศวกรเขียนโค้ดได้เร็วขึ้น ส่วน Lovable ช่วยให้ทั้งทีมสร้างงานร่วมกันได้ ทั้ง PM, นักออกแบบ และผู้ปฏิบัติงานสามารถสร้างซอฟต์แวร์ที่ใช้งานได้จริง ในขณะที่วิศวกรยังคงควบคุมได้ผ่านเทคสแต็กมาตรฐานและ PR บน GitHub":"ko"===t?"Cursor는 엔지니어가 더 빠르게 코드를 작성하도록 돕습니다. Lovable은 팀 전체가 함께 만들 수 있게 해줍니다. PM, 디자이너, 운영 담당자가 작동하는 소프트웨어를 만드는 동안 엔지니어는 표준 기술 스택과 GitHub PR을 통해 제어권을 유지합니다.":"Cursorはエンジニアがより速くコードを書くのを支援します。Lovableなら、チーム全体で一緒に開発できます。PM、デザイナー、オペレーターが実際に動くソフトウェアを作り、エンジニアは標準的な技術スタックとGitHubのPRを通じて管理を維持できます。"};e.s(["enterpriseLandingPage_faq3_answer",0,p1],14282),e.i(14282);let p2=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"How is Lovable different from Cursor/dev tools?":"pt-BR"===t?"Como a Lovable se diferencia do Cursor e de outras ferramentas de desenvolvimento?":"de"===t?"Wie unterscheidet sich Lovable von Cursor/Entwickler-Tools?":"fr"===t?"En quoi Lovable est-il différent de Cursor et des outils de développement ?":"es"===t?"¿En qué se diferencia Lovable de Cursor y otras herramientas para desarrolladores?":"it"===t?"In cosa si differenzia Lovable da Cursor e dagli strumenti per sviluppatori?":"hi"===t?"Lovable, Cursor/डेवलपर टूल्स से कैसे अलग है?":"id"===t?"Apa yang membuat Lovable berbeda dari Cursor/alat pengembangan?":"th"===t?"Lovable แตกต่างจาก Cursor หรือเครื่องมือสำหรับนักพัฒนาอย่างไร?":"ko"===t?"Lovable은 Cursor/개발 도구와 어떻게 다른가요?":"LovableはCursorや開発ツールとどう違いますか？"};e.s(["enterpriseLandingPage_faq3_question",0,p2],410231),e.i(410231);let p3=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Enterprise support include priority SLAs with guaranteed response times, white-glove onboarding and workspace configuration, security/compliance review support, and ongoing training to master best practices. You also get a direct line to our Product team for integrations and roadmap input, plus dedicated expert guidance to deploy and scale AI.":"pt-BR"===t?"O suporte para empresas inclui SLAs prioritários com tempos de resposta garantidos, integração personalizada e configuração do espaço de trabalho, suporte na revisão de segurança/conformidade e treinamento contínuo para dominar as melhores práticas. Você também tem uma linha direta com nossa equipe de Produto para integrações e contribuições no planejamento do produto, além de orientação especializada e dedicada para implementar e escalar IA.":"de"===t?"Der Enterprise-Support umfasst priorisierte SLAs mit garantierten Reaktionszeiten, persönliches Onboarding und Einrichtung des Arbeitsbereichs, Unterstützung bei Sicherheits- und Compliance-Prüfungen sowie laufende Schulungen zu Best Practices. Außerdem erhältst du einen direkten Draht zu unserem Produktteam für Integrationen und Feedback zur Produkt-Roadmap sowie dedizierte Expertenberatung, um KI einzuführen und zu skalieren.":"fr"===t?"L’assistance Entreprise comprend des SLA prioritaires avec des temps de réponse garantis, un accompagnement personnalisé à la prise en main et à la configuration de l’espace de travail, un soutien pour les revues de sécurité et de conformité, ainsi qu’une formation continue pour maîtriser les bonnes pratiques. Vous bénéficiez également d’un accès direct à notre équipe Produit pour les intégrations et vos retours sur la feuille de route, ainsi que de conseils d’experts dédiés pour déployer et faire évoluer l’IA.":"es"===t?"El soporte para empresas incluye acuerdos de nivel de servicio prioritarios con tiempos de respuesta garantizados, incorporación personalizada y configuración del espacio de trabajo, apoyo en revisiones de seguridad y cumplimiento, y formación continua para dominar las mejores prácticas. También tienes una línea directa con nuestro equipo de Producto para integraciones y aportes a la hoja de ruta, además de orientación experta dedicada para implementar y escalar la IA.":"it"===t?"Il supporto aziendale include SLA prioritari con tempi di risposta garantiti, affiancamento personalizzato e configurazione dell'area di lavoro, supporto per la revisione di sicurezza e conformità e formazione continua per padroneggiare le migliori pratiche. Ottieni inoltre una linea diretta con il nostro team di prodotto per integrazioni e contributi alla pianificazione, oltre a una guida dedicata di esperti per implementare e scalare l'AI.":"hi"===t?"एंटरप्राइज़ सपोर्ट में गारंटीशुदा प्रतिक्रिया समय के साथ प्राथमिकता वाले SLA, विशेष ऑनबोर्डिंग और वर्कस्पेस कॉन्फ़िगरेशन, सुरक्षा/अनुपालन समीक्षा सहायता, और सर्वोत्तम तरीकों में महारत हासिल करने के लिए निरंतर प्रशिक्षण शामिल है। आपको इंटीग्रेशन और रोडमैप सुझावों के लिए हमारी प्रोडक्ट टीम से सीधा संपर्क भी मिलता है, साथ ही AI को तैनात करने और बड़े पैमाने पर अपनाने के लिए समर्पित विशेषज्ञ मार्गदर्शन भी।":"id"===t?"Dukungan untuk perusahaan mencakup SLA prioritas dengan waktu respons terjamin, pendampingan orientasi dan konfigurasi ruang kerja, dukungan tinjauan keamanan/kepatuhan, serta pelatihan berkelanjutan untuk menguasai praktik terbaik. Anda juga mendapatkan jalur langsung ke tim Produk kami untuk integrasi dan masukan peta jalan, ditambah panduan ahli khusus untuk menerapkan dan meningkatkan skala penggunaan AI.":"th"===t?"การสนับสนุนสำหรับองค์กรประกอบด้วย SLA แบบเร่งด่วนพร้อมเวลาตอบกลับที่รับประกัน การเริ่มต้นใช้งานและตั้งค่าเวิร์กสเปซแบบดูแลอย่างใกล้ชิด การช่วยตรวจสอบด้านความปลอดภัยและการปฏิบัติตามข้อกำหนด รวมถึงการฝึกอบรมต่อเนื่องเพื่อให้ใช้แนวทางปฏิบัติที่ดีที่สุดได้อย่างเชี่ยวชาญ นอกจากนี้ คุณยังติดต่อทีมผลิตภัณฑ์ของเราได้โดยตรงเพื่อหารือเรื่องการเชื่อมต่อระบบและเสนอความคิดเห็นต่อโรดแมป พร้อมคำแนะนำเฉพาะจากผู้เชี่ยวชาญในการนำ AI ไปใช้งานและขยายการใช้งาน":"ko"===t?"엔터프라이즈 지원에는 보장된 응답 시간을 갖춘 우선 SLA, 전담 온보딩 및 워크스페이스 구성, 보안/규정 준수 검토 지원, 모범 사례를 숙달하기 위한 지속적인 교육이 포함됩니다. 또한 통합 및 로드맵 의견을 위해 제품팀과 직접 소통할 수 있으며, AI를 배포하고 확장하기 위한 전담 전문가 가이드도 제공받습니다.":"エンタープライズサポートには、保証された応答時間付きの優先SLA、手厚いオンボーディングとワークスペース設定、セキュリティ・コンプライアンスレビューのサポート、ベストプラクティスを習得するための継続的なトレーニングが含まれます。さらに、インテグレーションやロードマップに関する意見を直接当社のプロダクトチームに伝えられるほか、AIの導入と拡大に向けた専任の専門家によるガイダンスも受けられます。"};e.s(["enterpriseLandingPage_faq4_answer",0,p3],638892),e.i(638892);let p4=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"What support do enterprise customers get?":"pt-BR"===t?"Que suporte os clientes empresariais recebem?":"de"===t?"Welchen Support erhalten Enterprise-Kunden?":"fr"===t?"De quelle assistance bénéficient les clients Entreprise ?":"es"===t?"¿Qué soporte reciben los clientes empresariales?":"it"===t?"Quale supporto ricevono i clienti aziendali?":"hi"===t?"एंटरप्राइज़ ग्राहकों को क्या सपोर्ट मिलता है?":"id"===t?"Dukungan apa yang didapat pelanggan perusahaan?":"th"===t?"ลูกค้าองค์กรจะได้รับการสนับสนุนอะไรบ้าง?":"ko"===t?"엔터프라이즈 고객은 어떤 지원을 받나요?":"エンタープライズのお客様はどのようなサポートを受けられますか？"};e.s(["enterpriseLandingPage_faq4_question",0,p4],40438),e.i(40438);let p5=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Frequently asked questions":"pt-BR"===t?"Perguntas frequentes":"de"===t?"Häufig gestellte Fragen":"fr"===t?"Questions fréquentes":"es"===t?"Preguntas frecuentes":"it"===t?"Domande frequenti":"hi"===t?"अक्सर पूछे जाने वाले सवाल":"id"===t?"Pertanyaan yang sering diajukan":"th"===t?"คำถามที่พบบ่อย":"ko"===t?"자주 묻는 질문":"よくある質問"};e.s(["enterpriseLandingPage_faq_title",0,p5],25890),e.i(25890);let p8=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Product teams create prototypes and working software while engineers maintain standards and review on GitHub.":"pt-BR"===t?"Equipes de produto criam protótipos e software funcional enquanto os engenheiros mantêm os padrões e fazem revisões no GitHub.":"de"===t?"Produktteams erstellen Prototypen und funktionierende Software, während Entwicklerinnen und Entwickler Standards einhalten und Änderungen auf GitHub überprüfen.":"fr"===t?"Les équipes produit créent des prototypes et des logiciels fonctionnels pendant que les ingénieurs maintiennent les standards et effectuent les revues sur GitHub.":"es"===t?"Los equipos de producto crean prototipos y software funcional mientras los ingenieros mantienen los estándares y revisan en GitHub.":"it"===t?"I team di prodotto creano prototipi e software funzionante mentre gli ingegneri mantengono gli standard ed effettuano le revisioni su GitHub.":"hi"===t?"प्रोडक्ट टीमें प्रोटोटाइप और काम करने वाला सॉफ़्टवेयर बनाती हैं, जबकि इंजीनियर मानक बनाए रखते हैं और GitHub पर समीक्षा करते हैं।":"id"===t?"Tim produk membuat prototipe dan perangkat lunak yang berfungsi sementara insinyur menjaga standar dan meninjau di GitHub.":"th"===t?"ทีมผลิตภัณฑ์สร้างต้นแบบและซอฟต์แวร์ที่ใช้งานได้จริง ในขณะที่วิศวกรรักษามาตรฐานและรีวิวบน GitHub":"ko"===t?"제품팀이 프로토타입과 작동하는 소프트웨어를 만드는 동안 엔지니어는 표준을 유지하고 GitHub에서 검토합니다.":"プロダクトチームがプロトタイプや実際に動くソフトウェアを作成し、エンジニアは標準を維持してGitHub上でレビューします。"};e.s(["enterpriseLandingPage_feature1_description",0,p8],473210),e.i(473210);let p6=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Build together without bottlenecks":"pt-BR"===t?"Criar juntos sem gargalos":"de"===t?"Gemeinsam entwickeln ohne Engpässe":"fr"===t?"Créez ensemble sans goulots d'étranglement":"es"===t?"Construyan juntos sin cuellos de botella":"it"===t?"Sviluppate insieme senza colli di bottiglia":"hi"===t?"बिना अड़चनों के एक साथ मिलकर बनाएं":"id"===t?"Bangun bersama tanpa hambatan":"th"===t?"สร้างงานร่วมกันได้โดยไม่มีคอขวด":"ko"===t?"병목 현상 없이 함께 만들기":"ボトルネックなしでチーム一丸となって開発"};e.s(["enterpriseLandingPage_feature1_title",0,p6],229585),e.i(229585);let p9=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Our batteries-included platform provides auth, email, connectors, and hosting so you can go from prototype to production in days.":"pt-BR"===t?"Nossa plataforma completa oferece autenticação, e-mail, conectores e hospedagem para você ir do protótipo à produção em poucos dias.":"de"===t?"Unsere umfassend ausgestattete Plattform bietet Authentifizierung, E-Mail, Konnektoren und Hosting, damit du in wenigen Tagen vom Prototyp zur Produktion gelangst.":"fr"===t?"Notre plateforme tout-en-un fournit l'authentification, les e-mails, les connecteurs et l'hébergement pour passer du prototype à la production en quelques jours.":"es"===t?"Nuestra plataforma con todo incluido ofrece autenticación, correo electrónico, conectores y alojamiento para que pases del prototipo a producción en cuestión de días.":"it"===t?"La nostra piattaforma completa di tutto il necessario offre autenticazione, email, connettori e hosting, così puoi passare dal prototipo alla produzione in pochi giorni.":"hi"===t?"हमारा सभी सुविधाओं वाला प्लेटफ़ॉर्म प्रमाणीकरण, ईमेल, कनेक्टर और होस्टिंग देता है, ताकि आप कुछ ही दिनों में प्रोटोटाइप से प्रोडक्शन तक पहुँच सकें।":"id"===t?"Platform lengkap kami menyediakan autentikasi, email, konektor, dan hosting sehingga Anda bisa beralih dari prototipe ke produksi dalam hitungan hari.":"th"===t?"แพลตฟอร์มแบบครบเครื่องของเรามาพร้อมระบบยืนยันตัวตน อีเมล ตัวเชื่อมต่อ และโฮสติ้ง คุณจึงพัฒนาจากต้นแบบไปสู่การใช้งานจริงได้ภายในไม่กี่วัน":"ko"===t?"필요한 모든 기능이 기본 제공되는 플랫폼으로 인증, 이메일, 커넥터, 호스팅을 제공해 프로토타입에서 프로덕션까지 며칠 만에 완성할 수 있어요.":"認証、メール、コネクター、ホスティングまで一通り揃ったプラットフォームなので、プロトタイプから本番環境まで数日で進められます。"};e.s(["enterpriseLandingPage_feature2_description",0,p9],573724),e.i(573724);let p7=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Ship real tools fast":"pt-BR"===t?"Crie ferramentas reais rapidamente":"de"===t?"Echte Tools schnell ausliefern":"fr"===t?"Livrez de vrais outils rapidement":"es"===t?"Lanza herramientas reales rápidamente":"it"===t?"Lancia strumenti concreti rapidamente":"hi"===t?"काम आने वाले टूल तेज़ी से लॉन्च करें":"id"===t?"Luncurkan alat nyata dengan cepat":"th"===t?"ส่งมอบเครื่องมือใช้งานจริงได้อย่างรวดเร็ว":"ko"===t?"실제 도구를 빠르게 출시하세요":"実用的なツールを素早く提供"};e.s(["enterpriseLandingPage_feature2_title",0,p7],359428),e.i(359428);let me=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Integrate your favorite tools and connect context from places like Linear, Atlassian, Notion, n8n, Miro, and more. Code is always owned by you, can be exported to GitHub, and deployed anywhere.":"pt-BR"===t?"Integre suas ferramentas favoritas e conecte contexto de lugares como Linear, Atlassian, Notion, n8n, Miro e muito mais. O código é sempre seu, pode ser exportado para o GitHub e implantado em qualquer lugar.":"de"===t?"Integriere deine bevorzugten Tools und binde Kontext aus Quellen wie Linear, Atlassian, Notion, n8n, Miro und mehr ein. Der Code gehört immer dir, lässt sich nach GitHub exportieren und überall bereitstellen.":"fr"===t?"Intégrez vos outils favoris et récupérez du contexte depuis des plateformes comme Linear, Atlassian, Notion, n8n, Miro et bien d’autres. Le code vous appartient toujours, peut être exporté vers GitHub et déployé n’importe où.":"es"===t?"Integra tus herramientas favoritas y conecta contexto desde lugares como Linear, Atlassian, Notion, n8n, Miro y más. El código siempre es tuyo, puede exportarse a GitHub y desplegarse donde quieras.":"it"===t?"Integra i tuoi strumenti preferiti e collega il contesto da fonti come Linear, Atlassian, Notion, n8n, Miro e altre ancora. Il codice è sempre di tua proprietà, può essere esportato su GitHub e distribuito ovunque.":"hi"===t?"अपने पसंदीदा टूल जोड़ें और Linear, Atlassian, Notion, n8n, Miro जैसी जगहों से संदर्भ जोड़ें। कोड हमेशा आपका रहता है, उसे GitHub पर निर्यात किया जा सकता है और कहीं भी तैनात किया जा सकता है।":"id"===t?"Integrasikan alat favorit Anda dan hubungkan konteks dari tempat seperti Linear, Atlassian, Notion, n8n, Miro, dan lainnya. Kode selalu menjadi milik Anda, bisa diekspor ke GitHub, dan diterapkan di mana saja.":"th"===t?"ผสานเครื่องมือที่คุณชื่นชอบและเชื่อมต่อบริบทจากแหล่งต่าง ๆ เช่น Linear, Atlassian, Notion, n8n, Miro และอื่น ๆ โค้ดเป็นของคุณเสมอ สามารถส่งออกไปยัง GitHub และนำไปใช้งานได้ทุกที่":"ko"===t?"즐겨 쓰는 도구를 통합하고 Linear, Atlassian, Notion, n8n, Miro 등 다양한 곳의 컨텍스트를 연결하세요. 코드는 항상 여러분의 소유이며, GitHub로 내보내거나 어디든 배포할 수 있어요.":"お気に入りのツールを統合し、Linear、Atlassian、Notion、n8n、Miro などのコンテキストを連携できます。コードの所有権は常にお客様にあり、GitHub にエクスポートして、どこにでもデプロイできます。"};e.s(["enterpriseLandingPage_feature3_description",0,me],533115),e.i(533115);let ma=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Plays well with your stack":"pt-BR"===t?"Funciona bem com seu conjunto de ferramentas":"de"===t?"Passt zu deinem Stack":"fr"===t?"S’intègre parfaitement à votre environnement technique":"es"===t?"Encaja bien con tus herramientas":"it"===t?"Si integra perfettamente con il tuo stack":"hi"===t?"आपके टेक स्टैक के साथ बढ़िया तालमेल":"id"===t?"Cocok dengan tumpukan teknologi Anda":"th"===t?"ทำงานเข้ากับเครื่องมือที่คุณใช้อยู่ได้ดี":"ko"===t?"기존 스택과 잘 어울려요":"既存のスタックとスムーズに連携"};e.s(["enterpriseLandingPage_feature3_title",0,ma],767385),e.i(767385);let mt=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"SOC 2/ISO 27001 certified with SSO/SAML, role‑based access, audit logs, and workspace‑level brand consistency built in.":"pt-BR"===t?"Certificada SOC 2/ISO 27001, com SSO/SAML, acesso baseado em funções, logs de auditoria e consistência de marca no nível do workspace já integrados.":"de"===t?"SOC 2/ISO 27001-zertifiziert mit SSO/SAML, rollenbasiertem Zugriff, Prüfprotokollen und integrierter Markenkonsistenz auf Workspace-Ebene.":"fr"===t?"Certifiée SOC 2/ISO 27001, avec SSO/SAML, accès basé sur les rôles, journaux d’audit et cohérence de marque au niveau de l’espace de travail intégrés.":"es"===t?"Certificada SOC 2/ISO 27001, con SSO/SAML, acceso basado en roles, registros de auditoría y coherencia de marca a nivel de espacio de trabajo integrados.":"it"===t?"Certificata SOC 2/ISO 27001, con SSO/SAML, accesso basato sui ruoli, log di audit e coerenza del marchio integrata a livello di spazio di lavoro.":"hi"===t?"SOC 2/ISO 27001 प्रमाणित, जिसमें SSO/SAML, भूमिका‑आधारित एक्सेस, ऑडिट लॉग और कार्यक्षेत्र‑स्तर पर ब्रांड एकरूपता पहले से शामिल है।":"id"===t?"Bersertifikat SOC 2/ISO 27001 dengan SSO/SAML, akses berbasis peran, catatan audit, dan konsistensi merek tingkat ruang kerja yang sudah terintegrasi.":"th"===t?"ได้รับการรับรอง SOC 2/ISO 27001 พร้อม SSO/SAML การเข้าถึงตามบทบาท บันทึกการตรวจสอบ และการรักษาความสอดคล้องของแบรนด์ในระดับเวิร์กสเปซที่พร้อมใช้งาน":"ko"===t?"SOC 2/ISO 27001 인증을 받았으며 SSO/SAML, 역할 기반 접근 제어, 감사 로그, 워크스페이스 단위의 브랜드 일관성이 기본으로 내장되어 있어요.":"SOC 2／ISO 27001 認証を取得し、SSO／SAML、ロールベースのアクセス制御、監査ログ、ワークスペース単位のブランド統一を標準で備えています。"};e.s(["enterpriseLandingPage_feature4_description",0,mt],263284),e.i(263284);let mi=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Govern at enterprise standards":"pt-BR"===t?"Governe com padrões corporativos":"de"===t?"Governance nach Enterprise-Standards":"fr"===t?"Gérez selon les standards d'entreprise":"es"===t?"Gobierna con estándares empresariales":"it"===t?"Governance conforme agli standard aziendali":"hi"===t?"एंटरप्राइज़ मानकों पर नियंत्रण रखें":"id"===t?"Tata kelola sesuai standar perusahaan":"th"===t?"กำกับดูแลตามมาตรฐานองค์กร":"ko"===t?"엔터프라이즈 기준으로 거버넌스를 관리하세요":"エンタープライズ水準のガバナンスを実現"};e.s(["enterpriseLandingPage_feature4_title",0,mi],498769),e.i(498769);let mo=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Turn ideas into clickable prototypes and working tools in minutes. Ship them as production-ready apps that fit your internal workflows.":"pt-BR"===t?"Transforme ideias em protótipos clicáveis e ferramentas funcionais em minutos. Publique-os como aplicativos prontos para produção que se encaixam nos seus fluxos de trabalho internos.":"de"===t?"Verwandle Ideen in wenigen Minuten in klickbare Prototypen und funktionierende Tools. Liefere sie als produktionsreife Apps aus, die zu deinen internen Workflows passen.":"fr"===t?"Transformez vos idées en prototypes cliquables et en outils fonctionnels en quelques minutes. Livrez-les sous forme d'applications prêtes pour la production, adaptées à vos flux de travail internes.":"es"===t?"Convierte ideas en prototipos interactivos y herramientas funcionales en minutos. Lánzalos como aplicaciones listas para producción que encajan con tus flujos de trabajo internos.":"it"===t?"Trasforma le idee in prototipi cliccabili e strumenti funzionanti in pochi minuti. Distribuiscili come app pronte per la produzione, adatte ai tuoi flussi di lavoro interni.":"hi"===t?"मिनटों में विचारों को क्लिक करने योग्य प्रोटोटाइप और काम करने वाले टूल में बदलें। उन्हें उत्पादन के लिए तैयार ऐप के रूप में लॉन्च करें, जो आपके आंतरिक वर्कफ़्लो में सहजता से काम करें।":"id"===t?"Ubah ide menjadi prototipe yang bisa diklik dan alat yang berfungsi dalam hitungan menit. Luncurkan sebagai aplikasi siap produksi yang sesuai dengan alur kerja internal Anda.":"th"===t?"เปลี่ยนไอเดียให้เป็นต้นแบบที่คลิกใช้งานได้และเครื่องมือที่ทำงานได้จริงภายในไม่กี่นาที พร้อมส่งมอบในรูปแบบแอปที่พร้อมใช้งานจริงและเข้ากับเวิร์กโฟลว์ภายในของคุณ":"ko"===t?"아이디어를 몇 분 만에 클릭 가능한 프로토타입과 실제로 작동하는 도구로 만드세요. 내부 워크플로에 딱 맞는 프로덕션 수준의 앱으로 바로 출시할 수 있어요.":"アイデアをわずか数分でクリック可能なプロトタイプや実用的なツールに変えましょう。社内ワークフローにフィットする本番対応のアプリとして提供できます。"};e.s(["enterpriseLandingPage_features_subtitle",0,mo],389075),e.i(389075);let mn=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Build prototypes and internal tools fast":"pt-BR"===t?"Crie protótipos e ferramentas internas rapidamente":"de"===t?"Prototypen und interne Tools schnell erstellen":"fr"===t?"Créez rapidement des prototypes et des outils internes":"es"===t?"Crea prototipos y herramientas internas rápidamente":"it"===t?"Crea prototipi e strumenti interni in modo rapido":"hi"===t?"प्रोटोटाइप और आंतरिक टूल तेज़ी से बनाएं":"id"===t?"Bangun prototipe dan alat internal dengan cepat":"th"===t?"สร้างต้นแบบและเครื่องมือภายในได้อย่างรวดเร็ว":"ko"===t?"프로토타입과 내부 도구를 빠르게 만드세요":"プロトタイプと社内ツールを素早く構築"};e.s(["enterpriseLandingPage_features_title",0,mn],11171),e.i(11171);var mr=e.i(172333),ms=e.i(534012),ml=e.i(618376),mc=e.i(232181),mu=e.i(227397);let md=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Explore all integrations":"pt-BR"===t?"Explorar todas as integrações":"de"===t?"Alle Integrationen entdecken":"fr"===t?"Découvrir toutes les intégrations":"es"===t?"Explora todas las integraciones":"it"===t?"Esplora tutte le integrazioni":"hi"===t?"सभी एकीकरण देखें":"id"===t?"Jelajahi semua integrasi":"th"===t?"สำรวจการผสานการทำงานทั้งหมด":"ko"===t?"모든 통합 살펴보기":"すべての連携機能を見る"};e.s(["enterpriseLandingPage_integrations_cta",0,md],176988),e.i(176988);let mp=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Pull context from Jira, Confluence, Notion or Linear to build your prototype and validate with stakeholders before engineering starts.":"pt-BR"===t?"Extraia contexto do Jira, Confluence, Notion ou Linear para criar seu protótipo e validá-lo com as partes interessadas antes de a engenharia começar.":"de"===t?"Hole Kontext aus Jira, Confluence, Notion oder Linear, um deinen Prototyp zu erstellen und ihn mit Stakeholdern zu validieren, bevor die Entwicklung beginnt.":"fr"===t?"Récupérez le contexte depuis Jira, Confluence, Notion ou Linear pour créer votre prototype et le valider avec les parties prenantes avant le début du travail d’ingénierie.":"es"===t?"Obtén contexto desde Jira, Confluence, Notion o Linear para crear tu prototipo y validarlo con las partes interesadas antes de que empiece la ingeniería.":"it"===t?"Recupera il contesto da Jira, Confluence, Notion o Linear per creare il tuo prototipo e validarlo con le parti interessate prima che inizi lo sviluppo.":"hi"===t?"Jira, Confluence, Notion या Linear से संदर्भ लेकर अपना प्रोटोटाइप बनाएं और इंजीनियरिंग शुरू होने से पहले हितधारकों के साथ उसे सत्यापित करें।":"id"===t?"Ambil konteks dari Jira, Confluence, Notion, atau Linear untuk membangun prototipe Anda dan memvalidasinya bersama pemangku kepentingan sebelum pengembangan dimulai.":"th"===t?"ดึงบริบทจาก Jira, Confluence, Notion หรือ Linear เพื่อสร้างต้นแบบและตรวจสอบกับผู้มีส่วนได้ส่วนเสียก่อนเริ่มงานวิศวกรรม":"ko"===t?"Jira, Confluence, Notion 또는 Linear에서 컨텍스트를 가져와 프로토타입을 만들고, 엔지니어링이 시작되기 전에 이해관계자와 함께 검증하세요.":"Jira、Confluence、Notion、Linear からコンテキストを取り込んでプロトタイプを作り、エンジニアリングが始まる前に関係者と検証できます。"};e.s(["enterpriseLandingPage_integrations_step1_description",0,mp],113292),e.i(113292);let mm=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"For prototypes":"pt-BR"===t?"Para protótipos":"de"===t?"Für Prototypen":"fr"===t?"Pour les prototypes":"es"===t?"Para prototipos":"it"===t?"Per i prototipi":"hi"===t?"प्रोटोटाइप के लिए":"id"===t?"Untuk prototipe":"th"===t?"สำหรับต้นแบบ":"ko"===t?"프로토타입용":"プロトタイプ向け"};e.s(["enterpriseLandingPage_integrations_step1_title",0,mm],141818),e.i(141818);let mg=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Connect your CRM, databases, or enterprise systems to build custom dashboards and workflows your teams actually need.":"pt-BR"===t?"Conecte seu CRM, bancos de dados ou sistemas corporativos para criar painéis e fluxos de trabalho personalizados que suas equipes realmente precisam.":"de"===t?"Verbinde dein CRM, deine Datenbanken oder Enterprise-Systeme, um maßgeschneiderte Dashboards und Workflows zu erstellen, die deine Teams wirklich brauchen.":"fr"===t?"Connectez votre CRM, vos bases de données ou vos systèmes d'entreprise pour créer des tableaux de bord et des flux de travail personnalisés dont vos équipes ont réellement besoin.":"es"===t?"Conecta tu CRM, bases de datos o sistemas empresariales para crear paneles y flujos de trabajo personalizados que tus equipos realmente necesitan.":"it"===t?"Collega il tuo CRM, i database o i sistemi aziendali per creare dashboard e flussi di lavoro personalizzati di cui i tuoi team hanno davvero bisogno.":"hi"===t?"अपने CRM, डेटाबेस या एंटरप्राइज़ सिस्टम जोड़ें और ऐसे अनुकूलित डैशबोर्ड व वर्कफ़्लो बनाएं जिनकी आपकी टीमों को वाकई ज़रूरत है।":"id"===t?"Hubungkan CRM, basis data, atau sistem perusahaan Anda untuk membangun dasbor dan alur kerja khusus yang benar-benar dibutuhkan tim Anda.":"th"===t?"เชื่อมต่อ CRM, ฐานข้อมูล หรือระบบองค์กรของคุณ เพื่อสร้างแดชบอร์ดและเวิร์กโฟลว์ที่ปรับแต่งได้ตามที่ทีมของคุณต้องการจริง ๆ":"ko"===t?"CRM, 데이터베이스, 엔터프라이즈 시스템을 연결해 팀이 정말로 필요로 하는 맞춤형 대시보드와 워크플로를 만드세요.":"CRM、データベース、エンタープライズシステムを接続して、チームが本当に必要とするカスタムダッシュボードやワークフローを構築できます。"};e.s(["enterpriseLandingPage_integrations_step2_description",0,mg],42340),e.i(42340);let mb=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"For internal tools":"pt-BR"===t?"Para ferramentas internas":"de"===t?"Für interne Tools":"fr"===t?"Pour les outils internes":"es"===t?"Para herramientas internas":"it"===t?"Per gli strumenti interni":"hi"===t?"आंतरिक टूल के लिए":"id"===t?"Untuk alat internal":"th"===t?"สำหรับเครื่องมือภายใน":"ko"===t?"내부 도구용":"社内ツール向け"};e.s(["enterpriseLandingPage_integrations_step2_title",0,mb],31722),e.i(31722);let mh=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Sync validated prototypes to GitHub and hand off standard React, Supabase, and Tailwind code.":"pt-BR"===t?"Sincronize protótipos validados com o GitHub e entregue código padrão em React, Supabase e Tailwind.":"de"===t?"Synchronisiere validierte Prototypen mit GitHub und übergib standardmäßigen React-, Supabase- und Tailwind-Code.":"fr"===t?"Synchronisez les prototypes validés avec GitHub et transmettez du code React, Supabase et Tailwind standard.":"es"===t?"Sincroniza prototipos validados con GitHub y entrega código estándar de React, Supabase y Tailwind.":"it"===t?"Sincronizza i prototipi validati con GitHub e consegna codice standard React, Supabase e Tailwind.":"hi"===t?"सत्यापित प्रोटोटाइप को GitHub से सिंक करें और मानक React, Supabase तथा Tailwind कोड सौंपें।":"id"===t?"Sinkronkan prototipe yang sudah tervalidasi ke GitHub dan serahkan kode React, Supabase, dan Tailwind standar.":"th"===t?"ซิงค์ต้นแบบที่ผ่านการตรวจสอบไปยัง GitHub และส่งต่อโค้ด React, Supabase และ Tailwind มาตรฐาน":"ko"===t?"검증된 프로토타입을 GitHub에 동기화하고 표준 React, Supabase, Tailwind 코드로 인계하세요.":"検証済みのプロトタイプを GitHub に同期し、標準的な React、Supabase、Tailwind のコードとして引き継げます。"};e.s(["enterpriseLandingPage_integrations_step3_description",0,mh],849114),e.i(849114);let mv=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"For customer apps":"pt-BR"===t?"Para aplicativos voltados a clientes":"de"===t?"Für Kunden-Apps":"fr"===t?"Pour les applications destinées aux clients":"es"===t?"Para aplicaciones para clientes":"it"===t?"Per le app destinate ai clienti":"hi"===t?"ग्राहक ऐप्स के लिए":"id"===t?"Untuk aplikasi pelanggan":"th"===t?"สำหรับแอปลูกค้า":"ko"===t?"고객용 앱":"顧客向けアプリ用"};e.s(["enterpriseLandingPage_integrations_step3_title",0,mv],613169),e.i(613169);let m_=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Don't start from scratch. Connect your internal tools to Lovable and build within your context.":"pt-BR"===t?"Não comece do zero. Conecte suas ferramentas internas ao Lovable e crie dentro do seu contexto.":"de"===t?"Fang nicht bei null an. Verbinde deine internen Tools mit Lovable und entwickle mit deinem eigenen Kontext.":"fr"===t?"Ne partez pas de zéro. Connectez vos outils internes à Lovable et créez en tenant compte de votre contexte.":"es"===t?"No empieces desde cero. Conecta tus herramientas internas a Lovable y crea con tu propio contexto.":"it"===t?"Non partire da zero. Collega i tuoi strumenti interni a Lovable e crea all'interno del tuo contesto.":"hi"===t?"शून्य से शुरू न करें। अपने आंतरिक टूल को Lovable से जोड़ें और अपने संगठन की ज़रूरतों के हिसाब से बनाएं।":"id"===t?"Tidak perlu mulai dari nol. Hubungkan alat internal Anda ke Lovable dan bangun sesuai konteks Anda.":"th"===t?"ไม่ต้องเริ่มจากศูนย์ เชื่อมต่อเครื่องมือภายในของคุณกับ Lovable แล้วสร้างสิ่งต่าง ๆ โดยอิงบริบทของคุณเอง":"ko"===t?"처음부터 시작하지 마세요. 내부 도구를 Lovable에 연결하고 조직의 맥락에 맞춰 구축하세요.":"ゼロから始める必要はありません。社内ツールをLovableに接続し、既存の業務コンテキストの中で構築できます。"};e.s(["enterpriseLandingPage_integrations_subtitle",0,m_],262019),e.i(262019);let mf=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Integrations and ecosystem":"pt-BR"===t?"Integrações e ecossistema":"de"===t?"Integrationen und Ökosystem":"fr"===t?"Intégrations et écosystème":"es"===t?"Integraciones y ecosistema":"it"===t?"Integrazioni ed ecosistema":"hi"===t?"इंटीग्रेशन और इकोसिस्टम":"id"===t?"Integrasi dan ekosistem":"th"===t?"การเชื่อมต่อและระบบนิเวศ":"ko"===t?"통합 및 생태계":"インテグレーションとエコシステム"};e.s(["enterpriseLandingPage_integrations_title",0,mf],532880),e.i(532880);let mk=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Empower your teams with Lovable's enterprise AI platform. Go from prototype to production with integrations, governance, SSO, and SOC2 security.":"pt-BR"===t?"Capacite suas equipes com a plataforma de IA empresarial da Lovable. Vá do protótipo à produção com integrações, governança, SSO e segurança SOC2.":"de"===t?"Stärke deine Teams mit der Enterprise-KI-Plattform von Lovable. Vom Prototyp bis zur Produktion – mit Integrationen, Governance, SSO und SOC2-Sicherheit.":"fr"===t?"Donnez à vos équipes les moyens d'agir avec la plateforme d'IA d'entreprise de Lovable. Passez du prototype à la production grâce aux intégrations, à la gouvernance, au SSO et à la sécurité SOC2.":"es"===t?"Potencia a tus equipos con la plataforma de IA empresarial de Lovable. Pasa del prototipo a la producción con integraciones, gobernanza, SSO y seguridad SOC2.":"it"===t?"Potenzia i tuoi team con la piattaforma AI aziendale di Lovable. Passa dal prototipo alla produzione con integrazioni, governance, SSO e sicurezza SOC2.":"hi"===t?"Lovable के एंटरप्राइज़ AI प्लेटफ़ॉर्म से अपनी टीमों को सशक्त बनाएं। इंटीग्रेशन, गवर्नेंस, SSO और SOC2 सुरक्षा के साथ प्रोटोटाइप से प्रोडक्शन तक जाएं।":"id"===t?"Berdayakan tim Anda dengan platform AI perusahaan dari Lovable. Beralih dari prototipe ke produksi dengan integrasi, tata kelola, SSO, dan keamanan SOC2.":"th"===t?"เสริมศักยภาพให้ทีมของคุณด้วยแพลตฟอร์ม AI ระดับองค์กรของ Lovable เปลี่ยนจากต้นแบบสู่การใช้งานจริงด้วยการเชื่อมต่อ การกำกับดูแล SSO และความปลอดภัยระดับ SOC2":"ko"===t?"Lovable의 엔터프라이즈 AI 플랫폼으로 팀의 역량을 강화하세요. 통합, 거버넌스, SSO, SOC 2 보안을 통해 프로토타입에서 프로덕션까지 나아가세요.":"Lovableのエンタープライズ向けAIプラットフォームで、チームの力を引き出しましょう。インテグレーション、ガバナンス、SSO、SOC2セキュリティを備え、プロトタイプから本番環境まで実現できます。"};e.s(["enterpriseLandingPage_meta_description",0,mk],696134),e.i(696134);let mL=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Enterprise App Builder | Collaborative AI App Builder | Lovable":"pt-BR"===t?"Criador de aplicativos empresariais | Criador colaborativo de aplicativos com IA | Lovable":"de"===t?"Enterprise-App-Builder | Kollaborativer KI-App-Builder | Lovable":"fr"===t?"Créateur d'applications d'entreprise | Créateur collaboratif d'applications d'IA | Lovable":"es"===t?"Creador de aplicaciones para empresas | Creador colaborativo de apps con IA | Lovable":"it"===t?"Generatore di app aziendali | Generatore collaborativo di app con AI | Lovable":"hi"===t?"एंटरप्राइज़ ऐप बिल्डर | सहयोगी AI ऐप बिल्डर | Lovable":"id"===t?"Pembuat Aplikasi untuk Perusahaan | Pembuat Aplikasi AI Kolaboratif | Lovable":"th"===t?"เครื่องมือสร้างแอประดับองค์กร | เครื่องมือสร้างแอป AI แบบทำงานร่วมกัน | Lovable":"ko"===t?"엔터프라이즈 앱 빌더 | 협업형 AI 앱 빌더 | Lovable":"エンタープライズ向けアプリビルダー | 共同作業型AIアプリビルダー | Lovable"};e.s(["enterpriseLandingPage_meta_title",0,mL],706049),e.i(706049);let mP=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Learn more":"pt-BR"===t?"Saiba mais":"de"===t?"Mehr erfahren":"fr"===t?"En savoir plus":"es"===t?"Más información":"it"===t?"Scopri di più":"hi"===t?"और जानें":"id"===t?"Pelajari selengkapnya":"th"===t?"เรียนรู้เพิ่มเติม":"ko"===t?"자세히 알아보기":"詳しく見る"};e.s(["enterpriseLandingPage_resources_changelog_cta",0,mP],465497),e.i(465497);let my=(e={},a={})=>{let t=c.experimentalStaticLocale??a.locale??(0,c.getLocale)();return"en"===t?"Track updates to our terms, DPA, and other legal documents.":"pt-BR"===t?"Acompanhe as atualizaç