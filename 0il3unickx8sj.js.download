cyLink>.":"pt-BR"===n?"Ao continuar, você concorda com os <termsLink>Termos de Serviço</termsLink> e a <privacyLink>Política de Privacidade</privacyLink>.":"de"===n?"Indem du fortfährst, stimmst du den <termsLink>Nutzungsbedingungen</termsLink> und der <privacyLink>Datenschutzerklärung</privacyLink> zu.":"fr"===n?"En continuant, vous acceptez les <termsLink>Conditions d'utilisation</termsLink> et la <privacyLink>Politique de confidentialité</privacyLink>.":"es"===n?"Al continuar, aceptas los <termsLink>Términos del servicio</termsLink> y la <privacyLink>Política de privacidad</privacyLink>.":"it"===n?"Continuando, accetti i <termsLink>Termini di servizio</termsLink> e l'<privacyLink>Informativa sulla privacy</privacyLink>.":"hi"===n?"जारी रखकर, आप <termsLink>सेवा की शर्तों</termsLink> और <privacyLink>गोपनीयता नीति</privacyLink> से सहमत होते हैं।":"id"===n?"Dengan melanjutkan, Anda menyetujui <termsLink>Ketentuan Layanan</termsLink> dan <privacyLink>Kebijakan Privasi</privacyLink>.":"th"===n?"เมื่อดำเนินการต่อ ถือว่าคุณยอมรับ<termsLink>ข้อกำหนดในการให้บริการ</termsLink>และ<privacyLink>นโยบายความเป็นส่วนตัว</privacyLink>":"ko"===n?"계속하면 <termsLink>서비스 약관</termsLink> 및 <privacyLink>개인정보 처리방침</privacyLink>에 동의하는 것으로 간주됩니다.":"続行すると、<termsLink>利用規約</termsLink>および<privacyLink>プライバシーポリシー</privacyLink>に同意したことになります。"}])},357049,e=>{"use strict";var i=e.i(420459);e.s(["auth_recommended",0,(e={},t={})=>{let n=i.experimentalStaticLocale??t.locale??(0,i.getLocale)();return"en"===n?"Recommended":"pt-BR"===n?"Recomendado":"de"===n?"Empfohlen":"fr"===n?"Recommandé":"es"===n?"Recomendado":"it"===n?"Consigliato":"hi"===n?"अनुशंसित":"id"===n?"Direkomendasikan":"th"===n?"แนะนำ":"ko"===n?"추천":"おすすめ"}])},210122,e=>{"use strict";var i=e.i(420459);e.s(["auth_continueWithGoogle",0,(e={},t={})=>{let n=i.experimentalStaticLocale??t.locale??(0,i.getLocale)();return"en"===n?"Continue with Google":"pt-BR"===n?"Continuar com Google":"de"===n?"Mit Google fortfahren":"fr"===n?"Continuer avec Google"