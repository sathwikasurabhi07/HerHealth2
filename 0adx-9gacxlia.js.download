n?"We got an update for you!":"pt-BR"===n?"Temos uma novidade para você!":"de"===n?"Wir haben ein Update für dich!":"fr"===n?"Nous avons une nouveauté pour vous !":"es"===n?"¡Tenemos una novedad para ti!":"it"===n?"Abbiamo una novità per te!":"hi"===n?"आपके लिए एक अपडेट है!":"id"===n?"Ada pembaruan untuk Anda!":"th"===n?"เรามีอัปเดตใหม่มาฝากคุณ!":"ko"===n?"업데이트 소식이 있어요!":"アップデートのお知らせです！"}])},306576,e=>{"use strict";var t=e.i(420459);e.s(["supabaseReauthDialog_description",0,(e={},a={})=>{let n=t.experimentalStaticLocale??a.locale??(0,t.getLocale)();return"en"===n?"To make Supabase integration more robust, Lovable can now read your project logs. Please re-authenticate with Supabase to continue.":"pt-BR"===n?"Para tornar a integração com o Supabase mais robusta, a Lovable agora pode ler os logs do seu projeto. Autentique-se novamente com o Supabase para continuar.":"de"===n?"Damit die Supabase-Integration zuverlässiger wird, kann Lovable jetzt deine Projektprotokolle lesen. Bitte authentifiziere dich erneut bei Supabase, um fortzufahren.":"fr"===n?"Pour rendre l'intégration Supabase plus robuste, Lovable peut désormais lire les journaux de votre projet. Veuillez vous réauthentifier avec Supabase pour continuer.":"es"===n?"Para hacer la integración de Supabase más robusta, Lovable ahora puede leer los registros de tu proyecto. Vuelve a autenticarte con Supabase para continuar.":"it"===n?"Per rendere l'integrazione Supabase più affidabile, Lovable può ora leggere i log del tuo progetto. Autenticati di nuovo con Supabase per continuare.":"hi"===n?"Supabase एकीकरण को और मज़बूत बनाने के लिए, Lovable अब आपके प्रोजेक्ट के लॉग पढ़ सकता है। जारी रखने के लिए कृपया Supabase से फिर से प्रमाणित करें।":"id"===n?"Agar integrasi Supabase lebih andal, Lovable kini dapat membaca log proyek Anda. Silakan autentikasi ulang dengan Supabase untuk melanjutkan.":"th"===n?"เพื่อให้การเชื่อมต่อ Supabase มีความเสถียรยิ่งขึ้น ตอนนี้ Lovable สามารถอ่านบันทึกของโปรเจกต์คุณได้แล้ว กรุณายืนยันตัวตนกับ Supabase อีกครั้งเพื่อดำเนินการต่อ":"ko"===n?"Supabase 통합을 더 안정적으로 만들기 위해, 이제 Lovable이 프로젝트 로그를 읽을 수 있어요. 계속하려면 Supabase로 다시 인증해 주세요.":"Supabase連携をより堅牢にするため、Lovableがプロジェクトのログを読み取れるようになりました。続行するにはSupabaseで再認証してください。"}])},403288,e=>{"use strict";var t=e.i(420459);e.s(["supabaseReauthDialog_button_reauthenticate",0,(e={},a={})=>{let n=t.experimentalStaticLocale??a.locale??(0,t.getLocale)();return"en"===n?"Re-authenticate with Supabase":"pt-BR"===n?"Autenticar novamente com o Supabase":"de"===n?"Erneut bei Supabase authentifizieren":"fr"===n?"Se réauthentifier avec Supabase":"es"===n?"Volver a autenticarte con Supabase":"it"===n?"Autenticati di nuovo con Supabase":"hi"===n?"Supabase के साथ फिर से प्रमाणित करें":"id"===n?"Autentikasi ulang dengan Supabase":"th"===n?"ยืนยันตัวตนกับ Supabase อีกครั้ง":"ko"===n?"Supabase로 다시 인증하기":"Supabaseで再認証する"}])},788881,e=>{"use strict";var t=e.i(420459);e.s(["chatInputActionMenu_projectSettings",0,(e={},a={})=>{let n=t.experimentalStaticLocale??a.locale??(0,t.getLocale)();return"en"===n?"Settings":"pt-BR"===n?"Configurações":"de"===n?"Einstellungen":"fr"===n?"Paramètres":"es"===n?"Ajustes":"it"===n?"Impostazioni":"hi"===n?"सेटिंग्स":"id"===n?"Pengaturan":"th"===n?"การตั้งค่า":"ko"===n?"설정":"設定"}])},808314,50910,e=>{"use strict";var t=e.i(420459);e.s(["chatInputActionMenu_history",0,(e={},a={})=>{let n=t.experimentalStaticLocale??a.locale??(0,t.getLocale)();return"en"===n?"History":"pt-BR"===n?"Histórico":"de"===n?"Verlauf":"fr"===n?"Historique":"es"===n?"Historial":"it"===n?"Cronologia":"hi"===n?"इतिहास":"id"===n?"Riwayat":"th"===n?"ประวัติ":"ko"===n?"기록":"履歴"}],808314),e.s(["chatInputActionMenu_knowledge",0,(e={},a={})=>{let n=t.experimentalStaticLocale??a.locale??(0,t.getLocale)();return"en"===n?"Knowledge":"pt-BR"===n?"Conhecimento":"de"===n?"Wissen":"fr"===n?"Connaissances":"es"===n?"Conocimiento":"it"===n?"Conoscenza":"hi"===n?"ज्ञान":"id"===n?"Pengetahuan":"th"===n?"ความรู้":"ko"===n?"지식":"ナレッジ"}],50910)},486552,219495,e=>{"u