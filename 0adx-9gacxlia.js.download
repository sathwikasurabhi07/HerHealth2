Description",0,(e,a={})=>{let n=t.experimentalStaticLocale??a.locale??(0,t.getLocale)();if("en"===n)return`We've shortened it to ${e?.count} characters. Check if important parts were removed.`;if("pt-BR"===n)return`N\xf3s o encurtamos para ${e?.count} caracteres. Verifique se partes importantes foram removidas.`;if("de"===n)return`Wir haben ihn auf ${e?.count} Zeichen gek\xfcrzt. Pr\xfcfe, ob wichtige Teile entfernt wurden.`;if("fr"===n)return`Nous l'avons raccourci \xe0 ${e?.count} caract\xe8res. V\xe9rifiez si des parties importantes ont \xe9t\xe9 supprim\xe9es.`;if("es"===n)return`Lo hemos acortado a ${e?.count} caracteres. Comprueba si se eliminaron partes importantes.`;if("it"===n)return`L'abbiamo abbreviato a ${e?.count} caratteri. Controlla se sono state rimosse parti importanti.`;if("hi"===n)return`हमने इसे छोटा करके ${e?.count} वर्ण कर दिया है। जाँचें कि कहीं ज़रूरी हिस्से तो नहीं हटे।`;if("id"===n)return`Kami telah memendekkannya menjadi ${e?.count} karakter. Periksa apakah ada bagian penting yang terhapus.`;if("th"===n)return`เราได้ย่อข้อความเหลือ ${e?.count} อักขระ ตรวจสอบว่าส่วนสำคัญถูกตัดออกไปหรือไม่`;if("ko"===n)return`${e?.count}자로 줄였어요. 중요한 부분이 삭제되지 않았는지 확인해 주세요.`;return`${e?.count}文字に短縮しました。重要な部分が削除されていないか確認してください。`}],975498)}]);

