enschutzerklärung":"fr"===i?"Politique de confidentialité":"es"===i?"Política de privacidad":"it"===i?"Informativa sulla privacy":"hi"===i?"गोपनीयता नीति देखें":"id"===i?"Kebijakan Privasi":"th"===i?"นโยบายความเป็นส่วนตัว":"ko"===i?"개인정보 처리방침":"プライバシーポリシーをご覧ください"}])},480760,e=>{"use strict";var t=e.i(420459);e.s(["eventsMap_modal_registration_privacyPrefix",0,(e={},a={})=>{let i=t.experimentalStaticLocale??a.locale??(0,t.getLocale)();return"en"===i?"By submitting this form, you agree to Lovable using your personal data to review your application to join a community event and to send you related updates. You can unsubscribe at any time. See our":"pt-BR"===i?"Ao enviar este formulário, você concorda que a Lovable utilize seus dados pessoais para analisar sua inscrição em um evento da comunidade e enviar atualizações relacionadas. Você pode cancelar o recebimento a qualquer momento. Consulte nossa":"de"===i?"Mit dem Absenden dieses Formulars stimmst du zu, dass Lovable deine personenbezogenen Daten verwendet, um deine Anmeldung zur Teilnahme an einem Community-Event zu prüfen und dir zugehörige Updates zu senden. Du kannst dich jederzeit abmelden. Siehe unsere":"fr"===i?"En soumettant ce formulaire, vous acceptez que Lovable utilise vos données personnelles pour examiner votre candidature à un événement communautaire et vous envoyer les informations associées. Vous pouvez vous désinscrire à tout moment. Consultez notre":"es"===i?"Al enviar este formulario, aceptas que Lovable use tus datos personales para revisar tu solicitud de unirte a un evento de la comunidad y para enviarte novedades relacionadas. Puedes cancelar la suscripción en cualquier momento. Consulta nuestra":"it"===i?"Inviando questo modulo, accetti che Lovable utilizzi i tuoi dati personali per esaminare la tua candidatura a partecipare a un evento della comunità e per inviarti aggiornamenti correlati. Puoi annullare l'iscrizione in qualsiasi momento. Consulta la nostra":"hi"===i?"इस फ़ॉर्म को भेजकर, आप सहमत होते हैं कि Lovable आपके व्यक्तिगत डेटा का उपयोग किसी सामुदायिक कार्यक्रम में शामिल होने के आपके आवेदन की समीक्षा करने और आपको संबंधित सूचनाएँ भेजने के लिए कर सकता है। आप किसी भी समय सदस्यता समाप्त कर सकते हैं। अधिक जानकारी के लिए हमारी":"id"===i?"Dengan mengirimkan formulir ini, Anda menyetujui Lovable menggunakan data pribadi Anda untuk meninjau pendaftaran Anda guna mengikuti acara komunitas dan mengirimkan pembaruan terkait. Anda dapat berhenti berlangganan kapan saja. Lihat":"th"===i?"เมื่อส่งแบบฟอร์มนี้ ถือว่าคุณยินยอมให้ Lovable ใช้ข้อมูลส่วนบุคคลของคุณเพื่อพิจารณาใบสมัครเข้าร่วมกิจกรรมของชุมชนและส่งข้อมูลอัปเดตที่เกี่ยวข้องให้คุณ คุณสามารถยกเลิกการรับข้อมูลได้ตลอดเวลา ดูเพิ่มเติมที่":"ko"===i?"이 양식을 제출하면 Lovable이 커뮤니티 이벤트 참가 신청을 검토하고 관련 소식을 보내기 위해 개인정보를 사용하는 데 동의하는 것으로 간주됩니다. 언제든지 수신을 거부할 수 있어요. 자세한 내용은 다음을 확인하세요:":"このフォームを送信すると、コミュニティイベントへの参加申し込みの審査および関連するお知らせの送付のために、Lovableが個人情報を利用することに同意したものとみなされます。配信はいつでも停止できます。詳しくは、"}])},107254,e=>{"use strict";var t=e.i(420459);e.s(["eventsMap_modal_registration_register",0,(e={},a={})=>{let i=t.experimentalStaticLocale??a.locale??(0,t.getLocale)();return"en"===i?"Register":"pt-BR"===i?"Inscrever-se":"de"===i?"Anmelden":"fr"===i?"S'inscrire":"es"===i?"Registrarse":"it"===i?"Registrati":"hi"===i?"पंजीकरण करें":"id"===i?"Daftar":"th"===i?"ลงทะเบียน":"ko"===i?"등록하기":"登録する"}])},415897,e=>{"use strict";var t=e.i(420459);e.s(["eventsMap_modal_registration_spotsLeft_one",0,(e,a={})=>{let i=t.experimentalStaticLocale??a.locale??(0,t.getLocale)();if("en"===i)return`${e?.count} spot left`;if("pt-BR"===i)return`${e?.count} vaga restante`;if("de"===i)return`Noch ${e?.count} Platz frei`;if("fr"===i)return`${e?.count} place restante`;if("es"===i)return`Queda ${e?.count} plaza`;if("it"===i)return`${e?.count} posto disponibile`;if("hi"===i)return`${e?.count} सीट बची है`;if("id"===i)return`Sisa ${e?.count} tempat`;if("th"===i)return`เหลือ ${e?.count} ที่`;if("ko"===i)return`${e?.count}자리 남음`;return`残り${e?.count}席`}])},469419,e=>{"