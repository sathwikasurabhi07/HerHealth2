ototipi funzionanti. Dai vita alle tue idee con la massima fedeltà.":"hi"===i?"टिकट, दस्तावेज़ और वायरफ्रेम को काम करने वाले प्रोटोटाइप में बदलें। अपने कॉन्सेप्ट को पूरी वास्तविकता के साथ साकार करें।":"id"===i?"Ubah tiket, dokumen, dan kerangka desain menjadi prototipe yang berfungsi. Wujudkan konsep dengan tampilan dan interaksi yang utuh.":"th"===i?"เปลี่ยนทิกเก็ต เอกสาร และไวร์เฟรมให้กลายเป็นต้นแบบที่ใช้งานได้จริง ทำให้แนวคิดเป็นรูปเป็นร่างอย่างสมจริงครบถ้วน":"ko"===i?"티켓, 문서, 와이어프레임을 작동하는 프로토타입으로 바꿔보세요. 완성도 높은 형태로 아이디어를 현실로 만들어 보세요.":"チケット、ドキュメント、ワイヤーフレームを動くプロトタイプに変えましょう。コンセプトを忠実に再現して形にします。"}])},999718,693785,e=>{"use strict";var a=e.i(420459);e.s(["prototypesPage_hero_titleLine1",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Proof of concept":"pt-BR"===i?"Prova de conceito":"de"===i?"Proof of Concept":"fr"===i?"Preuve de concept":"es"===i?"Prueba de concepto":"it"===i?"Prova di concetto":"hi"===i?"कॉन्सेप्ट का प्रमाण":"id"===i?"Bukti konsep":"th"===i?"การพิสูจน์แนวคิด":"ko"===i?"개념 증명":"概念実証"}],999718),e.s(["prototypesPage_hero_titleLine2",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"in hours, not weeks":"pt-BR"===i?"em horas, não semanas":"de"===i?"in Stunden, nicht Wochen":"fr"===i?"en heures, pas en semaines":"es"===i?"en horas, no semanas":"it"===i?"in ore, non settimane":"hi"===i?"हफ़्तों में नहीं, घंटों में":"id"===i?"dalam hitungan jam, bukan minggu":"th"===i?"ภายในไม่กี่ชั่วโมง ไม่ใช่หลายสัปดาห์":"ko"===i?"몇 주가 아니라 몇 시간 만에":"数週間ではなく、数時間で"}],693785)},960658,e=>{"use strict";var a=e.i(420459);e.s(["peoplePage_hero_cta",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Book a demo":"pt-BR"===i?"Agendar uma demonstração":"de"===i?"Demo buchen":"fr"===i?"Réserver une démo":"es"===i?"Reservar una demo":"it"===i?"Prenota una demo":"hi"===i?"डेमो बुक करें":"id"===i?"Pesan demo":"th"===i?"จองการสาธิต":"ko"===i?"데모 예약하기":"デモ