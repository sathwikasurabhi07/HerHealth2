と連携してください。`}],239315)},956341,e=>{"use strict";var a=e.i(420459);e.s(["auth_linkWithSSO",0,(e,t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();if("en"===i)return`Link with ${e?.provider} SSO`;if("pt-BR"===i)return`Vincular com SSO do ${e?.provider}`;if("de"===i)return`Mit ${e?.provider}-SSO verkn\xfcpfen`;if("fr"===i)return`Associer le SSO ${e?.provider}`;if("es"===i)return`Vincular con SSO de ${e?.provider}`;if("it"===i)return`Collega con SSO di ${e?.provider}`;if("hi"===i)return`${e?.provider} SSO से जोड़ें`;if("id"===i)return`Tautkan dengan SSO ${e?.provider}`;if("th"===i)return`เชื่อมโยงกับ ${e?.provider} SSO`;if("ko"===i)return`${e?.provider} SSO와 연결`;return`${e?.provider} SSOと連携`}])},328016,e=>{"use strict";var a=e.i(420459);e.s(["auth_loginWithSSO",0,(e,t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();if("en"===i)return`Login with ${e?.provider} SSO`;if("pt-BR"===i)return`Entrar com SSO do ${e?.provider}`;if("de"===i)return`Mit ${e?.provider}-SSO anmelden`;if("fr"===i)return`Se connecter avec le SSO ${e?.provider}`;if("es"===i)return`Iniciar sesi\xf3n con SSO de ${e?.provider}`;if("it"===i)return`Accedi con SSO di ${e?.provider}`;if("hi"===i)return`${e?.provider} SSO के ज़रिए लॉग इन करें`;if("id"===i)return`Masuk dengan SSO ${e?.provider}`;if("th"===i)return`เข้าสู่ระบบด้วย ${e?.provider} SSO`;if("ko"===i)return`${e?.provider} SSO로 로그인`;return`${e?.provider} SSOでログイン`}])},572301,e=>{"use strict";var a=e.i(420459);e.s(["foundersPage_hero_cta",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Start building":"pt-BR"===i?"Comece a criar":"de"===i?"Jetzt loslegen":"fr"===i?"Commencer à créer":"es"===i?"Empieza a construir":"it"===i?"Inizia a creare":"hi"===i?"बनाना शुरू करें":"id"===i?"Mulai membangun":"th"===i?"เริ่มสร้าง":"ko"===i?"만들기 시작하기":"作り始める"}])},702678,e=>{"use strict";var a=e.i(420459);e.s(["foundersPage_hero_h1",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Tools for founders":"pt-BR"===i?"Ferramentas para fundadores":"de"===i?"Tools für Gründer":"fr"===i?"Outils pour fondateurs":"es"===i?"Herramientas para fundadores":"it"===i?"Strumenti per fondatori":"hi"===i?"संस्थापकों के लिए उपकरण":"id"===i?"Alat untuk pendiri":"th"===i?"เครื่องมือสำหรับผู้ก่อตั้ง":"ko"===i?"창업자를 위한 도구":"創業者のためのツール"}])},209462,e=>{"use strict";var a=e.i(420459);e.s(["foundersPage_hero_subtitle",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Lovable is your AI cofounder and development team. Ship your ideas in days, not months — and start building the business you've been dreaming about":"pt-BR"===i?"A Lovable é sua cofundadora de IA e equipe de desenvolvimento. Lance suas ideias em dias, não meses — e comece a construir o negócio com que você sempre sonhou":"de"===i?"Lovable ist dein KI-Mitgründer und Entwicklungsteam. Bring deine Ideen in Tagen statt Monaten auf den Markt – und beginne, das Unternehmen aufzubauen, von dem du schon immer geträumt hast":"fr"===i?"Lovable est votre cofondateur IA et votre équipe de développement. Concrétisez vos idées en quelques jours, pas en quelques mois — et lancez l'entreprise dont vous rêvez":"es"===i?"Lovable es tu cofundador de IA y tu equipo de desarrollo. Lanza tus ideas en días, no en meses, y empieza a construir el negocio con el que has estado soñando":"it"===i?"Lovable è il tuo cofondatore basato sull'AI e il tuo team di sviluppo. Realizza le tue idee in giorni, non in mesi — e inizia a costruire l'azienda che hai sempre sognato":"hi"===i?"Lovable आपका AI को-फाउंडर और डेवलपमेंट टीम है। अपने आइडिया महीनों में नहीं, दिनों में लॉन्च करें — और वह बिज़नेस बनाना शुरू करें जिसका आप सपना देखते आए हैं":"id"===i?"Lovable adalah rekan pendiri AI dan tim pengembanganmu. Wujudkan idemu dalam hitungan hari, bukan bulan — dan mulai bangun bisnis yang selama ini kamu impikan":"th"===i?"Lovable คือผู้ร่วมก่อตั้งและทีมพัฒนา AI ของคุณ ส่งไอเดียของคุณออกสู่ตลาดได้ในไม่กี่วัน ไม่ใช่หลายเดือน — และเริ่มสร้างธุรกิจที่คุณใฝ่ฝันมาตลอด":"ko"===i?"Lovable은 여러분의 AI 공동창업자이자 개발팀입니다. 몇 달이 아닌 며칠 만에 아이디어를 출시하고, 꿈꿔온 비즈니스를 만들어 보세요":"Lovableは、AI共同創業者であり開発チームです。アイデアを数か月ではなく数日で形にし、ずっと夢見てきたビジネスを始めましょう"}])},330516,835821,e=>{"use strict";var a=e.i(420459);e.s(["foundersPage_hero_titleLine1",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Build your":"pt-BR"===i?"Construa o seu":"de"===i?"Verwirkliche deinen":"fr"===i?"Donnez vie à votre":"es"===i?"Construye tu":"it"===i?"Costruisci il tuo":"hi"===i?"बनाएं अपना":"id"===i?"Wujudkan":"th"===i?"สร้าง":"ko"===i?"꿈을":"夢を"}],330516),e.s(["foundersPage_hero_titleLine2",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"dream":"pt-BR"===i?"sonho":"de"===i?"Traum":"fr"===i?"rêve":"es"===i?"sueño":"it"===i?"sogno":"hi"===i?"सपना":"id"===i?"impian Anda":"th"===i?"ความฝัน":"ko"===i?"현실로 만드세요":"築こう"}],835821)},505324,e=>{"use strict";var a=e.i(420459);e.s(["marketersPage_hero_cta",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Book a demo":"pt-BR"===i?"Agende uma demonstração":"de"===i?"Demo buchen":"fr"===i?"Réserver une démo":"es"===i?"Reserva una demo":"it"===i?"Prenota una demo":"hi"===i?"डेमो बुक करें":"id"===i?"Pesan demo":"th"===i?"นัดหมายชมการสาธิต":"ko"===i?"데모 예약하기":"デモを予約"}])},694616,e=>{"use strict";var a=e.i(420459);e.s(["marketersPage_hero_faster",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"faster":"pt-BR"===i?"mais rápido":"de"===i?"schneller":"fr"===i?"plus vite":"es"===i?"más rápido":"it"===i?"più velocemente":"hi"===i?"तेज़ी से":"id"===i?"lebih cepat":"th"===i?"เร็วขึ้น":"ko"===i?"더 빠르게":"スピーディに"}])},267806,492281,e=>{"use strict";var a=e.i(420459);e.s(["marketersPage_hero_h1",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Tools for marketers":"pt-BR"===i?"Ferramentas para profissionais de marketing":"de"===i?"Tools für Marketer":"fr"===i?"Des outils pour les équipes marketing":"es"===i?"Herramientas para profesionales del marketing":"it"===i?"Strumenti per il marketing":"hi"===i?"मार्केटर्स के लिए टूल्स":"id"===i?"Alat untuk pemasar":"th"===i?"เครื่องมือสำหรับนักการตลาด":"ko"===i?"마케터를 위한 도구":"マーケター向けツール"}],267806),e.s(["marketersPage_hero_ship",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Ship":"pt-BR"===i?"Entregue":"de"===i?"Veröffentliche":"fr"===i?"Lancez":"es"===i?"Lanza":"it"===i?"Pubblica":"hi"===i?"लॉन्च करें":"id"===i?"Luncurkan":"th"===i?"เปิดตัว":"ko"===i?"출시":"リリース"}],492281)},860939,e=>{"use strict";var a=e.i(420459);e.s(["marketersPage_hero_subtitle",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Launch on-brand landing pages, interactive campaigns, and digital experiences without engineering bottlenecks.":"pt-BR"===i?"Lance páginas de destino com a identidade da marca, campanhas interativas e experiências digitais sem gargalos de engenharia.":"de"===i?"Veröffentliche markenkonforme Landingpages, interaktive Kampagnen und digitale Erlebnisse ohne Engpässe in der Entwicklung.":"fr"===i?"Lancez des pages de destination à l'image de votre marque, des campagnes interactives et des expériences numériques sans blocage côté développement.":"es"===i?"Lanza páginas de destino con tu marca, campañas interactivas y experiencias digitales sin cuellos de botella en ingeniería.":"it"===i?"Lancia pagine di destinazione in linea con il marchio, campagne interattive ed esperienze digitali senza colli di bottiglia tecnici.":"hi"===i?"इंजीनियरिंग की रुकावटों के बिना ऑन-ब्रांड लैंडिंग पेज, इंटरैक्टिव कैंपेन और डिजिटल अनुभव लॉन्च करें।":"id"===i?"Luncurkan halaman arahan bermerek, kampanye interaktif, dan pengalaman digital tanpa hambatan dari tim teknik.":"th"===i?"เปิดตัวแลนดิงเพจที่ตรงกับแบรนด์ แคมเปญแบบอินเทอร์แอกทีฟ และประสบการณ์ดิจิทัล โดยไม่สะดุดเพราะต้องรอทีมวิศวกร":"ko"===i?"엔지니어링 병목 없이 브랜드에 맞는 랜딩 페이지, 인터랙티브 캠페인, 디지털 경험을 출시하세요.":"エンジニアリングのボトルネックなしに、ブランドに沿ったランディングページ、インタラクティブなキャンペーン、デジタル体験を公開しましょう。"}])},242769,e=>{"use strict";var a=e.i(420459);e.s(["connectorsPage_hero_cta",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Get started":"pt-BR"===i?"Começar":"de"===i?"Loslegen":"fr"===i?"Commencer":"es"===i?"Comenzar":"it"===i?"Inizia":"hi"===i?"शुरू करें":"id"===i?"Mulai sekarang":"th"===i?"เริ่มต้นใช้งาน":"ko"===i?"시작하기":"始める"}])},536366,e=>{"use strict";var a=e.i(420459);e.s(["connectorsPage_hero_label",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Lovable connectors":"pt-BR"===i?"Conectores da Lovable":"de"===i?"Lovable-Konnektoren":"fr"===i?"Connecteurs Lovable":"es"===i?"Conectores de Lovable":"it"===i?"Connettori Lovable":"hi"===i?"Lovable कनेक्टर":"id"===i?"Konektor Lovable":"th"===i?"คอนเนกเตอร์ Lovable":"ko"===i?"Lovable 커넥터":"Lovable コネクター"}])},964923,e=>{"use strict";var a=e.i(420459);e.s(["connectorsPage_hero_subtitle",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Connect Linear, Notion, Stripe, Slack, and more. Lovable builds with all of it.":"pt-BR"===i?"Conecte Linear, Notion, Stripe, Slack e muito mais. A Lovable cria usando tudo isso.":"de"===i?"Verbinde Linear, Notion, Stripe, Slack und mehr. Lovable nutzt all das zum Bauen.":"fr"===i?"Connectez Linear, Notion, Stripe, Slack et plus encore. Lovable s'appuie sur tout cela pour créer.":"es"===i?"Conecta Linear, Notion, Stripe, Slack y más. Lovable crea con todo eso.":"it"===i?"Collega Linear, Notion, Stripe, Slack e altri ancora. Lovable usa tutto questo per creare.":"hi"===i?"Linear, Notion, Stripe, Slack और अन्य टूल जोड़ें। Lovable इन सबका उपयोग करके बनाता है।":"id"===i?"Hubungkan Linear, Notion, Stripe, Slack, dan lainnya. Lovable menggunakan semuanya untuk membangun.":"th"===i?"เชื่อมต่อ Linear, Notion, Stripe, Slack และอื่น ๆ อีกมากมาย Lovable สร้างทุกอย่างขึ้นมาจากสิ่งเหล่านี้":"ko"===i?"Linear, Notion, Stripe, Slack 등을 연결하세요. Lovable이 이 모든 것을 바탕으로 만들어줘요.":"Linear、Notion、Stripe、Slack などに接続できます。Lovable はそれらを活用してアプリを作成します。"}])},76503,873620,e=>{"use strict";var a=e.i(420459);e.s(["connectorsPage_hero_titleLine1",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Build from what":"pt-BR"===i?"Construa a partir do que":"de"===i?"Bau aus dem,":"fr"===i?"Créez à partir de ce":"es"===i?"Construye a partir de lo":"it"===i?"Crea partendo da ciò":"hi"===i?"उसी से बनाएँ जो":"id"===i?"Bangun dengan yang":"th"===i?"สร้างจากสิ่งที่":"ko"===i?"이미 사용 중인 것으로":"普段使っているツールを活かして"}],76503),e.s(["connectorsPage_hero_titleLine2",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"you already use":"pt-BR"===i?"você já usa":"de"===i?"was du schon nutzt":"fr"===i?"que vous utilisez déjà":"es"===i?"que ya usas":"it"===i?"che usi già":"hi"===i?"आप पहले से उपयोग करते हैं":"id"===i?"sudah Anda gunakan":"th"===i?"คุณใช้อยู่แล้ว":"ko"===i?"만들어보세요":"作成しましょう"}],873620)},172333,e=>{"use strict";var a=e.i(420459);e.s(["enterpriseLandingPage_hero_cta",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Get a demo":"pt-BR"===i?"Solicitar uma demonstração":"de"===i?"Demo anfordern":"fr"===i?"Demander une démo":"es"===i?"Solicita una demo":"it"===i?"Richiedi una demo":"hi"===i?"डेमो लें":"id"===i?"Minta demo":"th"===i?"ขอดูเดโม":"ko"===i?"데모 신청하기":"デモを申し込む"}])},534012,e=>{"use strict";var a=e.i(420459);e.s(["enterpriseLandingPage_hero_label",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Lovable for enterprises":"pt-BR"===i?"Lovable para empresas":"de"===i?"Lovable für Unternehmen":"fr"===i?"Lovable pour les entreprises":"es"===i?"Lovable para empresas":"it"===i?"Lovable per le aziende":"hi"===i?"एंटरप्राइज़ के लिए Lovable":"id"===i?"Lovable untuk perusahaan":"th"===i?"Lovable สำหรับองค์กร":"ko"===i?"엔터프라이즈를 위한 Lovable":"企業向けの Lovable"}])},618376,e=>{"use strict";var a=e.i(420459);e.s(["enterpriseLandingPage_hero_subtitle",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Prototype faster, validate early, and ship internal tools and production apps without waiting on engineering.":"pt-BR"===i?"Prototipe mais rápido, valide cedo e publique ferramentas internas e aplicativos de produção sem depender da engenharia.":"de"===i?"Erstelle schneller Prototypen, validiere frühzeitig und liefere interne Tools sowie Produktions-Apps aus, ohne auf die Entwicklung warten zu müssen.":"fr"===i?"Prototypez plus vite, validez tôt et livrez des outils internes et des applications de production sans attendre l'équipe d'ingénierie.":"es"===i?"Crea prototipos más rápido, valida desde el principio y lanza herramientas internas y aplicaciones de producción sin depender de ingeniería.":"it"===i?"Prototipa più velocemente, valida in anticipo e distribuisci strumenti interni e app di produzione senza dover attendere il team di sviluppo.":"hi"===i?"तेज़ी से प्रोटोटाइप बनाएं, जल्दी सत्यापित करें, और इंजीनियरिंग का इंतज़ार किए बिना आंतरिक टूल और उत्पादन ऐप लॉन्च करें।":"id"===i?"Buat prototipe lebih cepat, validasi lebih awal, dan luncurkan alat internal serta aplikasi produksi tanpa menunggu tim teknik.":"th"===i?"สร้างต้นแบบได้เร็วขึ้น ตรวจสอบความเป็นไปได้ตั้งแต่เนิ่น ๆ และส่งมอบเครื่องมือภายในและแอปใช้งานจริงได้โดยไม่ต้องรอทีมวิศวกรรม":"ko"===i?"더 빠르게 프로토타입을 만들고, 일찍 검증하고, 엔지니어링을 기다리지 않고 내부 도구와 프로덕션 앱을 출시하세요.":"より速くプロトタイプを作り、早い段階で検証し、エンジニアリングを待たずに社内ツールや本番アプリを提供できます。"}])},232181,e=>{"use strict";var a=e.i(420459);e.s(["enterpriseLandingPage_hero_title_faster",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"faster":"pt-BR"===i?"mais rápido":"de"===i?"schneller":"fr"===i?"plus vit