)=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Unable to complete registration with this email address":"pt-BR"===i?"Não foi possível concluir o cadastro com este endereço de e-mail":"de"===i?"Die Registrierung mit dieser E-Mail-Adresse kann nicht abgeschlossen werden":"fr"===i?"Impossible de finaliser l'inscription avec cette adresse e-mail":"es"===i?"No se pudo completar el registro con esta dirección de correo electrónico":"it"===i?"Impossibile completare la registrazione con questo indirizzo email":"hi"===i?"इस ईमेल पते के साथ पंजीकरण पूरा नहीं किया जा सका":"id"===i?"Tidak dapat menyelesaikan pendaftaran dengan alamat email ini":"th"===i?"ไม่สามารถลงทะเบียนด้วยอีเมลนี้ได้":"ko"===i?"이 이메일 주소로는 가입을 완료할 수 없어요":"このメールアドレスでは登録を完了できません"}],381485),e.s(["auth_errors_ssoNoLongerAvailable",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"SSO is no longer available for this workspace":"pt-BR"===i?"O SSO não está mais disponível para este espaço de trabalho":"de"===i?"SSO ist für diesen Arbeitsbereich nicht mehr verfügbar":"fr"===i?"Le SSO n'est plus disponible pour cet espace de travail":"es"===i?"El SSO ya no está disponible para este espacio de trabajo":"it"===i?"L'SSO non è più disponibile per questo spazio di lavoro":"hi"===i?"इस वर्कस्पेस के लिए SSO अब उपलब्ध नहीं है":"id"===i?"SSO sudah tidak tersedia untuk ruang kerja ini":"th"===i?"SSO ไม่สามารถใช้งานได้สำหรับเวิร์กสเปซนี้อีกต่อไป":"ko"===i?"이 워크스페이스에서는 더 이상 SSO를 사용할 수 없습니다":"このワークスペースではSSOが利用できなくなりました"}],268779),e.s(["auth_errors_ssoNoLongerAvailableDescription",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Your organization's SSO is no longer available. Please sign in with your existing account method (email/password, Google, or GitHub) and contact your admin to re-enable SSO.":"pt-BR"===i?"O SSO da sua organização não está mais disponível. Faça login usando seu método de acesso existente (e-mail/senha, Google ou GitHub) e entre em contato com seu administrador para reativar o SSO.":"de"===i?"SSO ist für deine Organisation nicht mehr verfügbar. Bitte melde dich mit deiner bestehenden Anmeldemethode (E-Mail/Passwort, Google oder GitHub) an und wende dich an deinen Administrator, um SSO wieder zu aktivieren.":"fr"===i?"Le SSO de votre organisation n'est plus disponible. Veuillez vous connecter avec votre méthode de connexion existante (e-mail/mot de passe, Google ou GitHub) et contacter votre administrateur pour réactiver le SSO.":"es"===i?"El SSO de tu organización ya no está disponible. Inicia sesión con el método de tu cuenta existente (correo electrónico/contraseña, Google o GitHub) y ponte en contacto con tu administrador para volver a habilitar el SSO.":"it"===i?"L'SSO della tua organizzazione non è più disponibile. Accedi con il metodo del tuo account esistente (email/password, Google o GitHub) e contatta il tuo amministratore per riabilitare l'SSO.":"hi"===i?"आपके संगठन का SSO अब उपलब्ध नहीं है। कृपया अपने मौजूदा साइन-इन तरीके (ईमेल/पासवर्ड, Google या GitHub) से साइन इन करें और SSO को फिर से सक्षम करने के लिए अपने व्यवस्थापक से संपर्क करें।":"id"===i?"SSO organisasi Anda sudah tidak tersedia. Silakan masuk dengan metode login yang sudah Anda gunakan (email/kata sandi, Google, atau GitHub) dan hubungi administrator Anda untuk mengaktifkan kembali SSO.":"th"===i?"SSO ขององค์กรคุณไม่สามารถใช้งานได้อีกต่อไป กรุณาเข้าสู่ระบบด้วยวิธีเดิมของบัญชีคุณ (อีเมล/รหัสผ่าน, Google หรือ GitHub) และติดต่อผู้ดูแลระบบเพื่อเปิดใช้งาน SSO อีกครั้ง":"ko"===i?"조직의 SSO를 더 이상 사용할 수 없습니다. 기존 계정 방식(이메일/비밀번호, Google 또는 GitHub)으로 로그인한 후 관리자에게 SSO 재활성화를 요청해 주세요.":"組織のSSOが利用できなくなりました。既存のサインイン方法（メール／パスワード、Google、またはGitHub）でサインインし、管理者に連絡してSSOの再有効化をご依頼ください。"}],267596),e.s(["auth_errors_ssoNotConfiguredForEmail",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"We couldn't continue. Please contact your administrator if the problem persists.":"pt-BR"===i?"Não foi possível continuar. Entre em contato com seu administrador se o problema persistir.":"de"===i?"Wir konnten nicht fortfahren. Bitte wende dich an deinen Administrator, falls das Problem weiterhin besteht.":"fr"===i?"Nous n'avons pas pu continuer. Veuillez contacter votre administrateur si le problème persiste.":"es"===i?"No pudimos continuar. Ponte en contacto con tu administrador si el problema persiste.":"it"===i?"Non è stato possibile continuare. Contatta il tuo amministratore se il problema persiste.":"hi"===i?"हम जारी नहीं रख सके। यदि समस्या बनी रहती है तो कृपया अपने व्यवस्थापक से संपर्क करें।":"id"===i?"Kami tidak dapat melanjutkan. Hubungi administrator Anda jika masalah ini berlanjut.":"th"===i?"เราไม่สามารถดำเนินการต่อได้ กรุณาติดต่อผู้ดูแลระบบของคุณหากปัญหายังคงอยู่":"ko"===i?"계속할 수 없습니다. 문제가 계속되면 관리자에게 문의해 주세요.":"続行できませんでした。問題が解決しない場合は、管理者にお問い合わせください。"}],998682)},204827,e=>{"use strict";var a=e.i(420459);e.s(["auth_errors_tryAgainOrUsePassword",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Please try again or use your existing sign-in method. You can link SSO after signing in.":"pt-BR"===i?"Tente novamente ou use seu método de login atual. Você pode vincular o SSO após entrar.":"de"===i?"Bitte versuche es erneut oder verwende deine bestehende Anmeldemethode. Du kannst SSO nach der Anmeldung verknüpfen.":"fr"===i?"Veuillez réessayer ou utiliser votre méthode de connexion existante. Vous pourrez associer le SSO après vous être connecté.":"es"===i?"Inténtalo de nuevo o usa tu método de inicio de sesión actual. Puedes vincular el SSO después de iniciar sesión.":"it"===i?"Riprova o usa il tuo metodo di accesso esistente. Puoi collegare l'SSO dopo aver effettuato l'accesso.":"hi"===i?"कृपया फिर से प्रयास करें या अपनी मौजूदा साइन-इन विधि का उपयोग करें। साइन इन करने के बाद आप SSO जोड़ सकते हैं।":"id"===i?"Silakan coba lagi atau gunakan metode masuk Anda yang sudah ada. Anda dapat menautkan SSO setelah masuk.":"th"===i?"กรุณาลองอีกครั้งหรือใช้วิธีลงชื่อเข้าใช้เดิมของคุณ คุณสามารถเชื่อมต่อ SSO ได้หลังจากลงชื่อเข้าใช้":"ko"===i?"다시 시도하거나 기존 로그인 방법을 사용해 주세요. 로그인 후 SSO를 연결할 수 있어요.":"再度お試しいただくか、既存のサインイン方法をご利用ください。サインイン後にSSOと連携できます。"}])},638898,e=>{"use strict";var a=e.i(420459);e.s(["auth_forgotPassword",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Forgot password?":"pt-BR"===i?"Esqueceu a senha?":"de"===i?"Passwort vergessen?":"fr"===i?"Mot de passe oublié ?":"es"===i?"¿Olvidaste tu contraseña?":"it"===i?"Password dimenticata?":"hi"===i?"पासवर्ड भूल गए?":"id"===i?"Lupa kata sandi?":"th"===i?"ลืมรหัสผ่าน?":"ko"===i?"비밀번호를 잊으셨나요?":"パスワードをお忘れですか？"}])},966849,e=>{"use strict";var a=e.i(420459);e.s(["auth_hidePassword",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Hide password":"pt-BR"===i?"Ocultar senha":"de"===i?"Passwort verbergen":"fr"===i?"Masquer le mot de passe":"es"===i?"Ocultar contraseña":"it"===i?"Nascondi password":"hi"===i?"पासवर्ड छिपाएँ":"id"===i?"Sembunyikan kata sandi":"th"===i?"ซ่อนรหัสผ่าน":"ko"===i?"비밀번호 숨기기":"パスワードを非表示"}])},999830,e=>{"use strict";var a=e.i(420459);e.s(["auth_password",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Password":"pt-BR"===i?"Senha":"de"===i?"Passwort":"fr"===i?"Mot de passe":"es"===i?"Contraseña":"it"===i?"Password":"hi"===i?"पासवर्ड":"id"===i?"Kata sandi":"th"===i?"รหัสผ่าน":"ko"===i?"비밀번호":"パスワード"}])},489969,e=>{"use strict";var a=e.i(420459);e.s(["auth_passwordReset_backToLogin",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Back to login":"pt-BR"===i?"Voltar para o login":"de"===i?"Zurück zur Anmeldung":"fr"===i?"Retour à la connexion":"es"===i?"Volver al inicio de sesión":"it"===i?"Torna all'accesso":"hi"===i?"लॉगिन पर वापस जाएँ":"id"===i?"Kembali ke halaman masuk":"th"===i?"กลับไปหน้าเข้าสู่ระบบ":"ko"===i?"로그인으로 