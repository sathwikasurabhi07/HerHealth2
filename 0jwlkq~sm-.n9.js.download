n link SSO from your account settings":"pt-BR"===i?"Falha na autenticação SSO. Faça login com sua conta existente primeiro e, em seguida, vincule o SSO nas configurações da sua conta":"de"===i?"Die SSO-Authentifizierung ist fehlgeschlagen. Bitte melde dich zuerst mit deinem bestehenden Konto an und verknüpfe SSO anschließend in deinen Kontoeinstellungen":"fr"===i?"L'authentification SSO a échoué. Veuillez d'abord vous connecter avec votre compte existant, puis associer le SSO depuis les paramètres de votre compte":"es"===i?"Error de autenticación con SSO. Inicia sesión primero con tu cuenta existente y luego vincula el SSO desde la configuración de tu cuenta":"it"===i?"Autenticazione SSO non riuscita. Accedi prima con il tuo account esistente, quindi collega l'SSO dalle impostazioni del tuo account":"hi"===i?"SSO प्रमाणीकरण विफल रहा। कृपया पहले अपने मौजूदा खाते से साइन इन करें, फिर अपनी खाता सेटिंग्स से SSO लिंक करें":"id"===i?"Autentikasi SSO gagal. Masuk terlebih dahulu dengan akun Anda yang sudah ada, lalu tautkan SSO dari pengaturan akun Anda":"th"===i?"การยืนยันตัวตนด้วย SSO ล้มเหลว กรุณาเข้าสู่ระบบด้วยบัญชีที่มีอยู่ของคุณก่อน จากนั้นเชื่อมโยง SSO จากการตั้งค่าบัญชีของคุณ":"ko"===i?"SSO 인증에 실패했습니다. 먼저 기존 계정으로 로그인한 다음 계정 설정에서 SSO를 연결해 주세요":"SSO認証に失敗しました。まず既存のアカウントでサインインし、その後アカウント設定からSSOを連携してください"}])},667690,e=>{"use strict";var a=e.i(420459);e.s(["auth_logIn",0,(e={},t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();return"en"===i?"Log in":"pt-BR"===i?"Entrar":"de"===i?"Anmelden":"fr"===i?"Se connecter":"es"===i?"Iniciar sesión":"it"===i?"Accedi":"hi"===i?"लॉग इन करें":"id"===i?"Masuk":"th"===i?"เข้าสู่ระบบ":"ko"===i?"로그인":"ログイン"}])},588365,e=>{"use strict";var a=e.i(420459);e.s(["auth_signUpWithSSO",0,(e,t={})=>{let i=a.experimentalStaticLocale??t.locale??(0,a.getLocale)();if("en"===i)return`Sign up with ${e?.provider} SSO`;if("pt-BR"===i)return`Cadastre-se com SSO via ${e?.provider}`;if("de"===i)return`Mit ${e?.provider}-SSO registrieren`;i